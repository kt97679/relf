\ edit.4 - the interactive line editor (Iteration 303)
\
\ Until now an interactive line came from the terminal driver in its
\ cooked mode: it could be typed and backspaced over, and nothing else.
\ An arrow key arrived as three bytes and was inserted into the command,
\ so `echo hi` with a cursor correction ran as `echo h^[[Di`. There was
\ no history at all.
\
\ With TERM-RAW (Iteration 303's engine primitive) the shell reads one
\ byte at a time and does the editing itself: the arrow keys, the usual
\ control characters, and a history the up and down arrows walk.
\
\ Everything is written to fd 2, where the prompt goes, so that a piped
\ stdout still carries only what the script printed.

DEFER RUN-TRAP-CALL              \ shell.4's RUN-TRAP, for an interrupted read
VARIABLE CMD-START?              \ the next line begins a command: PS1, else PS2
                                 \ (declared here: tree.4 loads after this)
LINE-MAX BUFFER: ED-BUF          \ the line being edited
VARIABLE ED-LEN
VARIABLE ED-POS                  \ the cursor, 0 .. ED-LEN
VARIABLE ED-PROMPT-LEN
VARIABLE ED-SIGNAL               \ a signal seen while waiting for a key
VARIABLE ED-DONE                 \ 0 editing, 1 accepted, 2 cancelled, 3 end of input
2 BUFFER: ED-KEY

\ History: every line of the session, however many and however long.
\
\ It was 32 slots of 256 bytes - 8 KB, fixed - so the 33rd command
\ pushed the 1st out and a line over 255 characters was silently
\ truncated, which is the shape of line a person most wants back
\ (Iteration 408). Now the text goes into one growing arena, entries
\ NUL-terminated end to end, with a growing array of offsets beside
\ it. Memory is what was actually typed: a thousand commands of fifty
\ characters is fifty kilobytes.
1024 BUFFER: HIST-TEXT            \ the lines, NUL-terminated, end to end
64 CELLS BUFFER: HIST-OFF         \ where each one starts in HIST-TEXT
VARIABLE HIST-TEXT#              \ bytes used in HIST-TEXT
VARIABLE HIST#                   \ how many lines are stored
VARIABLE HIST-VIEW               \ which one is shown; HIST# means "the new line"
VARIABLE HIST-SAVED-LEN          \ the new line, kept while history is walked
LINE-MAX BUFFER: HIST-SAVED      \ grown with the line it saves

: HIST-SLOT ( i --- addr )   \ the i-th line, NUL-terminated
  CELLS HIST-OFF + @ HIST-TEXT + ;

: HIST-ADD ( c-addr u --- )   \ the newest line
  DUP 0= IF 2DROP EXIT THEN
  \ Both buffers grow BEFORE any address into them is taken: growing
  \ one moves it.
  HIST-TEXT# @ OVER + 1+ ENSURE-BUFFER HIST-TEXT
  HIST# @ 1+ CELLS ENSURE-BUFFER HIST-OFF
  HIST-TEXT# @ HIST# @ CELLS HIST-OFF + !    ( c-addr u )
  DUP >R
  HIST-TEXT HIST-TEXT# @ + SWAP MOVE         \ the length is on the return stack
  0 HIST-TEXT HIST-TEXT# @ + R@ + C!       \ the terminator
  R> 1+ HIST-TEXT# +!
  HIST# @ 1+ HIST# ! ;

\ ---- the screen ----

: ED-OUT ( c-addr u --- )   ERR-TYPE ;
: ED-CH ( c --- )   ED-KEY C!  ED-KEY 1 ED-OUT ;

: ED-CSI ( --- )   27 ED-CH  91 ED-CH ;

: ED-NUM ( n --- )   \ a small decimal, for a control sequence
  0 <# #S #> ED-OUT ;

: ED-REDRAW ( --- )
  13 ED-CH                                   \ column 0
  CMD-START? @ IF SH-PROMPT ELSE SH-PROMPT2 THEN
  ED-BUF ED-LEN @ ED-OUT
  ED-CSI 75 ED-CH                            \ erase to end of line
  13 ED-CH
  ED-PROMPT-LEN @ ED-POS @ + ?DUP IF ED-CSI ED-NUM 67 ED-CH THEN ;

\ ---- editing ----

: ED-INSERT ( c --- )
  \ The line grows as it is typed rather than stopping at LINE-MAX.
  \ 256 characters is not many for a shell line - a pipeline with two
  \ absolute paths reaches it - and the old behaviour was to drop the
  \ keystroke silently (Iteration 408). Grown BEFORE any address into
  \ the buffer is taken, since growing moves it.
  ED-LEN @ 2 + ENSURE-BUFFER ED-BUF
  ED-BUF ED-POS @ + DUP 1+                   ( c src dst )
  ED-LEN @ ED-POS @ - MOVE                   \ make room
  ED-BUF ED-POS @ + C!
  1 ED-LEN +!  1 ED-POS +! ;

: ED-BACKSPACE ( --- )
  ED-POS @ 0= IF EXIT THEN
  ED-BUF ED-POS @ + DUP 1-                   ( src dst )
  ED-LEN @ ED-POS @ - MOVE
  -1 ED-LEN +!  -1 ED-POS +! ;

: ED-DELETE ( --- )   \ the character under the cursor
  ED-POS @ ED-LEN @ < 0= IF EXIT THEN
  ED-BUF ED-POS @ + 1+ DUP 1-
  ED-LEN @ ED-POS @ - 1- MOVE
  -1 ED-LEN +! ;

: ED-KILL-TO-END ( --- )   ED-POS @ ED-LEN ! ;

: ED-KILL-LINE ( --- )   0 ED-LEN !  0 ED-POS ! ;

: ED-SET-LINE ( c-addr u --- )   \ replace what is being edited
  DUP 2 + ENSURE-BUFFER ED-BUF
  DUP ED-LEN !  DUP ED-POS !
  ED-BUF SWAP MOVE ;

\ ---- history ----

: ED-HIST-UP ( --- )
  HIST-VIEW @ 0= IF EXIT THEN
  HIST-VIEW @ HIST# @ = IF                   \ leaving the new line: keep it
    ED-LEN @ 2 + ENSURE-BUFFER HIST-SAVED
    ED-BUF HIST-SAVED ED-LEN @ MOVE  ED-LEN @ HIST-SAVED-LEN !
  THEN
  HIST-VIEW @ 1- DUP HIST-VIEW !
  HIST-SLOT DUP CSTRLEN ED-SET-LINE ;

: ED-HIST-DOWN ( --- )
  HIST-VIEW @ HIST# @ < 0= IF EXIT THEN
  HIST-VIEW @ 1+ DUP HIST-VIEW !
  DUP HIST# @ = IF
    DROP HIST-SAVED HIST-SAVED-LEN @ ED-SET-LINE
  ELSE
    HIST-SLOT DUP CSTRLEN ED-SET-LINE
  THEN ;

\ ---- keys ----

: ED-GET-BYTE ( --- c | -1 )
  \ Waits in short polls rather than in a blocking read, so a signal is
  \ noticed between them. Relying on the read failing with EINTR did not
  \ work (Iteration 313 measured it: the signal arrives and the handler
  \ runs, but the read carries on), and a shell that ignores ^C at its
  \ prompt is worse than one that answers it 10 ms later.
  BEGIN
    SIGNALS-PENDING ?DUP IF ED-SIGNAL ! -1 EXIT THEN
    KEY? IF
      ED-KEY 1 0 READ-SOME DUP 1 = IF DROP ED-KEY C@ EXIT THEN
      DROP -1 EXIT                             \ end of input
    THEN
    5 MS
  AGAIN ;

: ED-ESCAPE ( --- )   \ an arrow or a home/end key: ESC [ x
  ED-GET-BYTE DUP 91 = SWAP 79 = OR 0= IF EXIT THEN
  ED-GET-BYTE
  DUP 65 = IF DROP ED-HIST-UP        EXIT THEN   \ up
  DUP 66 = IF DROP ED-HIST-DOWN      EXIT THEN   \ down
  DUP 67 = IF DROP
    ED-POS @ ED-LEN @ < IF 1 ED-POS +! THEN EXIT THEN   \ right
  DUP 68 = IF DROP
    ED-POS @ 0 > IF -1 ED-POS +! THEN EXIT THEN         \ left
  DUP 72 = IF DROP 0 ED-POS ! EXIT THEN                 \ home
  DUP 70 = IF DROP ED-LEN @ ED-POS ! EXIT THEN          \ end
  51 = IF ED-GET-BYTE 126 = IF ED-DELETE THEN THEN ;    \ delete

\ ---- reverse incremental history search: ^R ----
\
\ Iteration 409, asked for by a user of the shell once history held
\ the whole session (408): what is the point of keeping every line if
\ the only way back is the up arrow, one at a time.
\
\ ^R starts it, with readline's own prompt, `(reverse-i-search)'pat': `
\ followed by the newest history line containing the pattern. Each
\ printable key extends the pattern; ^R again steps to the next older
\ match; backspace shortens it; ^G restores what was being typed. Any
\ other control key - RETURN, an arrow, ^A, ^E - accepts the match
\ into the line and is THEN acted on, which is readline's rule and why
\ RETURN runs the found command at once.

VARIABLE ED-SEARCHING             \ -1 while a search is under way
VARIABLE ED-SEARCH-HIT            \ the matching history entry, or -1
VARIABLE ED-SEARCH-FAIL           \ -1 when the pattern matches nothing
VARIABLE ED-SEARCH-LEN
VARIABLE ED-SEARCH-ORIG-LEN
64 BUFFER: ED-SEARCH-PAT          \ grown as the pattern is typed
LINE-MAX BUFFER: ED-SEARCH-ORIG   \ the line as it was when ^R was pressed

VARIABLE ED-PAT-A
VARIABLE ED-PAT-U

: ED-CONTAINS? ( c-addr u pat u2 --- flag )   \ pat occurs in c-addr u
  \ The pattern in variables rather than on the return stack: this
  \ kernel has no 2>R, and the first version of this word used it,
  \ which left ED-LINE undefined and the shell image booting into the
  \ bare Forth prompt instead (Iteration 409).
  ED-PAT-U !  ED-PAT-A !
  ED-PAT-U @ 0= IF 2DROP -1 EXIT THEN
  BEGIN DUP ED-PAT-U @ < 0= WHILE              ( a u )
    OVER ED-PAT-U @ ED-PAT-A @ ED-PAT-U @ COMPARE 0= IF 2DROP -1 EXIT THEN
    1 /STRING
  REPEAT
  2DROP 0 ;

: ED-SEARCH-FROM ( i --- )   \ the newest entry at or before i holding the pattern
  BEGIN DUP 0< 0= WHILE
    DUP HIST-SLOT DUP CSTRLEN ED-SEARCH-PAT ED-SEARCH-LEN @ ED-CONTAINS? IF
      ED-SEARCH-HIT !  0 ED-SEARCH-FAIL !  EXIT
    THEN
    1-
  REPEAT
  DROP -1 ED-SEARCH-FAIL ! ;              \ the last good match stays shown

: ED-SEARCH-BEGIN ( --- )
  ED-LEN @ 2 + ENSURE-BUFFER ED-SEARCH-ORIG
  ED-BUF ED-SEARCH-ORIG ED-LEN @ MOVE  ED-LEN @ ED-SEARCH-ORIG-LEN !
  0 ED-SEARCH-LEN !  -1 ED-SEARCH-HIT !  0 ED-SEARCH-FAIL !
  -1 ED-SEARCHING ! ;

: ED-SEARCH-ACCEPT ( --- )   \ the match becomes the line being edited
  ED-SEARCH-HIT @ 0< 0= IF
    ED-SEARCH-HIT @ DUP HIST-VIEW !           \ the arrows walk on from here
    HIST-SLOT DUP CSTRLEN ED-SET-LINE
  THEN
  0 ED-SEARCHING ! ;

: ED-SEARCH-CANCEL ( --- )   \ ^G: as if ^R had never been pressed
  ED-SEARCH-ORIG ED-SEARCH-ORIG-LEN @ ED-SET-LINE
  0 ED-SEARCHING ! ;

: ED-SEARCH-REDRAW ( --- )
  13 ED-CH
  ED-SEARCH-FAIL @ IF S" (failed reverse-i-search)'" ELSE S" (reverse-i-search)'" THEN
  ED-OUT
  ED-SEARCH-PAT ED-SEARCH-LEN @ ED-OUT
  S" ': " ED-OUT
  ED-SEARCH-HIT @ 0< 0= IF ED-SEARCH-HIT @ HIST-SLOT DUP CSTRLEN ED-OUT THEN
  ED-CSI 75 ED-CH ;                          \ erase to end of line

: ED-KEY-ACT ( c --- )
  DUP 10 = OVER 13 = OR IF DROP 1 ED-DONE ! EXIT THEN
  DUP 27 = IF DROP ED-ESCAPE EXIT THEN
  DUP 127 = OVER 8 = OR IF DROP ED-BACKSPACE EXIT THEN
  DUP 1 = IF DROP 0 ED-POS ! EXIT THEN            \ ^A
  DUP 5 = IF DROP ED-LEN @ ED-POS ! EXIT THEN     \ ^E
  DUP 2 = IF DROP ED-POS @ 0 > IF -1 ED-POS +! THEN EXIT THEN   \ ^B
  DUP 6 = IF DROP ED-POS @ ED-LEN @ < IF 1 ED-POS +! THEN EXIT THEN \ ^F
  DUP 11 = IF DROP ED-KILL-TO-END EXIT THEN       \ ^K
  DUP 21 = IF DROP ED-KILL-LINE EXIT THEN         \ ^U
  DUP 4 = IF DROP                                 \ ^D: end of input if empty
    ED-LEN @ 0= IF 3 ED-DONE ! ELSE ED-DELETE THEN EXIT THEN
  DUP 3 = IF DROP 2 ED-DONE ! EXIT THEN           \ ^C
  DUP 12 = IF DROP EXIT THEN                      \ ^L: redraw, which happens anyway
  DUP 18 = IF DROP ED-SEARCH-BEGIN EXIT THEN      \ ^R: search the history
  DUP 32 < IF DROP EXIT THEN                      \ other control characters
  ED-INSERT ;

: ED-SEARCH-KEY ( c --- )
  DUP 18 = IF DROP                                \ ^R: the next older match
    ED-SEARCH-HIT @ 0> IF ED-SEARCH-HIT @ 1- ED-SEARCH-FROM THEN EXIT THEN
  DUP 7 = IF DROP ED-SEARCH-CANCEL EXIT THEN      \ ^G
  DUP 127 = OVER 8 = OR IF DROP                   \ backspace: a shorter pattern
    ED-SEARCH-LEN @ 0= IF EXIT THEN
    -1 ED-SEARCH-LEN +!
    ED-SEARCH-LEN @ IF HIST# @ 1- ED-SEARCH-FROM
    ELSE -1 ED-SEARCH-HIT !  0 ED-SEARCH-FAIL ! THEN EXIT THEN
  DUP 32 < IF ED-SEARCH-ACCEPT ED-KEY-ACT EXIT THEN   \ accept, then act
  ED-SEARCH-LEN @ 2 + ENSURE-BUFFER ED-SEARCH-PAT
  ED-SEARCH-PAT ED-SEARCH-LEN @ + C!  1 ED-SEARCH-LEN +!
  ED-SEARCH-HIT @ 0< IF HIST# @ 1- ELSE ED-SEARCH-HIT @ THEN ED-SEARCH-FROM ;

: ED-LINE ( --- c-addr u flag )   \ flag: -1 a line, 0 end of input
  0 ED-LEN !  0 ED-POS !  0 ED-DONE !  0 ED-SEARCHING !
  HIST# @ HIST-VIEW !  0 HIST-SAVED-LEN !
  CMD-START? @ IF PS1-NM PS1-DEFAULT ELSE PS2-NM PS2-DEFAULT THEN
  PROMPT-STRING NIP ED-PROMPT-LEN !
  ED-REDRAW
  BEGIN ED-DONE @ 0= WHILE
    ED-GET-BYTE DUP -1 = IF
      DROP
      \ A read cut short by a signal is not end of input: ^C cancels the
      \ line, and dash writes a newline before its next prompt
      \ (Iteration 312).
      ED-SIGNAL @ ?DUP IF
        0 ED-SIGNAL !
        RUN-TRAP-CALL  2 ED-DONE !              \ ^C: the line is abandoned
        0 INT-SEEN? !                           \ handled here, not at the prompt
      ELSE
        3 ED-DONE !                             \ the terminal closed
      THEN
    ELSE
      ED-SEARCHING @ IF ED-SEARCH-KEY ELSE ED-KEY-ACT THEN
      ED-SEARCHING @ IF ED-SEARCH-REDRAW ELSE ED-REDRAW THEN
    THEN
  REPEAT
  \ With ECHO off nothing shows ^C, which the terminal driver prints for
  \ a shell in cooked mode; the editor prints it (Iteration 312).
  ED-DONE @ 2 = IF 94 ED-CH 67 ED-CH THEN
  10 ED-CH                                      \ the newline the user typed
  ED-DONE @ 3 = IF ED-BUF 0 0 EXIT THEN
  ED-DONE @ 2 = IF ED-BUF 0 -1 EXIT THEN        \ ^C: an empty line
  ED-BUF ED-LEN @ 2DUP HIST-ADD -1 ;
