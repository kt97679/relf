VARIABLE ON-N
: ON-EXIT ( --- )   \ on EXIT { block }: the block a def of its own, R-EXIT-n, named to R-ON-EXIT
  1 ON-N +!  TO-DEFS  OUT-POS DEF-START !  S" :" OUT+  S" R-EXIT-" OUT-RAW ON-N @ OUT-NUM  -1 IN-EXIT ! BLOCK 0 IN-EXIT !  S" ;" OUT+ 10 OUT-C  TO-MAIN
  [CHAR] [ OUT-C [CHAR] ' OUT-C [CHAR] ] OUT-C BL OUT-C  S" R-EXIT-" OUT-RAW ON-N @ OUT-NUM  S" R-ON-EXIT" OUT+ ;
\ continue: a for loop's body holding one at its own level becomes a def
\ of its own, R-BODY-n - continue is its EXIT, break sets R-BRK - put in
\ front of the def being made (or after the defs, from R-MAIN), as
\ rillc.py's loop_body() appends it before the def that holds it (745)
VARIABLE HC-KINDS  VARIABLE HC-LOOPS  VARIABLE HC-DEPTH  VARIABLE HC-PEND  VARIABLE HC-BREAKS
: HAS-CONTINUE? ( --- f )   \ the block ahead, its { the current token
  0 HC-KINDS ! 0 HC-LOOPS ! 0 HC-DEPTH ! 0 HC-PEND !  TK-I @
  BEGIN
    DUP T@ S" {" S= OVER K@ T-OP = AND IF
      HC-KINDS @ 2* HC-PEND @ 1 AND OR HC-KINDS !  HC-PEND @ IF 1 HC-LOOPS +! THEN  0 HC-PEND !  1 HC-DEPTH +!
    ELSE DUP T@ S" }" S= OVER K@ T-OP = AND IF
      HC-KINDS @ 1 AND IF -1 HC-LOOPS +! THEN  HC-KINDS @ 2/ HC-KINDS !  -1 HC-DEPTH +!
      HC-DEPTH @ 0= IF DROP 0 EXIT THEN
    ELSE DUP K@ T-KW = OVER T@ S" for" S= 2 PICK T@ S" while" S= OR AND IF -1 HC-PEND !
    ELSE DUP K@ T-WORD = OVER T@ S" continue" S= AND HC-LOOPS @ 0= AND IF DROP -1 EXIT THEN
      HC-BREAKS @ IF DUP K@ T-KW = OVER T@ S" break" S= AND HC-LOOPS @ 0= AND IF DROP -1 EXIT THEN THEN   \ a while's break (779)
    THEN THEN THEN
    1+
  AGAIN ;
: HAS-RETURN? ( --- f )   \ the block ahead, its { the current token: a return at any depth (779)
  0 TK-I @
  BEGIN
    DUP T@ S" {" S= OVER K@ T-OP = AND IF SWAP 1+ SWAP
    ELSE DUP T@ S" }" S= OVER K@ T-OP = AND IF SWAP 1- DUP 0= IF 2DROP 0 EXIT THEN SWAP
    ELSE DUP K@ T-KW = OVER T@ S" return" S= AND IF 2DROP -1 EXIT THEN
    THEN THEN
    1+
  AGAIN ;
VARIABLE LB-WHILE   \ set by WHILE-STMT for the LOOP-BODY it calls: break, as continue, makes the body a word (779)
: LOOP-BODY ( kind --- ret )   \ ret: the body a word that may return
  LB-WHILE @  0 LB-WHILE !  DUP HC-BREAKS !                      ( kind w )
  HOIST @                                                          ( kind w old )
  HAS-CONTINUE? 0 HC-BREAKS ! 0= IF
    NIP 0 HOIST !  SWAP LK-PUSH  BLOCK  -1 LK-N +!  HOIST !  0 EXIT THEN
  ROT DROP  SWAP >R  HAS-RETURN? >R  LK-BASE @ >R  LK-N @ LK-BASE !   ( old  R: w ret base )
  -1 HOIST !  1 HOISTS +!  1 BODY-N +!  BODY-N @                 ( old n )
  CUR-B @ DEFS-B = DUP 0= IF TO-DEFS THEN                          ( old n in-def )
  DEF-START @  OUT-POS DUP DEF-START !                             ( old n in-def d0 s1 )
  S" :" OUT+ S" R-BODY-" OUT-RAW 3 PICK OUT-NUM  BLOCK  S" ;" OUT+ 10 OUT-C
  SWAP DEF-START !                                                 ( old n in-def s1 )
  OVER IF  DEF-START @ SEG>POS  SG-LEN @ DEF-START +!  ELSE DROP TO-MAIN THEN
  DROP  S" R-BODY-" OUT-RAW OUT-NUM
  R> LK-BASE !  R> R>                                              ( old ret w )
  0= IF DUP IF S" R-BRK @ R-RET @ OR IF 0 R-BRK ! LEAVE THEN" ELSE S" R-BRK @ IF 0 R-BRK ! LEAVE THEN" THEN OUT+ THEN
  -1 HOISTS +!  SWAP HOIST ! ;
: AFTER-BODY ( ret --- )   \ after a loop whose body word may return: pass it on, or return it (779)
  0= IF EXIT THEN
  HOISTS @ IF S" R-RET @ IF" OUT+ 0 UNWIND S" EXIT THEN" OUT+ EXIT THEN
  S" R-RET @ IF 0 R-RET !" OUT+ 0 UNWIND
  DF-CUR @ 0< 0= IF DEF-WANT ELSE 0 THEN IF S" R-RETV @" OUT+ THEN S" EXIT THEN" OUT+ ;   \ a def that names no kind returns nothing (805)
: BODY-BRACE ( --- i )   \ the { that opens the body ahead, past a condition's ( ... )
  0 TK-I @
  BEGIN
    DUP T@ S" (" S= OVER K@ T-OP = AND IF SWAP 1+ SWAP ELSE
    DUP T@ S" )" S= OVER K@ T-OP = AND IF SWAP 1- SWAP ELSE
    DUP T@ S" {" S= OVER K@ T-OP = AND 2 PICK 0= AND IF NIP EXIT THEN THEN THEN
    1+
  AGAIN ;
: WHILE-STMT ( --- )   \ a body with break or continue made a word: the stop checked before the condition (779)
  NEXT-TK
  TK-I @  BODY-BRACE TK-I !  -1 HC-BREAKS ! HAS-CONTINUE? 0 HC-BREAKS !  DUP IF HAS-RETURN? ELSE 0 THEN  ROT TK-I !   ( hoist? ret )
  OVER 0= IF 2DROP S" BEGIN" OUT+ COND S" WHILE" OUT+ -1 LB-WHILE ! 0 LOOP-BODY DROP S" REPEAT" OUT+ EXIT THEN
  NIP  S" BEGIN" OUT+  DUP IF S" R-BRK @ R-RET @ OR" ELSE S" R-BRK @" THEN OUT+
  S" 0= IF" OUT+ COND S" ELSE 0 THEN WHILE" OUT+  -1 LB-WHILE ! 0 LOOP-BODY DROP  S" REPEAT 0 R-BRK !" OUT+  AFTER-BODY ;
\ for, as rillc.py's for_(): a counted loop over range(a, b); a list's items; a record's keys and values
VARIABLE FOR-A  VARIABLE FOR-AL  VARIABLE FOR-B  VARIABLE FOR-BL  VARIABLE FOR-P
: RANGE-COMMAS ( --- n )   \ the commas at range( ... )'s own level, from the token after its ( : two mean a step (770)
  0 0 TK 2 +                                                    ( commas depth i )
  BEGIN
    DUP K@ T-EOF = IF 2DROP EXIT THEN
    DUP S" (" TK-IS? OVER S" [" TK-IS? OR OVER S" {" TK-IS? OR IF SWAP 1+ SWAP ELSE
    DUP S" )" TK-IS? OVER S" ]" TK-IS? OR OVER S" }" TK-IS? OR IF
      OVER 0= IF 2DROP EXIT THEN  SWAP 1- SWAP ELSE
    DUP S" ," TK-IS? IF OVER 0= IF ROT 1+ ROT ROT THEN THEN THEN THEN
    1+
  AGAIN ;
: FOR-STMT ( --- )
  NEXT-TK  TK T@ FOR-AL ! FOR-A !  NEXT-TK  0 FOR-BL !
  S" ," CUR-IS? IF NEXT-TK TK T@ FOR-BL ! FOR-B ! NEXT-TK THEN
  S" in" EXPECT
\ [gene rangeloop]
  S" range" CUR-IS? TK 1+ S" (" TK-IS? AND IF RANGE-COMMAS 2 < ELSE 0 THEN IF   \ hi lo TUCK MAX SWAP ?DO, no list made
    NEXT-TK NEXT-TK  OUT-POS FOR-P !  1 EXPR TO-NUM
    S" ," CUR-IS? IF NEXT-TK  OUT-POS  1 EXPR TO-NUM  S" )" EXPECT  FOR-P @ SEG>POS     \ hi moved before lo
    ELSE S" )" EXPECT  S" 0" OUT+ THEN                            \ range(b): from 0
    S" TUCK MAX SWAP" OUT+                                        \ an end not past the start: no rounds
    FOR-A @ FOR-AL @ DA-NEXT
\ [gene loopvar]
    FOR-A @ FOR-AL @ 2DUP DECLARE K-NUM BIND-K FOR-K !
    FOR-A @ FOR-AL @ LOOPVAR-OK? IF                               \ hi lo 2DUP SWAP 1+ SWAP ?DO ... I ... LOOP, stored once after
      S" 2DUP ?DO" OUT+  FOR-A @ FOR-AL @  2DUP LV-L ! LV-A !       \ the name kept on the stack over the body
      2 LOOP-BODY -ROT  0 LV-L !
      S" LOOP OVER < IF 1-" OUT+  FOR-K @ NUM-INTO  VAR-OUT S" ! ELSE DROP THEN" OUT+  AFTER-BODY  EXIT
    THEN
\ [/gene]
    FOR-A @ FOR-AL @ 2DUP DECLARE K-NUM BIND-K FOR-K !
    S" ?DO" OUT+ S" I" OUT+ FOR-K @ NUM-INTO FOR-A @ FOR-AL @ VAR-OUT S" !" OUT+ 1 LOOP-BODY S" LOOP" OUT+ AFTER-BODY  EXIT
  THEN
\ [/gene]
  1 EXPR                                                       ( sk )
  FOR-A @ FOR-AL @ TK-I @ TMP-NAME 2DUP DECLARE                ( sk tmp )
  IN-DEF @ 0= IF 2DUP 4 PICK K-REC = IF K-REC ELSE K-LIST THEN GR-ADD THEN   \ the collector's root (776)
  2 PICK K-REC = IF ROT DROP
    FOR-A @ FOR-AL @ 2DUP DECLARE K-TEXT BIND-K FOR-K !
    FOR-BL @ IF FOR-B @ FOR-BL @ 2DUP DECLARE K-ANY BIND-K DROP THEN
    FOR-A @ FOR-AL @ DA-NEXT  FOR-BL @ IF FOR-B @ FOR-BL @ DA-NEXT THEN
    2DUP VAR-OUT S" !" OUT+ 2DUP VAR-OUT S" @ R-KEYS R-LEN 0 ?DO" OUT+
    2DUP VAR-OUT S" @ R-KEYS I R-AT" OUT+ FOR-K @ K-TEXT = IF S" R-ANY>TEXT" OUT+ THEN FOR-A @ FOR-AL @ VAR-OUT S" !" OUT+
    FOR-BL @ IF 2DUP VAR-OUT S" @ R-VALS I R-AT" OUT+ FOR-B @ FOR-BL @ VAR-OUT S" !" OUT+ THEN
    2DROP 1 LOOP-BODY S" LOOP" OUT+ AFTER-BODY  EXIT
  THEN
  ROT DUP K-ANY = IF DROP S" R-UNBOX DROP" OUT+ ELSE K-LIST <> IF S" for needs a list or a record" ERR THEN THEN
  FOR-BL @ IF FOR-B @ FOR-BL @ ELSE FOR-A @ FOR-AL @ THEN 2DUP DECLARE K-ANY BIND-K DROP      \ the item, then the index: rillc.py's order
  FOR-BL @ IF FOR-A @ FOR-AL @ 2DUP DECLARE K-NUM BIND-K FOR-K ! THEN
  FOR-A @ FOR-AL @ DA-NEXT  FOR-BL @ IF FOR-B @ FOR-BL @ DA-NEXT THEN
  2DUP VAR-OUT S" !" OUT+ 2DUP VAR-OUT S" @ R-LEN 0 ?DO" OUT+
  FOR-BL @ IF S" I" OUT+ FOR-K @ NUM-INTO FOR-A @ FOR-AL @ VAR-OUT S" !" OUT+ THEN
  VAR-OUT S" @ I R-AT" OUT+  FOR-BL @ IF FOR-B @ FOR-BL @ ELSE FOR-A @ FOR-AL @ THEN VAR-OUT S" !" OUT+
  1 LOOP-BODY S" LOOP" OUT+ AFTER-BODY ;
\ x[i] = v: rillc.py puts the value first, then the container, then the index
VARIABLE IA-A  VARIABLE IA-L  VARIABLE IA-P  VARIABLE IA-K  VARIABLE IA-T
: IA-NO-OP ( --- )   \ x[i] = v: the = taken; += and -= gone (one way, 800)
  S" +=" CUR-IS? S" -=" CUR-IS? OR IF S" += and -= are gone: write x[i] = $x[i] + v" ERR THEN  S" =" EXPECT ;
CREATE CH-T 8 CELLS ALLOT  VARIABLE CH-N   \ a[i][j]: where each index's tokens start (779)
: CH-READ ( j conv --- )   \ index j's code again: conv 0 boxed, 1 a number, 2 a text
  TK-I @ >R  SWAP CELLS CH-T + @ TK-I !  1 EXPR  SWAP
  DUP 1 = IF DROP TO-NUM ELSE 2 = IF TO-TEXT ELSE BOX THEN THEN  R> TK-I ! ;
: CH-CONT ( --- )   \ the container, an item: the first index by the variable's kind, each later one R-INDEX-ANY - rillc.py's cc
  CH-N @ 2 - 0 ?DO  CH-N @ 2 - I -  0 CH-READ  LOOP                 \ the later indexes, last first
  IA-K @ K-LIST = IF IA-A @ IA-L @ VAR-OUT S" @" OUT+ 0 1 CH-READ S" R-AT" OUT+ ELSE
  IA-K @ K-REC = IF 0 2 CH-READ IA-A @ IA-L @ VAR-OUT S" @" OUT+ S" R-GET" OUT+ ELSE
  IA-K @ K-ANY = IF 0 0 CH-READ IA-A @ IA-L @ VAR-OUT S" @" OUT+ S" R-INDEX-ANY" OUT+ ELSE
  S" is not a list or a record" ERR THEN THEN THEN
  CH-N @ 2 - 0 ?DO S" R-INDEX-ANY" OUT+ LOOP ;
: CHAIN-ASSIGN ( --- )   \ a[i][j] = v, += v, -= v: rillc.py's chain - each index's code read again where it goes
  IA-P @ CUR#A @ !                                                   \ the first index's code, not here
  IA-T @ CH-T !  1 CH-N !
  BEGIN TK S" [" TK-IS? TK TOK-AT TK 1- TOK-END = AND WHILE
    CH-N @ 8 = IF S" more indexes than eight" ERR THEN
    NEXT-TK  TK-I @ CH-N @ CELLS CH-T + !  1 CH-N +!
    OUT-POS >R 1 EXPR DROP R> CUR#A @ !  S" ]" EXPECT                 \ passed over: read again below
  REPEAT
  IA-NO-OP  1 EXPR BOX
  CH-N @ 1- 0 CH-READ  CH-CONT  S" R-ASSIGN-ANY" OUT+ ;
: INDEX-ASSIGN ( --- )
  TK T@ IA-L ! IA-A !  NEXT-TK NEXT-TK
  IA-A @ IA-L @ NM-FIND DUP 0< IF S" is not set" ERR THEN CELLS NM-K + @  DUP IA-K !     ( ck )
  TK-I @ IA-T !                                                      \ where the index starts, to read it again
  OUT-POS IA-P !  1 EXPR  OVER K-LIST = IF TO-NUM ELSE OVER K-ANY = IF BOX ELSE TO-TEXT THEN THEN  S" ]" EXPECT
  TK S" [" TK-IS? TK TOK-AT TK 1- TOK-END = AND IF DROP CHAIN-ASSIGN EXIT THEN   \ a[i][j] (779)
  IA-NO-OP
  OUT-POS  1 EXPR BOX  IA-P @ SEG>POS          \ the value before the index
  DUP K-LIST = IF DROP OUT-POS IA-A @ IA-L @ VAR-OUT S" @" OUT+ IA-P @ SG-LEN @ + SEG>POS S" R-SET" OUT+ EXIT THEN
  DUP K-REC = IF DROP IA-A @ IA-L @ VAR-OUT S" @" OUT+ S" R-PUT" OUT+ EXIT THEN
  K-ANY = IF IA-A @ IA-L @ VAR-OUT S" @" OUT+ S" R-ASSIGN-ANY" OUT+ EXIT THEN      \ 758
  S" is not a list or a record" ERR ;
VARIABLE CD-P
: CD-STMT ( --- )   \ cd DIR; cd DIR { ... }: back where it was after the block (760)
  NEXT-TK OUT-POS CD-P !  ARG-ITEM S" R-CD" OUT+
  S" {" CUR-IS? IF S" R-CWD-PUSH" CD-P @ OUT-INSERT  BLOCK  S" R-CWD-POP" OUT+ THEN ;
: CASE-PAT ( --- quoted? )   \ a case arm's pattern (783): a string or $x, a term; else touching tokens, as written - rillc.py's
  TK K@ DUP T-STR = SWAP T-RAW = OR IF TERM TO-TEXT -1 EXIT THEN               \ quoted: the text itself, as the shell's
  TK K@ T-VAR = IF TERM TO-TEXT 0 EXIT THEN
  TK TOK-AT  TK-I @
  BEGIN 1+ DUP K@ DUP T-NL = SWAP T-EOF = OR  OVER TOK-AT 2 PICK 1- TOK-END <> OR  OVER T@ S" {" S= OR UNTIL
  DUP TK-I !  1- TOK-END OVER -  SWAP RS-SRC @ + SWAP LIT-TEXT  0 ;
: CASE-STMT ( --- )   \ case subject { pat pat { block } ... }: the first arm with a pattern that matches
  NEXT-TK  1 EXPR TO-TEXT  S" {" EXPECT  0
  BEGIN SKIP-NL S" }" CUR-IS? 0= WHILE
    0
    BEGIN S" {" CUR-IS? 0= WHILE
      TK K@ DUP T-NL = SWAP T-EOF = OR IF S" a case arm is patterns, then a block" ERR THEN
      DUP IF S" OVER" ELSE S" DUP" THEN OUT+  CASE-PAT IF S" R-T=" ELSE S" R-GLOB?" THEN OUT+  DUP IF S" OR" OUT+ THEN  1+
    REPEAT
    0= IF S" a case arm is patterns, then a block" ERR THEN
    S" IF DROP" OUT+ BLOCK S" ELSE" OUT+  1+
  REPEAT  NEXT-TK
  S" DROP" OUT+  0 ?DO S" THEN" OUT+ LOOP ;
: STATEMENT-IMPL ( --- )
\ [gene gc]
  IN-DEF @ 0= STACKMODE @ 0= AND IN-EXIT @ 0= AND IF                 \ a safe point before each top-level statement
    S" def" CUR-IS? S" on" CUR-IS? OR 0= IF HAS-ON-EXIT @ IF S" R-GC?S" ELSE S" R-GC?" THEN OUT+ THEN THEN   \ 786
\ [/gene]
\ [gene lines]
  S" def" CUR-IS? 0= IF S" [" OUT+ TK L@ OUT-NUM S" R-MARK ]" OUT+ THEN   \ where its code starts, and its line (781)
\ [/gene]
  S" if" CUR-IS? IF IF-STMT EXIT THEN
  S" case" CUR-IS? IF TK 1+ T@ 2DUP S" (" S= >R 2DUP S" =" S= >R 2DUP S" +=" S= >R 2DUP S" -=" S= >R S" [" S= R> OR R> OR R> OR R> OR
    0= IF CASE-STMT EXIT THEN THEN                                                   \ 783
  S" cd" CUR-IS? IF TK 1+ T@ 2DUP S" =" S= >R 2DUP S" (" S= >R S" [" S= R> OR R> OR 0= IF CD-STMT EXIT THEN THEN
  S" while" CUR-IS? IF WHILE-STMT EXIT THEN
  S" return" CUR-IS? IF RETURN-STMT EXIT THEN
  S" def" CUR-IS? IF DEF-STMT EXIT THEN
  S" for" CUR-IS? IF FOR-STMT EXIT THEN
  S" break" CUR-IS? IF NEXT-TK HOIST @ IF S" -1 R-BRK ! EXIT" ELSE S" LEAVE" THEN OUT+ EXIT THEN
  S" continue" CUR-IS? TK K@ T-WORD = AND IF HOIST @ 0= IF S" continue outside a for loop" ERR THEN
    NEXT-TK S" EXIT" OUT+ EXIT THEN
  S" exit" CUR-IS? TK K@ T-WORD = AND TK 1+ S" (" TK-IS? 0= AND IF NEXT-TK
    STATEMENT-END? IF S" 0 R-EXIT" OUT+ ELSE 1 EXPR TO-NUM S" R-EXIT" OUT+ THEN EXIT THEN
  S" on" CUR-IS? TK 1+ S" EXIT" TK-IS? AND IF NEXT-TK NEXT-TK ON-EXIT EXIT THEN
  TK K@ T-WORD = IF
    S" echo" CUR-IS? IF ECHO-OPTS THEN                                                \ 805
    TK 1+ S" [" TK-IS? TK 1+ TOK-AT TK TOK-END = AND IF INDEX-ASSIGN EXIT THEN
    TK 1+ S" =" TK-IS? TK 1+ S" +=" TK-IS? OR TK 1+ S" -=" TK-IS? OR IF ASSIGN EXIT THEN
\ [gene echolit]
    S" echo" CUR-IS? IF ECHO-ERR? IF ECHO-ERR EXIT THEN PLUMBED? 0= IF ECHO-TYPED EXIT THEN THEN
\ [/gene]
\ [gene !echolit]
    S" echo" CUR-IS? IF ECHO-ERR? IF ECHO-ERR EXIT THEN PLUMBED? 0= IF ECHO-STMT EXIT THEN THEN
\ [/gene]
    TK 1+ S" (" TK-IS? IF CALL-STMT EXIT THEN
  THEN
  TK K@ DUP T-WORD = OVER T-STR = OR OVER T-RAW = OR SWAP T-VAR = OR IF COMMAND-STMT EXIT THEN
  NOT-YET ;
' STATEMENT-IMPL IS STATEMENT
' SKIP-NL IS SKIP-NL-HOOK
\ the program: names declared in order, the defs, R-MAIN
1048576 BUFFER: FINAL  VARIABLE FINAL#
NM-MAX CELLS BUFFER: ORDER
: FIN+ ( c-addr u --- )   FINAL FINAL# @ + SWAP DUP >R MOVE  R> FINAL# +! ;
: DC-NAME ( i --- c-addr u )   DUP CELLS DC-A + @ SWAP CELLS DC-L + @ ;
VARIABLE RT-K
: KIND-NAME ( kind --- c-addr u )
  DUP K-TEXT = IF DROP S" K-TEXT" EXIT THEN  DUP K-LIST = IF DROP S" K-LIST" EXIT THEN
  K-REC = IF S" K-REC" ELSE S" K-ANY" THEN ;
: ROOT-KIND ( c-addr u --- kind | 0 )   \ rillc.py's root_kind: a top-level loop's source, or a script variable of a kind that points
  GR-N @ 0 ?DO 2DUP GR-A I CELLS + @ GR-L I CELLS + @ COMPARE 0= IF 2DROP GR-K I CELLS + @ UNLOOP EXIT THEN LOOP
  NM-FIND DUP 0< IF DROP 0 EXIT THEN  CELLS NM-K + @
  DUP K-TEXT = OVER K-LIST = OR OVER K-REC = OR OVER K-ANY = OR 0= IF DROP 0 THEN ;
: SORT-NAMES ( --- )   \ insertion sort of the declared names, as Python's sorted()
  DC-N @ 0 ?DO I I CELLS ORDER + ! LOOP
  DC-N @ 2 < IF EXIT THEN          \ 0 1 ?DO would run the whole unsigned range: no names, nothing to sort
  DC-N @ 1 ?DO
    I BEGIN DUP 0> IF DUP CELLS ORDER + @ DC-NAME 2 PICK 1- CELLS ORDER + @ DC-NAME COMPARE 0< ELSE 0 THEN
    WHILE DUP CELLS ORDER + @ OVER 1- CELLS ORDER + @ 2 PICK CELLS ORDER + ! OVER 1- CELLS ORDER + ! 1- REPEAT DROP
  LOOP ;
: RILL-INIT ( --- )
  0 NM-N !  0 DC-N !  0 DF-N !  0 PRM-N !  0 ON-N !
\ [gene littext]
  0 LT-N !
\ [/gene]
   0 BODY-N !  0 HOIST !  0 HOISTS !  0 IN-DEF !  0 STACKMODE !  -1 DF-CUR !  0 SM-DEPTH !  0 FINAL# !  0 CMR-N !
   0 DA-DEPTH !  0 DA-N !  0 IN-EXIT !  0 GR-N !  0 NI-N !  0 PD-N !  0 PD-NOW !  1 TK-LINE0 !
  TK-ALLOC BUF-ALLOC ;
: ON-EXIT-AHEAD? ( --- f )   TK-N @ 1- 0 ?DO I T@ S" on" S= I 1+ T@ S" EXIT" S= AND IF -1 UNLOOP EXIT THEN LOOP 0 ;
: RILL-PASS ( c-addr u --- c-addr2 u2 )   \ a Rill script's text, its Forth
  RILL-INIT TOKENIZE 0 TK-I !  TO-MAIN  ON-EXIT-AHEAD? HAS-ON-EXIT !
\ [gene infer]
  FIXED @ IF IK-PRELOAD THEN
\ [/gene]
  SKIP-NL BEGIN TK K@ T-EOF <> WHILE STATEMENT SKIP-NL REPEAT
\ [gene infer]
  INFER @ IF -1 PD-NOW !  PD-N @ 0 ?DO I CELLS PD-T + @ TK-I ! STATEMENT LOOP  0 PD-NOW ! THEN   \ the defs' bodies, the first pass's last (785)
\ [/gene]
  SORT-NAMES
  DC-N @ 0 ?DO S" VARIABLE R." FIN+ I CELLS ORDER + @ DC-NAME FIN+ 10 FINAL FINAL# @ + C! 1 FINAL# +! LOOP
\ [gene gc]
  DC-N @ 0 ?DO I CELLS ORDER + @ DC-NAME ROOT-KIND ?DUP IF                \ the collector's roots, in the same order
    RT-K ! S" R." FIN+ I CELLS ORDER + @ DC-NAME FIN+ S"  " FIN+ RT-K @ KIND-NAME FIN+ S"  R-ROOT" FIN+ 10 FINAL FINAL# @ + C! 1 FINAL# +! THEN LOOP   \ not >R: I reads that stack
\ [/gene]
  DC-N @ 0 ?DO I CELLS ORDER + @ DC-NAME NI-HAS? IF                      \ R-NONE until set (785), in the same order
    S" R-NONE R." FIN+ I CELLS ORDER + @ DC-NAME FIN+ S"  !" FIN+ 10 FINAL FINAL# @ + C! 1 FINAL# +! THEN LOOP
\ [gene littext]
  LITS-B @ LITS# @ FIN+
\ [/gene]
  DEFS-B @ DEFS# @ FIN+
  S" : R-MAIN " FIN+ MAIN-B @ MAIN# @ FIN+ S" ;" FIN+ 10 FINAL FINAL# @ + C! 1 FINAL# +! S" R-MAIN" FIN+
  10 FINAL FINAL# @ + C! 1 FINAL# +!
  FINAL FINAL# @ ;
\ [gene infer]
: RILL>FORTH ( c-addr u --- c-addr2 u2 )   \ two passes: the kinds, then the code (764)
  0 IK-N !  -1 INFER !  0 FIXED !  2DUP RILL-PASS 2DROP  0 INFER !  -1 FIXED !  RILL-PASS  0 FIXED ! ;
\ [/gene]
\ [gene !infer]
: RILL>FORTH ( c-addr u --- c-addr2 u2 )   RILL-PASS ;
\ [/gene]
: .RILL ( c-addr u --- )   \ a script file's Forth, printed: tests/rill/oracle
  R-SLURP RILL>FORTH TYPE ;
' RILL>FORTH IS R-COMPILE   \ the image compiles a .rill itself (Iteration 741)
