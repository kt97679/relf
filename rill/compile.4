\ [gene purestack]
  2DUP PARAM-AT DUP 0< 0= IF
    NIP NIP  SM-DEPTH @ PRM-N @ 1- ROT - +  1 DEPTH+
    DUP 0= IF DROP S" DUP" OUT+ ELSE DUP 1 = IF DROP S" OVER" OUT+ ELSE OUT-NUM S" PICK" OUT+ THEN THEN
    K-NUM EXIT THEN  DROP
\ [/gene]
  2DUP NM-FIND 0< IF                                  \ $args and $script, unless the script set them (744)
    2DUP S" args" S= IF 2DROP S" R-ARGS" OUT+ K-LIST EXIT THEN
    2DUP S" script" S= IF 2DROP S" R-SCRIPT" OUT+ K-TEXT EXIT THEN THEN
  2DUP NM-FIND DUP 0< IF
    DROP S" is not set" 2SWAP ." rillc: line " TK 1- L@ . ." : $" TYPE SPACE TYPE R-NL -4100 THROW THEN
  >R  2DUP [CHAR] R OUT-C [CHAR] . OUT-C  OUT-RAW BL OUT-C  S" @" OUT+                     ( a u )  ( R: i )
  NM-K R@ CELLS + @ DUP K-TEXT = OVER K-LIST = OR OVER K-REC = OR SWAP K-ANY = OR  NM-DAL R@ CELLS + @ 0< AND IF
    S" DUP 0= IF" OUT+  [CHAR] S OUT-C 34 OUT-C BL OUT-C OUT-RAW 34 OUT-C BL OUT-C  S" R-UNSET THEN" OUT+   \ maybe not set (772)
  ELSE NM-DAL R@ CELLS + @ 0< NM-LOC R@ CELLS + @ 0= AND IF                          \ a number of the script's (785): R-NONE until set
    2DUP NI-ADD  S" DUP R-NONE = IF" OUT+  [CHAR] S OUT-C 34 OUT-C BL OUT-C OUT-RAW 34 OUT-C BL OUT-C  S" R-UNSET THEN" OUT+
  ELSE 2DROP THEN THEN  NM-K R> CELLS + @ ;

: SAVE-TK ( --- x1 .. x9 )   TK-KIND @ TK-AT @ TK-LEN @ TK-LINE @ TK-N @ TK-I @ RS-SRC @ SRC# @ CUR-LINE @ ;
: RESTORE-TK ( x1 .. x9 --- )   CUR-LINE ! SRC# ! RS-SRC ! TK-I ! TK-N ! TK-LINE ! TK-LEN ! TK-AT ! TK-KIND ! ;
VARIABLE SUB-A  VARIABLE SUB-L
\ [gene echolit]
VARIABLE ECHO-MODE  VARIABLE ECHO-SAVED   \ a string read for echo; one inside its {...} an ordinary one (rillc.py's sub-compiler)
: SUB-ECHO-OFF ( --- old )   ECHO-MODE @  0 ECHO-MODE ! ;   \ the old mode on the stack: a string's {...} may hold strings (789)
: SUB-ECHO-ON ( old --- )   ECHO-MODE ! ;
\ [/gene]
\ [gene !echolit]
: SUB-ECHO-OFF ( --- 0 )   0 ;   : SUB-ECHO-ON ( x --- )   DROP ;
\ [/gene]
: CAPTURE ( --- )   \ $( cmd [?? cmd] ... ): its output, then its status - ?? runs the next if one fails, as the shell's || (787)
  -1 COMMAND-HOOK
  BEGIN S" ??" CUR-IS? WHILE NEXT-TK S" DUP IF DROP" OUT+ -1 COMMAND-HOOK S" >R R-CAP-JOIN R> THEN" OUT+ REPEAT ;
4096 BUFFER: LITBUF  VARIABLE LIT#  VARIABLE NPARTS
: SUB-ENTER ( --- old )   \ the sub-text's first line: its own text's, and the newlines before it there (786)
  TK-LINE0 @ DUP
  SUB-A @ RS-SRC @ U< 0= SUB-A @ RS-SRC @ SRC# @ + U< AND IF SUB-A @ RS-SRC @ ?DO I C@ 10 = IF 1+ THEN LOOP THEN
  TK-LINE0 ! ;
: SUB-COMMAND ( c-addr u --- )   \ a capture in a string, $( ... ): tokenized apart, then read
  SUB-L ! SUB-A !  SUB-ENTER >R  NPARTS @ LIT# @  SAVE-TK  TK-ALLOC SUB-A @ SUB-L @ TOKENIZE 0 TK-I !  SUB-ECHO-OFF
  CAPTURE S" R-CHECK" OUT+  SUB-ECHO-ON  RESTORE-TK  LIT# ! NPARTS !  R> TK-LINE0 ! ;   \ the string's own count kept (789)
: SUB-EXPR ( c-addr u --- kind )   \ an expression in a string's {...}: tokenized apart, then read
  SUB-L ! SUB-A !  SUB-ENTER >R  NPARTS @ LIT# @  SAVE-TK  TK-ALLOC SUB-A @ SUB-L @ TOKENIZE 0 TK-I !  SUB-ECHO-OFF
  1 EXPR >R  SUB-ECHO-ON  RESTORE-TK  LIT# ! NPARTS !  R> R> TK-LINE0 ! ;   \ the string's own count kept (789)
\ [gene echolit]
4096 BUFFER: EL-BUF  VARIABLE EL#      \ echo's literal run (753)
: EL+ ( c-addr u --- )   EL-BUF EL# @ + SWAP DUP EL# +! MOVE ;
: OUT-STYPE ( c-addr u --- )   [CHAR] S OUT-C 34 OUT-C BL OUT-C OUT-RAW 34 OUT-C BL OUT-C S" TYPE" OUT+ ;
: EL-FLUSH ( --- )   \ the run typed: S" ..." TYPE - or its bytes and R-TYPE, as rillc.py's typed_lit
  EL# @ 0= IF EXIT THEN
  EL-BUF EL# @ 2DUP 0 HAS-SPECIAL? IF OUT-BYTES S" R-TYPE" OUT+ ELSE OUT-STYPE THEN  0 EL# ! ;
: LIT-FLUSH ( force? --- )   \ the literal gathered so far, as one part - or, for echo, onto its run
  ECHO-MODE @ IF DROP LIT# @ IF LITBUF LIT# @ EL+ THEN 0 LIT# ! EXIT THEN
  LIT# @ 0<> OR IF  LITBUF LIT# @ LIT-TEXT  1 NPARTS +!  THEN  0 LIT# ! ;
: PIECE-START ( --- )   0 LIT-FLUSH  ECHO-MODE @ IF EL-FLUSH THEN ;
: PIECE-END ( --- )   ECHO-MODE @ IF S" R-TYPE" OUT+ ELSE 1 NPARTS +! THEN ;
\ [/gene]
\ [gene !echolit]
: LIT-FLUSH ( force? --- )   \ the literal gathered so far, as one part
  LIT# @ 0<> OR IF  LITBUF LIT# @ LIT-TEXT  1 NPARTS +!  THEN  0 LIT# ! ;
: PIECE-START ( --- )   0 LIT-FLUSH ;
: PIECE-END ( --- )   1 NPARTS +! ;
\ [/gene]
: LIT-C ( c --- )   LITBUF LIT# @ + C!  1 LIT# +! ;
: HEX-DIGIT ( c --- n )   DUP [CHAR] 0 [CHAR] 9 1+ WITHIN IF [CHAR] 0 - EXIT THEN  32 OR DUP [CHAR] a [CHAR] f 1+ WITHIN IF [CHAR] a - 10 + EXIT THEN  DROP -1 ;
: UTF8-C ( cp --- )   \ a code point's UTF-8 bytes into the literal
  DUP 128 < IF LIT-C EXIT THEN
  DUP 2048 < IF DUP 6 RSHIFT 192 OR LIT-C 63 AND 128 OR LIT-C EXIT THEN
  DUP 12 RSHIFT 224 OR LIT-C  DUP 6 RSHIFT 63 AND 128 OR LIT-C  63 AND 128 OR LIT-C ;
: ESC-U? ( a u --- cp -1 | 0 )   \ a u at an escape's u: four hex digits after it
  DUP 5 < IF 2DROP 0 EXIT THEN  DROP 1+ 0 SWAP
  4 0 DO DUP I + C@ HEX-DIGIT DUP 0< IF 2DROP DROP UNLOOP 0 EXIT THEN ROT 16 * + SWAP LOOP DROP -1 ;
: ESCAPE-C ( a u c --- a' u' )   \ the character after a backslash (793): \n \t \r \uXXXX; \ before a mark, the mark; else an error
  DUP [CHAR] u = IF DROP 2DUP ESC-U? IF UTF8-C 5 /STRING EXIT THEN [CHAR] u THEN
  DUP [CHAR] n = IF DROP 10 LIT-C 1 /STRING EXIT THEN
  DUP [CHAR] t = IF DROP 9 LIT-C 1 /STRING EXIT THEN
  DUP [CHAR] r = IF DROP 13 LIT-C 1 /STRING EXIT THEN
  DUP SH-ALNUM? IF ." rillc: line " TK L@ . ." : \" EMIT ."  is no escape - \n \t \r \uXXXX, or \ before a mark" R-NL -4100 THROW THEN
  LIT-C 1 /STRING ;
: STRING-LIT ( c-addr u --- kind )   \ between the quotes: literal runs, $name, {expr}, $( ... )
  \ In the loop the stack is ( c-addr u c ): the next character is 2 PICK 1+ C@,
  \ the length OVER - 742 found OVER 1+ C@ there, reading at an address made of the length.
  0 LIT# !  0 NPARTS !
  BEGIN DUP WHILE
    OVER C@  DUP [CHAR] \ = OVER 1 > AND IF DROP
      1 /STRING  OVER C@ ESCAPE-C
    ELSE DUP [CHAR] $ = OVER 1 > AND IF  2 PICK 1+ C@ [CHAR] ( = IF DROP          \ $( ... ): a capture
      PIECE-START  2 /STRING  OVER >R  [CHAR] ) SN-NEST 0= IF R> DROP S" a $( in a string is not closed" ERR THEN   \ 789
      R> 2 PICK OVER - 1- SUB-COMMAND  PIECE-END
    ELSE 2 PICK 1+ C@ NAME-START? 0= IF LIT-C 1 /STRING ELSE DROP
      PIECE-START  1 /STRING  OVER >R  BEGIN DUP IF OVER C@ NAME-CHAR? ELSE 0 THEN WHILE 1 /STRING REPEAT
      R> 2 PICK OVER - OUT-POS >R READ-VAR                     ( c-addr u kind )  ( R: the var's code )
      DUP K-REC = 2 PICK 1 > AND IF 2 PICK C@ [CHAR] . = 3 PICK 1+ C@ NAME-START? AND IF   \ "$r.f" gone: one way, {$r[f]} (801)
        S" a field in a string is written {$r[f]}" ERR THEN THEN
      R> DROP
      TO-TEXT  PIECE-END  THEN THEN
    ELSE DUP [CHAR] { = IF DROP
      PIECE-START  1 /STRING  OVER >R  [CHAR] } SN-NEST 0= IF R> DROP S" a { in a string is not closed" ERR THEN   \ 789
      R> 2 PICK OVER - 1- SUB-EXPR TO-TEXT  PIECE-END
    ELSE LIT-C 1 /STRING THEN THEN THEN
  REPEAT 2DROP
\ [gene echolit]
  ECHO-MODE @ IF 0 LIT-FLUSH K-TEXT EXIT THEN                       \ for echo: the last run onto echo's
\ [/gene]
  NPARTS @ 0= LIT-FLUSH
  NPARTS @ 1 > IF NPARTS @ OUT-NUM S" R-CONCAT" OUT+ THEN  K-TEXT ;

: KIND-WORD ( c-addr u --- kind )   \ the kind a def's -> names
  2DUP S" number" S= IF 2DROP K-NUM EXIT THEN  2DUP S" text" S= IF 2DROP K-TEXT EXIT THEN
  2DUP S" bool" S= IF 2DROP K-BOOL EXIT THEN  2DUP S" list" S= IF 2DROP K-LIST EXIT THEN
  2DUP S" record" S= IF 2DROP K-REC EXIT THEN  2DUP S" decimal" S= IF 2DROP K-DEC EXIT THEN  2DROP K-ANY ;
\ the library, as rillc.py's library(): each argument converted as its
\ function needs, the code in rillc.py's order
: ARG ( --- kind )   1 EXPR  S" ," CUR-IS? IF NEXT-TK THEN ;
VARIABLE LB-POS  VARIABLE LB-W1  VARIABLE LB-W2
: CONT ( kind --- )   K-ANY = IF S" R-UNBOX DROP" OUT+ THEN ;   \ an item holding a list or record, unboxed (758)
: TO-DEC ( kind --- )   \ a value made a decimal (760)
  DUP K-DEC = IF DROP EXIT THEN  DUP K-NUM = IF DROP S" R-N>D" OUT+ EXIT THEN
  K-ANY = IF S" R-ANY>DEC" OUT+ EXIT THEN  S" needs a number or a decimal" ERR ;
: LIBRARY ( c-addr u --- kind -1 | 0 )   \ a library function's call, its ( taken; its ) not
  2DUP S" len" S= IF 2DROP ARG  DUP K-ANY = IF DROP S" R-ANY-LEN" OUT+ ELSE
     K-REC = IF S" R-KEYS @" OUT+ ELSE S" @" OUT+ THEN THEN  K-NUM -1 EXIT THEN
  2DUP S" words" S= IF 2DROP ARG TO-TEXT S" R-SPLIT-WS" OUT+ K-LIST -1 EXIT THEN
  2DUP S" lines" S= IF 2DROP ARG TO-TEXT S" R-LINES" OUT+ K-LIST -1 EXIT THEN
  2DUP S" abs" S= IF 2DROP ARG DUP K-NUM = OVER K-DEC = OR IF S" ABS" OUT+ -1 EXIT THEN   \ a number's or a decimal's (a path's: realpath, 799)
     K-ANY = IF S" R-ANY-ABS" OUT+ K-ANY -1 EXIT THEN  S" abs needs a number" ERR THEN
  2DUP S" join" S= IF 2DROP ARG CONT ARG TO-TEXT S" R-JOIN" OUT+ K-TEXT -1 EXIT THEN
  2DUP S" range" S= IF 2DROP OUT-POS LB-POS !  ARG TO-NUM                     \ range(b), (a, b), (a, b, step): Python's (770)
    S" )" CUR-IS? IF S" 0" LB-POS @ OUT-INSERT S" R-RANGE" OUT+ K-LIST -1 EXIT THEN
    ARG TO-NUM  S" )" CUR-IS? IF S" R-RANGE" OUT+ K-LIST -1 EXIT THEN
    ARG TO-NUM  S" R-RANGE-STEP" OUT+ K-LIST -1 EXIT THEN
  2DUP S" number" S= IF 2DROP ARG TO-TEXT S" R-NUMBER" OUT+ K-NUM -1 EXIT THEN
  2DUP S" push" S= IF 2DROP OUT-POS LB-POS ! ARG CONT  OUT-POS ARG BOX LB-POS @ SEG>POS  \ the item before the list
     S" R-PUSH" OUT+ 0 -1 EXIT THEN
  2DUP S" glob" S= IF 2DROP ARG TO-TEXT S" R-GLOB" OUT+ K-LIST -1 EXIT THEN   \ 786
  2DUP S" code" S= IF 2DROP                                      \ code((cmd args)): its status, a number (786)
    S" (" CUR-IS? IF NEXT-TK TK T@ 2DUP S" true" S= >R S" false" S= R> OR IF -1 ELSE RUN-COND?-D THEN ELSE 0 THEN   \ code((true)): the program
    0= IF S" code() takes a command in ( ): code((cmd args))" ERR THEN
    0 COMMAND-HOOK S" )" EXPECT K-NUM -1 EXIT THEN
  2DUP S" setenv" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-SETENV" OUT+ 0 -1 EXIT THEN   \ 783
  2DUP S" sort" S= IF 2DROP ARG CONT S" R-SORT" OUT+ K-LIST -1 EXIT THEN
  2DUP S" split" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-SPLIT" OUT+ K-LIST -1 EXIT THEN
  2DUP S" match" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-MATCH" OUT+ K-LIST -1 EXIT THEN   \ 746
  2DUP S" all" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-ALL" OUT+ K-LIST -1 EXIT THEN
  2DUP S" sub" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT ARG TO-TEXT S" R-SUB" OUT+ K-TEXT -1 EXIT THEN
  2DUP S" env" S= IF 2DROP ARG TO-TEXT S" R-ENV" OUT+ K-TEXT -1 EXIT THEN
  2DUP S" default" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-DEFAULT" OUT+ K-TEXT -1 EXIT THEN
  2DUP S" slice" S= IF 2DROP ARG DUP CONT >R ARG TO-NUM                      \ a list's; a text's, a record's (754)
     S" )" CUR-IS? IF R@ K-TEXT = IF S" OVER @" ELSE R@ K-REC = IF S" OVER R-KEYS R-LEN" ELSE S" OVER R-LEN" THEN THEN OUT+
     ELSE ARG TO-NUM THEN
     R@ K-TEXT = IF S" R-TSLICE" ELSE R@ K-REC = IF S" R-RSLICE" ELSE S" R-SLICE" THEN THEN OUT+
     R> DUP K-TEXT <> OVER K-REC <> AND IF DROP K-LIST THEN -1 EXIT THEN
  2DUP S" read" S= IF 2DROP ARG TO-TEXT S" R-READ" OUT+ K-TEXT -1 EXIT THEN       \ texts and files (754)
  2DUP S" trim" S= IF 2DROP ARG TO-TEXT S" R-TRIM" OUT+ K-TEXT -1 EXIT THEN
  2DUP S" write" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-WRITE" OUT+ 0 -1 EXIT THEN
  2DUP S" starts" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-STARTS" OUT+ K-BOOL -1 EXIT THEN
  2DUP S" ends" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT S" R-ENDS" OUT+ K-BOOL -1 EXIT THEN
  2DUP S" sum" S= IF 2DROP ARG CONT S" R-SUM" OUT+ K-ANY -1 EXIT THEN   \ a decimal among them, a decimal (794)
  2DUP S" at" S= IF 2DROP ARG                                    \ a record's field; a list's item (782); or the default
     DUP K-LIST = IF DROP ARG TO-NUM ARG BOX S" R-AT-OR-L" ELSE
     DUP K-ANY = IF DROP ARG BOX ARG BOX S" R-AT-OR-ANY" ELSE
     DROP ARG TO-TEXT ARG BOX S" R-AT-OR" THEN THEN OUT+ K-ANY -1 EXIT THEN
  2DUP S" sort-by" S= IF 2DROP ARG DUP CONT >R  ARG TO-TEXT  S" )" CUR-IS? IF S" asc" LIT-TEXT ELSE ARG TO-TEXT THEN   \ a list's records (798; a record's entries no more, 799)
     R> K-REC = IF S" sort-by sorts a list of records" ERR THEN  S" R-SORT-BY-L" OUT+ K-LIST -1 EXIT THEN
  2DUP S" pop" S= IF 2DROP ARG DUP K-LIST = IF DROP ARG TO-NUM S" R-POP-L" ELSE DUP K-ANY = IF DROP ARG BOX S" R-POP-ANY" ELSE   \ pop(x, key) (799)
     K-REC <> IF S" pop needs a list or a record" ERR THEN  ARG TO-TEXT S" R-POP-R" THEN THEN OUT+ K-ANY -1 EXIT THEN
  2DUP S" find" S= IF 2DROP ARG DUP K-LIST = IF DROP ARG BOX S" R-FIND-L" ELSE DUP K-ANY = IF DROP ARG BOX S" R-FIND-ANY" ELSE
     TO-TEXT ARG TO-TEXT S" R-FIND-T" THEN THEN OUT+ K-NUM -1 EXIT THEN
  2DUP S" decimal" S= IF 2DROP ARG TO-TEXT S" R-TEXT>DEC" OUT+ K-DEC -1 EXIT THEN
  2DUP S" json" S= IF 2DROP ARG BOX S" R-JSON" OUT+ K-TEXT -1 EXIT THEN                     \ JSON (811, A36)
  2DUP S" from-json" S= IF 2DROP ARG TO-TEXT S" R-FROM-JSON" OUT+ K-ANY -1 EXIT THEN
  2DUP S" replace" S= IF 2DROP ARG TO-TEXT ARG TO-TEXT ARG TO-TEXT S" R-REPLACE" OUT+ K-TEXT -1 EXIT THEN
  2DUP S" max" S= >R 2DUP S" min" S= R> OR IF                       \ of a list: an item (760; of two values no more, 799)
     S" max" S= IF S" R-LMAX" ELSE S" R-LMIN" THEN LB-W2 ! LB-W1 !  ARG CONT  LB-W1 @ LB-W2 @ OUT+ K-ANY -1 EXIT THEN
  2DROP 0 ;
: DEF-LATER? ( c-addr u --- f )   \ a def of that name further down the script (786)
  TK-N @ 1- 0 ?DO  I K@ T-KW = I T@ S" def" S= AND IF 2DUP I 1+ T@ COMPARE 0= IF 2DROP -1 UNLOOP EXIT THEN THEN  LOOP 2DROP 0 ;
: CALL ( --- kind )   \ name( args ), the name the current token
  TK T@ NEXT-TK  S" (" EXPECT
  2DUP LIBRARY IF >R 2DROP R> S" )" EXPECT EXIT THEN          \ the kind, not the name, left
  2DUP DF-FIND DUP 0< IF DROP                                    \ named, and whether it is further down (786)
    ." rillc: line " TK L@ . ." : " 2DUP TYPE ." () is "
    DEF-LATER? IF ." defined further down: a def comes before its use" ELSE ." not defined" THEN R-NL -4100 THROW THEN
  >R 2DROP 0
  BEGIN S" )" CUR-IS? 0= WHILE
    1 EXPR  DF-PURE R@ CELLS + @ IF TO-NUM ELSE BOX THEN  1+          \ a pure def's arguments numbers (749)
    S" ," CUR-IS? IF NEXT-TK THEN
  REPEAT NEXT-TK
  DUP DF-P R@ CELLS + @ <> IF S" a function given the wrong number of arguments" ERR THEN
  R@ DF-CUR @ = IF S" RECURSE" OUT+ ELSE
    [CHAR] R OUT-C [CHAR] : OUT-C  DF-A R@ CELLS + @ DF-L R@ CELLS + @ OUT-RAW BL OUT-C THEN
  DF-K R@ CELLS + @ DUP 0<> 1 AND ROT - DEPTH+  R> DROP ;
: RUN-COND? ( --- f )   \ rillc.py's cond(): ( word ... ) a run, unless its second token makes it an expression
  TK T@ 2DUP S" true" S= >R S" false" S= R> OR  TK 1+ S" )" TK-IS? AND IF 0 EXIT THEN   \ (true): the literal, not the program (786)
  TK K@ T-WORD = 0= IF 0 EXIT THEN  TK 1+ S" (" TK-IS? IF 0 EXIT THEN
  TK 1+ K@ DUP T-KW = SWAP T-OP = OR IF
    TK 1+ T@ 2DUP S" in" S= >R 2DUP S" not" S= R> OR >R 2DUP S" and" S= R> OR >R 2DUP S" or" S= R> OR
    IF 2DROP 0 EXIT THEN 2DROP THEN
  TK 1+ PREC-OF IF 0 EXIT THEN  -1 ;
' RUN-COND? IS RUN-COND?-D
: DIGITS-ABOVE? ( c-addr u limit-a limit-u --- f )   \ a run of digits, its leading zeros off, above the limit's (794)
  2SWAP BEGIN DUP 1 > IF OVER C@ [CHAR] 0 = ELSE 0 THEN WHILE 1 /STRING REPEAT  2SWAP
  2 PICK OVER <> IF NIP ROT DROP > EXIT THEN  COMPARE 0> ;
: NUM-TOO-BIG? ( c-addr u --- f )   OVER C@ [CHAR] - = IF 1 /STRING THEN  S" 9223372036854775807" DIGITS-ABOVE? ;
: DEC-LIT? ( c-addr u --- n -1 | 0 )   \ -?\d+\.\d+ as a decimal: the number times a million (754)
  OVER C@ [CHAR] - = DUP >R IF 1 /STRING THEN                         \ ( R: negative? )
  2DUP [CHAR] . SCAN DUP 0= IF 2DROP 2DROP R> DROP 0 EXIT THEN       ( a u a2 u2 )
  >R >R  OVER R@ OVER - NUMBER-TEXT? 0= IF R> R> 2DROP 2DROP R> DROP 0 EXIT THEN
  R> R> 1 /STRING  2DUP NUMBER-TEXT? 0= IF 2DROP 2DROP R> DROP 0 EXIT THEN   ( a u fa fu )
  0 6 0 DO 10 * OVER I > IF 2 PICK I + C@ [CHAR] 0 - + THEN LOOP NIP NIP   ( a u frac )   \ OVER: fu, 2 PICK: fa (the PICK slip again)
  >R  0 -ROT 0 ?DO DUP I + C@ [CHAR] . = IF LEAVE THEN DUP I + C@ [CHAR] 0 - ROT 10 * + SWAP LOOP DROP
  TK T@ OVER C@ [CHAR] - = IF 1 /STRING THEN  2DUP [CHAR] . SCAN NIP - NIP 13 >       \ past 9223372036854.775807: too big (794)
  OVER 9223372036854 > OR  OVER 9223372036854 = R@ 775807 > AND OR
  IF ." rillc: line " TK L@ . ." : " TK T@ TYPE ."  is too big for a decimal (at most 9223372036854.775807)" R-NL -4100 THROW THEN
  1000000 * R> +  R> IF NEGATE THEN -1 ;
VARIABLE IN-ARG  VARIABLE IA-NOW   \ a command's argument: its bare word is its text (762)
: BARE-ERR ( --- )   \ a bare word that names a variable: a slip of the $ rule, most likely
  ." rillc: line " TK L@ . ." : " TK T@ TYPE ."  is a variable - $" TK T@ TYPE ." , or " 34 EMIT TK T@ TYPE 34 EMIT ."  for the text"
  R-NL -4100 THROW ;
: RUN-VAR? ( --- )   \ ( name ) runs a program; a variable of that name means its $ was left out (805)
  TK 1+ S" )" TK-IS? 0= IF EXIT THEN  TK T@ DF-FIND 0< 0= IF EXIT THEN  TK T@ NM-FIND 0< TK T@ CRENAMED? 0= AND IF EXIT THEN
  ." rillc: line " TK L@ . ." : " TK T@ TYPE ."  is a variable: ($" TK T@ TYPE ." ) for its truth, (env " TK T@ TYPE
  ." ) for a program of that name" R-NL -4100 THROW ;
: TERM0 ( --- kind )
  IN-ARG @ IA-NOW !  0 IN-ARG !
  TK K@ T-WORD = IF S" true" CUR-IS? IF NEXT-TK S" -1" OUT+ K-BOOL EXIT THEN                   \ 759: booleans
    S" false" CUR-IS? IF NEXT-TK S" 0" OUT+ K-BOOL EXIT THEN THEN
  TK K@ T-WORD = IF TK T@ DEC-LIT? IF OUT-NUM NEXT-TK 1 DEPTH+ K-DEC EXIT THEN THEN
  TK K@ T-WORD = IF TK T@ NUMBER-TEXT? IF TK T@ 2DUP NUM-TOO-BIG? IF ." rillc: line " TK L@ . ." : " TYPE ."  is too big for a number (64 bits)" R-NL -4100 THROW THEN
    OUT+ NEXT-TK 1 DEPTH+ K-NUM EXIT THEN THEN
  TK K@ T-VAR = IF TK T@ 1 /STRING NEXT-TK READ-VAR EXIT THEN
  TK K@ T-STR = IF TK T@ 1 /STRING 1- NEXT-TK STRING-LIT EXIT THEN
  TK K@ T-RAW = IF TK T@ 1 /STRING 1- NEXT-TK TEXT-LIT K-TEXT EXIT THEN
  S" (" CUR-IS? IF NEXT-TK  RUN-COND? IF RUN-VAR? 0 COMMAND-HOOK S" 0=" OUT+ S" )" EXPECT K-BOOL EXIT THEN   \ a run is a term (745)
    1 EXPR S" )" EXPECT EXIT THEN
  S" $(" CUR-IS? IF NEXT-TK CAPTURE S" )" EXPECT S" R-CHECK" OUT+ K-TEXT EXIT THEN
  S" [" CUR-IS? IF NEXT-TK LIST-LIT EXIT THEN
  S" {" CUR-IS? IF NEXT-TK SKIP-NL-HOOK RECORD-LIT EXIT THEN
  TK K@ T-WORD = IF TK 1+ S" (" TK-IS? IF CALL EXIT THEN
    IA-NOW @ 0= IF TK T@ NM-FIND 0< 0= TK T@ CRENAMED? OR IF BARE-ERR THEN THEN  TK T@ NEXT-TK TEXT-LIT K-TEXT EXIT THEN
  S" unexpected token" ERR ;
: TERM ( --- kind )   \ TERM0, then $x[i] touching it
  OUT-POS >R  TERM0
  BEGIN
    S" [" CUR-IS? TK TOK-AT TK 1- TOK-END = AND IF
      NEXT-TK
      DUP K-LIST = IF DROP 1 EXPR TO-NUM S" R-AT" OUT+ ELSE
      DUP K-ANY = IF DROP OUT-POS 1 EXPR                                     \ ( keystart kind )
        DUP K-NUM = IF 2DROP S" R-ITEM-ANY" OUT+ ELSE                          \ a number: a list's item, checked (801)
        DUP K-TEXT = IF DROP R@ SEG>POS S" R-FIELD-ANY" OUT+ ELSE              \ a text: a record's field, no key boxed (801)
        BOX R@ SEG>POS S" R-INDEX-ANY" OUT+ THEN THEN ELSE                     \ else either, as it holds (800)
      K-REC = IF OUT-POS 1 EXPR TO-TEXT R@ SEG>POS S" R-GET" OUT+ ELSE
      S" only a list or a record is indexed" ERR THEN THEN THEN
      S" ]" EXPECT K-ANY 0
    ELSE TK K@ T-WORD = TK T@ DROP C@ [CHAR] . = AND TK TOK-AT TK 1- TOK-END = AND
      OVER DUP K-REC = SWAP K-ANY = OR AND IF                    \ one way: $r[f] (801)
      S" a field is read as $r[f], not $r.f" ERR
    ELSE -1 THEN THEN
  UNTIL R> DROP ;
: SPREAD-WORD? ( i --- f )   \ @name
  DUP K@ T-WORD <> IF DROP 0 EXIT THEN  T@ DUP 2 < IF 2DROP 0 EXIT THEN
  OVER C@ [CHAR] @ <> IF 2DROP 0 EXIT THEN  1 /STRING OVER C@ NAME-START? >R
  -1 -ROT 0 ?DO DUP I + C@ NAME-CHAR? 0= IF NIP 0 SWAP THEN LOOP DROP R> AND ;
\ the name of a loop's list: name.srcN, N a token's index, as rillc.py makes it
64 BUFFER: TMPN  VARIABLE TMPN#
: TMP-NAME ( c-addr u n --- c-addr2 u2 )
  >R  DUP TMPN# !  TMPN SWAP MOVE  S" .src" TMPN TMPN# @ + SWAP MOVE  4 TMPN# +!
  R> 0 <# #S #> TMPN TMPN# @ + SWAP DUP >R MOVE R> TMPN# +!
  \ a copy of its own: the tables keep the address, and TMPN is made again for the next
  TMPN# @ ALLOCATE THROW  TMPN OVER TMPN# @ MOVE  TMPN# @ ;
: CM-RENAME ( c-addr u j --- c-addr2 u2 )   \ a comprehension's name made its own, name.cJ, and kept in CMR (808)
  >R  CMR-N @ CMR-MAX < 0= IF S" comprehensions nested too deep" ERR THEN
  2DUP CMR-N @ CELLS CMR-SL + !  CMR-N @ CELLS CMR-SA + !
  DUP TMPN# !  TMPN SWAP MOVE  S" .c" TMPN TMPN# @ + SWAP MOVE  2 TMPN# +!
  R> 0 <# #S #> TMPN TMPN# @ + SWAP DUP >R MOVE R> TMPN# +!
  TMPN# @ ALLOCATE THROW  TMPN OVER TMPN# @ MOVE  TMPN# @
  2DUP CMR-N @ CELLS CMR-IL + !  CMR-N @ CELLS CMR-IA + !  1 CMR-N +! ;
\ certainly set (772), as rillc.py's da_*: a name set in a block is certainly set in it and in the blocks
\ within, from there on; leaving the block forgets it unless it was set before. Names to set as a block
\ opens (a loop's, a def's parameters) wait in DA-NEXT.
VARIABLE DA-DEPTH   16 CONSTANT DA-MAX   DA-MAX CELLS BUFFER: DA-NA   DA-MAX CELLS BUFFER: DA-NL   VARIABLE DA-N
: DA-MARK ( c-addr u --- )   NM-FIND DUP 0< IF DROP EXIT THEN  CELLS NM-DAL +  DUP @ 0< IF DA-DEPTH @ SWAP ! ELSE DROP THEN ;
: DA-NEXT ( c-addr u --- )   DA-N @ DA-MAX < IF  DA-NL DA-N @ CELLS + !  DA-NA DA-N @ CELLS + !  1 DA-N +!  ELSE 2DROP THEN ;
: DA-ENTER ( --- )   1 DA-DEPTH +!  DA-N @ 0 ?DO DA-NA I CELLS + @ DA-NL I CELLS + @ DA-MARK LOOP  0 DA-N ! ;
: DA-LEAVE ( --- )   NM-N @ 0 ?DO NM-DAL I CELLS + @ DA-DEPTH @ = IF -1 NM-DAL I CELLS + ! THEN LOOP  -1 DA-DEPTH +! ;
VARIABLE IN-EXIT   \ compiling on EXIT's block: no safe point there (776)
64 CONSTANT GR-MAX   GR-MAX CELLS BUFFER: GR-A   GR-MAX CELLS BUFFER: GR-L   GR-MAX CELLS BUFFER: GR-K   VARIABLE GR-N
: GR-ADD ( c-addr u kind --- )   \ a top-level for loop's source, registered with the collector (776)
  GR-N @ GR-MAX < IF  GR-K GR-N @ CELLS + !  GR-L GR-N @ CELLS + !  GR-A GR-N @ CELLS + !  1 GR-N +!  ELSE DROP 2DROP THEN ;
: SET-KIND ( c-addr u kind --- )   \ rillc.py's scope()[name] = kind: set, or add, in the current scope
  >R 2DUP NM-FIND DUP 0< 0= IF DUP CELLS NM-LOC + @ IN-DEF @ = IF
     R> SWAP CELLS NM-K + ! 2DROP EXIT THEN THEN
  DROP R> IN-DEF @ NM-ADD ;
\ [gene infer]
\ gene infer (764): two passes, as rillc.py's - the first records every binding's kind per variable
\ (the script's, or a def's own), two kinds joining to an item; the second starts each scope with them
1024 CONSTANT IK-MAX
IK-MAX CELLS BUFFER: IK-SA  IK-MAX CELLS BUFFER: IK-SL  IK-MAX CELLS BUFFER: IK-NA  IK-MAX CELLS BUFFER: IK-NL
IK-MAX CELLS BUFFER: IK-K   VARIABLE IK-N   \ INFER and FIXED: above READ-VAR (785)
VARIABLE SK-A  VARIABLE SK-L  VARIABLE IKS-A  VARIABLE IKS-L   \ the def being compiled; a scope's key
: SCOPE-KEY ( --- c-addr u )   IN-DEF @ IF SK-A @ SK-L @ ELSE 0 0 THEN ;
: IK-SCOPE? ( i --- f )   DUP CELLS IK-SA + @ SWAP CELLS IK-SL + @ IKS-A @ IKS-L @ COMPARE 0= ;
: IK-FIND ( c-addr u --- i | -1 )   \ the current scope's entry for the name
  SCOPE-KEY IKS-L ! IKS-A !
  IK-N @ 0 ?DO  I IK-SCOPE? IF 2DUP I CELLS IK-NA + @ I CELLS IK-NL + @ COMPARE 0= IF 2DROP I UNLOOP EXIT THEN THEN  LOOP
  2DROP -1 ;
: IK-RECORD ( c-addr u kind --- )   \ a binding's kind joined into its variable's entry
  >R 2DUP IK-FIND DUP 0< 0= IF NIP NIP CELLS IK-K + DUP @ R@ = IF R> 2DROP EXIT THEN
    DUP @ R>  2DUP K-DEC = SWAP K-NUM = AND >R  K-NUM = SWAP K-DEC = AND R> OR       \ number and decimal: decimal (771)
    IF K-DEC ELSE K-ANY THEN SWAP ! EXIT THEN
  DROP IK-N @ IK-MAX < 0= IF S" too many variables to infer" ERR THEN
  IK-N @ CELLS IK-NL + !  IK-N @ CELLS IK-NA + !  SCOPE-KEY IK-N @ CELLS IK-SL + !  IK-N @ CELLS IK-SA + !
  R> IK-N @ CELLS IK-K + !  1 IK-N +! ;
: IK-PRELOAD ( --- )   \ the second pass: the current scope starts with each variable's joined kind
  SCOPE-KEY IKS-L ! IKS-A !
  IK-N @ 0 ?DO  I IK-SCOPE? IF I CELLS IK-NA + @ I CELLS IK-NL + @ 2DUP DECLARE I CELLS IK-K + @ SET-KIND THEN  LOOP ;
: BIND-K ( c-addr u kind --- kind' )   \ rillc.py's bind: recorded in the first pass, the joined kind in the second
  INFER @ IF >R 2DUP R@ IK-RECORD R> ELSE
  FIXED @ IF >R 2DUP IK-FIND DUP 0< IF DROP R> ELSE R> DROP CELLS IK-K + @ THEN THEN THEN
  DUP >R SET-KIND R> ;
\ [/gene]
\ [gene !infer]
: BIND-K ( c-addr u kind --- kind' )   DUP >R SET-KIND R> ;
\ [/gene]
VARIABLE FOR-K   \ the kind a loop's count, index or key variable was bound to
: NUM-INTO ( k --- )   \ a count or an index stored in a variable of kind k (771)
  DUP K-NUM = IF DROP EXIT THEN  K-DEC = IF S" R-N>D" ELSE S" K-NUM R-BOX" THEN OUT+ ;
: VAR-OUT ( c-addr u --- )   [CHAR] R OUT-C [CHAR] . OUT-C OUT-RAW BL OUT-C ;
: SPREAD-OUT ( c-addr u --- )   \ @name's items: rillc.py's spread_code - the script's arguments for @args, unless it set its own (786)
  CNAME
  2DUP NM-FIND 0< IF 2DUP S" args" S= IF 2DROP S" R-ARGS" OUT+ EXIT THEN THEN
  2DUP NM-FIND DUP 0< IF S" is not set" ERR THEN
  CELLS NM-K + @ DUP K-ANY = IF DROP VAR-OUT S" @ R-AS-LIST" OUT+ EXIT THEN   \ an item: its list, checked (799)
  K-LIST <> IF S" a spread needs a list" ERR THEN
  VAR-OUT S" @" OUT+ ;
: LIST-ITEMS ( --- kind )   \ [ items ], the [ taken
  S" R-NEW-LIST" OUT+
  BEGIN S" ]" CUR-IS? 0= WHILE
    TK SPREAD-WORD? IF                                          \ [@refs, more]: a spread (744)
      TK T@ 1 /STRING NEXT-TK SPREAD-OUT S" OVER SWAP R-EXTEND" OUT+
    ELSE 1 EXPR BOX S" OVER" OUT+ S" R-PUSH" OUT+ THEN             \ an item: an expression (796)
    S" ," CUR-IS? IF NEXT-TK S" ]" CUR-IS? IF S" no comma after the last item" ERR THEN   \ commas between, one way (802)
    ELSE S" ]" CUR-IS? 0= IF S" items are separated by commas: [a, b]" ERR THEN THEN
  REPEAT NEXT-TK K-LIST ;
VARIABLE CM-COND
VARIABLE CM-2A  VARIABLE CM-2L  VARIABLE CM-SK  VARIABLE CM-NA  VARIABLE CM-NL
DEFER TRUTH-D   \ TRUTH, defined below (782)
: COMPREHENSION ( j --- kind )   \ [expr for x in src if cond] - or for k, v in a record, for i, x in a list (754)
  CMR-N @ SWAP                                             \ the renames before it, back when it ends (808)
  TK-I @ >R  DUP 1+ TK-I !                                 ( j )  ( R: the expr's start )
  TK T@ NEXT-TK                                            ( j name )
  0 CM-2L !  S" ," CUR-IS? IF NEXT-TK TK T@ CM-2L ! CM-2A ! NEXT-TK THEN
  S" in" EXPECT
  S" R-NEW-LIST" OUT+  1 EXPR CM-SK !
  CM-SK @ K-ANY = IF S" R-UNBOX DROP" OUT+ K-LIST CM-SK ! THEN     \ an item holding a list - a def's parameter (758)
  CM-SK @ K-LIST <> CM-SK @ K-REC <> AND  CM-SK @ K-REC = CM-2L @ 0= AND OR IF S" for needs a list" ERR THEN
  2DUP 4 PICK TMP-NAME 2DUP DECLARE                        ( j name tmp )
  2SWAP 4 PICK CM-RENAME 2SWAP                             \ its names its own from here (808)
  CM-2L @ IF CM-2A @ CM-2L @ 6 PICK CM-RENAME CM-2L ! CM-2A ! THEN
  2OVER CM-NL ! CM-NA !                                    \ the name kept for the certainly-set marks (772)
  2OVER DECLARE  2OVER CM-2L @ IF CM-SK @ K-LIST = IF K-NUM ELSE K-TEXT THEN ELSE K-ANY THEN BIND-K FOR-K !
  CM-2L @ IF CM-2A @ CM-2L @ 2DUP DECLARE K-ANY BIND-K DROP THEN
  2DUP VAR-OUT S" !" OUT+ 2DUP VAR-OUT S" @" OUT+
  CM-SK @ K-REC = IF S" R-KEYS" OUT+ THEN  S" R-LEN" OUT+ S" 0" OUT+ S" ?DO" OUT+
  CM-2L @ 0= IF  VAR-OUT S" @" OUT+ S" I" OUT+ S" R-AT" OUT+ VAR-OUT S" !" OUT+
  ELSE CM-SK @ K-REC = IF
    2DUP VAR-OUT S" @" OUT+ S" R-KEYS I R-AT" OUT+ FOR-K @ K-TEXT = IF S" R-ANY>TEXT" OUT+ THEN 2OVER VAR-OUT S" !" OUT+
    VAR-OUT S" @" OUT+ S" R-VALS I R-AT" OUT+ CM-2A @ CM-2L @ VAR-OUT S" !" OUT+  2DROP
  ELSE
    S" I" OUT+ FOR-K @ NUM-INTO 2OVER VAR-OUT S" !" OUT+  VAR-OUT S" @" OUT+ S" I R-AT" OUT+ CM-2A @ CM-2L @ VAR-OUT S" !" OUT+  2DROP
  THEN THEN  DROP
  CM-NA @ CM-NL @ DA-NEXT  CM-2L @ IF CM-2A @ CM-2L @ DA-NEXT THEN  DA-ENTER      \ its names certainly set inside (772)
  0 CM-COND !  S" if" CUR-IS? IF NEXT-TK 1 EXPR TRUTH-D S" IF" OUT+ -1 CM-COND ! THEN   \ as an if's (782)
  CM-COND @ >R  S" ]" EXPECT  TK-I @                       ( after )  ( R: start cond )
  R> R> TK-I ! >R                                          ( after )  ( R: cond )
  1 EXPR BOX S" OVER" OUT+ S" R-PUSH" OUT+  DA-LEAVE
  R> IF S" THEN" OUT+ THEN  S" LOOP" OUT+  TK-I !  CMR-N !  K-LIST ;
: LIST-LIT-IMPL ( --- kind )   \ the [ taken: a comprehension if a for stands at this level
  TK-I @ 0                                                 ( j depth )
  BEGIN OVER T@ S" ]" S= OVER 0= AND 0= WHILE
    OVER K@ T-STR <> OVER K@ T-RAW <> AND IF
      OVER T@ 2DUP S" [" S= >R 2DUP S" (" S= R> OR >R S" {" S= R> OR IF 1+ ELSE
      OVER T@ 2DUP S" ]" S= >R 2DUP S" )" S= R> OR >R S" }" S= R> OR IF 1- ELSE
      DUP 0= 2 PICK T@ S" for" S= AND 2 PICK K@ T-KW = AND IF DROP COMPREHENSION EXIT THEN THEN THEN
    THEN SWAP 1+ SWAP
  REPEAT 2DROP LIST-ITEMS ;
' LIST-LIT-IMPL IS LIST-LIT
: RECORD-LIT-IMPL ( --- kind )   \ { name: value, 'key': value }, the { taken
  S" R-NEW-RECORD" OUT+
  BEGIN S" }" CUR-IS? 0= WHILE
    TK K@ T-WORD = TK T@ + 1- C@ [CHAR] : = AND IF TK T@ 1- NEXT-TK
    ELSE TK K@ DUP T-RAW = SWAP T-STR = OR TK 1+ S" :" TK-IS? AND IF TK T@ 1 /STRING 1- NEXT-TK NEXT-TK
    ELSE S" a record field is name: value" ERR THEN THEN       ( key )
    1 EXPR BOX  LIT-TEXT  S" 2" OUT+ S" PICK" OUT+ S" R-PUT" OUT+
    S" ," CUR-IS? IF NEXT-TK SKIP-NL-HOOK S" }" CUR-IS? IF S" no comma after the last field" ERR THEN   \ commas between, one way (802)
    ELSE SKIP-NL-HOOK S" }" CUR-IS? 0= IF S" fields are separated by commas: {a: 1, b: 2}" ERR THEN THEN
  REPEAT NEXT-TK K-REC ;
' RECORD-LIT-IMPL IS RECORD-LIT
: TRUTH ( kind --- )   \ gene truth (751): an empty text, list or record false - rillc.py's truth()
\ [gene truth]
  DUP K-TEXT = OVER K-LIST = OR IF DROP S" @ 0<>" OUT+ EXIT THEN
  DUP K-REC = IF DROP S" @ @ 0<>" OUT+ EXIT THEN
  DUP K-ANY = IF DROP S" R-ANY>BOOL" OUT+ EXIT THEN
\ [/gene]
  DROP ;
' TRUTH IS TRUTH-D
: UNARY ( --- kind )
  S" not" CUR-IS? IF NEXT-TK RECURSE TRUTH S" 0=" OUT+ K-BOOL EXIT THEN
  TK K@ T-WORD = S" -" CUR-IS? AND IF NEXT-TK RECURSE                \ a number's, a decimal's, an item's own kind (796)
    DUP K-DEC = IF DROP S" NEGATE" OUT+ K-DEC EXIT THEN  DUP K-ANY = IF DROP S" R-ANY-NEG" OUT+ K-ANY EXIT THEN
    TO-NUM S" NEGATE" OUT+ K-NUM EXIT THEN
  TERM ;
\ [gene short]
: SHORT-FORM ( opi --- c-addr u | 0 0 )   \ the right side a lone 1 or 0, and a one-word form for it
  TK K@ T-WORD = 0= IF DROP 0 0 EXIT THEN
  TK 1+ PREC-OF OVER PREC-OF > IF DROP 0 0 EXIT THEN
  TK T@ S" 1" S= IF T@ 2DUP S" +" S= IF 2DROP S" 1+" EXIT THEN S" -" S= IF S" 1-" EXIT THEN 0 0 EXIT THEN
  TK T@ S" 0" S= IF T@ 2DUP S" >" S= IF 2DROP S" 0>" EXIT THEN 2DUP S" <" S= IF 2DROP S" 0<" EXIT THEN
    2DUP S" ==" S= IF 2DROP S" 0=" EXIT THEN S" !=" S= IF S" 0<>" EXIT THEN 0 0 EXIT THEN
  DROP 0 0 ;
\ [/gene]
VARIABLE BL-POS   VARIABLE BL-K
: LEFT-TEXT ( --- )   OUT-POS BL-K @ TO-TEXT  BL-POS @ SEG>POS ;      \ to_text(left), at lpos
: LEFT-NUM ( --- )    OUT-POS BL-K @ TO-NUM   BL-POS @ SEG>POS ;
: LEFT-BOX ( --- )    OUT-POS BL-K @ BOX      BL-POS @ SEG>POS ;
: ARITH-OP ( c-addr u --- n )   \ + - * / %: 0 .. 4; anything else -1 (790)
  2DUP S" +" S= IF 2DROP 0 EXIT THEN  2DUP S" -" S= IF 2DROP 1 EXIT THEN  2DUP S" *" S= IF 2DROP 2 EXIT THEN
  2DUP S" /" S= IF 2DROP 3 EXIT THEN  S" %" S= IF 4 ELSE -1 THEN ;
: CMP-WORD ( c-addr u --- c-addr' u' )   \ a comparison's Forth: == =, != <>, <= > 0=, >= < 0=; < and > themselves
  2DUP S" ==" S= IF 2DROP S" =" EXIT THEN  2DUP S" !=" S= IF 2DROP S" <>" EXIT THEN
  2DUP S" <=" S= IF 2DROP S" > 0=" EXIT THEN  2DUP S" >=" S= IF 2DROP S" < 0=" EXIT THEN ;
: ORDER-OP ( c-addr u --- n )   \ < <= > >=: 1 2 3 4; anything else 0 (786)
  2DUP S" <" S= IF 2DROP 1 EXIT THEN  2DUP S" <=" S= IF 2DROP 2 EXIT THEN
  2DUP S" >" S= IF 2DROP 3 EXIT THEN  S" >=" S= IF 4 EXIT THEN  0 ;
: ORDER-OUT ( n --- )   DUP 1 = IF DROP S" 0<" ELSE DUP 2 = IF DROP S" 0> 0=" ELSE 3 = IF S" 0>" ELSE S" 0< 0=" THEN THEN THEN OUT+ ;
: CONTAINER? ( kind --- f )   DUP K-LIST = OVER K-REC = OR SWAP K-ANY = OR ;
: NUMISH? ( kind --- f )   DUP K-NUM = OVER K-DEC = OR SWAP K-ANY = OR ;
: BINOP ( lk lpos rk opi --- kind )
  >R  SWAP BL-POS !  SWAP BL-K !                                ( rk )  ( R: opi )
  R@ T@ S" and" S= R@ T@ S" or" S= OR IF DROP R> T@ S" and" S= IF S" AND" ELSE S" OR" THEN OUT+ K-BOOL EXIT THEN
  R@ T@ S" in" S= R@ T@ S" not" S= OR IF
    DUP K-REC = IF DROP LEFT-TEXT S" R-HAS" OUT+ ELSE
    DUP K-LIST = IF DROP LEFT-BOX S" R-IN" OUT+ ELSE
    DUP K-ANY = IF DROP LEFT-BOX S" R-IN-ANY" OUT+ ELSE
    K-TEXT = IF LEFT-TEXT S" SWAP R-CONTAINS" OUT+ ELSE S" in needs a list, a record or a text" ERR THEN THEN THEN THEN   \ 798
    R> T@ S" not" S= IF S" 0=" OUT+ THEN  K-BOOL EXIT THEN
  R@ T@ S" +" S= IF  BL-K @ K-TEXT = OVER K-TEXT = OR  BL-K @ K-LIST = OR  OVER K-LIST = OR IF   \ one way each (800)
    S" + adds numbers - texts join in a string, lists as [@a @b]" ERR THEN THEN
  R@ T@ S" ==" S= R@ T@ S" !=" S= OR  BL-K @ K-ANY = AND  OVER K-ANY = AND IF          \ two items (758)
    DROP S" R-BOX=" OUT+ R> T@ S" !=" S= IF S" 0=" OUT+ THEN K-BOOL EXIT THEN
  R@ T@ S" ==" S= R@ T@ S" !=" S= OR  BL-K @ K-TEXT = 2 PICK K-TEXT = OR AND   \ 2 PICK: the right side's kind (749)
  BL-K @ DUP K-TEXT = SWAP K-ANY = OR AND  OVER DUP K-TEXT = SWAP K-ANY = OR AND IF
    LEFT-TEXT TO-TEXT S" R-T=" OUT+ R> T@ S" !=" S= IF S" 0=" OUT+ THEN K-BOOL EXIT THEN
  R@ T@ ORDER-OP  BL-K @ K-ANY = AND  OVER K-ANY = AND ?DUP IF                    \ two items: their kinds decide, as Python's (786)
    >R S" R-ANY-CMP" OUT+ R> ORDER-OUT R> DROP DROP K-BOOL EXIT THEN
  R@ T@ ORDER-OP  BL-K @ K-TEXT = 2 PICK K-TEXT = OR AND                        \ texts in order, as Python's (786)
  BL-K @ DUP K-TEXT = SWAP K-ANY = OR AND  OVER DUP K-TEXT = SWAP K-ANY = OR AND ?DUP IF
    >R LEFT-TEXT TO-TEXT S" R-TCMP" OUT+ R> ORDER-OUT R> DROP K-BOOL EXIT THEN
  R@ T@ S" ==" S= R@ T@ S" !=" S= OR  BL-K @ CONTAINER? AND  OVER CONTAINER? AND IF        \ lists, records: by what they hold (782)
    LEFT-BOX BOX S" R-BOX=" OUT+ R> T@ S" !=" S= IF S" 0=" OUT+ THEN K-BOOL EXIT THEN
  BL-K @ K-DEC = OVER K-DEC = OR  BL-K @ NUMISH? AND  OVER NUMISH? AND IF        \ decimals (754): fixed point, six places
    BL-K @ K-NUM = IF OUT-POS S" R-N>D" OUT+ BL-POS @ SEG>POS THEN
    BL-K @ K-ANY = IF OUT-POS S" R-ANY>DEC" OUT+ BL-POS @ SEG>POS THEN     \ an item holding a decimal too (774)
    DUP K-NUM = IF S" R-N>D" OUT+ THEN  K-ANY = IF S" R-ANY>DEC" OUT+ THEN  -1 DEPTH+
    R@ T@ S" +" S= IF S" R-ADD" ELSE R@ T@ S" -" S= IF S" R-MINUS" ELSE R@ T@ S" *" S= IF S" R-DMUL" ELSE   \ checked (794)
    R@ T@ S" /" S= IF S" R-DDIV" ELSE R@ T@ S" %" S= IF S" R-MODC" ELSE R@ T@ S" ==" S= IF S" =" ELSE
    R@ T@ S" !=" S= IF S" <>" ELSE R@ T@ S" <" S= IF S" <" ELSE R@ T@ S" >" S= IF S" >" ELSE
    R@ T@ S" <=" S= IF S" > 0=" ELSE S" < 0=" THEN THEN THEN THEN THEN THEN THEN THEN THEN THEN
    OUT+  R> PREC-OF 4 < IF K-BOOL ELSE K-DEC THEN EXIT
  THEN
  BL-K @ K-ANY = OVER K-ANY = OR  BL-K @ DUP K-NUM = SWAP K-ANY = OR AND  OVER DUP K-NUM = SWAP K-ANY = OR AND IF   \ an item: a decimal in it counts (790)
    R@ T@ ARITH-OP DUP 0< 0= IF
      -1 DEPTH+  OUT-NUM  BL-K @ OVER = IF S" R-ARITH-AA" ELSE BL-K @ K-ANY = IF S" R-ARITH-AN" ELSE S" R-ARITH-NA" THEN THEN OUT+
      DROP R> DROP K-ANY EXIT THEN
    DROP BL-K @ OVER <> IF
      -1 DEPTH+  BL-K @ K-ANY = IF S" R-CMP-AN" ELSE S" R-CMP-NA" THEN OUT+  DROP  R@ T@ CMP-WORD OUT+  R> DROP K-BOOL EXIT THEN
  THEN
  LEFT-NUM TO-NUM  -1 DEPTH+
  R@ T@ S" +" S= IF S" R-ADD" ELSE R@ T@ S" -" S= IF S" R-MINUS" ELSE R@ T@ S" *" S= IF S" R-MUL" ELSE R@ T@ S" /" S= IF S" R-DIV" ELSE   \ checked (794)
  R@ T@ S" %" S= IF S" R-MODC" ELSE R@ T@ S" ==" S= IF S" =" ELSE R@ T@ S" !=" S= IF S" <>" ELSE R@ T@ S" <" S= IF S" <" ELSE
  R@ T@ S" >" S= IF S" >" ELSE R@ T@ S" <=" S= IF S" > 0=" ELSE S" < 0=" THEN THEN THEN THEN THEN THEN THEN THEN THEN THEN
  OUT+  R> PREC-OF 4 < IF K-BOOL ELSE K-NUM THEN ;
: EXPR-IMPL ( minp --- kind )
  >R UNARY
  BEGIN TK PREC-OF DUP R@ < 0= SWAP 0<> AND WHILE
    TK >R NEXT-TK  R@ T@ S" not" S= IF NEXT-TK THEN              \ not in: two tokens
    R@ T@ S" and" S= R@ T@ S" or" S= OR IF                        \ short-circuit (755): rillc.py's expr()
      DROP  S" DUP" OUT+  R@ T@ S" or" S= IF S" 0=" OUT+ THEN  S" IF DROP" OUT+  -1 DEPTH+
      R> PREC-OF 1+ EXPR DROP  S" THEN" OUT+  K-BOOL
