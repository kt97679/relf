\ rill/compile.4 - Rill's compiler, in Forth (Iteration 740 on).
\
\ The port of tools/rillc.py, its oracle: for every program both can
\ compile, the two must make the same Forth - word for word, blanks
\ aside (tests/rill/oracle). Written for the image (SHELL-LANGUAGE.md
\ Part 5): it reads a Rill script, makes Forth text, EVALUATEs it.
\ Part 1: the tokenizer, the output text, the tables.

: -ROT ( a b c --- c a b )   ROT ROT ;   \ not in the kernel
\ ---- tokens -------------------------------------------------------------
0 CONSTANT T-EOF   1 CONSTANT T-NL   2 CONSTANT T-STR   3 CONSTANT T-RAW
4 CONSTANT T-VAR   5 CONSTANT T-OP   6 CONSTANT T-WORD  7 CONSTANT T-KW
16384 CONSTANT TK-MAX
VARIABLE TK-KIND  VARIABLE TK-AT  VARIABLE TK-LEN  VARIABLE TK-LINE   \ arrays, ALLOCATEd
VARIABLE TK-N   VARIABLE TK-I
VARIABLE RS-SRC   VARIABLE SRC#   VARIABLE CUR-LINE
: TK-ALLOC ( --- )
  TK-MAX CELLS ALLOCATE THROW TK-KIND !  TK-MAX CELLS ALLOCATE THROW TK-AT !
  TK-MAX CELLS ALLOCATE THROW TK-LEN !   TK-MAX CELLS ALLOCATE THROW TK-LINE ! ;
: TK+ ( kind at len --- )
  TK-N @ TK-MAX = ABORT" rill: the script has too many tokens"
  TK-N @ CELLS TK-LEN @ + !  TK-N @ CELLS TK-AT @ + !  TK-N @ CELLS TK-KIND @ + !
  CUR-LINE @ TK-N @ CELLS TK-LINE @ + !  1 TK-N +! ;
: K@ ( i --- kind )   CELLS TK-KIND @ + @ ;
: T@ ( i --- c-addr u )   DUP CELLS TK-AT @ + @ RS-SRC @ +  SWAP CELLS TK-LEN @ + @ ;
: L@ ( i --- line )   CELLS TK-LINE @ + @ ;
: TOK-AT ( i --- offset )   CELLS TK-AT @ + @ ;
: TOK-END ( i --- offset )   DUP TOK-AT SWAP CELLS TK-LEN @ + @ + ;

: SRC-C@ ( pos --- c )   RS-SRC @ + C@ ;
: WORD-CHAR? ( c --- f )   \ not blank, not one of  " ' $ ( ) { } , ; < > = [ ]
  DUP 33 < IF DROP 0 EXIT THEN
  DUP [CHAR] " = OVER [CHAR] ' = OR OVER [CHAR] $ = OR OVER [CHAR] ( = OR OVER [CHAR] ) = OR
  OVER [CHAR] { = OR OVER [CHAR] } = OR OVER [CHAR] , = OR OVER [CHAR] ; = OR OVER [CHAR] < = OR
  OVER [CHAR] > = OR OVER [CHAR] = = OR OVER [CHAR] [ = OR SWAP [CHAR] ] = OR 0= ;
: NAME-CHAR? ( c --- f )
  DUP [CHAR] a [CHAR] z 1+ WITHIN OVER [CHAR] A [CHAR] Z 1+ WITHIN OR
  OVER [CHAR] 0 [CHAR] 9 1+ WITHIN OR SWAP [CHAR] _ = OR ;
: NAME-START? ( c --- f )   DUP [CHAR] 0 [CHAR] 9 1+ WITHIN 0= SWAP NAME-CHAR? AND ;
: OPS2 ( --- c-addr u )   S" $(==!=<=>=>>+=-=->??" ;   \ the two-character operators, in pairs
VARIABLE OPF   VARIABLE POS
: OP2? ( pos --- f )   \ a two-character operator starts here
  0 OPF !
  DUP 1+ SRC# @ < 0= IF DROP 0 EXIT THEN
  DUP SRC-C@ 8 LSHIFT SWAP 1+ SRC-C@ OR
  OPS2 DROP 20 0 DO  DUP I + C@ 8 LSHIFT OVER I + 1+ C@ OR  2 PICK = IF -1 OPF ! THEN  2 +LOOP  2DROP OPF @ ;
: OP1? ( c --- f )   \ one of  < > = ( ) { } , ; | [ ]
  DUP [CHAR] < = OVER [CHAR] > = OR OVER [CHAR] = = OR OVER [CHAR] ( = OR OVER [CHAR] ) = OR
  OVER [CHAR] { = OR OVER [CHAR] } = OR OVER [CHAR] , = OR OVER [CHAR] ; = OR OVER [CHAR] | = OR
  OVER [CHAR] [ = OR SWAP [CHAR] ] = OR ;
: KEYWORD? ( c-addr u --- f )
  2DUP S" if" COMPARE 0= >R  2DUP S" else" COMPARE 0= R> OR >R  2DUP S" while" COMPARE 0= R> OR >R
  2DUP S" def" COMPARE 0= R> OR >R  2DUP S" return" COMPARE 0= R> OR >R  2DUP S" and" COMPARE 0= R> OR >R
  2DUP S" or" COMPARE 0= R> OR >R  2DUP S" not" COMPARE 0= R> OR >R  2DUP S" for" COMPARE 0= R> OR >R
  2DUP S" in" COMPARE 0= R> OR >R  S" break" COMPARE 0= R> OR ;
: AT-END? ( pos --- f )   SRC# @ < 0= ;
: SN-RAW ( a u --- a' u' )   \ past a '...' whose ' is at a
  1 /STRING BEGIN DUP IF OVER C@ [CHAR] ' <> ELSE 0 THEN WHILE 1 /STRING REPEAT DUP IF 1 /STRING THEN ;
DEFER SN-STR-D
: SN-NEST ( a u closer --- a' u' f )   \ from just inside an opener to just past its closer, strings in it skipped whole (789)
  >R
  BEGIN DUP WHILE
    OVER C@ CASE
      [CHAR] \ OF DUP 2 MIN /STRING ENDOF
      [CHAR] " OF SN-STR-D ENDOF
      [CHAR] ' OF SN-RAW ENDOF
      [CHAR] { OF 1 /STRING [CHAR] } RECURSE 0= IF R> DROP 0 EXIT THEN ENDOF
      [CHAR] ( OF 1 /STRING [CHAR] ) RECURSE 0= IF R> DROP 0 EXIT THEN ENDOF
      DUP R@ = IF DROP 1 /STRING R> DROP -1 EXIT THEN  >R 1 /STRING R>
    ENDCASE
  REPEAT R> DROP 0 ;
: SN-STR ( a u --- a' u' )   \ past a "..." whose " is at a: its {...} and $(...) may hold strings of their own (789)
  1 /STRING
  BEGIN DUP WHILE
    OVER C@ CASE
      [CHAR] \ OF DUP 2 MIN /STRING ENDOF
      [CHAR] " OF 1 /STRING EXIT ENDOF
      [CHAR] { OF 1 /STRING [CHAR] } SN-NEST DROP ENDOF
      [CHAR] $ OF DUP 1 > IF OVER 1+ C@ [CHAR] ( = ELSE 0 THEN IF 2 /STRING [CHAR] ) SN-NEST DROP ELSE 1 /STRING THEN ENDOF
      >R 1 /STRING R>
    ENDCASE
  REPEAT ;
' SN-STR IS SN-STR-D
: NL-COUNT ( from to --- n )   SWAP 0 ROT ROT ?DO I SRC-C@ 10 = IF 1+ THEN LOOP ;
: SCAN-STR ( --- )   \ "...", as SN-STR finds its end (789); the token on the line it starts, the lines after it counted
  POS @ RS-SRC @ +  SRC# @ POS @ -  SN-STR DROP  RS-SRC @ -
  T-STR POS @ ROT DUP >R OVER - TK+  POS @ R@ NL-COUNT CUR-LINE +!  R> POS ! ;
: SCAN-RAW ( --- )   \ '...', nothing escaped
  POS @ 1+  BEGIN DUP AT-END? IF 0 ELSE DUP SRC-C@ [CHAR] ' <> THEN WHILE 1+ REPEAT
  DUP AT-END? 0= IF 1+ THEN  T-RAW POS @ ROT DUP >R OVER - TK+  POS @ R@ NL-COUNT CUR-LINE +!  R> POS ! ;   \ its lines counted (789)
: SCAN-WHILE ( pos xt --- end )   >R BEGIN DUP AT-END? IF 0 ELSE DUP SRC-C@ R@ EXECUTE THEN WHILE 1+ REPEAT R> DROP ;
VARIABLE NAME-XT   ' NAME-CHAR? NAME-XT !XT   VARIABLE WORD-XT   ' WORD-CHAR? WORD-XT !XT
: SCAN-VAR ( --- )   POS @ 1+ NAME-XT @XT SCAN-WHILE  T-VAR POS @ ROT DUP >R OVER - TK+  R> POS ! ;
: SCAN-WORD ( --- )
  POS @ WORD-XT @XT SCAN-WHILE  DUP POS @ - >R                 ( end )  ( R: len )
  POS @ RS-SRC @ + R@ KEYWORD? IF T-KW ELSE T-WORD THEN  POS @ R> TK+  POS ! ;
: SKIP-COMMENT ( --- )   BEGIN POS @ AT-END? IF 0 ELSE POS @ SRC-C@ 10 <> THEN WHILE 1 POS +! REPEAT ;
VARIABLE TK-LINE0   1 TK-LINE0 !   \ the line the text being tokenized starts on: 1, or a string's {...} on the script's lines (786)
VARIABLE SQ-DEPTH   \ the [ open: a newline inside them is no token, as Python's (782)
: TOKEN-1 ( --- )
  POS @ SRC-C@
  DUP 10 = SQ-DEPTH @ AND IF DROP 1 CUR-LINE +!  1 POS +! EXIT THEN
  DUP 10 = IF DROP T-NL POS @ 1 TK+  1 CUR-LINE +!  1 POS +! EXIT THEN
  DUP 33 < IF DROP 1 POS +! EXIT THEN
  DUP [CHAR] # = IF DROP SKIP-COMMENT EXIT THEN
  DUP [CHAR] " = IF DROP SCAN-STR EXIT THEN
  DUP [CHAR] ' = IF DROP SCAN-RAW EXIT THEN
  DUP [CHAR] $ = IF  POS @ 1+ AT-END? 0= IF POS @ 1+ SRC-C@ NAME-START? IF DROP SCAN-VAR EXIT THEN THEN  THEN
  POS @ OP2? IF DROP T-OP POS @ 2 TK+  2 POS +! EXIT THEN
  DUP [CHAR] [ = IF 1 SQ-DEPTH +! THEN  DUP [CHAR] ] = IF SQ-DEPTH @ IF -1 SQ-DEPTH +! THEN THEN
  DUP OP1? IF DROP T-OP POS @ 1 TK+  1 POS +! EXIT THEN
  DUP WORD-CHAR? IF DROP SCAN-WORD EXIT THEN
  DROP 1 POS +! ;
: TOKENIZE ( c-addr u --- )
  SRC# ! RS-SRC !  0 TK-N !  TK-LINE0 @ CUR-LINE !  0 POS !  0 SQ-DEPTH !
  BEGIN POS @ AT-END? 0= WHILE TOKEN-1 REPEAT
  T-EOF SRC# @ 0 TK+ ;
: .TOKENS ( --- )   \ for tests/rill/oracle: one token a line, kind and text
  TK-N @ 0 ?DO  I K@ .  I L@ .  I T@ TYPE  R-NL  LOOP ;

\ ---- Part 2: output, tables, expressions (Iteration 740) ----------------
\ The tables are BUFFER:s (pool.4) - on the heap, ALLOCATEd at boot by
\ ALLOC-BUFFERS - not laid in the image: the user's call at 741, and the
\ image went from 44,431 bytes back toward its runtime's size.
\ Code is written as text into one of two buffers - the defs and R-MAIN -
\ each piece followed by a blank; names to declare are gathered and
\ sorted at the end, as rillc.py's program() does.
VARIABLE MAIN-B  VARIABLE MAIN#  VARIABLE DEFS-B  VARIABLE DEFS#  VARIABLE CUR-B  VARIABLE CUR#A
\ [gene littext]
VARIABLE LITS-B  VARIABLE LITS#      \ literal texts made once (gene littext, 750)
\ [/gene]
: BUF-ALLOC ( --- )   1048576 ALLOCATE THROW MAIN-B !  1048576 ALLOCATE THROW DEFS-B !  0 MAIN# !  0 DEFS# !
\ [gene littext]
  262144 ALLOCATE THROW LITS-B !  0 LITS# !
\ [/gene]
  ;
: TO-MAIN ( --- )   MAIN-B CUR-B !  MAIN# CUR#A ! ;
: TO-DEFS ( --- )   DEFS-B CUR-B !  DEFS# CUR#A ! ;
: OUT+ ( c-addr u --- )   \ a piece of code and a blank (gene inline tried at 753 and taken out)
  CUR-B @ @ CUR#A @ @ + SWAP DUP >R MOVE  R> CUR#A @ +!  BL CUR-B @ @ CUR#A @ @ + C!  1 CUR#A @ +! ;
: OUT-NUM ( n --- )   DUP ABS 0 <# #S ROT SIGN #> OUT+ ;
: OUT-POS ( --- n )   CUR#A @ @ ;

\ names: a table of name (address, length), kind, and whether it is a
\ def's local; kinds K-NUM K-TEXT K-BOOL, and 9 for a box (any)
9 CONSTANT K-ANY
256 CONSTANT NM-MAX
NM-MAX CELLS BUFFER: NM-A  NM-MAX CELLS BUFFER: NM-L  NM-MAX CELLS BUFFER: NM-K  NM-MAX CELLS BUFFER: NM-LOC
NM-MAX CELLS BUFFER: NM-DAL   \ certainly set (772): the block depth a name was set at on this path; -1 not certainly
VARIABLE NM-N   VARIABLE IN-DEF
VARIABLE NF-R   \ not the return stack: inside DO, R@ is the loop's index (739's lesson, again)
: NM-FIND ( c-addr u --- i | -1 )   \ the def's local first, then the script's
  -1 NF-R !  NM-N @ 0 ?DO
    2DUP NM-A I CELLS + @ NM-L I CELLS + @ COMPARE 0= IF
      NM-LOC I CELLS + @ IF I NF-R ! ELSE NF-R @ 0< IF I NF-R ! THEN THEN
    THEN LOOP 2DROP NF-R @ ;
: NM-ADD ( c-addr u kind local? --- )
  NM-N @ NM-MAX = ABORT" rill: too many names"
  NM-LOC NM-N @ CELLS + !  NM-K NM-N @ CELLS + !  NM-L NM-N @ CELLS + !  NM-A NM-N @ CELLS + !
  -1 NM-DAL NM-N @ CELLS + !  1 NM-N +! ;
: NM-DROP-LOCALS ( --- )   \ a def's names leave with it
  0 NM-N @ 0 ?DO  NM-LOC I CELLS + @ 0= IF
    NM-A I CELLS + @ NM-A 2 PICK CELLS + !  NM-L I CELLS + @ NM-L 2 PICK CELLS + !
    NM-K I CELLS + @ NM-K 2 PICK CELLS + !  NM-DAL I CELLS + @ NM-DAL 2 PICK CELLS + !  0 NM-LOC 2 PICK CELLS + !  1+ THEN  LOOP NM-N ! ;
\ every name declared as a VARIABLE, once
NM-MAX CELLS BUFFER: DC-A  NM-MAX CELLS BUFFER: DC-L  VARIABLE DC-N
: DECLARE ( c-addr u --- )
  DC-N @ 0 ?DO  2DUP DC-A I CELLS + @ DC-L I CELLS + @ COMPARE 0= IF 2DROP UNLOOP EXIT THEN  LOOP
  DC-L DC-N @ CELLS + !  DC-A DC-N @ CELLS + !  1 DC-N +! ;

\ the token cursor
: TK ( --- i )   TK-I @ ;
: NEXT-TK ( --- )   1 TK-I +! ;
: TK-IS? ( i c-addr u --- f )   ROT DUP K@ T-STR = OVER K@ T-RAW = OR IF DROP 2DROP 0 EXIT THEN T@ COMPARE 0= ;
: CUR-IS? ( c-addr u --- f )   TK -ROT TK-IS? ;
: EXPECT ( c-addr u --- )
  2DUP CUR-IS? IF 2DROP NEXT-TK EXIT THEN
  ." rillc: line " TK L@ . ." : expected " TYPE ." , found " TK T@ TYPE R-NL -4100 THROW ;
: ERR ( c-addr u --- )   ." rillc: line " TK L@ . ." : " TYPE R-NL -4100 THROW ;

\ ---- Part 3: expressions (Iteration 740) --------------------------------
VARIABLE STACKMODE   VARIABLE SM-DEPTH
16 CELLS BUFFER: PRM-A  16 CELLS BUFFER: PRM-L  VARIABLE PRM-N   \ a pure def's parameters
: S= ( c-addr1 u1 c-addr2 u2 --- f )   COMPARE 0= ;
: OUT-INSERT ( c-addr u pos --- )   \ text and a blank put in at pos
  >R  CUR-B @ @ R@ +  DUP 2 PICK 1+ +  OUT-POS R@ - MOVE
  DUP 1+ CUR#A @ +!
  CUR-B @ @ R@ + SWAP DUP >R MOVE
  BL CUR-B @ @ R> R> + + C! ;
4096 BUFFER: HDR  VARIABLE HDR#
VARIABLE SG-FROM  VARIABLE SG-POS  VARIABLE SG-LEN  VARIABLE RD-POS
: SEG>POS ( from pos --- )   \ the code from `from` to the end, moved in at pos
  SG-POS ! SG-FROM !  OUT-POS SG-FROM @ - SG-LEN !
  CUR-B @ @ SG-FROM @ +  HDR  SG-LEN @ MOVE
  CUR-B @ @ SG-POS @ +  DUP SG-LEN @ +  SG-FROM @ SG-POS @ -  MOVE
  HDR  CUR-B @ @ SG-POS @ +  SG-LEN @ MOVE ;
: DEPTH+ ( n --- )   STACKMODE @ IF SM-DEPTH +! ELSE DROP THEN ;
: NUMBER-TEXT? ( c-addr u --- f )   \ -?\d+
  DUP 0= IF 2DROP 0 EXIT THEN
  OVER C@ [CHAR] - = IF 1 /STRING DUP 0= IF 2DROP 0 EXIT THEN THEN
  -1 -ROT 0 ?DO DUP I + C@ [CHAR] 0 [CHAR] 9 1+ WITHIN 0= IF NIP 0 SWAP LEAVE THEN LOOP DROP ;
: PREC-OF ( i --- p )   \ an operator's precedence, 0 if it is none
  DUP K@ DUP T-OP = OVER T-KW = OR SWAP T-WORD = OR 0= IF DROP 0 EXIT THEN
  DUP T@ S" not" S= IF 1+ S" in" TK-IS? IF 3 ELSE 0 THEN EXIT THEN          \ not in
  T@ 2DUP S" or" S= IF 2DROP 1 EXIT THEN  2DUP S" and" S= IF 2DROP 2 EXIT THEN
  2DUP S" in" S= IF 2DROP 3 EXIT THEN
  2DUP S" ==" S= >R 2DUP S" !=" S= R> OR >R 2DUP S" <" S= R> OR >R 2DUP S" <=" S= R> OR >R
  2DUP S" >" S= R> OR >R 2DUP S" >=" S= R> OR IF 2DROP 3 EXIT THEN
  2DUP S" +" S= >R 2DUP S" -" S= R> OR IF 2DROP 4 EXIT THEN
  2DUP S" *" S= >R 2DUP S" /" S= R> OR >R S" %" S= R> OR IF 5 EXIT THEN  0 ;
: OUT-C ( c --- )   CUR-B @ @ OUT-POS + C!  1 CUR#A @ +! ;
: OUT-RAW ( c-addr u --- )   CUR-B @ @ OUT-POS + SWAP DUP >R MOVE  R> CUR#A @ +! ;
: OUT-S" ( c-addr u --- )   \ S" text" R-TEXT
  [CHAR] S OUT-C  34 OUT-C  BL OUT-C  OUT-RAW  34 OUT-C  BL OUT-C  S" R-TEXT" OUT+ ;
VARIABLE HS-Q
: HAS-SPECIAL? ( c-addr u quote-only? --- f )   \ a quote - or a line end or a tab, unless quote-only
  HS-Q !  0 -ROT 0 ?DO  DUP I + C@ DUP 34 = SWAP DUP 10 = OVER 9 = OR SWAP 13 = OR HS-Q @ 0= AND OR IF NIP -1 SWAP LEAVE THEN  LOOP DROP ;   \ 13 too (793)
: OUT-BYTES ( c-addr u --- )   DUP >R 0 ?DO DUP I + C@ OUT-NUM LOOP DROP R> OUT-NUM S" R-BYTES" OUT+ ;
: LIT-CODE ( c-addr u quote-only? --- )   >R 2DUP R> HAS-SPECIAL? IF OUT-BYTES ELSE OUT-S" THEN ;
\ [gene littext]
1024 CONSTANT LT-MAX   LT-MAX CELLS BUFFER: LT-OFF   LT-MAX CELLS BUFFER: LT-LEN   VARIABLE LT-N
VARIABLE LT-SAVEB  VARIABLE LT-SAVEN  VARIABLE LT-START
: SHARED-LIT ( c-addr u quote-only? --- )   \ gene littext: its code once in LITS, R-LIT-n here (rillc.py's shared)
  CUR-B @ LT-SAVEB !  CUR#A @ LT-SAVEN !  LITS-B CUR-B !  LITS# CUR#A !  LITS# @ LT-START !
  LIT-CODE                                                   \ the candidate, at LITS's end
  LITS# @ LT-START @ -                                       ( len )
  0 LT-N @ 0 ?DO                                             ( len found )
    OVER I CELLS LT-LEN + @ = IF
      LITS-B @ LT-START @ +  2 PICK  LITS-B @ I CELLS LT-OFF + @ +  OVER  COMPARE 0= IF DROP I 1+ LEAVE THEN
    THEN LOOP                                                ( len found )
  ?DUP IF  NIP LT-START @ LITS# !                            \ known: the candidate given back
  ELSE  LT-N @ LT-MAX = IF S" too many literal texts" ERR THEN
    LT-START @ LT-N @ CELLS LT-OFF + !  LT-N @ CELLS LT-LEN + !  1 LT-N +!
    S" R-FIX" OUT+  S" CONSTANT" OUT+  S" R-LIT-" OUT-RAW LT-N @ OUT-NUM  10 OUT-C  LT-N @   \ out of the arena (776)
  THEN                                                       ( n )
  LT-SAVEB @ CUR-B !  LT-SAVEN @ CUR#A !
  S" R-LIT-" OUT-RAW OUT-NUM ;
\ [/gene]
\ [gene littext]
: LIT-TEXT ( c-addr u --- )   0 SHARED-LIT ;    \ rillc.py's lit_text
: TEXT-LIT ( c-addr u --- )   -1 SHARED-LIT ;
\ [/gene]
\ [gene !littext]
: LIT-TEXT ( c-addr u --- )   0 LIT-CODE ;      \ rillc.py's lit_text
: TEXT-LIT ( c-addr u --- )   -1 LIT-CODE ;
\ [/gene]
: TO-TEXT ( kind --- )   \ the value just made, as text - a list as its items with a blank between
  DUP K-TEXT = IF DROP EXIT THEN  DUP K-ANY = IF DROP S" R-ANY>TEXT" OUT+ EXIT THEN
  DUP K-LIST = IF DROP S"  " OUT-S" S" R-JOIN" OUT+ EXIT THEN
  DUP K-DEC = IF DROP S" R-DEC>TEXT" OUT+ EXIT THEN                   \ a decimal (754)
  DUP K-REC = IF DROP S" R-SHOW-REC" OUT+ EXIT THEN                   \ {k: v, ...}, not its address (793)
  K-BOOL = IF S" R-BOOL>TEXT" OUT+ EXIT THEN  S" R-NUM" OUT+ ;          \ true or false (759)
: SH-ALNUM? ( c --- f )   DUP [CHAR] 0 [CHAR] 9 1+ WITHIN SWAP 32 OR [CHAR] a [CHAR] z 1+ WITHIN OR ;
: TO-NUM ( kind --- )   DUP K-NUM = OVER K-BOOL = OR IF DROP EXIT THEN
  DUP K-DEC = IF DROP S" 1000000 /" OUT+ EXIT THEN                  \ a decimal's whole part (754)
  K-ANY = IF S" R-ANY>NUM" OUT+ EXIT THEN  S" a number is needed here" ERR ;
: K-CODE ( kind --- c-addr u )
  DUP K-NUM = IF DROP S" K-NUM" EXIT THEN DUP K-TEXT = IF DROP S" K-TEXT" EXIT THEN
  DUP K-LIST = IF DROP S" K-LIST" EXIT THEN  DUP K-REC = IF DROP S" K-REC" EXIT THEN
  DUP K-DEC = IF DROP S" K-DEC" EXIT THEN  DROP S" K-BOOL" ;
: BOX ( kind --- )   DUP K-ANY = IF DROP EXIT THEN  K-CODE OUT+ S" R-BOX" OUT+ ;

\ defs: name, parameter count, return kind (0 none), pure
64 CELLS BUFFER: DF-A  64 CELLS BUFFER: DF-L  64 CELLS BUFFER: DF-P
64 CELLS BUFFER: DF-K  64 CELLS BUFFER: DF-PURE  VARIABLE DF-N  VARIABLE DF-CUR
: DF-FIND ( c-addr u --- i | -1 )
  -1 -ROT DF-N @ 0 ?DO 2DUP DF-A I CELLS + @ DF-L I CELLS + @ S= IF ROT DROP I -ROT LEAVE THEN LOOP 2DROP ;

: NOT-YET ( --- )   S" not in the Forth compiler yet (rillc.py has it)" ERR ;
DEFER EXPR ( minp --- kind )
DEFER RUN-COND?-D   \ RUN-COND?, for code() in the library (786)
DEFER COMMAND-HOOK ( capture? --- )   \ commands come in part 5; terms and strings need them first
DEFER LIST-LIT ( --- kind )   DEFER RECORD-LIT ( --- kind )   DEFER SKIP-NL-HOOK ( --- )
\ [gene purestack]
: PARAM-AT ( c-addr u --- i | -1 )   \ a pure def's parameter
  STACKMODE @ 0= IF 2DROP -1 EXIT THEN
  -1 -ROT PRM-N @ 0 ?DO 2DUP PRM-A I CELLS + @ PRM-L I CELLS + @ S= IF ROT DROP I -ROT LEAVE THEN LOOP 2DROP ;
\ [/gene]
\ [gene loopvar]
VARIABLE LV-A  VARIABLE LV-L   \ the counted loop whose index is read as I (753), its name; 0 0 none
: LV-BAD? ( j --- f )   \ a token that keeps the index from I alone - rillc.py's loopvar_ok, token by token
  DUP K@ T-KW = IF T@ 2DUP S" for" COMPARE 0= >R 2DUP S" def" COMPARE 0= >R S" break" COMPARE 0= R> OR R> OR EXIT THEN   \ break a keyword (770)
  DUP K@ T-WORD <> IF DROP 0 EXIT THEN
  DUP T@ 2DUP S" break" COMPARE 0= >R 2DUP S" continue" COMPARE 0= >R 2DUP S" par" COMPARE 0= >R
  S" EXIT" COMPARE 0= R> OR R> OR R> OR IF DROP -1 EXIT THEN
  DUP T@ LV-A @ LV-L @ COMPARE IF DROP 0 EXIT THEN                 \ not the loop's own variable
  1+ T@ 2DUP S" =" COMPARE 0= >R 2DUP S" +=" COMPARE 0= >R 2DUP S" -=" COMPARE 0= >R S" [" COMPARE 0= R> OR R> OR R> OR ;
: LOOPVAR-OK? ( c-addr u --- f )   \ the body ahead (its { the current token) leaves the index to I alone
  LV-L ! LV-A !  TK-I @ 0                                    \ LV-A/LV-L hold the name for the scan only
  BEGIN
    OVER T@ S" {" COMPARE 0= IF 1+ ELSE
    OVER T@ S" }" COMPARE 0= IF 1- DUP 0= IF 2DROP 0 LV-L ! -1 EXIT THEN ELSE
    OVER LV-BAD? IF 2DROP 0 LV-L ! 0 EXIT THEN
    THEN THEN  SWAP 1+ SWAP
  AGAIN ;
\ [/gene]
\ [gene infer]
VARIABLE INFER  VARIABLE FIXED   \ gene infer's first pass, its second (764) - READ-VAR asks (785)
\ [/gene]
VARIABLE HAS-ON-EXIT   \ the script has an on EXIT block: its safe points poll for INT and TERM (786)
256 CONSTANT NI-MAX   \ the script's numbers read where they may not be set: R-NONE until they are (785)
NI-MAX CELLS BUFFER: NI-A  NI-MAX CELLS BUFFER: NI-L  VARIABLE NI-N
: NI-HAS? ( c-addr u --- f )   NI-N @ 0 ?DO 2DUP I CELLS NI-A + @ I CELLS NI-L + @ COMPARE 0= IF 2DROP -1 UNLOOP EXIT THEN LOOP 2DROP 0 ;
: NI-ADD ( c-addr u --- )
  2DUP NI-HAS? IF 2DROP EXIT THEN  NI-N @ NI-MAX < 0= IF S" too many numbers read before they are set" ERR THEN
  NI-N @ CELLS NI-L + !  NI-N @ CELLS NI-A + !  1 NI-N +! ;
\ a comprehension's variables are its own (808), as Python 3's: inside it each name is name.cJ, J
\ its for's token - innermost first; outside, the name is the script's again (rillc.py's cname)
16 CONSTANT CMR-MAX
CMR-MAX CELLS BUFFER: CMR-SA  CMR-MAX CELLS BUFFER: CMR-SL  CMR-MAX CELLS BUFFER: CMR-IA  CMR-MAX CELLS BUFFER: CMR-IL
VARIABLE CMR-N
: CNAME ( c-addr u --- c-addr' u' )
  CMR-N @ BEGIN DUP WHILE 1-
    >R 2DUP R@ CELLS CMR-SA + @ R@ CELLS CMR-SL + @ COMPARE 0= IF 2DROP R@ CELLS CMR-IA + @ R> CELLS CMR-IL + @ EXIT THEN R>
  REPEAT DROP ;
: CRENAMED? ( c-addr u --- f )   OVER >R CNAME DROP R> <> ;
: READ-VAR ( c-addr u --- kind )   \ $name, without its $
  CNAME
\ [gene loopvar]
  LV-L @ IF 2DUP LV-A @ LV-L @ COMPARE 0= IF 2DROP S" I" OUT+ K-NUM EXIT THEN THEN
