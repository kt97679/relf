: GB-SPLIT ( t --- dir comp )   \ the pattern's directory ("" for none, "/" for the root) and its last part
  R-T@ DUP BEGIN DUP WHILE 1- 2 PICK OVER + C@ [CHAR] / = IF
      >R  OVER R@ DUP 0= IF 1+ THEN R-TEXT  ROT ROT R@ 1+ /STRING R-TEXT  R> DROP EXIT THEN
    REPEAT DROP  S" " R-TEXT ROT ROT R-TEXT ;
: GB-JOIN ( dir name --- t )   \ dir/name; the name alone for the dir ""
  OVER R-T@ NIP 0= IF NIP EXIT THEN
  OVER R-T@ + 1- C@ [CHAR] / = IF 2 R-CONCAT ELSE S" /" R-TEXT SWAP 3 R-CONCAT THEN ;
