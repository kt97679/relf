: R-LIST= ( l l --- f )   \ as long as each other, each item = (782)
  OVER @ OVER @ <> IF 2DROP 0 EXIT THEN
  DUP @ 0 ?DO  OVER I R-AT OVER I R-AT R-BOX= 0= IF 2DROP 0 UNLOOP EXIT THEN  LOOP 2DROP -1 ;
: R-REC= ( r r --- f )   \ the same keys, in any order, each value = (782)
  OVER R-KEYS @ OVER R-KEYS @ <> IF 2DROP 0 EXIT THEN
  OVER R-KEYS DUP @ 0 ?DO                                         ( r1 r2 keys )
    DUP I R-AT R-ANY>TEXT  2 PICK R-FIND DUP 0< IF DROP 2DROP DROP 0 UNLOOP EXIT THEN
