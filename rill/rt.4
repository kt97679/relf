\ records
VARIABLE RK
: R-NEW-RECORD ( --- r )   \ keys, values, and a hash table and its size (0 0: none yet; gene rechash, 750)
  4 CELLS R-ALLOT  R-NEW-LIST OVER !  R-NEW-LIST OVER CELL+ !  0 OVER 2 CELLS + !  0 OVER 3 CELLS + ! ;
: R-KEYS ( r --- l )   @ ;
: R-VALS ( r --- l )   CELL+ @ ;
: R-HASH ( t --- h )   R-T@ OVER + SWAP 2166136261 ROT ROT ?DO I C@ XOR 16777619 * LOOP ;   \ FNV-1a: its low 32 bits the same, no mask per byte (775)
: RH-TABLE ( r --- a )   2 CELLS + @ ;
: RH-CAP ( r --- n )   3 CELLS + @ ;
VARIABLE RH-R  VARIABLE RH-K
: RH-PROBE ( key r --- slot )   \ the slot holding the key's index + 1, or the empty one it would take
  RH-R ! RH-K !  RH-K @ DUP CELL+ RK-A ! @ RK-U !  RH-K @ R-HASH RH-R @ RH-CAP 1- AND
  BEGIN
    DUP CELLS RH-R @ RH-TABLE + DUP @
    DUP 0= IF DROP NIP EXIT THEN
    1- CELLS RH-R @ @ 2 CELLS + @ + @ CELL+ @                     \ the key at that index, its text (775: in place)
    DUP @ RK-U @ = IF CELL+ RK-U @ RK-A @ RK-U @ COMPARE 0= IF NIP EXIT THEN ELSE DROP THEN
    DROP 1+ RH-R @ RH-CAP 1- AND
  AGAIN ;
: RH-POW2 ( n --- p )   1 BEGIN 2DUP > WHILE 2* REPEAT NIP ;
: RH-BUILD ( r cap --- )   \ a table of cap slots for every key r has
  OVER 3 CELLS + !  DUP RH-CAP CELLS R-ALLOT DUP 2 PICK RH-CAP CELLS ERASE OVER 2 CELLS + !
  DUP @ R-LEN 0 ?DO  DUP @ I R-AT R-UNBOX DROP OVER RH-PROBE  I 1+ SWAP !  LOOP DROP ;
: RH-MAINTAIN ( r --- )   \ a key was added: past G-RECHASH keys a table, kept at most half full
  G-RECHASH 0= IF DROP EXIT THEN
  DUP @ R-LEN                                                  ( r n )
  OVER RH-TABLE 0= IF  DUP G-RECHASH > IF 4 * RH-POW2 RH-BUILD ELSE 2DROP THEN EXIT  THEN
  DUP 2* 2 PICK RH-CAP > IF 4 * RH-POW2 RH-BUILD EXIT THEN
  1- >R  DUP @ R@ R-AT R-UNBOX DROP OVER RH-PROBE  R> 1+ SWAP !  DROP ;
: R-FIND-LINEAR ( key r --- i | -1 )   \ key a text
  SWAP DUP CELL+ RK-A ! @ RK-U !  R-KEYS DUP @ SWAP 2 CELLS + @ SWAP      \ 775: each key's bytes compared in place
  0 ?DO  DUP I CELLS + @ CELL+ @  DUP @ RK-U @ = IF CELL+ RK-U @ RK-A @ RK-U @ COMPARE 0= IF DROP I UNLOOP EXIT THEN ELSE DROP THEN  LOOP
  DROP -1 ;
: R-FIND ( key r --- i | -1 )   \ through the table when the record has one
  DUP RH-TABLE IF RH-PROBE @ 1- EXIT THEN  R-FIND-LINEAR ;
: R-PUT ( box key r --- )
  2DUP R-FIND DUP 0< IF  DROP  >R K-TEXT R-BOX R@ R-KEYS R-PUSH  R@ R-VALS R-PUSH  R>
    RH-MAINTAIN
    EXIT  THEN
  ROT DROP SWAP R-VALS SWAP R-SET ;
: R-GET ( key r --- box )
  2DUP R-FIND DUP 0< IF DROP DROP R-ERR> ." cm: no field " R-TYPE R-ERR-NL -4003 THROW THEN  ROT DROP SWAP R-VALS SWAP R-AT ;
: R-HAS ( key r --- f )   R-FIND 0< 0= ;
: R-DEL ( l i --- )   \ the item at i taken out, those after it moved down: in place (905)
  OVER @ OVER U> 0= IF R-INDEX THEN
  >R DUP R-ITEMS R@ 1+ CELLS +  OVER R-ITEMS R@ CELLS +  2 PICK @ R> - 1- CELLS MOVE  -1 SWAP +! ;
: R-REC-DEL ( key r --- )   \ a key and its value taken out; its table, if it has one, made again (905)
  2DUP R-FIND DUP 0< IF DROP DROP R-ERR> ." cm: no field " R-TYPE R-ERR-NL -4003 THROW THEN
  ROT DROP  2DUP SWAP R-KEYS SWAP R-DEL  OVER R-VALS SWAP R-DEL
  DUP RH-TABLE IF DUP RH-CAP RH-BUILD ELSE DROP THEN ;
