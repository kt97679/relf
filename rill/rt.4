    OVER SP-U @ SP-A @ SP-U @ COMPARE 0= IF DROP R> - EXIT THEN  1 /STRING
  REPEAT 2DROP R> DROP -1 ;
: R-SPLIT ( t sep --- l )   \ split(text, sep): the pieces between seps, empty ones kept - Python's
  R-T@ DUP 0= ABORT" rill: split by an empty text" SP-U ! SP-A !  R-NEW-LIST SP-L !  R-T@
  BEGIN 2DUP SP-FIND DUP 0< 0= WHILE
    >R OVER R@ R-TEXT K-TEXT R-BOX SP-L @ R-PUSH  R> SP-U @ + /STRING
  REPEAT DROP  R-TEXT K-TEXT R-BOX SP-L @ R-PUSH  SP-L @ ;
: R-IN-ANY ( box cbox --- f )   \ in, the container an item: a record's keys or a list's items
  R-UNBOX K-REC = IF SWAP R-ANY>TEXT SWAP R-HAS ELSE R-IN THEN ;
: R-ASSIGN-ANY ( vbox kbox cbox --- )   \ x[k] = v, x an item: a record's field or a list's item
  R-UNBOX K-REC = IF SWAP R-ANY>TEXT SWAP R-PUT ELSE SWAP R-ANY>NUM R-SET THEN ;
: R-BOOL>TEXT ( f --- t )   IF S" true" ELSE S" false" THEN R-TEXT ;   \ a bool as text (759)

\ ---- What the third pilot needs (Iteration 760) ----------------------------
: R-CONTAINS ( t s --- f )   \ contains(text, part)
