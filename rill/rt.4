\ ---- Glob patterns (Iteration 783): case's arms, as the shell's: * ? [...] and \ ----------
VARIABLE GL-T  VARIABLE GL-N  VARIABLE GL-P  VARIABLE GL-M  VARIABLE GL-I  VARIABLE GL-J  VARIABLE GL-ST  VARIABLE GL-MK
VARIABLE GC-C  VARIABLE GC-NEG  VARIABLE GC-HIT  VARIABLE GC-K0
: GL-PC ( j --- c )   GL-P @ + C@ ;
: GL-CLASS ( c j --- j' f )   \ the class whose [ is at j, against c: j' past its ], and whether c is in it - j' 0 if it never closes
  SWAP GC-C !  1+  0 GC-NEG ! 0 GC-HIT !
  DUP GL-M @ < IF DUP GL-PC DUP [CHAR] ! = SWAP [CHAR] ^ = OR IF -1 GC-NEG ! 1+ THEN THEN
  DUP GC-K0 !
  BEGIN DUP GL-M @ < WHILE
    DUP GL-PC [CHAR] ] = OVER GC-K0 @ <> AND IF 1+ GC-HIT @ GC-NEG @ XOR EXIT THEN
    DUP 2 + GL-M @ < IF DUP 1+ GL-PC [CHAR] - = OVER 2 + GL-PC [CHAR] ] <> AND ELSE 0 THEN IF
      DUP GL-PC GC-C @ > 0= OVER 2 + GL-PC GC-C @ < 0= AND IF -1 GC-HIT ! THEN 3 +
    ELSE DUP GL-PC GC-C @ = IF -1 GC-HIT ! THEN 1+ THEN
  REPEAT DROP 0 0 ;
: GL-STEP? ( --- f )   \ the pattern at J takes the text's character at I: both moved past
  GL-J @ GL-M @ < 0= IF 0 EXIT THEN
  GL-I @ GL-T @ + C@  GL-J @ GL-PC
  DUP [CHAR] ? = IF 2DROP 1 GL-I +! 1 GL-J +! -1 EXIT THEN
  DUP [CHAR] [ = IF DROP GL-J @ GL-CLASS OVER IF IF GL-J ! 1 GL-I +! -1 ELSE DROP 0 THEN EXIT THEN
    2DROP GL-I @ GL-T @ + C@ [CHAR] [ THEN
  DUP [CHAR] \ = GL-J @ 1+ GL-M @ < AND IF DROP 1 GL-J +! GL-J @ GL-PC THEN
  = IF 1 GL-I +! 1 GL-J +! -1 ELSE 0 THEN ;
: R-GLOB? ( t pat --- f )   \ the whole text matches the pattern
  R-T@ GL-M ! GL-P !  R-T@ GL-N ! GL-T !  0 GL-I ! 0 GL-J ! -1 GL-ST ! 0 GL-MK !
  BEGIN GL-I @ GL-N @ < WHILE
    GL-J @ GL-M @ < IF GL-J @ GL-PC [CHAR] * = ELSE 0 THEN IF
      GL-J @ GL-ST !  GL-I @ GL-MK !  1 GL-J +!
    ELSE GL-STEP? 0= IF
      GL-ST @ 0< IF 0 EXIT THEN
      GL-ST @ 1+ GL-J !  1 GL-MK +!  GL-MK @ GL-I !
    THEN THEN
  REPEAT
  BEGIN GL-J @ GL-M @ < IF GL-J @ GL-PC [CHAR] * = ELSE 0 THEN WHILE 1 GL-J +! REPEAT
  GL-J @ GL-M @ = ;

: R-ANY-CMP ( box1 box2 --- n )   \ two items in order: texts by their bytes, numbers and decimals by value; a text and a number cannot be (786)
  OVER R-UNBOX NIP K-TEXT =  OVER R-UNBOX NIP K-TEXT =  2DUP AND IF 2DROP R-ANY>TEXT >R R-ANY>TEXT R> R-TCMP EXIT THEN
  OR IF ." rill: a text and a number cannot be put in order" R-ERR-NL -4001 THROW THEN
  R-ANY>DEC >R R-ANY>DEC R>  2DUP < IF 2DROP -1 ELSE > IF 1 ELSE 0 THEN THEN ;

: R-CAP-JOIN ( t1 t2 --- t )   \ $(a ?? b): the two captures as one - a line break between when both said something, as the shell keeps it (787)
  OVER R-T@ NIP 0= IF NIP EXIT THEN  DUP R-T@ NIP 0= IF DROP EXIT THEN
  S"  " R-TEXT DUP R-T@ DROP 10 SWAP C!  SWAP 3 R-CONCAT ;

: R-DOT ( box name --- box )   \ "$x.f" with x an item: a record's field; anything else, its text then .f - as the shell reads "$x.f" (787)
  OVER R-UNBOX NIP K-REC = IF SWAP R-UNBOX DROP R-GET EXIT THEN
  >R R-ANY>TEXT S" ." R-TEXT R> 3 R-CONCAT K-TEXT R-BOX ;

\ ---- Arithmetic and order on items (Iteration 790): a decimal in either side, decimals; else numbers, as Python's ----
: R-NUM-OR-DEC ( box --- v dec? )   DUP R-UNBOX NIP K-DEC = IF R-UNBOX DROP -1 ELSE R-ANY>NUM 0 THEN ;
: R-CMP-AN ( box n --- v1 v2 )   >R R-NUM-OR-DEC IF R> R-N>D ELSE R> THEN ;      \ an item against a number, on one scale
: R-CMP-NA ( n box --- v1 v2 )   R-NUM-OR-DEC IF SWAP R-N>D SWAP THEN ;
: R-ANY-LEN ( box --- n )   R-UNBOX K-REC = IF R-KEYS THEN @ ;   \ len() of an item: a record's fields counted (799)
: R-ANY-ABS ( box --- box )   R-NUM-OR-DEC IF ABS K-DEC ELSE ABS K-NUM THEN R-BOX ;   \ abs() of an item (799)
VARIABLE AR-OP
: AR-DEC ( v dec? --- d )   0= IF R-N>D THEN ;
: R-ARITH ( v1 dec1 v2 dec2 op --- box )   \ op 0 + 1 - 2 * 3 / 4 %: a decimal if either is one, else a number
  AR-OP !  2 PICK OVER OR IF
    AR-DEC >R AR-DEC R>
    AR-OP @ CASE 0 OF R-ADD ENDOF 1 OF R-MINUS ENDOF 2 OF R-DMUL ENDOF 3 OF R-DDIV ENDOF >R R-MODC R> ENDCASE K-DEC R-BOX
  ELSE DROP NIP
    AR-OP @ CASE 0 OF R-ADD ENDOF 1 OF R-MINUS ENDOF 2 OF R-MUL ENDOF 3 OF R-DIV ENDOF >R R-MODC R> ENDCASE K-NUM R-BOX
  THEN ;
: R-ARITH-AN ( box n op --- box )   >R >R R-NUM-OR-DEC R> 0 R> R-ARITH ;
: R-ARITH-NA ( n box op --- box )   >R R-NUM-OR-DEC ROT 0 2SWAP R> R-ARITH ;
: R-LIST-CAT ( l1 l2 --- l )   >R R-NEW-LIST TUCK SWAP R-EXTEND DUP R> R-EXTEND ;   \ l1 + l2: a new list (798)
: R-ARITH-AA ( box box op --- box )
  DUP 0= IF >R  OVER R-UNBOX NIP OVER R-UNBOX NIP                  \ +: two texts joined, two lists joined (798)
    2DUP K-TEXT = SWAP K-TEXT = AND IF 2DROP R> DROP SWAP R-ANY>TEXT SWAP R-ANY>TEXT 2 R-CONCAT K-TEXT R-BOX EXIT THEN
    K-LIST = SWAP K-LIST = AND IF R> DROP R-UNBOX DROP SWAP R-UNBOX DROP SWAP R-LIST-CAT K-LIST R-BOX EXIT THEN
    R> THEN
  >R >R R-NUM-OR-DEC R> R-NUM-OR-DEC R> R-ARITH ;
: R-DEL-L ( l i --- )   \ the item at i (0 to n-1) out
  >R  DUP R-ITEMS R@ 1+ CELLS +  OVER R-ITEMS R@ CELLS +  2 PICK @ R@ - 1- CELLS MOVE  R> DROP  -1 SWAP +! ;
: R-AS-LIST ( box --- l )   R-UNBOX K-LIST <> IF ." rill: a spread needs a list" R-ERR-NL -4002 THROW THEN ;   \ @name of an item (799)
: R-POP-L ( l i --- box )   \ pop(list, i): the item at i, out; negative from the end (799)
  DUP 0< IF OVER @ + THEN
  DUP 0< OVER 3 PICK @ < 0= OR IF ." rill: pop: no item " . ." in a list of " @ R-.N R-ERR-NL -4002 THROW THEN
  2DUP R-AT >R R-DEL-L R> ;
: R-DEL-R ( r key --- )   \ its field out
  2DUP SWAP R-FIND DUP 0< IF DROP NIP ." rill: no field " R-T@ TYPE R-ERR-NL -4002 THROW THEN
  NIP  OVER R-KEYS OVER R-DEL-L  OVER R-VALS SWAP R-DEL-L
\ [gene rechash]
  DUP RH-TABLE IF DUP RH-CAP RH-BUILD ELSE DROP THEN      \ the table's slots counted the old places: made again
\ [/gene]
\ [gene !rechash]
  DROP
\ [/gene]
  ;
: R-POP-R ( r key --- box )   2DUP 0 R-AT-OR >R R-DEL-R R> ;   \ pop(record, key): its field's value, out (799)
: R-POP-ANY ( box kbox --- box )   \ pop() on an item: a list's item or a record's field (799)
  SWAP R-UNBOX DUP K-REC = IF DROP SWAP R-ANY>TEXT R-POP-R EXIT THEN
  K-LIST <> IF ." rill: pop needs a list or a record" R-ERR-NL -4002 THROW THEN  SWAP R-ANY>NUM R-POP-L ;
: R-FIND-L ( l box --- n )   \ find(list, x): x's first index, or -1 (798)
  SWAP DUP @ 0 ?DO DUP I R-AT 2 PICK R-BOX= IF 2DROP I UNLOOP EXIT THEN LOOP 2DROP -1 ;
: R-FIND-ANY ( box xbox --- n )   SWAP R-UNBOX K-LIST = IF SWAP R-FIND-L ELSE SWAP R-ANY>TEXT R-FIND-T THEN ;
VARIABLE SBL-F  VARIABLE SBL-D
: SBL-KEY ( box --- box )   R-UNBOX DROP SBL-F @ SWAP R-GET ;
: SBL-CMP ( b1 b2 --- n )   SBL-KEY SWAP SBL-KEY SWAP R-CMP  SBL-D @ IF NEGATE THEN ;
: R-SORT-BY-L ( l field order --- l2 )   \ sort-by(list, field, asc|desc): its records by that field, stable (798)
  S" desc" R-TEXT R-T= SBL-D !  SBL-F !
  R-NEW-LIST SRT !  DUP R-LEN 0 ?DO DUP I R-AT SRT @ R-PUSH LOOP DROP
  SRT @ R-LEN 1 MAX 1 ?DO
    SRT @ I R-AT  I
    BEGIN DUP 0> IF OVER SRT @ 2 PICK 1- R-AT SBL-CMP 0< ELSE 0 THEN WHILE
      SRT @ OVER 1- R-AT SRT @ 2 PICK R-SET 1-
    REPEAT  SRT @ SWAP R-SET
  LOOP SRT @ ;
: R-ANY-NEG ( box --- box )   R-NUM-OR-DEC IF NEGATE K-DEC ELSE NEGATE K-NUM THEN R-BOX ;   \ - item: its kind kept (796)
: R-SUM ( l --- box )   \ sum(list): a decimal among them, a decimal (794: they were taken as whole numbers)
  0 K-NUM R-BOX SWAP  DUP R-LEN 0 ?DO DUP I R-AT ROT SWAP 0 R-ARITH-AA SWAP LOOP DROP ;

\ ---- Showing a value (Iteration 793): a list or a record inside another, and any record, as Rill writes them -
\ texts quoted, lists [a b], records {k: v, ...}. A list on its own stays its items with a blank between.
VARIABLE SH-B  VARIABLE SH-N  VARIABLE SH-CAP  CREATE SH-C 1 ALLOT
: SH-ROOM ( u --- )   SH-N @ + DUP SH-CAP @ > 0= IF DROP EXIT THEN  2* 256 MAX DUP SH-CAP !  SH-B @ ?DUP IF SWAP RESIZE ELSE ALLOCATE THEN THROW SH-B ! ;
: SH-ADD ( a u --- )   DUP SH-ROOM  TUCK SH-B @ SH-N @ + SWAP MOVE  SH-N +! ;
: SH-CH ( c --- )   SH-C C!  SH-C 1 SH-ADD ;
: R-SHOW-TEXT ( t --- t' )   \ "...": \ before " and \, \n and \t for line ends and tabs
  0 SH-N !  [CHAR] " SH-CH
  R-T@ 0 ?DO DUP I + C@ CASE
      [CHAR] " OF [CHAR] \ SH-CH [CHAR] " SH-CH ENDOF
      [CHAR] \ OF [CHAR] \ SH-CH [CHAR] \ SH-CH ENDOF
      10 OF [CHAR] \ SH-CH [CHAR] n SH-CH ENDOF
      9 OF [CHAR] \ SH-CH [CHAR] t SH-CH ENDOF
      DUP SH-CH
    ENDCASE LOOP DROP
  [CHAR] " SH-CH  SH-B @ SH-N @ R-TEXT ;
: SH-NC? ( c --- f )   DUP [CHAR] _ = OVER [CHAR] - = OR OVER [CHAR] 0 [CHAR] 9 1+ WITHIN OR SWAP 32 OR [CHAR] a [CHAR] z 1+ WITHIN OR ;
: SH-NAME? ( a u --- f )   \ a field name written bare: a letter or _ first, then letters, digits, _ and -
  DUP 0= IF 2DROP 0 EXIT THEN
  OVER C@ DUP [CHAR] _ = SWAP 32 OR [CHAR] a [CHAR] z 1+ WITHIN OR 0= IF 2DROP 0 EXIT THEN
  0 ?DO DUP I + C@ SH-NC? 0= IF DROP 0 UNLOOP EXIT THEN LOOP DROP -1 ;
: R-SHOW-KEY ( t --- t' )   DUP R-T@ SH-NAME? IF EXIT THEN  R-SHOW-TEXT ;
: R-SHOW-LIST ( l --- t )   \ [a b c]
  R-NEW-LIST SWAP  DUP @ 0 ?DO DUP I R-AT R-SHOW-D K-TEXT R-BOX 2 PICK R-PUSH LOOP DROP
  S"  " R-TEXT R-JOIN  S" [" R-TEXT SWAP S" ]" R-TEXT 3 R-CONCAT ;
: R-SHOW-REC ( r --- t )   \ {k: v, ...}
  R-NEW-LIST SWAP
  DUP R-KEYS @ 0 ?DO
    DUP R-KEYS I R-AT R-ANY>TEXT R-SHOW-KEY  S" : " R-TEXT  2 PICK R-VALS I R-AT R-SHOW-D  3 R-CONCAT
    K-TEXT R-BOX 2 PICK R-PUSH
  LOOP DROP
  S" , " R-TEXT R-JOIN  S" {" R-TEXT SWAP S" }" R-TEXT 3 R-CONCAT ;
: R-SHOW ( box --- t )   \ a value as Rill writes it
  DUP R-UNBOX NIP
  DUP K-TEXT = IF DROP R-ANY>TEXT R-SHOW-TEXT EXIT THEN
  DUP K-LIST = IF DROP R-UNBOX DROP R-SHOW-LIST EXIT THEN
  K-REC = IF R-UNBOX DROP R-SHOW-REC EXIT THEN
  R-ANY>TEXT ;
' R-SHOW IS R-SHOW-D
: R-CONT>TEXT ( v kind --- t )   K-LIST = IF S"  " R-TEXT R-JOIN ELSE R-SHOW-REC THEN ;
' R-CONT>TEXT IS R-CONT>TEXT-D

\ ---- glob (Iteration 786) -------------------------------------------------
\ glob(pattern): the paths it matches, sorted - * ? [...] in its last part, the directories before
\ it as written; a name starting with . only for a pattern that does; . and .. never. No wildcard:
\ the path itself, if it is there. None: an empty list, as Python's.
: GB-WILD? ( a u --- f )   0 ?DO DUP I + C@ DUP [CHAR] * = OVER [CHAR] ? = OR SWAP [CHAR] [ = OR IF DROP -1 UNLOOP EXIT THEN LOOP DROP 0 ;
: GB-SPLIT ( t --- dir comp )   \ the pattern's directory ("" for none, "/" for the root) and its last part
  R-T@ DUP BEGIN DUP WHILE 1- 2 PICK OVER + C@ [CHAR] / = IF
      >R  OVER R@ DUP 0= IF 1+ THEN R-TEXT  ROT ROT R@ 1+ /STRING R-TEXT  R> DROP EXIT THEN
    REPEAT DROP  S" " R-TEXT ROT ROT R-TEXT ;
: GB-JOIN ( dir name --- t )   \ dir/name; the name alone for the dir ""
  OVER R-T@ NIP 0= IF NIP EXIT THEN
  OVER R-T@ + 1- C@ [CHAR] / = IF 2 R-CONCAT ELSE S" /" R-TEXT SWAP 3 R-CONCAT THEN ;
VARIABLE GB-DIR  VARIABLE GB-COMP  VARIABLE GB-OUT  VARIABLE GB-P
: GB-LIST ( dir comp out --- )   \ the entries of dir that comp matches, pushed onto out as dir/name
  GB-OUT ! GB-COMP ! GB-DIR !
  GB-DIR @ R-T@ NIP IF GB-DIR @ ELSE S" ." R-TEXT THEN R-CSTR OPEN-DIR ?DUP 0= IF EXIT THEN GB-P !
  BEGIN GB-P @ READ-DIR ?DUP WHILE
    DUP CSTRLEN R-TEXT
    DUP R-T@ S" ." COMPARE 0= OVER R-T@ S" .." COMPARE 0= OR
    OVER R-T@ DROP C@ [CHAR] . =  GB-COMP @ R-T@ DROP C@ [CHAR] . <> AND OR
    IF DROP ELSE DUP GB-COMP @ R-GLOB? IF GB-DIR @ SWAP GB-JOIN K-TEXT R-BOX GB-OUT @ R-PUSH ELSE DROP THEN THEN
  REPEAT GB-P @ CLOSE-DIR ;
: R-GLOB ( pattern --- list )
  R-NEW-LIST SWAP
  DUP R-T@ NIP 0= IF DROP EXIT THEN
  DUP R-T@ GB-WILD? 0= IF DUP R-CSTR FILE-KIND IF K-TEXT R-BOX OVER R-PUSH ELSE DROP THEN EXIT THEN
  GB-SPLIT 2 PICK GB-LIST  R-SORT ;

