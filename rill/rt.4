: R-TEXT>DEC ( t --- d )   \ decimal(text): "1.021" -> 1021000, "-0.5" -> -500000, "7" -> 7000000
  R-T@ OVER C@ [CHAR] - = DUP >R IF 1 /STRING THEN
  2DUP [CHAR] . SCAN                                          ( a u a2 u2 )
  2SWAP DROP 2 PICK OVER -                                    ( a2 u2 a ulen )
  0 0 2SWAP >NUMBER 2DROP DROP 1000000 *                      ( a2 u2 whole )
  ROT ROT DUP IF 1 /STRING THEN                                  ( whole fa fu )
  0 6 0 DO 10 * OVER I > IF 2 PICK I + C@ [CHAR] 0 - + THEN LOOP NIP NIP
  +  R> IF NEGATE THEN ;
693147181 CONSTANT R-LN2   \ at 10^9, the scale log and exp work in before rounding to 10^6
: R-LOG ( d --- d2 )   \ log(x), natural, fixed point: x = m 2^k, ln m = 2 atanh((m-1)/(m+1))
  DUP 0> 0= ABORT" rill: log of a number not above 0"
  0 SWAP  BEGIN DUP 2000000 < 0= WHILE 2/ SWAP 1+ SWAP REPEAT
  BEGIN DUP 1000000 < WHILE 2* SWAP 1- SWAP REPEAT             ( k m )
  1000 *  DUP 1000000000 - 1000000000 ROT 1000000000 + */     ( k y, at 10^9 )
  DUP DUP 1000000000 */                                       ( k y y2 )
  SWAP 0 SWAP 1                                               ( k y2 sum term n )
  BEGIN OVER WHILE  2DUP / >R ROT R> + ROT ROT  SWAP 3 PICK 1000000000 */ SWAP 2 +  REPEAT
  2DROP NIP 2*  SWAP R-LN2 * +  DUP 0< IF NEGATE 500 + 1000 / NEGATE ELSE 500 + 1000 / THEN ;
