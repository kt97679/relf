\ A pipeline: PL-BEGIN, a PL-STAGE a command (the last with a true
\ flag), PL-END. Every pipe end is listed, and each child closes them
\ all once its own are on 0 and 1 - or a reader would never see the end.
64 CONSTANT PL-MAX                                 \ a pipeline's programs: 16 until 891
PL-MAX CELLS BUFFER: PL-PIDS   VARIABLE PL-NP
PL-MAX 2* 2 + CELLS BUFFER: PL-FDS   VARIABLE PL-NF
VARIABLE PL-PREV  VARIABLE PL-CAPW  VARIABLE PL-CAPR
VARIABLE PL-IN  VARIABLE PL-OUT  VARIABLE PL-NEXT  VARIABLE PL-OWN
: PL-FD+ ( fd --- )   PL-FDS PL-NF @ CELLS + !  1 PL-NF +! ;
\ A stage's argument can run a pipeline of its own - $(...) or code((...)) in it (795): the pipeline being made
\ is put aside, in the C heap, while that one runs, and back when it ends - its pids, pipe ends, redirections.
VARIABLE PL-DEPTH   VARIABLE PL-SAVED
15 CONSTANT PL-NPARTS
: PL-PART ( i --- addr cells )   \ named as it runs: a BUFFER: has its memory from ALLOC-BUFFERS at boot, not from the build
  CASE  0 OF PL-PIDS PL-MAX ENDOF  1 OF PL-FDS PL-MAX 2* 2 + ENDOF  2 OF RR-T RR-MAX ENDOF  3 OF RR-M RR-MAX ENDOF  4 OF RR-F RR-MAX ENDOF
        5 OF PL-NP 1 ENDOF  6 OF PL-NF 1 ENDOF  7 OF PL-PREV 1 ENDOF  8 OF PL-CAPW 1 ENDOF  9 OF PL-CAPR 1 ENDOF
        10 OF PL-IN 1 ENDOF  11 OF PL-OUT 1 ENDOF  12 OF PL-NEXT 1 ENDOF  13 OF PL-OWN 1 ENDOF  14 OF RR-N 1 ENDOF
  ENDCASE ;
: PL-STATE-CELLS ( --- n )   0 PL-NPARTS 0 DO I PL-PART NIP + LOOP 1+ ;
: PL-SAVE ( --- )
  PL-STATE-CELLS CELLS ALLOCATE THROW  PL-SAVED @ OVER !  DUP PL-SAVED !  CELL+
  PL-NPARTS 0 DO  I PL-PART >R  OVER R@ CELLS MOVE  R> CELLS +  LOOP DROP ;
: PL-RESTORE ( --- )
  PL-SAVED @ DUP @ PL-SAVED !  DUP >R CELL+
  PL-NPARTS 0 DO  I PL-PART >R  OVER SWAP R@ CELLS MOVE  R> CELLS +  LOOP DROP  R> FREE DROP ;
: PL-BEGIN ( capture? --- )   \ 2: captured if a $( ) is being made - its stdout read into that text (896)
  DUP 2 = IF DROP CT-ON @ THEN
  PL-DEPTH @ IF PL-SAVE THEN  1 PL-DEPTH +!                 \ inside another's arguments: that one put aside (795)
  0 PL-NP !  0 PL-NF !  -1 PL-PREV !  -1 PL-CAPW !  -1 PL-CAPR !  R-RD-RESET
  IF  PIPE THROW  DUP PL-CAPW ! PL-FD+  DUP PL-CAPR ! PL-FD+  THEN ;
: PL-CHILD ( in out --- )
  DUP -1 <> IF 1 DUP2 DROP ELSE DROP THEN
  DUP -1 <> IF 0 DUP2 DROP ELSE DROP THEN
  PL-NF @ 0 ?DO  PL-FDS I CELLS + @ CLOSE-FILE DROP  LOOP
  R-RD-APPLY ;
: R-ARGV-L ( l --- argv )   \ a list's items, as texts, a NUL-ended vector: "env", what setenv set (870), the words (744)
  DUP R-LEN DUP RV-N !  2 + SE-N @ + CELLS R-ALLOT RV-V !
  0  RV-V @ RV-N @ SE-N @ + 1+ CELLS + !
  RV-N @ 0 ?DO  DUP I R-AT R-ANY>TEXT R-CSTR  RV-V @ I SE-N @ + 1+ CELLS + !  LOOP DROP
  SE-N @ 0 ?DO  I CELLS SE-A + @  RV-V @ I 1+ CELLS + !  LOOP
  S" env" R-TEXT R-CSTR RV-V @ !  RV-V @ ;
: PL-STAGE-V ( argv last? --- )   \ PL-MAX stages at most: past it had written over the next buffers (891)
  PL-NP @ PL-MAX = IF R-ERR> ." cm: a pipeline of more than 64 programs" R-ERR-NL -4004 THROW THEN
  >R  PL-PREV @ PL-IN !  -1 PL-NEXT !  0 PL-OWN !
  R> IF  PL-CAPW @ PL-OUT !
  ELSE  PIPE THROW  DUP PL-FD+ PL-OUT !  DUP PL-FD+ PL-NEXT !  -1 PL-OWN !  THEN
  FORK DUP 0= IF  DROP  PL-IN @ PL-OUT @ PL-CHILD  R-EXECV  THEN
  PL-PIDS PL-NP @ CELLS + !  1 PL-NP +!  DROP
  PL-IN @ -1 <> IF  PL-IN @ CLOSE-FILE DROP  THEN
  PL-OWN @ IF  PL-OUT @ CLOSE-FILE DROP  THEN
  PL-NEXT @ PL-PREV !  R-RD-RESET ;

: PL-STAGE-L ( argl last? --- )   >R R-ARGV-L R> PL-STAGE-V ;

: R-READ-ALL ( fd --- t )   \ to its end, one text; one trailing newline off
  >R  R-TOP @ ALIGNED DUP R-TOP !  DUP CELL+                 ( t p )
  BEGIN
    DUP 65536 + R-END @ U> IF R-READ-GROW THEN
    DUP 65536 R@ READ-SOME DUP 0>
  WHILE + REPEAT  DROP R> DROP                                ( t end )
  OVER CELL+ -                                                ( t len )
  DUP IF  OVER CELL+ OVER + 1- C@ 10 = IF 1- THEN  THEN
  OVER !  DUP @ CELL+ ALIGNED OVER + R-TOP ! ;
: PL-END ( --- [t] status )   \ t when captured; the status: the rightmost stage that failed, as bash's pipefail (795)
  PL-CAPR @ -1 <> IF
    PL-CAPW @ CLOSE-FILE DROP  PL-CAPR @ R-READ-ALL  PL-CAPR @ CLOSE-FILE DROP
  THEN
  0  PL-NP @ 0 ?DO
    PL-PIDS I CELLS + @ R-WAIT R-DECODE
    DUP 141 = I PL-NP @ 1- < AND IF DROP 0 THEN      \ a stage its reader stopped reading (SIGPIPE): not a failure
    ?DUP IF NIP THEN
  LOOP
  -1 PL-DEPTH +!  PL-DEPTH @ IF PL-RESTORE THEN ;            \ the pipeline put aside, back (795)

