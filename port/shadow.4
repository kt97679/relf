\ port/shadow.4 - forth/shadow.4's locals, DEFER and IS for a Forth that is not relf.
\
\ relf's shadow.4 compiles each save, store and restore as one of the
\ engine's locals opcodes (LSAVE, L!, LZERO, LRESTORE), laid by the CV8
\ compiler's own words. A host Forth has neither, so here a definition's
\ saves and restores are a frame of a save stack in Forth, compiled inline. The syntax and the meaning are
\ relf's: SHADOW{ a b | c } saves a b c on entry, stores the two
\ arguments into a and b, zeroes c, and EXIT and ; restore all three on
\ every way out. As in relf, a THROW past a word does not unwind the save
\ stack.

BASE @  DECIMAL

: DEFER ( "name" --- )
  CREATE 0 ,
  DOES> DUP @ 0= IF DROP EXIT THEN  @XT EXECUTE ;
: IS ( xt "name" --- )  ' >BODY !XT ;

: LOCALS-FAILED ( n --- )
  DUP 1 = ABORT" shadow: save stack overflow"
  2 = ABORT" shadow: save stack underflow" ;

4096 CONSTANT LSAVE-MAX              \ the engines' LSAVE_MAX
\ The save stack is allocated, as the engines' is theirs, not in the image:
\ the host's boot runs LSAVE-INIT, and so does this file, for the build.
\ LSAVE-PTR is its next free cell, LSAVE-LIM its end.
VARIABLE LSAVE-BASE   VARIABLE LSAVE-PTR   VARIABLE LSAVE-LIM
\ compiled by their xts (COMPILE,: a host may make a variable a literal),
\ kept as offsets: a forth command's SHADOW{ compiles them after boot too
VARIABLE LB-XT  ' LSAVE-BASE LB-XT !XT   VARIABLE LP-XT  ' LSAVE-PTR LP-XT !XT
VARIABLE LL-XT  ' LSAVE-LIM LL-XT !XT
: LSAVE-INIT ( --- )
  LSAVE-MAX CELLS ALLOCATE ABORT" shadow: no memory for the save stack"
  DUP LSAVE-BASE !  DUP LSAVE-PTR !  LSAVE-MAX CELLS + LSAVE-LIM ! ;
LSAVE-INIT

16 CONSTANT LDECL-MAX
CREATE LDECL-ADDRS  LDECL-MAX CELLS ALLOT
VARIABLE LDECL-N      0 LDECL-N !     \ names declared by the definition being compiled
VARIABLE LDECL-ARGS   0 LDECL-ARGS !  \ how many of them take a data-stack argument

\ What a definition's SHADOW{ compiles: one frame of the save stack, inline.
\ On entry the frame's end checked against LSAVE-LIM, each variable's value
\ stored into it, LSAVE-PTR moved past it, then the arguments stored into
\ their variables (the last name the stack's top) and the rest zeroed; at
\ every EXIT and ; the frame's start checked against LSAVE-BASE, LSAVE-PTR
\ moved back, each value fetched back. relf's engine does a slot at a time
\ (LSAVE, LRESTORE), with the same checks; here a call to a run-time word a
\ slot was 24 dispatches on a design, the frame inline about 6 a slot.
: L-VAR, ( i --- )  CELLS LDECL-ADDRS + @ COMPILE, ;   \ the i-th variable: its address
: L-NUM, ( n --- )  POSTPONE LITERAL ;
: L-OFF, ( i --- )  ?DUP IF CELLS L-NUM, POSTPONE + THEN ;   \ frame -> its i-th cell
: L-COMPILE-ENTRY ( --- )
  LDECL-N @ 0 > IF
    LP-XT @XT COMPILE, POSTPONE @                                ( frame )
    POSTPONE DUP LDECL-N @ CELLS L-NUM, POSTPONE +  LL-XT @XT COMPILE, POSTPONE @
    POSTPONE SWAP POSTPONE U< POSTPONE IF 1 L-NUM, POSTPONE LOCALS-FAILED POSTPONE THEN
    LDECL-N @ 0 DO
      I L-VAR, POSTPONE @ POSTPONE OVER I L-OFF, POSTPONE !
    LOOP
    LDECL-N @ CELLS L-NUM, POSTPONE +  LP-XT @XT COMPILE, POSTPONE !
  THEN
  LDECL-ARGS @ 0 > IF
    LDECL-ARGS @ 0 DO LDECL-ARGS @ 1- I - L-VAR, POSTPONE ! LOOP
  THEN
  LDECL-N @ LDECL-ARGS @ > IF
    LDECL-N @ LDECL-ARGS @ DO 0 L-NUM, I L-VAR, POSTPONE ! LOOP
  THEN ;

: L-COMPILE-RESTORES ( --- )
  LDECL-N @ 0 > IF
    LP-XT @XT COMPILE, POSTPONE @  LDECL-N @ CELLS NEGATE L-NUM, POSTPONE +   ( frame )
    POSTPONE DUP LB-XT @XT COMPILE, POSTPONE @
    POSTPONE U< POSTPONE IF 2 L-NUM, POSTPONE LOCALS-FAILED POSTPONE THEN
    POSTPONE DUP LP-XT @XT COMPILE, POSTPONE !
    LDECL-N @ 0 DO
      POSTPONE DUP I L-OFF, POSTPONE @ I L-VAR, POSTPONE !
    LOOP
    POSTPONE DROP
  THEN ;

: L-END? ( c-addr --- f )
  DUP C@ 1 <> IF DROP 0 EXIT THEN  1+ C@ [CHAR] } = ;
: L-BAR? ( c-addr --- f )
  DUP C@ 1 <> IF DROP 0 EXIT THEN  1+ C@ [CHAR] | = ;
: L-OUT? ( c-addr --- f )
  DUP C@ 2 <> IF DROP 0 EXIT THEN
  DUP 1+ C@ [CHAR] - = SWAP 2 + C@ [CHAR] - = AND ;

: L-ADD-NAME ( c-addr --- )
  LDECL-N @ LDECL-MAX < 0= ABORT" shadow: too many locals"
  FIND 0= ABORT" shadow: undefined local name"
  LDECL-ADDRS LDECL-N @ CELLS + !               \ its xt, compiled where it is used
  LDECL-N @ 1+ LDECL-N ! ;

: SHADOW{ ( --- )
  0 LDECL-N !
  -1 LDECL-ARGS !
  BEGIN
    BL WORD
    DUP C@ 0= ABORT" shadow: missing } on this line"
    DUP L-END? 0=
  WHILE
    DUP L-BAR? IF
      DROP LDECL-N @ LDECL-ARGS !
    ELSE DUP L-OUT? IF
      DROP
      BEGIN BL WORD
        DUP C@ 0= ABORT" shadow: missing } on this line"
        DUP L-END? 0=
      WHILE DROP REPEAT
      DROP
      LDECL-ARGS @ -1 = IF LDECL-N @ LDECL-ARGS ! THEN
      L-COMPILE-ENTRY EXIT
    ELSE
      L-ADD-NAME
    THEN THEN
  REPEAT
  DROP
  LDECL-ARGS @ -1 = IF LDECL-N @ LDECL-ARGS ! THEN
  L-COMPILE-ENTRY ; IMMEDIATE

: EXIT ( --- )
  L-COMPILE-RESTORES POSTPONE EXIT ; IMMEDIATE
: ; ( --- )
  L-COMPILE-RESTORES 0 LDECL-N ! 0 LDECL-ARGS ! POSTPONE ; ; IMMEDIATE

BASE !
