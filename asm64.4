\ asm64.4 - an x86-64 assembler written in Forth (SELF-HOSTING.md).
\
\ Iteration 541, M0: the encoder. The assembly engine, relfasm64.S, is
\ to be written in this and assembled by relf itself; tests/asm-corpus.txt
\ is what it has to match - every instruction shape the engine uses, with
\ the bytes GNU as made for it.
\
\ The syntax: operands in Intel's order - destination first - then the
\ mnemonic, with a comma so it never meets a Forth word of the same name:
\
\     rax [ r13 8 ] mov,          mov rax, [r13 + 8]
\     [ r14 ] byte-ptr 63 # cmp,  cmp byte ptr [r14], 63
\     rdx [ rcx rax *8 8 ] lea,   lea rdx, [rcx + rax*8 + 8]
\
\ A memory operand is written between [ and ]: registers, a register
\ scaled by *1 *2 *4 or *8 as the index, and numbers, summed into the
\ displacement. A size, where no register gives one, follows it.

VOCABULARY ASSEMBLER
ALSO ASSEMBLER DEFINITIONS
BASE @ DECIMAL

\ ---- where the bytes go -------------------------------------------------
VARIABLE ABUF      \ the buffer the code is laid down in
VARIABLE THERE     \ where the next byte goes, in the buffer
VARIABLE ORG       \ the address the buffer's first byte runs at
: ASM-BUFFER ( org size --- )
  ALLOCATE ABORT" asm64: no memory" DUP ABUF ! THERE !  ORG ! ;
: HERE-A ( --- addr ) THERE @ ABUF @ - ORG @ + ;   \ the next byte's address
: C,A ( c --- ) THERE @ C!  1 THERE +! ;
: W,A ( w --- ) DUP C,A 8 RSHIFT C,A ;
: L,A ( l --- ) DUP W,A 16 RSHIFT W,A ;
: Q,A ( q --- ) DUP L,A 32 RSHIFT L,A ;

\ ---- operands: one cell each, the kind in the top byte --------------------
82 56 LSHIFT CONSTANT T-REG      \ R: a register
88 56 LSHIFT CONSTANT T-IDX      \ X: a register scaled, as an index
73 56 LSHIFT CONSTANT T-IMM      \ I: an immediate, its value in IMM
77 56 LSHIFT CONSTANT T-MEM      \ M: the memory operand, in the M- variables
255 56 LSHIFT CONSTANT T-MASK
: KIND ( d --- k ) T-MASK AND ;
: REG? ( d --- f ) KIND T-REG = ;
: IMM? ( d --- f ) KIND T-IMM = ;
: MEM? ( d --- f ) KIND T-MEM = ;
: R# ( d --- n ) 15 AND ;                       \ the register's number
: RSIZE ( d --- s ) 4 RSHIFT 15 AND ;            \ in bytes
: REX8? ( d --- f ) 256 AND 0= 0= ;              \ spl bpl sil dil: need a REX
: MSIZE ( m --- s ) 15 AND ;                     \ a memory operand's size, 0 unsaid

: REG: ( n size "name" --- ) CREATE 4 LSHIFT OR T-REG OR , DOES> @ ;
 0 8 REG: rax   1 8 REG: rcx   2 8 REG: rdx   3 8 REG: rbx
 4 8 REG: rsp   5 8 REG: rbp   6 8 REG: rsi   7 8 REG: rdi
 8 8 REG: r8    9 8 REG: r9   10 8 REG: r10  11 8 REG: r11
12 8 REG: r12  13 8 REG: r13  14 8 REG: r14  15 8 REG: r15
 0 4 REG: eax   1 4 REG: ecx   2 4 REG: edx   3 4 REG: ebx
 4 4 REG: esp   5 4 REG: ebp   6 4 REG: esi   7 4 REG: edi
 8 4 REG: r8d   9 4 REG: r9d  10 4 REG: r10d 11 4 REG: r11d
12 4 REG: r12d 13 4 REG: r13d 14 4 REG: r14d 15 4 REG: r15d
 0 2 REG: ax    1 2 REG: cx    2 2 REG: dx    3 2 REG: bx
 6 2 REG: si    7 2 REG: di
 8 2 REG: r8w   9 2 REG: r9w  10 2 REG: r10w 11 2 REG: r11w
12 2 REG: r12w 13 2 REG: r13w 14 2 REG: r14w 15 2 REG: r15w
 0 1 REG: al    1 1 REG: cl    2 1 REG: dl    3 1 REG: bl
 4 1 REG: ah    5 1 REG: ch    6 1 REG: dh    7 1 REG: bh    \ never with a REX
260 1 REG: spl 261 1 REG: bpl 262 1 REG: sil 263 1 REG: dil
 8 1 REG: r8b   9 1 REG: r9b  10 1 REG: r10b 11 1 REG: r11b
12 1 REG: r12b 13 1 REG: r13b 14 1 REG: r14b 15 1 REG: r15b

: SCALE: ( log2 "name" --- )
  CREATE , DOES> @ 12 LSHIFT SWAP 255 AND OR T-IDX OR ;
0 SCALE: *1   1 SCALE: *2   2 SCALE: *4   3 SCALE: *8

VARIABLE IMM       \ the immediate
VARIABLE M-BASE    \ the memory operand: base register number, or -1
VARIABLE M-INDEX   \ index register number, or -1
VARIABLE M-SCALE   \ log2 of the scale
VARIABLE M-DISP    \ displacement
VARIABLE M-DEPTH   \ the stack depth at [
: byte-ptr  ( m --- m ) 1 OR ;
: word-ptr  ( m --- m ) 2 OR ;
: dword-ptr ( m --- m ) 4 OR ;
: qword-ptr ( m --- m ) 8 OR ;

\ ---- labels: one pass, forward references resolved as cross.4 does ------
\ (M1, Iteration 544.) LABEL name declares a label, as cross.4's FORWARD
\ declares a word; name L: defines it here. Used before it is defined, a
\ label is a forward reference: the jump lays down its displacement as a
\ placeholder and threads a fixup onto the label's list, and L: patches
\ them all. A forward jump is short unless NEAR is said before it - one
\ pass cannot know the distance - and a short one its label turns out too
\ far for is an error there, never a wrong byte. END-ASM names any label
\ declared and never defined, as cross.4's RESOLVE does.
70 56 LSHIFT CONSTANT T-FWD      \ F: a forward reference, a label's record
VARIABLE LABELS    \ every named label's record, linked, for END-ASM
VARIABLE NEAR?     \ set by NEAR for the next forward jump
VARIABLE LENIENT   \ set, a short jump too far is reported, not fatal: to
                   \ get a whole output to compare while debugging (M3)
VARIABLE #LABELS   \ how many named labels are declared
VARIABLE M-FWD     \ a forward label in the memory operand, or 0 (546)
: W! ( w a --- ) OVER 8 RSHIFT OVER 1+ C! C! ;
: DISP8? ( d --- f ) DUP -129 > SWAP 128 < AND ;
: L! ( l a --- ) 2DUP W! SWAP 16 RSHIFT SWAP 2 + W! ;
: NEAR ( --- ) -1 NEAR? ! ;
\ A label's record: its address (-1 until defined), its fixups' list, the
\ next named label. A fixup: the next one, where its displacement is in
\ the buffer, and how wide it is (1 or 4).
: RECORD, ( --- rec ) HERE -1 , 0 , 0 , ;
: LABEL ( "name" --- )
  CREATE RECORD, LABELS @ OVER 2 CELLS + !  LABELS !  1 #LABELS +!
  DOES> DUP @ -1 = IF T-FWD OR ELSE @ THEN ;
: FIXUP ( rec width addend --- ) \ next, where, width, addend
  >R >R CELL+ HERE OVER @ , THERE @ , R> , R> , SWAP ! ;
: PLACEHOLDER ( rec --- ) \ zeros of the width NEAR? says; a fixup for them
  NEAR? @ IF 4 0 FIXUP 0 L,A ELSE 1 0 FIXUP 0 C,A THEN  0 NEAR? ! ;
: PATCH ( fixup --- ) \ its displacement, now that the label is here
  DUP 2 CELLS + @ 8 = IF                    \ absolute, 64 bits: address + addend
    DUP 3 CELLS + @ HERE-A +  SWAP CELL+ @ ! EXIT THEN
  DUP 2 CELLS + @ 5 = IF                    \ absolute, 32 bits: a displacement
    DUP 3 CELLS + @ HERE-A +  SWAP CELL+ @ L! EXIT THEN
  DUP CELL+ @ SWAP 2 CELLS + @              ( buf width )
  OVER ABUF @ - ORG @ + OVER +              ( buf width next-ip )
  HERE-A SWAP -  SWAP 1 = IF                ( buf disp )
    DUP DISP8? 0= IF LENIENT @ IF CR ." asm64: a short jump does not reach, at " OVER ABUF @ - ORG @ + .
      ELSE TRUE ABORT" asm64: a short jump does not reach its label - say NEAR" THEN THEN
    SWAP C! EXIT THEN
  2DUP SWAP W!  16 RSHIFT SWAP 2 + W! ;
: RESOLVE ( rec --- ) \ here, and every fixup waiting for it patched
  HERE-A OVER !  CELL+ @  BEGIN ?DUP WHILE DUP PATCH @ REPEAT ;
: Q,+ ( target addend --- )
\ A 64-bit absolute value, a label's address plus addend - the ELF
\ header's entry point and sizes (Iteration 546). Forward too: then a
\ fixup of width 8, which PATCH knows for absolute.
  OVER KIND T-FWD = IF SWAP T-MASK INVERT AND 8 ROT FIXUP 0 Q,A EXIT THEN
  + Q,A ;
: L,+ ( target addend --- ) \ the same, 32 bits (a width-5 fixup)
  OVER KIND T-FWD = IF SWAP T-MASK INVERT AND 5 ROT FIXUP 0 L,A EXIT THEN
  + L,A ;
\ Numeric local labels, as GNU as has them: n L: defines one; n F is the
\ next n L: to come, n B the last one gone.
100 CONSTANT #LOCALS   \ local labels 0-99 - GNU as allows more digits than
                        \ one, and the engine uses 11: (the first 10 failed)
CREATE LOCAL-LAST #LOCALS CELLS ALLOT   CREATE LOCAL-NEXT #LOCALS CELLS ALLOT
LOCAL-NEXT #LOCALS CELLS 0 FILL  LOCAL-LAST #LOCALS CELLS 0 FILL
: F ( n --- target )
  CELLS LOCAL-NEXT + DUP @ 0= IF RECORD, OVER ! THEN @ T-FWD OR ;
: B ( n --- addr ) CELLS LOCAL-LAST + @ ;
: L: ( label | n --- ) \ define it here
  DUP #LOCALS U< IF                                \ a numeric local
    CELLS DUP LOCAL-NEXT + @ ?DUP IF RESOLVE THEN
    0 OVER LOCAL-NEXT + !  HERE-A SWAP LOCAL-LAST + ! EXIT THEN
  DUP KIND T-FWD <> ABORT" asm64: a label defined twice"
  T-MASK INVERT AND RESOLVE ;
: END-ASM ( --- ) \ every label declared must have been defined
  0 LABELS @ BEGIN ?DUP WHILE DUP @ -1 = IF SWAP 1+ SWAP THEN 2 CELLS + @ REPEAT
  ?DUP IF CR . ." asm64: labels declared and never defined" ABORT THEN ;

\ ---- the encoding ------------------------------------------------------
VARIABLE REX       \ W R X B as 8 4 2 1; 64 when a REX is needed anyway
VARIABLE OPSIZE    \ the operation's size in bytes
: OR! ( x a --- ) DUP @ ROT OR SWAP ! ;
: REX-R ( n --- ) 8 AND IF 4 REX OR! THEN ;
: REX-X ( n --- ) 8 AND IF 2 REX OR! THEN ;
: REX-B ( n --- ) 8 AND IF 1 REX OR! THEN ;
: REX-8 ( d --- ) DUP REG? IF REX8? IF 64 REX OR! THEN ELSE DROP THEN ;
: REX, ( --- ) REX @ IF REX @ 15 AND 64 OR C,A THEN ;
: OPC, ( op --- ) DUP 255 > IF DUP 8 RSHIFT C,A THEN 255 AND C,A ;
: MODRM, ( mod reg rm --- ) 7 AND SWAP 7 AND 3 LSHIFT OR SWAP 6 LSHIFT OR C,A ;
: MEM-REX ( --- )
  M-BASE @ 0< 0= IF M-BASE @ REX-B THEN
  M-INDEX @ 0< 0= IF M-INDEX @ REX-X THEN ;
: SIB, ( --- ) \ scale, index (4: none), base (5: none)
  M-SCALE @ 6 LSHIFT
  M-INDEX @ 0< IF 4 ELSE M-INDEX @ 7 AND THEN 3 LSHIFT OR
  M-BASE @ 0< IF 5 ELSE M-BASE @ 7 AND THEN OR C,A ;
: DISP32, ( --- ) \ the displacement; a fixup if a forward label is in it
  M-FWD @ ?DUP IF 5 M-DISP @ FIXUP 0 L,A 0 M-FWD ! EXIT THEN  M-DISP @ L,A ;
: MEM, ( reg --- )
\ ModRM, SIB and displacement for the memory operand, reg in the reg field
\ - as GNU as chooses them: an absolute address through a SIB with
\ neither base nor index; the shortest displacement that fits; rbp and
\ r13 as base always with one, rsp and r12 always through a SIB.
  M-BASE @ 0< IF 0 SWAP 4 MODRM, SIB, DISP32, EXIT THEN
  M-FWD @ IF 2 ELSE                            \ a forward label: 32 bits
  M-DISP @ 0= M-BASE @ 7 AND 5 <> AND IF 0 ELSE
    M-DISP @ DISP8? IF 1 ELSE 2 THEN THEN THEN  ( reg mod )
  DUP >R SWAP
  M-INDEX @ 0< M-BASE @ 7 AND 4 <> AND IF M-BASE @ MODRM, ELSE 4 MODRM, SIB, THEN
  R> DUP 1 = IF DROP M-DISP @ C,A EXIT THEN
  2 = IF DISP32, THEN ;
: SIZE-OF ( d --- s ) DUP REG? IF RSIZE ELSE MSIZE THEN ;
: PREFIX, ( --- ) OPSIZE @ 2 = IF 102 C,A THEN ;
: W? ( --- ) OPSIZE @ 8 = IF 8 REX OR! THEN ;

\ An operation on r/m with a register (or an opcode extension) in the reg
\ field: prefixes, REX, the opcode, ModRM and the rest. op8 is the
\ opcode for byte operands, op the one for the others; they differ by 1
\ where the byte form exists.
VARIABLE X-RM   VARIABLE X-REG   VARIABLE X-R8
: RM, ( rm reg# op --- )
  >R X-REG ! X-RM !  0 REX !  W?
  X-R8 @ IF 64 REX OR! THEN  0 X-R8 !      \ spl bpl sil dil in the reg field
  X-REG @ REX-R
  X-RM @ MEM? IF MEM-REX ELSE X-RM @ R# REX-B  X-RM @ REX-8 THEN
  PREFIX, REX, R> OPC,
  X-RM @ MEM? IF X-REG @ MEM, ELSE 3 X-REG @ X-RM @ R# MODRM, THEN ;
: RMR, ( rm reg op --- )   \ as RM, with a register in the reg field
  >R DUP REX8? IF -1 X-R8 ! THEN R# R> RM, ;
: OPSIZE! ( s --- ) OPSIZE ! ;
: BYTE? ( --- f ) OPSIZE @ 1 = ;

\ ---- the ALU group: add or adc sbb and sub xor cmp ----------------------
: IMM, ( --- ) \ an immediate of the operation's size, 4 at most
  OPSIZE @ 1 = IF IMM @ C,A EXIT THEN
  OPSIZE @ 2 = IF IMM @ W,A EXIT THEN  IMM @ L,A ;
: ALU ( dst src k --- )
  >R
  DUP IMM? IF DROP                                   \ r/m, imm
    DUP SIZE-OF OPSIZE!
    BYTE? IF DUP R# 0= OVER REG? AND IF DROP       \ al: the short form
        R> 8 * 4 + C,A IMM @ C,A EXIT THEN
      R> 128 RM, IMM, EXIT THEN
    IMM @ DISP8? IF R> 131 RM, IMM @ C,A EXIT THEN
    DUP REG? IF DUP R# 0= IF DROP                    \ the accumulator's short form
      0 REX ! W? PREFIX, REX, R> 8 * 5 + C,A IMM, EXIT THEN THEN
    R> 129 RM, IMM, EXIT THEN
  DUP MEM? IF                                        \ reg, r/m
    OVER SIZE-OF OPSIZE!  SWAP R> 8 * 2 + BYTE? 0= - RMR, EXIT THEN
  DUP SIZE-OF OPSIZE!  R> 8 * BYTE? 0= - RMR, ;      \ r/m, reg: the reg's size
: add, 0 ALU ;  : or, 1 ALU ;  : adc, 2 ALU ;  : sbb, 3 ALU ;
: and, 4 ALU ;  : sub, 5 ALU ;  : xor, 6 ALU ;  : cmp, 7 ALU ;

\ ---- mov -------------------------------------------------------------------
: mov, ( dst src --- )
  DUP IMM? IF DROP DUP SIZE-OF OPSIZE!
    DUP REG? IF
      OPSIZE @ 8 = IF IMM @ -2147483649 > IMM @ 2147483648 < AND IF
        0 199 RM, IMM @ L,A EXIT THEN                \ sign-extended imm32
        0 REX ! W? DUP R# REX-B REX, R# 184 + C,A IMM @ Q,A EXIT THEN
      0 REX ! W? DUP R# REX-B DUP REX-8 PREFIX, REX,
      R# 7 AND BYTE? IF 176 ELSE 184 THEN + C,A IMM, EXIT THEN
    0 BYTE? IF 198 ELSE 199 THEN RM, IMM, EXIT THEN
  DUP MEM? IF OVER SIZE-OF OPSIZE!  SWAP BYTE? IF 138 ELSE 139 THEN RMR, EXIT THEN
  DUP SIZE-OF OPSIZE!  BYTE? IF 136 ELSE 137 THEN RMR, ;

: lea, ( reg mem --- ) OVER RSIZE OPSIZE! SWAP 141 RMR, ;

\ ---- test ---------------------------------------------------------------
: test, ( dst src --- )
  DUP IMM? IF DROP DUP SIZE-OF OPSIZE!
    DUP REG? IF DUP R# 0= IF DROP
      0 REX ! W? PREFIX, REX, BYTE? IF 168 ELSE 169 THEN C,A IMM, EXIT THEN THEN
    0 BYTE? IF 246 ELSE 247 THEN RM, IMM, EXIT THEN
  DUP SIZE-OF OPSIZE!  BYTE? IF 132 ELSE 133 THEN RMR, ;

\ ---- one operand: inc dec not neg mul imul div idiv ---------------------
: UNARY ( rm k op8 --- ) >R >R DUP SIZE-OF OPSIZE! R> R> BYTE? 0= - RM, ;
: inc, 0 254 UNARY ;  : dec, 1 254 UNARY ;
: not, 2 246 UNARY ;  : neg, 3 246 UNARY ;
: mul, 4 246 UNARY ;  : div, 6 246 UNARY ;  : idiv, 7 246 UNARY ;

\ ---- push pop --------------------------------------------------------------
: push, ( reg --- ) 0 REX ! DUP R# REX-B REX, R# 7 AND 80 + C,A ;
: pop,  ( reg --- ) 0 REX ! DUP R# REX-B REX, R# 7 AND 88 + C,A ;

\ ---- no operands --------------------------------------------------------
: syscall, 3845 OPC, ;   : ret, 195 C,A ;
: std, 253 C,A ;   : cld, 252 C,A ;

\ ---- movzx movsx movsxd: a register, from a narrower r/m -------------------
: EXTEND ( reg rm op --- ) >R OVER RSIZE OPSIZE! SWAP R> RMR, ;
: movzx, ( reg rm --- ) DUP SIZE-OF 1 = IF 4022 ELSE 4023 THEN EXTEND ;
: movsx, ( reg rm --- ) DUP SIZE-OF 1 = IF 4030 ELSE 4031 THEN EXTEND ;
: movsxd, ( reg rm --- ) 99 EXTEND ;
: bsr, ( reg rm --- ) 4029 EXTEND ;
: cmova, ( reg rm --- ) 3911 EXTEND ;
: imul, ( reg rm --- | reg rm imm --- )
  DUP IMM? IF DROP OVER RSIZE OPSIZE! SWAP                 \ three operands
    IMM @ DISP8? IF 107 RMR, IMM @ C,A ELSE 105 RMR, IMM, THEN EXIT THEN
  4015 EXTEND ;
: xchg, ( rm reg --- ) DUP SIZE-OF OPSIZE! BYTE? IF 134 ELSE 135 THEN RMR, ;

\ ---- shifts and rotates: by 1, by an immediate, by cl -----------------------
: SHIFT ( rm cnt k --- )
  >R DUP IMM? IF DROP DUP SIZE-OF OPSIZE!
      IMM @ 1 = IF R> BYTE? IF 208 ELSE 209 THEN RM, EXIT THEN
      R> BYTE? IF 192 ELSE 193 THEN RM, IMM @ C,A EXIT THEN
  DROP DUP SIZE-OF OPSIZE!  R> BYTE? IF 210 ELSE 211 THEN RM, ;   \ by cl
: rol, 0 SHIFT ;  : ror, 1 SHIFT ;  : shl, 4 SHIFT ;  : shr, 5 SHIFT ;  : sar, 7 SHIFT ;

\ ---- jumps and calls: to an address, short where the distance fits ---------
: REL8? ( target len --- rel f ) HERE-A + - DUP DISP8? ;
: FWD? ( t --- f ) KIND T-FWD = ;
: JCC ( target cc --- )
  OVER FWD? IF NEAR? @ IF 15 C,A 128 + C,A ELSE 112 + C,A THEN
    T-MASK INVERT AND PLACEHOLDER EXIT THEN
  >R DUP 2 REL8? IF NIP R> 112 + C,A C,A EXIT THEN DROP
  6 HERE-A + - 15 C,A R> 128 + C,A L,A ;
: jo, 0 JCC ;  : jno, 1 JCC ;  : jb, 2 JCC ;  : jae, 3 JCC ;
: je, 4 JCC ;  : jne, 5 JCC ;  : jbe, 6 JCC ;  : ja, 7 JCC ;
: js, 8 JCC ;  : jns, 9 JCC ;  : jl, 12 JCC ;  : jge, 13 JCC ;
: jle, 14 JCC ;  : jg, 15 JCC ;
: jz, je, ;  : jnz, jne, ;  : jc, jb, ;  : jnc, jae, ;
: jmp, ( target | rm --- )
  DUP REG? OVER MEM? OR IF 4 OPSIZE! 4 255 RM, EXIT THEN   \ 64-bit by default: no REX.W
  DUP FWD? IF NEAR? @ IF 233 ELSE 235 THEN C,A T-MASK INVERT AND PLACEHOLDER EXIT THEN
  DUP 2 REL8? IF NIP 235 C,A C,A EXIT THEN DROP
  5 HERE-A + - 233 C,A L,A ;
: call, ( target | rm --- )
  DUP REG? OVER MEM? OR IF 4 OPSIZE! 2 255 RM, EXIT THEN
  DUP FWD? IF 232 C,A T-MASK INVERT AND -1 NEAR? ! PLACEHOLDER EXIT THEN
  5 HERE-A + - 232 C,A L,A ;

\ ---- setcc: a byte register or r/m from a condition --------------------------
: SETCC ( rm cc --- ) 1 OPSIZE! 0 SWAP 3984 + RM, ;
: sete, 4 SETCC ;  : setne, 5 SETCC ;  : setb, 2 SETCC ;  : seta, 7 SETCC ;
: setl, 12 SETCC ;  : setg, 15 SETCC ;  : setle, 14 SETCC ;  : setge, 13 SETCC ;

\ ---- alignment, padded as GNU as pads code -------------------------------
\ (Iteration 547.) The multi-byte NOPs GNU as fills code with, for 1 to 8
\ bytes - the engine needs 2 and 6; more would need more of its table.
CREATE NOP-TABLE  144 C,  102 C, 144 C,  15 C, 31 C, 0 C,  15 C, 31 C, 64 C, 0 C,
  15 C, 31 C, 68 C, 0 C, 0 C,  102 C, 15 C, 31 C, 68 C, 0 C, 0 C,
  15 C, 31 C, 128 C, 0 C, 0 C, 0 C, 0 C,  15 C, 31 C, 132 C, 0 C, 0 C, 0 C, 0 C, 0 C,
: ALIGN, ( n --- ) \ pad with one NOP up to a multiple of n
  HERE-A OVER MOD ?DUP IF -                    ( pad )
    DUP 9 < 0= ABORT" asm64: padding longer than 8 bytes"
    NOP-TABLE OVER 1 ?DO I + LOOP                    \ its NOP: after 1+2+..+(pad-1)
    SWAP 0 ?DO DUP I + C@ C,A LOOP DROP
  ELSE DROP THEN ;

\ ---- the string instructions, with their prefixes -----------------------------
: rep, 243 C,A ;  : repe, 243 C,A ;  : repne, 242 C,A ;
: movsb, 164 C,A ;  : stosb, 170 C,A ;  : cmpsb, 166 C,A ;  : scasb, 174 C,A ;
: movsq, 72 C,A 165 C,A ;  : stosq, 72 C,A 171 C,A ;   \ REX.W; the corpus had
\ lumped `rep movsq` in with `rep movsb` until 548, and never tested it

\ ---- and last, the words that would shadow Forth's while this is written --
: [ ( --- ) DEPTH M-DEPTH ! ;
: ] ( ... --- m )
  -1 M-BASE ! -1 M-INDEX ! 0 M-SCALE ! 0 M-DISP ! 0 M-FWD !
  BEGIN DEPTH M-DEPTH @ > WHILE
    DUP KIND T-FWD = IF T-MASK INVERT AND M-FWD ! ELSE
    DUP KIND T-REG = IF R#                 \ popped last-written first:
      M-BASE @ 0< 0= IF M-BASE @ M-INDEX ! 0 M-SCALE ! THEN M-BASE ! ELSE
    DUP KIND T-IDX = IF DUP R# M-INDEX ! 12 RSHIFT 3 AND M-SCALE ! ELSE
    M-DISP +! THEN THEN THEN
  REPEAT T-MEM ;
: # ( n --- i ) IMM ! T-IMM ;

BASE !
