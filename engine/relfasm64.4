\ Traps (Iteration 556, Q21): SIGFPE - a zero divisor - and SIGSEGV or
\ SIGBUS - a bad address, or since 586 a stack's guard page: -3 at the
\ data stack's, -5 at the return stack's, told apart by the fault's
\ address (siginfo's si_addr, at rsi + 16) as cv8.c does. The saved
\ registers are rewritten and the handler returns, so rt_sigreturn
\ resumes at L_noop - a dispatch - in the trap word, on fresh stacks with
\ the code on top, as cv8.c restarts its VM. Nothing registered: at
\ L_sysexit with 70, the engine's own exit. The message is TRAPPED's.
\ The saved registers are the kernel's sigcontext, at ucontext + 40.
trap_handler L:                          \ edi: the signal; rsi: the siginfo; rdx: the ucontext
r8 [ rdx 128 ] mov,                      \ rbx as the trap found it: the base
r9 -9 # mov,
edi 8 # cmp,                             \ SIGFPE
3 F jne,
r9 -10 # mov,
1 F jmp,
3 L:  rax [ rsi 16 ] mov,                \ the address that faulted
rcx [ r8 DGUARD ] lea,
rax rcx sub,
rax PAGE # cmp,
4 F jae,                                 \ not the data stack's guard
r9 -3 # mov,
1 F jmp,
4 L:  rax [ rsi 16 ] mov,
rcx [ r8 RGUARD ] lea,
rax rcx sub,
rax PAGE # cmp,
1 F jae,                                 \ nor the return stack's: -9
r9 -5 # mov,
1 L:  trap_code L:                     \ r8 the base, r9 the code (571: int_throw's too)
rax [ trap_xt_v ] mov,
rax rax test,
2 F je,
[ rdx 72 ] r9 mov,                       \ r12, the top of stack: the code
rcx [ r8 MEMSIZE RSTACK_BYTES - DSTACK_BYTES - PAGE + 1024 + ] lea,
[ rdx 80 ] rcx mov,                      \ r13: 1 KB above the data stack's floor
[ rdx 88 ] rax mov,                      \ r14, ip: the trap word
rcx [ r8 MEMSIZE RSTACK_BYTES - 1024 + ] lea,
[ rdx 96 ] rcx mov,                      \ r15: 1 KB above the return stack's
\ floor - not the tops, where the outermost frames live (cv8.c's main)
