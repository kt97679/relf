[ rdx 168 ] rax mov,                     \ rip
ret,
2 L:  [ rdx 72 ] qword-ptr 70 # mov,     \ nothing registered: exit 70
rax [ L_sysexit ] lea,
[ rdx 168 ] rax mov,
