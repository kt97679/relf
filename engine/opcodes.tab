# opcodes.tab - the CV8 opcode map, its one source (Iteration 518).
#
# Every one-byte opcode (0x00-0x7F) and every escape selector, with
# its Forth name and the engine's handler. tools/gen-opcodes.sh makes
# cv8-ops.h, the engine's dispatch tables, from it; the Forth sources
# that must declare the same numbers themselves - kernel.4's PRIMITIVE
# and OPCODE lines, cross.4's and shadow.4's constants - are CHECKED
# against it (tools/gen-opcodes.sh --check, run by tests/portability),
# and the Python tools read it. CV8.md 2.2 says what each kind is.
#
# Adding a primitive: a line here, then `make`, then the PRIMITIVE line
# in kernel.4 that --check will ask for, and the kernels rebuilt.
#
# The last column is the operand that follows the opcode, which is how
# every tool that decodes an image finds the next instruction (Iteration
# 533; they kept their own lists of opcode numbers until then):
#   -      none               u8, i8  one byte, unsigned or signed
#   u16    two bytes          i32     four, signed       u64  eight
#   b8     a one-byte branch offset, from the operand
#   b16    a two-byte branch offset, from the operand
#   slot   a variable's slot: two bytes, or three if the first has bit 7
#   2slot  two slots, each from its own position (2VAR@, 940)
#   i8b16  a signed byte, then a two-byte branch offset (EQI?BRANCH, 940)
#   sel    ESC's selector     data    the body is data, not code
#
# kind     number  name        handler         operand
direct    0x00    NOOP        L_noop          -
direct    0x01    EXIT        L_exit          -
direct    0x02    LIT         L_lit           u16
direct    0x03    BRANCH      L_branch        b16
direct    0x04    ?BRANCH     L_0branch       b16
direct    0x05    DROP        L_drop          -
direct    0x06    DUP         L_dup           -
direct    0x07    SWAP        L_swap          -
direct    0x08    ROT         L_rot           -
direct    0x09    OVER        L_over          -
direct    0x0A    C@          L_cfetch        -
direct    0x0B    @           L_fetch         -
direct    0x0C    C!          L_cstore        -
direct    0x0D    !           L_store         -
direct    0x0E    AND         L_and           -
direct    0x0F    OR          L_or            -
direct    0x10    XOR         L_xor           -
direct    0x11    R>          L_fromr         -
direct    0x12    >R          L_tor           -
direct    0x13    R@          L_rfetch        -
direct    0x14    =           L_eq            -
direct    0x15    U<          L_ult           -
direct    0x16    <           L_lt            -
direct    0x17    +           L_plus          -
direct    0x18    UM*         L_ummult        -
direct    0x19    SP@         L_spfetch       -
synth     0x1A    LIT32       L_lit32         i32
synth     0x1B    DOVAR       L_dovar         data
synth     0x1C    DODOES      L_dodoes        data
synth     0x1D    LIT8        L_lit8          u8
# The superinstructions (Iteration 940): two operations in one dispatch, the
# pairs relf's own counts put first (tools/knee-model.py; relf had nine at
# 532-535, given up at 536). VAR@ and the operation after it - the VAR@'s
# byte rewritten, its slot staying - in the order of cross.4's VARX-OPS-T;
# two VAR@s in a row, the second slot after the first; a comparison and the
# ?BRANCH after it - IF's and WHILE's - in the order of BRX-OPS-T, EQI's
# immediate staying before the branch offset. --check holds both lists.
super     0x2C    VAR@+       L_vfplus        slot
super     0x2D    VAR@<       L_vflt          slot
super     0x2E    VAR@C@      L_vfcfetch      slot
super     0x2F    VAR@1+      L_vfonep        slot
super     0x30    VAR@0=      L_vfzeq         slot
super     0x31    VAR@SWAP    L_vfswap        slot
super     0x32    2VAR@       L_2vf           2slot
super     0x33    0=?BRANCH   L_zeqbr         b16
super     0x34    AND?BRANCH  L_andbr         b16
super     0x35    <?BRANCH    L_ltbr          b16
super     0x36    U<?BRANCH   L_ultbr         b16
super     0x37    EQI?BRANCH  L_eqibr         i8b16
# Iteration 946: three more of IF's and WHILE's tests - > and = as the
# comparisons are, and DUP as `DUP IF`, the value kept - and (LOOP) with
# LOOP's branch back, when that reaches in a byte. Chosen by
# tools/pair-corpus.py over four families of work - Forth programs, the
# Forth system, rill3, the shell - each family weighed alike, so no one
# program chose them.
super     0x38    >?BRANCH    L_gtbr          b16
super     0x39    =?BRANCH    L_eqbr          b16
super     0x3A    DUP?BRANCH  L_dupbr         b16
super     0x3B    (LOOP)BRANCH8 L_loopb8      b8
# Two plain operations in one (946): cross.4's PAIR-OPS-T has each as
# FIRST SECOND FUSED, and --check holds the fused row's name to the two
# names it joins.
pair      0x3C    CELLS+      L_cellsplus     -
pair      0x3D    CELL+@      L_cellpfetch    -
pair      0x3E    DUPC@       L_dupcfetch     -
branch8   0x3F    BRANCH8     L_branch8       b8
branch8   0x40    ?BRANCH8    L_0branch8      b8
tiny      0x41    +!          L_plusstore     -
tiny      0x42    ?DUP        L_qdup          -
tiny      0x43    I           L_i             -
tiny      0x44    (LOOP)      L_loop          -
tiny      0x45    (?DO)       L_qdo           -
tiny      0x46    EXECUTE     L_execute       -
tiny      0x47    @XT         L_atxt          -
# The folded returns (Iteration 939; relf had them until 538 gave them up for
# 64 opcodes, and forth-vm-evolution's designs keep them): an operation
# and the EXIT after it as one opcode. The set is relf's own counts' (the
# shell's and rill3's workloads, tools/knee-model.py), in the order of the
# base opcodes; cross.4's FOLD-OPS-T lists the bases, and --check holds them
# together.
fold      0x48    DROP;EXIT   LX_drop         -
fold      0x49    C@;EXIT     LX_cfetch       -
fold      0x4A    @;EXIT      LX_fetch        -
fold      0x4B    C!;EXIT     LX_cstore       -
fold      0x4C    !;EXIT      LX_store        -
fold      0x4D    AND;EXIT    LX_and          -
fold      0x4E    OR;EXIT     LX_or           -
fold      0x4F    XOR;EXIT    LX_xor          -
fold      0x50    R>;EXIT     LX_fromr        -
fold      0x51    >R;EXIT     LX_tor          -
fold      0x52    =;EXIT      LX_eq           -
fold      0x53    U<;EXIT     LX_ult          -
fold      0x54    +;EXIT      LX_plus         -
fold      0x55    +!;EXIT     LX_plusstore    -
fold      0x56    push0;EXIT  LX_lit0         -
fold      0x57    push1;EXIT  LX_lit1         -
fold      0x58    push-1;EXIT LX_litm1        -
fold      0x59    VAR!;EXIT   LX_vs           slot
fold      0x5A    0=;EXIT     LX_zeq          -
fold      0x5B    -;EXIT      LX_sub          -
fold      0x5C    2DROP;EXIT  LX_2drop        -
fold      0x5D    1+;EXIT     LX_onep         -
fold      0x5E    1-;EXIT     LX_onem         -
spec      0x61    push0       L_lit0          -
spec      0x62    push1       L_lit1          -
spec      0x63    push-1      L_litm1         -
spec      0x64    VAR@        L_vf            slot
spec      0x65    VAR!        L_vs            slot
spec      0x66    LSAVE       L_lsave         slot
spec      0x67    LRESTORE    L_lrest         slot
spec      0x68    L!          L_lstore        slot
spec      0x69    LZERO       L_lzero         slot
tiny      0x6A    0=          L_zeq           -
tiny      0x6B    -           L_sub           -
tiny      0x6C    <>          L_ne            -
tiny      0x6D    0<          L_zlt           -
tiny      0x6E    >           L_sgt           -
tiny      0x6F    2DUP        L_2dup          -
tiny      0x70    2DROP       L_2drop         -
pair      0x71    DUP1-       L_dup1m         -
tiny      0x72    1+          L_onep          -
tiny      0x73    CELL+       L_cellp         -
tiny      0x74    CELLS       L_cells         -
tiny      0x75    1-          L_onem          -
pair      0x76    OVER+       L_overplus      -
tiny      0x77    COUNT       L_count         -
pair      0x78    DUP>R       L_duptor        -
spec      0x79    ADDI        L_addi          i8
spec      0x7B    EQI         L_eqi           i8
# Hybrid-native (Iteration 952, NATIVE.md 18): never in an image file - an
# engine that runs native code writes NATIVE over a word's body in memory, and
# its native code returns into CV8 through NRET. NATIVE's operand is the
# native code's distance from the operand's end; NRET has none. The C engine
# has neither: native code runs on the assembly engine only (A47). At 0x7A and
# 0x7C, which no band grows into: 0x1E-0x2B is where the synthetic opcodes move.
hybrid    0x7A    NATIVE      L_native        i32
hybrid    0x7C    NRET        L_nret          -
lit64     0x7D    LIT64       L_lit64         u64
esc       0x7E    ESC         L_esc           sel
