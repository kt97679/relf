\ cm/values.4 - the command model's values (870): rill2/rill2.4's, which the command model has used since 855,
\ now its own - kept apart so Rill 2 can go (one language). Whole numbers tagged (2n+1), texts, lists,
\ maps, true and false (two boxes made once), none (0), over Rill's runtime. Changed from rill2's: + is
\ arithmetic only (texts join side by side, lists by @); a text that reads as a whole number is that
\ number in $(( )) - arithmetic, comparison, == - as the shell's (NUMERIC?, D-NUMERIC); errors say cm.
\ Left out: what only Rill 2 used (slices, FIXED-BOX, D2N, D-SEQ).
: D-NUM ( n --- item )   2* 1+ ;
CREATE TRUE-BOX K-BOOL , -1 ,   CREATE FALSE-BOX K-BOOL , 0 ,      \ outside the arena: never moved
: D-BOOL ( f --- item )   IF TRUE-BOX ELSE FALSE-BOX THEN ;
: D-KIND ( item --- kind )   DUP 1 AND IF DROP K-NUM EXIT THEN  DUP IF @ THEN ;
: D-ERR ( c-addr u --- )   R-FAIL ;
: D-BOXED ( item --- box )   DUP 1 AND IF 2/ K-NUM R-BOX THEN ;
: D-ITEM ( box --- item )   \ a number boxed, tagged - if it fits: past 62 bits it stays boxed (837)
  DUP IF DUP @ K-NUM = IF DUP CELL+ @ DUP 2* 2/ = IF CELL+ @ 2* 1+ THEN THEN THEN ;
: N>ITEM-D ( n --- item )   DUP 2* 2/ OVER = IF 2* 1+ ELSE K-NUM R-BOX THEN ;   \ tagged if it fits, else boxed
: D>N0 ( item --- n )   DUP 1 AND IF 2/ EXIT THEN
  DUP D-KIND K-NUM <> IF S" cm: a whole number was wanted" D-ERR THEN CELL+ @ ;
: D-TEXT ( item --- t )   ?DUP IF D-BOXED R-ANY>TEXT ELSE S" none" R-TEXT THEN ;
: D-STR ( item --- text )   DUP D-KIND K-TEXT = IF EXIT THEN  D-TEXT K-TEXT R-BOX ;
: D-LIST ( item --- l )   DUP D-KIND K-LIST <> IF S" cm: a list was wanted" D-ERR THEN CELL+ @ ;
: D-REC ( item --- r )   DUP D-KIND K-REC <> IF S" cm: a record was wanted" D-ERR THEN CELL+ @ ;
: BOTH# ( a b --- a b f )   2DUP AND 1 AND ;
: NUMERIC? ( item --- f )   \ a text that reads as a whole number: -?[0-9]+
  DUP D-KIND K-TEXT <> IF DROP 0 EXIT THEN  D-TEXT R-T@  OVER C@ [CHAR] - = IF 1 /STRING THEN
  DUP 0= IF NIP EXIT THEN  -1 ROT ROT 0 ?DO  DUP I + C@ [CHAR] 0 [CHAR] 9 1+ WITHIN ROT AND SWAP  LOOP DROP ;
: DIGITS# ( c-addr u --- n f )   \ its digits' value; f 0 if a character is no digit
  0 ROT ROT OVER + SWAP ?DO  I C@ [CHAR] 0 - DUP 10 U< 0= IF 2DROP 0 0 UNLOOP EXIT THEN  SWAP DUP 2* 2* + 2* +  LOOP  -1 ;
: TXT>INT? ( c-addr u --- n -1 | 0 )   \ -?[0-9]+, 18 digits at most, in one pass (898): $(f)'s numbers come back as
  \ text since 896, and NUMERIC?, then >NUMBER through R-NUMBER, had been a third of calls.cm's dispatches
  DUP 0= IF 2DROP 0 EXIT THEN  OVER C@ [CHAR] - = DUP >R IF 1 /STRING THEN
  DUP 0= OVER 18 > OR IF 2DROP R> DROP 0 EXIT THEN
  DIGITS# R> SWAP IF IF NEGATE THEN -1 ELSE 2DROP 0 THEN ;   \ times 10 as 2* 2* + 2*: * is a colon word here
: D-NUMERIC ( item --- item' )   \ "41" in $(( )): 41, as the shell's
  DUP D-KIND K-TEXT <> IF EXIT THEN  DUP D-TEXT R-T@ TXT>INT? IF NIP N>ITEM-D EXIT THEN
  DUP NUMERIC? IF D-TEXT R-NUMBER N>ITEM-D THEN ;   \ past 18 digits: R-NUMBER's, which says when it is past 64 bits
: D>N ( item --- n )   DUP 1 AND IF 2/ EXIT THEN  D-NUMERIC D>N0 ;   \ a whole number - or a text that reads as one,
  \ as $( ) gives a def's number back (912): range $(count $l), $l[$i], exit $n, as $(( )) took them already
: D-NOT-NUM ( text --- )   \ the text named (887): "a text that reads as none" said not which
  R-ERR> ." cm: $(( )) takes numbers, not the text " D-TEXT R-T@ TYPE R-ERR-NL -4004 THROW ;
: D-ARITH ( a b op --- c )   >R D-NUMERIC SWAP D-NUMERIC SWAP
  OVER D-KIND K-TEXT = IF DROP D-NOT-NUM THEN  DUP D-KIND K-TEXT = IF D-NOT-NUM THEN
  D-BOXED SWAP D-BOXED SWAP R> R-ARITH-AA D-ITEM ;
: D+ ( a b --- c )   \ two tagged: one add, the overflow looked at - past 62 bits the checked way (837)
  BOTH# IF 2DUP 2DUP + 1- TUCK XOR >R XOR R> AND 0< IF 0 D-ARITH EXIT THEN + 1- EXIT THEN
  0 D-ARITH ;   \ + is arithmetic only: texts join side by side, "$a$b" (870)
: D- ( a b --- c )   BOTH# IF 2DUP 2DUP - 1+ 2 PICK XOR >R XOR R> AND 0< IF 1 D-ARITH EXIT THEN - 1+ EXIT THEN  1 D-ARITH ;
: SMALL? ( a --- f )   2147483648 + 4294967296 U< ;               \ tagged, under 2^30 either way
: D* ( a b --- c )   BOTH# IF OVER SMALL? OVER SMALL? AND IF >R 2/ R> 1- * 1+ EXIT THEN THEN  2 D-ARITH ;
: D/ ( a b --- c )   3 D-ARITH ;
: D% ( a b --- c )   4 D-ARITH ;
: D-NEG ( a --- c )   1 SWAP D- ;
: D-TRUE? ( item --- f )   \ none, 0, false, "", [] and {} are false
  ?DUP 0= IF 0 EXIT THEN  DUP 1 AND IF 1 <> EXIT THEN  R-UNBOX
  DUP K-TEXT = IF DROP R-T@ NIP 0<> EXIT THEN  DUP K-LIST = IF DROP R-LEN 0<> EXIT THEN
  K-REC = IF R-KEYS R-LEN 0<> EXIT THEN  0<> ;
: D-CMP ( a b --- n )   BOTH# IF 2DUP > >R < R> - EXIT THEN          \ no subtraction: no overflow
  D-NUMERIC SWAP D-NUMERIC SWAP  BOTH# IF 2DUP > >R < R> - EXIT THEN
  OVER 0= OVER 0= OR IF S" cm: none has no order" D-ERR THEN  D-BOXED SWAP D-BOXED SWAP R-ANY-CMP ;
: D< ( a b --- c )   D-CMP 0< D-BOOL ;      : D> ( a b --- c )   D-CMP 0> D-BOOL ;
: D<= ( a b --- c )   D-CMP 0> 0= D-BOOL ;  : D>= ( a b --- c )   D-CMP 0< 0= D-BOOL ;
: D-CLASS ( item --- c )   D-KIND ;
: D== ( a b --- c )
  BOTH# IF = D-BOOL EXIT THEN  2DUP = IF 2DROP TRUE-BOX EXIT THEN  D-NUMERIC SWAP D-NUMERIC SWAP  BOTH# IF = D-BOOL EXIT THEN
  OVER 0= OVER 0= OR IF 2DROP FALSE-BOX EXIT THEN
  OVER D-CLASS OVER D-CLASS <> IF 2DROP FALSE-BOX EXIT THEN
  DUP D-KIND DUP K-BOOL = SWAP K-REC = OR IF CELL+ @ SWAP CELL+ @ = D-BOOL EXIT THEN
  DUP D-KIND K-LIST = IF  R-DEEP?  CELL+ @ SWAP CELL+ @  OVER R-LEN OVER R-LEN <> IF 2DROP FALSE-BOX EXIT THEN
    DUP R-LEN 0 ?DO  OVER I R-AT OVER I R-AT RECURSE FALSE-BOX = IF 2DROP FALSE-BOX UNLOOP EXIT THEN  LOOP
    2DROP TRUE-BOX EXIT THEN     \ lists item by item, each as == takes it (961): Rill's R-CMP had taken cm's tagged
  D-BOXED SWAP D-BOXED SWAP R-CMP 0= D-BOOL ;   \ numbers for boxes, and [1 2] == [1 2] faulted
: D!= ( a b --- c )   D== D-TRUE? 0= D-BOOL ;
: D-IN ( x c --- f )   \ x in c: a list's item, a record's key, a text's part (835)
  DUP D-KIND K-REC = IF D-REC SWAP D-TEXT SWAP R-HAS D-BOOL EXIT THEN
  DUP D-KIND K-TEXT = IF D-TEXT SWAP D-TEXT R-CONTAINS D-BOOL EXIT THEN
  D-LIST DUP R-LEN 0 ?DO 2DUP I R-AT D-ITEM D== D-TRUE? IF 2DROP TRUE-BOX UNLOOP EXIT THEN LOOP  2DROP FALSE-BOX ;
: D-IDX ( n len --- n' )   OVER 0< IF + ELSE DROP THEN ;          \ a negative index from the end
: U-COUNT0 ( c-addr u --- n )   0 ROT ROT OVER + SWAP ?DO I C@ CONT? 0= - LOOP ;   \ a text's characters, UTF-8 (879)
: U-FROM ( c-addr u off k --- off' )   \ from byte off, a character's start, k characters on: where the next starts, or u
  >R BEGIN DUP 2 PICK < WHILE
    2 PICK OVER + C@ CONT? 0= IF R@ 0= IF NIP NIP R> DROP EXIT THEN R> 1- >R THEN  1+
  REPEAT NIP NIP R> DROP ;
\ The last text counted or indexed, kept (927): its characters' count, and the last character found and its
\ byte - so $t[$i] in a loop goes on from where the last one stopped, and an ASCII text's byte is its
\ character. 20,000 characters read one by one had taken 18 s, each from the text's start, each counting
\ the whole. Kept by the text's address and length, and the collector's count: a collection moves texts
VARIABLE UC-A  VARIABLE UC-U  VARIABLE UC-N  VARIABLE UC-I  VARIABLE UC-B  VARIABLE UC-G
: UC? ( c-addr u --- f )   UC-U @ = SWAP UC-A @ = AND  G-RUNS @ UC-G @ = AND ;
: UC! ( c-addr u --- )   2DUP U-COUNT0 UC-N !  UC-U ! UC-A !  G-RUNS @ UC-G !  0 UC-I !  0 UC-B ! ;
: U-COUNT ( c-addr u --- n )   2DUP UC? 0= IF 2DUP UC! THEN 2DROP UC-N @ ;
: U-START ( c-addr u i --- off )   \ the byte where character i starts, or u
  >R  2DUP UC? 0= IF 2DUP UC! THEN
  UC-N @ UC-U @ = IF NIP R> MIN EXIT THEN                   \ ASCII: the byte is the character
  R@ UC-I @ < IF 0 UC-I ! 0 UC-B ! THEN
  UC-B @ R@ UC-I @ - U-FROM  DUP UC-B !  R> UC-I ! ;
: T-CHAR ( t i --- t2 )   >R DUP R-T@ R@ U-START  OVER R-T@ R> 1+ U-START  R-TSLICE ;   \ character i, its bytes
: D-AT ( a i --- item )   \ a list's item, a text's character, a record's value
  OVER D-KIND K-REC = IF D-TEXT SWAP D-REC R-GET D-ITEM EXIT THEN
  OVER D-KIND K-TEXT = IF D>N SWAP D-TEXT DUP R-T@ U-COUNT ROT SWAP D-IDX T-CHAR K-TEXT R-BOX EXIT THEN
  D>N SWAP D-LIST DUP R-LEN ROT SWAP D-IDX R-AT D-ITEM ;
: D-DEL ( x i --- )   \ del x[i]: a list's item, a map's key, taken out in place (905)
  OVER D-KIND K-REC = IF D-TEXT SWAP D-REC R-REC-DEL EXIT THEN
  OVER D-KIND K-LIST = IF D>N SWAP D-LIST DUP R-LEN ROT SWAP D-IDX R-DEL EXIT THEN
  2DROP S" cm: del takes an item of a list or a map" R-FAIL ;
: D-SET ( x i v --- )   \ x[i] = v
  D-BOXED ROT  DUP D-KIND K-REC = IF D-REC ROT D-TEXT SWAP R-PUT EXIT THEN
  D-LIST ROT D>N OVER R-LEN D-IDX R-SET ;
