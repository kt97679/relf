\ cm/prompt.4 - the command model's prompt (869): kernel64-cm.img with no script. A line - more while a
\ bracket or a quote is open, or the line ends in |, && or || - is compiled and run in one session: what
\ one line declares and defines the next sees (cm/cmc.4's SESSION - the session's own variables boxed,
\ since a later line's block may capture them). At a terminal relfsh's line editor reads it (keys,
\ history, ^R; no TAB); without one, lines as they come. An error is said and the prompt comes back; ^C
\ ends what runs; the input's end ends the prompt, with the last status. Rill 2's prompt (835), as cm.
65536 CONSTANT CL-MAX   VARIABLE CL-BUF  VARIABLE CL#  VARIABLE CL-TTY  VARIABLE CL-D  VARIABLE CL-Q
: CL@ ( i --- c )   DUP CL# @ < IF CL-BUF @ + C@ ELSE DROP 0 THEN ;
VARIABLE CL-HAT  VARIABLE CL-HTO  VARIABLE CL-TAIL   \ here-documents (963): the line's end the scan jumps from, to
: CL-HD? ( i --- f )   \ << at i, a word of its own                  \ where; the entry's end before its last bodies
  DUP 1+ CL@ 60 = OVER 2 + CL@ HD-BL? AND  SWAP DUP IF 1- CL@ DUP HD-BL? SWAP 10 = OR ELSE DROP -1 THEN AND ;
: CL-HD ( i --- i' open? )   \ its END word, as the front end reads it, and a line END after the line: else open -
  CL-BUF @ IN-TEXT !  CL# @ IN-LEN !  2 + IN-POS !        \ more lines wanted; an END word wrong, the front end's to say
  BEGIN CUR HD-BL? WHILE 1 IN-POS +! REPEAT
  CUR DUP 39 = SWAP 34 = OR IF  CUR 1 IN-POS +!  HERE-IN  BEGIN CUR 2 PICK <> CUR 10 <> AND CUR AND WHILE 1 IN-POS +! REPEAT
    CUR 2 PICK <> IF 2DROP IN-POS @ 1- 0 EXIT THEN  HERE-IN OVER -  1 IN-POS +!  ROT DROP
  ELSE  HERE-IN  BEGIN CUR DUP HD-BL? 0= SWAP S" ;})]" ONE-OF? 0= AND CUR 10 <> AND CUR AND WHILE 1 IN-POS +! REPEAT  HERE-IN OVER -  THEN
  DUP 0= IF 2DROP IN-POS @ 1- 0 EXIT THEN  HD-DU ! HD-D !
  IN-POS @ HD-EOL  DUP CL-HAT @ = IF DROP CL-HTO @ ELSE 1+ THEN  HD-SEEK  DUP 0< IF DROP IN-POS @ -1 EXIT THEN
  LINE-REST 1+ CL# @ MIN CL-HTO !  IN-POS @ HD-EOL CL-HAT !  IN-POS @ 1- 0 ;
: CL-OPEN? ( --- f )   \ a bracket or a quote open at the input's end, or its last word |, && or ||
  0 CL-D !  0 CL-Q !  -1 CL-HAT !  CL# @ CL-TAIL !  0  BEGIN DUP CL# @ < WHILE
    DUP CL-HAT @ = IF  CL-HTO @ CL# @ < 0= IF DUP CL-TAIL ! THEN  DROP CL-HTO @  -1 CL-HAT !  ELSE
    CL-Q @ IF DUP CL@ DUP 92 = CL-Q @ 34 = AND IF DROP 1+ ELSE CL-Q @ = IF 0 CL-Q ! THEN THEN ELSE
    DUP CL@ CASE  34 OF 34 CL-Q ! ENDOF  39 OF 39 CL-Q ! ENDOF
      35 OF BEGIN DUP 1+ CL@ DUP 10 <> SWAP 0<> AND WHILE 1+ REPEAT ENDOF
      60 OF DUP CL-HD? IF CL-HD IF DROP -1 EXIT THEN THEN ENDOF
      123 OF 1 CL-D +! ENDOF  91 OF 1 CL-D +! ENDOF  40 OF 1 CL-D +! ENDOF
      125 OF -1 CL-D +! ENDOF  93 OF -1 CL-D +! ENDOF  41 OF -1 CL-D +! ENDOF  ENDCASE THEN  1+  THEN
  REPEAT DROP  CL-D @ 0> CL-Q @ 0<> OR IF -1 EXIT THEN
  CL-TAIL @ BEGIN 1- DUP 0< IF DROP 0 EXIT THEN DUP CL@ BL > UNTIL
  DUP CL@ [CHAR] | = IF DROP -1 EXIT THEN  DUP CL@ [CHAR] & = SWAP 1- CL@ [CHAR] & = AND ;
VARIABLE CL-CAP                                    \ the entry's buffer, grown as a line needs (907: 64 KB before)
: CL-ROOM ( --- )   CL-CAP @ CL# @ - 4096 < IF  CL-CAP @ 2* DUP CL-CAP !  CL-BUF @ SWAP RESIZE THROW CL-BUF !  THEN ;
: CL-ADD ( c-addr u --- )   CL-ROOM  CL-CAP @ CL# @ - 2 - MIN  CL-BUF @ CL# @ + SWAP DUP >R MOVE  R> CL# +!  10 CL-BUF @ CL# @ + C!  1 CL# +! ;
: CL-READ ( --- f )   \ a line, from no terminal
  BEGIN  CL-ROOM  CL-BUF @ CL# @ +  CL-CAP @ CL# @ - 1-  DUP >R  0 READ-LINE  IF R> DROP 2DROP 0 EXIT THEN
    0= IF R> 2DROP 0 EXIT THEN  DUP CL# +!  R> =  WHILE REPEAT      \ the buffer filled: more of the line
  10 CL-BUF @ CL# @ + C!  1 CL# +!  -1 ;
: CL-EDIT ( --- f )   \ a line from the editor; ^C drops what was typed so far
  CL# @ 0= CMD-START? !  0 TERM-RAW DROP  ED-LINE  0 TERM-RESTORE DROP
  0= IF 2DROP 0 EXIT THEN  ED-DONE @ 2 = IF 2DROP 0 CL# ! -1 EXIT THEN  CL-ADD -1 ;
VARIABLE CL-FP  VARIABLE CL-LS#  VARIABLE CL-CTL#           \ the session's frame and activations, as it began
VARIABLE CL-HAVE                                   \ the session frame's slots: made longer as variables come (891)
: CL-GROW ( need --- )   \ between lines the session's frame is LS's top: more slots at its end, cleared
  CL-HAVE @ - DUP 0> 0= IF DROP EXIT THEN  LS# @ OVER + 1+ LS-CAP @ > IF LS# @ OVER + 1+ LS-GROW THEN
  LS LS# @ CELLS + OVER CELLS ERASE  DUP LS# +!  CL-HAVE +!  LS# @ CL-LS# ! ;
: CL-RUN ( --- )   CL-BUF @ CL# @ CM-COMPILE  MAIN-FR @ CELL+ @ CL-GROW  INSTALL ;   \ tokens, not text (926)
VARIABLE CL-RUN-XT   ' CL-RUN CL-RUN-XT !XT
: CL-BACK ( --- )   \ after an error: the session's frame and nothing deeper, nothing captured, nothing compiling
  CL-FP @ FP !  CL-LS# @ LS# !  CL-CTL# @ CTL# !  0 SINK# !  0 IN# !  0 ENV# !  0 STATE !  R-OUT-BACK  0 CT-ON !  0 CT-LEN !  0 CT-HELD !  -1 CT-ARM !  0 HELD !  0 TESTING ! ;
: CL-CAUGHT ( code --- )   \ said already, if cm's or the runtime's; else said here - exit ends the prompt (873)
  DUP -4100 -3999 WITHIN 0= IF R-ERR> ." cm: error " DUP . R-NL R-OUT-BACK THEN
  DUP -4000 = R-EXITED @ AND IF CL-BACK THROW THEN  DROP  0 R-SIGGED !  CL-BACK ;
: CM-REPL ( --- )
  -1 SESSION !  0 ISATTY CL-TTY !  CL-MAX DUP CL-CAP ! ALLOCATE THROW CL-BUF !  R-SIG-CATCH
  SESSION-SLOTS 1+ DUP CL-HAVE ! FRAME  FP @ MFP !  ACT-PUSH D-NUM 0 LS!  FP @ CL-FP !  LS# @ CL-LS# !  CTL# @ CL-CTL# !
  BEGIN 0 CL# !
    BEGIN CL-TTY @ IF CL-EDIT ELSE CL-READ THEN
      0= IF CL# @ 0= IF CM-END EXIT THEN -1 ELSE CL-OPEN? 0= THEN
      R-SIGNAL DROP UNTIL
    CL-RUN-XT @XT CATCH  R-OUT-BACK  ?DUP IF CL-CAUGHT THEN
  AGAIN ;
