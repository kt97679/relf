\ cm/out.4 - the command model's runtime, step 2 of its prototype (856): value output and byte
\ output kept apart, captures, and the printed form - docs/COMMAND-MODEL.md, rules 2 and 12.
\ Loaded after cm/rt-cm.4. `put` sends a value to the innermost capture, or prints it at the
\ terminal; `echo`'s bytes go to the byte output and are never captured.

\ ---- the printed form: lists [a b], maps [k: v  k2: v2], [:] when empty, blocks <block> ----
DEFER SHOW ( item --- )
: QUOTE? ( c-addr u --- f )   \ a text that would not read back as one word
  DUP 0= IF 2DROP -1 EXIT THEN
  0 ?DO  DUP I + C@  DUP 33 < OVER [CHAR] [ = OR OVER [CHAR] ] = OR OVER [CHAR] { = OR
         OVER [CHAR] } = OR OVER [CHAR] " = OR SWAP [CHAR] $ = OR
         IF DROP -1 UNLOOP EXIT THEN  LOOP DROP 0 ;
: SHOW-QUOTED ( c-addr u --- )   [CHAR] " OUT-EMIT
  0 ?DO  DUP I + C@  DUP [CHAR] " = OVER 92 = OR IF 92 OUT-EMIT THEN  OUT-EMIT  LOOP DROP  [CHAR] " OUT-EMIT ;
: SHOW-IN ( item --- )   \ an element: a text quoted when it must be
  DUP 0<> IF DUP D-KIND K-TEXT = IF CELL+ @ R-T@ 2DUP QUOTE? IF SHOW-QUOTED ELSE OUT-TYPE THEN EXIT THEN THEN
  SHOW ;
: SHOW-LIST ( l --- )   [CHAR] [ OUT-EMIT
  DUP @ 0 ?DO  I IF BL OUT-EMIT THEN  DUP R-ITEMS I CELLS + @ SHOW-IN  LOOP DROP  [CHAR] ] OUT-EMIT ;
: SHOW-MAP ( r --- )   DUP @ @ 0= IF DROP S" [:]" OUT-TYPE EXIT THEN  [CHAR] [ OUT-EMIT   \ OUT-TYPE, not ." or SPACES: the
  DUP @ @ 0 ?DO  I IF BL OUT-EMIT BL OUT-EMIT THEN                                                 \ kernel's would miss $( )'s text (896)
    DUP @ R-ITEMS I CELLS + @ SHOW-IN  S" : " OUT-TYPE  DUP CELL+ @ R-ITEMS I CELLS + @ SHOW-IN  LOOP DROP
  [CHAR] ] OUT-EMIT ;
24 BUFFER: NB
: N-TYPE ( n --- )   \ a whole number's digits, no text made (898): # and #S divide double cells, and R-NUM made a text
  DUP 0< IF  DUP ABS 0< IF R-NUM R-T@ OUT-TYPE EXIT THEN  [CHAR] - OUT-EMIT ABS  THEN
  NB 24 + SWAP  BEGIN  0 10 UM/MOD >R  [CHAR] 0 + SWAP 1- TUCK C!  R> ?DUP 0= UNTIL   \ UM/MOD: one primitive; /MOD was SM/REM, FM/MOD, DABS
  NB 24 + OVER - OUT-TYPE ;
: CT-FLUSH' ( --- )   CT-HELD @  0 CT-HELD !  D>N R-NUM R-T@ CT+  10 SP@ 1 CT+ DROP ;   \ printed where held - not by
  \ N-TYPE, whose buffer may hold the number whose printing flushes it: put 1; put 2 had made 1 and 1
' CT-FLUSH' IS CT-FLUSH
: CT-OWN ( --- )   CT-HELD @ IF CT-FLUSH THEN ;   \ before a text of its own is made after it in CT-BUF
: SHOW-IMPL ( item --- )
  DUP 0= IF DROP S" none" OUT-TYPE EXIT THEN  DUP ENV-BOX = IF DROP ENV>MAP THEN   \ $env, a map (969: it recursed)
  DUP D-KIND  DUP K-LIST = IF DROP CELL+ @ SHOW-LIST EXIT THEN
  DUP K-REC = IF DROP CELL+ @ SHOW-MAP EXIT THEN
  DUP K-BLOCK = IF 2DROP S" <block>" OUT-TYPE EXIT THEN
  DUP K-NUM = IF DROP D>N N-TYPE EXIT THEN
  K-UPV = IF UPV@ RECURSE EXIT THEN
  D-TEXT R-T@ OUT-TYPE ;
' SHOW-IMPL IS SHOW
: SHOWN ( v kind --- t )   \ a list's, map's or block's text - in "...", join's - its printed form, as echo shows it
  \ (901): it had been Rill's - a list's items blank-separated, a map as {k: "v"} - two forms of one value
  R-BOX  CT-OWN  CT-LEN @ >R  CT-ON @ >R  -1 CT-ON !  SHOW  R> CT-ON !
  CT-BUF @ R@ +  CT-LEN @ R@ -  R-TEXT  R> CT-LEN ! ;
' SHOWN IS R-CONT>TEXT-D

\ ---- value output: a stack of sinks - each @( )'s list; 0, printed - at the terminal, or into $( )'s text ----
64 CONSTANT SINK-MAX
SINK-MAX CELLS BUFFER: SINKS   VARIABLE SINK#
VARIABLE SINK-CAP  SINK-MAX SINK-CAP !           \ grown when full (891): SINK-MAX had been the most
' SINKS >BODY START @ - CONSTANT SINKS'
: SINK-MORE ( --- )   SINKS' BODY-OF BUF-GROW  SINK-CAP @ 2* SINK-CAP ! ;
: SINK ( --- list-item | 0 )   SINK# @ IF SINKS SINK# @ 1- CELLS + @ ELSE 0 THEN ;
: PUT ( item --- )   SINK ?DUP IF CELL+ @ R-PUSH EXIT THEN   \ taken by @( ) - or printed (896: $( ) takes no values of
  DUP 1 AND CT-ON @ AND IF  CT-ARM @ CT-LEN @ = IF  CT-HELD !  -1 CT-ARM !  EXIT THEN THEN   \ its own); in (( ))'s $( ),
  SHOW R-NL ;                                                    \ the first, a number before any byte, held (964)
: SINK+ ( list-item|0 --- )   R-DEEP?  SINK# @ SINK-CAP @ < 0= IF SINK-MORE THEN  SINKS SINK# @ CELLS + !  1 SINK# +! ;
: CAPTURE ( i*x xt --- j*x list-item )   \ @( ): run xt, the values it puts captured - not its bytes
  R-NEW-LIST K-LIST R-BOX SINK+  CATCH  SINK SWAP  -1 SINK# +!  THROW ;
: ONE ( list-item --- item )   \ var x @(...) and set's: the one value there (896)
  CELL+ @  DUP @ 1 = IF R-ITEMS @ EXIT THEN
  R-ERR> ." cm: one value goes here - @( ) gave " @ R-.N R-ERR-NL -4004 THROW ;

\ ---- the collector: the captures' lists too ----
: G-MORE-OUT ( --- )   G-MORE-CM  SINK# @ 0 ?DO  SINKS I CELLS + DUP @ G-BOX SWAP !  LOOP ;
' G-MORE-OUT IS G-MORE
