\ cm/lib.4 - what tools/cmc.py's Forth calls (858): texts, arguments as lists, the builtins, calls.
\ Loaded after cm/rt-cm.4, out.4 and ctl.4.

: TXT ( c-addr u --- item )   R-TEXT K-TEXT R-BOX ;
: CHARS>TXT ( c1 .. ck k --- item )   \ a text with characters S" cannot hold
  DUP CELL+ R-ALLOT >R  DUP R@ !  BEGIN DUP WHILE 1- TUCK R@ CELL+ + C! REPEAT DROP  R> K-TEXT R-BOX ;
: JOIN ( item item --- text )   D-STR SWAP D-STR SWAP D+ ;

\ ---- a command's arguments: a list, @ spreading a list into it ----
: ARGL ( --- list )   R-NEW-LIST K-LIST R-BOX ;
: ARG ( list item --- list )   OVER CELL+ @ R-PUSH ;
: ARG@ ( list spread --- list )
  DUP D-KIND K-LIST <> IF S" cm: @ spreads a list - this is not one" R-FAIL THEN
  CELL+ @  DUP @ 0 ?DO  DUP R-ITEMS I CELLS + @  2 PICK CELL+ @ R-PUSH  LOOP DROP ;
: #ARGS ( list --- n )   CELL+ @ @ ;
: ARGN ( list i --- item )   SWAP CELL+ @ R-ITEMS SWAP CELLS + @ ;

\ ---- the builtins ----
: ECHO ( args --- )   DUP #ARGS 0 ?DO  I IF SPACE THEN  DUP I ARGN SHOW  LOOP DROP CR ;
: PUTS ( args --- )   DUP #ARGS 0 ?DO  DUP I ARGN PUT  LOOP DROP ;
: APPEND ( list args --- )   SWAP D-LIST SWAP  DUP #ARGS 0 ?DO  DUP I ARGN  2 PICK R-PUSH  LOOP 2DROP ;
: COUNT-OF ( args --- )   DUP #ARGS 1 <> IF S" cm: count takes one value" R-FAIL THEN  0 ARGN
  DUP D-KIND DUP K-LIST = IF DROP CELL+ @ @ ELSE DUP K-REC = IF DROP CELL+ @ @ @ ELSE
  K-TEXT = IF CELL+ @ @ ELSE S" cm: count of something with no count" R-FAIL THEN THEN THEN  D-NUM PUT ;
: RANGE-OF ( args --- )   DUP #ARGS 1 <> IF S" cm: range takes one number" R-FAIL THEN
  0 ARGN D>N 0 ?DO I D-NUM PUT LOOP ;
: MERGE-OF ( args --- )   \ merge $a $b: a new map, a's entries, b's over them - the top level copied
  DUP #ARGS 2 <> IF S" cm: merge takes two maps" R-FAIL THEN
  R-NEW-RECORD K-REC R-BOX  SWAP
  2 0 DO  DUP I ARGN  DUP D-KIND K-REC <> IF S" cm: merge takes maps" R-FAIL THEN
    CELL+ @  DUP @ @ 0 ?DO  DUP @ R-ITEMS I CELLS + @  OVER CELL+ @ R-ITEMS I CELLS + @
      4 PICK ROT ROT D-SET  LOOP DROP  LOOP DROP PUT ;
\ ---- an element of a list or a map (865): a list keeps its items as they are - not boxed, as rill2's
\ D-AT and D-SET take a list's - so $l[0] read a number as a box and faulted; a map's go through D-SET
: CM-AT ( c k --- item )   OVER D-KIND K-LIST <> IF D-AT EXIT THEN  D>N SWAP D-LIST DUP R-LEN ROT SWAP D-IDX R-AT ;
: CM-SET ( c k v --- )   2 PICK D-KIND K-LIST <> IF D-SET EXIT THEN  ROT D-LIST ROT D>N OVER R-LEN D-IDX R-SET ;
: HAS-OF ( args --- )   \ has $m key, has $l value: true if the map has the key, the list the value (865)
  DUP #ARGS 2 <> IF S" cm: has takes a map or list and a value" R-FAIL THEN  DUP 1 ARGN SWAP 0 ARGN D-IN PUT ;
: FOR-ONE ( args --- args )   \ for x $l: one value, a list - @ spreads it
  DUP #ARGS 1 = IF DUP 0 ARGN D-KIND K-LIST = IF S" cm: for over one list - @ spreads it" R-FAIL THEN THEN ;

\ ---- calls ----
: DEF-TAIL ( xt --- )   \ a def's body run, its return caught, its frame and activations put back
  FP @ >R  CTL# @ >R  CATCH  R> CTL# !  R> FP !
  0 LS@ D>N  OVER T-RETURN = OVER T-TARGET @ = AND IF 2DROP 0 ELSE DROP THEN
  ACT-POP UNFRAME  THROW ;
: DEF-CALL ( args k n xt --- )   \ slot 0 its number, slots 1..k its parameters, each in an upvalue
  >R  1+ FRAME  ACT-PUSH D-NUM 0 LS!                                        ( args k ) ( R: xt )
  OVER #ARGS OVER <> IF S" cm: a def called with the wrong number of arguments" R-FAIL THEN
  0 ?DO  DUP I ARGN UPV-NEW  I 1+ LS!  LOOP DROP  R> DEF-TAIL ;
: BLK-BIND ( args k --- )   \ a block's parameters from its arguments, each in an upvalue
  OVER #ARGS OVER <> IF S" cm: a block called with the wrong number of arguments" R-FAIL THEN
  0 ?DO  DUP I ARGN UPV-NEW  I 1+ LS!  LOOP DROP ;
: CALL-VALUE ( args item --- )   \ rule 11: a value as a command's first word
  DUP D-KIND K-BLOCK = IF BLK-CALL EXIT THEN
  DUP D-KIND K-BOOL = IF NIP D-TRUE? 0= STATUS ! EXIT THEN
  S" cm: a value that is no block or boolean as a command - programs come later" R-FAIL ;

\ ---- programs (859): a command whose first word names no builtin, def or value - its words as texts
: ARG-TEXTS ( args --- l )   \ numbers, texts and booleans; a list, map or block is an error (rule 12)
  DUP #ARGS 0 ?DO  DUP I ARGN D-KIND  DUP K-LIST = OVER K-REC = OR SWAP K-BLOCK = OR
    IF S" cm: a list, map or block given to a program - @ spreads a list, to-json writes one" R-FAIL THEN  LOOP
  CELL+ @ ;
: RD-FILE ( item mode fd --- )   ROT D-STR CELL+ @ ROT ROT R-RD-FILE ;
: PSTAGE ( args last? --- )   >R ARG-TEXTS R> PL-STAGE-L ;
: PIPE-END ( --- )   PL-END STATUS ! ;
: TRIM-NLS ( t --- t )   \ every trailing newline off (rule 4 of C.1)
  BEGIN  DUP @ DUP IF OVER CELL+ + 1- C@ 10 = ELSE 0 THEN  WHILE  -1 OVER +!  REPEAT ;
: PIPE-TEXT ( --- item )   PL-END STATUS !  TRIM-NLS K-TEXT R-BOX ;
: NL-AT ( c-addr u --- i )   \ the first newline's place, or u
  TUCK 0 ?DO  DUP I + C@ 10 = IF 2DROP I UNLOOP EXIT THEN  LOOP  DROP ;
: PIPE-LINES ( --- list )   \ @( ): a program's lines, each a text
  PIPE-TEXT CELL+ @ R-T@  ARGL ROT ROT                                  ( list c-addr u )
  BEGIN DUP WHILE
    2DUP NL-AT  >R  OVER R@ TXT  3 PICK SWAP ARG DROP                    ( list c-addr u )  ( R: i )
    R> 1+ OVER MIN  TUCK - >R + R>                                      ( list c-addr' u' )
  REPEAT 2DROP ;
