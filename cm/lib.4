\ cm/lib.4 - what the front end's Forth calls (858; tools/cmc.py's then, cm/cmc.4's since 867): texts, arguments as lists, the builtins, calls.
\ Loaded after cm/rt-cm.4, out.4 and ctl.4.

: TXT ( c-addr u --- item )   R-TEXT K-TEXT R-BOX ;
\ A text S" cannot hold - past 200 characters, or with a " or a control character - is made in pieces in a
\ buffer of its own, grown as needed, and made a text at the end (891; CHARS>TXT had put each character on
\ the data stack)
VARIABLE TB  VARIABLE TB#  VARIABLE TB-CAP
: TXT( ( --- )   0 TB# ! ;
: TB-ROOM ( u --- )   TB# @ +  DUP TB-CAP @ > IF  2* DUP TB-CAP !  TB @ ?DUP IF SWAP RESIZE ELSE ALLOCATE THEN THROW TB !  ELSE DROP THEN ;
: TXT+ ( c-addr u --- )   DUP TB-ROOM  TB @ TB# @ + SWAP DUP TB# +! MOVE ;
: TXT-C ( c --- )   1 TB-ROOM  TB @ TB# @ + C!  1 TB# +! ;
: )TXT ( --- item )   TB @ TB# @ TXT ;
: JOIN ( item item --- text )   D-TEXT SWAP D-TEXT SWAP 2 R-CONCAT K-TEXT R-BOX ;   \ side by side - + is arithmetic only (870)

\ ---- a command's arguments: a list, @ spreading a list into it ----
: ARGL ( --- list )   R-NEW-LIST K-LIST R-BOX ;
: ARG ( list item --- list )   OVER CELL+ @ R-PUSH ;
: ARG@ ( list spread --- list )
  DUP D-KIND K-LIST <> IF S" cm: @ spreads a list - this is not one" R-FAIL THEN
  CELL+ @  DUP @ 0 ?DO  DUP R-ITEMS I CELLS + @  2 PICK CELL+ @ R-PUSH  LOOP DROP ;
: ARG@1 ( list item --- list )   DUP D-KIND K-LIST = IF ARG@ ELSE ARG THEN ;   \ @(cmd)[k]: spread if a list, else one word (913)
: #ARGS ( list --- n )   CELL+ @ @ ;
: ARGN ( list i --- item )   SWAP CELL+ @ R-ITEMS SWAP CELLS + @ ;
: ARGS>S ( list --- a1 .. ak k )   DUP #ARGS DUP >R 0 ?DO  DUP I ARGN SWAP  LOOP DROP R> ;
: BLK-CALL ( args block --- )   >R ARGS>S R> BLK-RUN ;   \ a block given its arguments as a list

\ ---- the builtins ----
: ECHO ( args --- )   DUP #ARGS 0 ?DO  I IF BL OUT-EMIT THEN  DUP I ARGN SHOW  LOOP DROP R-NL ;   \ a newline, no carriage return (882): files and pipes get lines
: PUTS ( args --- )   DUP #ARGS 0 ?DO  DUP I ARGN PUT  LOOP DROP ;
: APPEND ( list args --- )   SWAP D-LIST SWAP  DUP #ARGS 0 ?DO  DUP I ARGN  2 PICK R-PUSH  LOOP 2DROP ;
: COUNT-OF ( args --- )   DUP #ARGS 1 <> IF S" cm: count takes no words after it - $v count" R-FAIL THEN  0 ARGN
  DUP D-KIND DUP K-LIST = IF DROP CELL+ @ @ ELSE DUP K-REC = IF DROP CELL+ @ @ @ ELSE
  K-TEXT = IF CELL+ @ R-T@ U-COUNT ELSE S" cm: count takes a list, a map or a text - count of a number's digits is count of its text" R-FAIL THEN THEN THEN  D-NUM PUT ;
: RANGE-OF ( args --- )   DUP #ARGS 1 <> IF S" cm: range takes one number" R-FAIL THEN
  0 ARGN D>N 0 MAX 0 ?DO I D-NUM PUT LOOP ;   \ none for a negative, as for 0 (966: ?DO ran -1 times round, for ever)
: MERGE-OF ( args --- )   \ $a merge $b: a new map, a's entries, b's over them - the top level copied
  DUP #ARGS 2 <> IF S" cm: merge takes one map - $m merge $m2" R-FAIL THEN
  R-NEW-RECORD K-REC R-BOX  SWAP
  2 0 DO  DUP I ARGN  DUP D-KIND K-REC <> IF S" cm: merge takes a map - $m merge $m2" R-FAIL THEN
    CELL+ @  DUP @ @ 0 ?DO  DUP @ R-ITEMS I CELLS + @  OVER CELL+ @ R-ITEMS I CELLS + @
      4 PICK ROT ROT D-SET  LOOP DROP  LOOP DROP PUT ;
\ ---- an element of a list or a map (865): a list keeps its items as they are - not boxed, as rill2's
\ D-AT and D-SET take a list's - so $l[0] read a number as a box and faulted; a map's go through D-SET
CREATE ENV-BOX 9 , 0 ,                             \ $env: the environment, as a map (870) - outside the arena
: SCRIPT-ARGS ( --- item )   R-ARGS K-LIST R-BOX ;  \ $args: the script's arguments, each a text (870)
: CM-AT ( c k --- item )   OVER ENV-BOX = IF NIP D-TEXT R-ENV K-TEXT R-BOX EXIT THEN
  OVER D-KIND K-LIST <> IF D-AT EXIT THEN  D>N SWAP D-LIST SWAP R-AT ;
: CM-DEL ( c k --- )   OVER ENV-BOX = IF NIP D-TEXT R-UNSETENV EXIT THEN  D-DEL ;   \ del env[NAME]: unset (907)
: CM-SET ( c k v --- )   2 PICK ENV-BOX = IF ROT DROP SWAP D-TEXT SWAP D-TEXT R-SETENV EXIT THEN   \ programs see it
  2 PICK D-KIND K-LIST <> IF D-SET EXIT THEN  ROT D-LIST ROT D>N R-SET ;
\ ---- the library (870): what values need and programs cannot do - split, join, keys; has, count, range,
\ merge, each above; most a value's operations since 967. Texts' other work - trimming, replacing - is sed's, cut's.
VARIABLE SPL-A  VARIABLE SPL-U  VARIABLE SPL-S  VARIABLE SPL-N
: SPL-AT ( i --- f )   SPL-A @ + SPL-N @ SPL-S @ SPL-N @ COMPARE 0= ;
: SPLIT-OF ( args --- )   \ $text split sep: each part put
  DUP #ARGS 2 <> IF S" cm: split takes one separator - $t split ','" R-FAIL THEN
  DUP 1 ARGN D-TEXT R-T@ SPL-N ! SPL-S !  0 ARGN D-TEXT R-T@ SPL-U ! SPL-A !
  SPL-N @ 0= IF S" cm: split's separator is empty" R-FAIL THEN
  0 0 BEGIN DUP SPL-N @ + SPL-U @ > 0= WHILE
    DUP SPL-AT IF  2DUP SWAP - >R OVER SPL-A @ + R> TXT PUT  SPL-N @ + NIP DUP  ELSE 1+ THEN
  REPEAT DROP  SPL-A @ OVER + SPL-U @ ROT - TXT PUT ;
: KEYS-OF ( args --- )   \ $map keys: each key put
  DUP #ARGS 1 <> IF S" cm: keys takes no words after it - $m keys" R-FAIL THEN  0 ARGN D-REC R-KEYS  DUP R-LEN 0 ?DO DUP I R-AT PUT LOOP DROP ;
4096 BUFFER: GE-BUF
: GLOB-ESC ( item --- text )   \ a value in a glob's pattern: its * ? [ and \ escaped, matched as they are (881)
  D-STR CELL+ @ R-T@  DUP 2* 4096 > IF S" cm: a value in a glob too long" R-FAIL THEN
  0 ROT ROT OVER + SWAP ?DO
    I C@ DUP [CHAR] * = OVER [CHAR] ? = OR OVER [CHAR] [ = OR SWAP [CHAR] \ = OR IF [CHAR] \ OVER GE-BUF + C! 1+ THEN
    I C@ OVER GE-BUF + C! 1+  LOOP  GE-BUF SWAP R-TEXT K-TEXT R-BOX ;
: GLOB ( text --- list )   \ an unquoted word with * or ?, an argument: the paths it matches, sorted - none an error (872)
  DUP D-TEXT R-GLOB DUP R-LEN 0= IF DROP R-ERR> ." cm: no file matches " D-TEXT R-T@ TYPE R-ERR-NL -4004 THROW THEN
  NIP K-LIST R-BOX ;
\ ---- a builtin's or a function's redirections (875): in the shell's own descriptors while it runs - each
\ one put aside first (a copy at 10 and up), put back after, the last first; a file not opened is said,
\ status 1, and the command not run, as sh does. Nested ones stack.
32 CONSTANT RDK-MAX   RDK-MAX 2* CELLS BUFFER: RDK   VARIABLE RDK#
VARIABLE RDK-CAP  RDK-MAX RDK-CAP !   ' RDK >BODY START @ - CONSTANT RDK'   \ grown when full (891)
: RDK-PUSH ( fd saved --- )   RDK# @ RDK-CAP @ = IF  RDK' BODY-OF BUF-GROW  RDK-CAP @ 2* RDK-CAP !  THEN  RDK RDK# @ 2* CELLS + TUCK CELL+ ! !  1 RDK# +! ;
: RDK-BACK ( n --- )   PAD 0 1 WRITE DROP  0 ?DO  -1 RDK# +!  RDK RDK# @ 2* CELLS + DUP CELL+ @ SWAP @  OVER SWAP DUP2 DROP CLOSE-FILE DROP  LOOP ;
: RD-FD1? ( --- f )   0 RR-N @ 0 ?DO  RR-F I CELLS + @ 1 = OR  LOOP ;
: RD-RUN ( xt --- )   \ the command, R-RD-FILE's and R-RD-DUP's redirections round it
  PAD 0 1 WRITE DROP  RR-N @ 0 ?DO
    RR-F I CELLS + @  DUP 10 DUP-FROM  RDK-PUSH
    RR-T I CELLS + @ -1 = IF  RR-M I CELLS + @  RR-F I CELLS + @  DUP2 DROP
    ELSE  I RR-OPEN IF
        DROP I RR-HD-DEL  I 1+ RDK-BACK  R-ERR> ." cm: cannot open " RR-T I CELLS + @ R-TYPE R-ERR-NL R-OUT-BACK  DROP 1 STATUS !  UNLOOP EXIT THEN
      DUP RR-F I CELLS + @ DUP2 DROP  CLOSE-FILE DROP  THEN
  LOOP  CT-ON @ >R  RD-FD1? IF 0 CT-ON ! THEN          \ stdout redirected: to its file, not $( )'s text (896)
  RR-N @ >R  CATCH  R-OUT-BACK  R> RDK-BACK  R> CT-ON !  THROW ;   \ an error told inside: its telling undone first, then
  \ the descriptors put back (961: the other way round, the prompt's stdout stayed the file - `f > out` that failed
  \ sent every later line's output there, and a script's trap's)
: D-COND ( item --- f )   \ a value as if's or while's condition: true or false, nothing else (876) - the
  DUP D-KIND K-BOOL = IF D-TRUE? DUP 0= 1 AND STATUS ! EXIT THEN   \ its status too, as a boolean command's (903);
  \ the shell's [ -f x ] is a list here, and was taken as true
  DUP D-KIND K-BLOCK = IF 0 SWAP BLK-RUN STATUS @ 0= EXIT THEN   \ a block: run, its status (901) - if $cmd { }
  D-KIND K-LIST = IF S" cm: a list is no condition - [ ] makes a list here; test -f x tests a file" R-FAIL THEN
  S" cm: a condition is a command, true or false - $(( $n != 0 )) makes one of a number" R-FAIL ;   \ (965: it had pointed
  \ at if $(( $n )), a number too)
: MATCH-OF ( args --- )   \ $text match pattern: status 0 if the whole text matches - * ? [...], as a glob's (877)
  DUP #ARGS 2 <> IF S" cm: match takes one pattern - quote it, or it is globbed" R-FAIL THEN
  DUP 0 ARGN D-TEXT SWAP 1 ARGN D-TEXT R-GLOB? 0= 1 AND STATUS ! ;
: STDIN-LINE ( --- item )   \ read name: a line of stdin, a byte at a time, so what comes after it is left for the
  PAD 0 1 WRITE DROP  0                             \ next reader - status 0, or 1 at the end with nothing read (886)
  BEGIN  DUP 4096 = IF S" cm: read: a line too long" R-FAIL THEN
    DUP GE-BUF + 1 0 READ 1 = WHILE  DUP GE-BUF + C@ 10 = IF GE-BUF SWAP R-TEXT K-TEXT R-BOX 0 STATUS ! EXIT THEN  1+
  REPEAT  DUP 0= 1 AND STATUS !  GE-BUF SWAP R-TEXT K-TEXT R-BOX ;
: GLOB-OF ( args --- )   \ glob pattern...: each path a pattern matches, sorted, put - none, none put (899): a pattern
  \ made with values, as "$dir/*.cm", since a plain word has no $ in it - and a plain word with * or ? globs still
  DUP #ARGS 0 ?DO  DUP I ARGN D-TEXT R-GLOB  DUP R-LEN 0 ?DO  DUP R-ITEMS I CELLS + @ PUT  LOOP DROP  LOOP DROP ;   \ its items boxed already
: SLICE-IDX ( i len --- i' )   SWAP OVER  OVER 0< IF + ELSE DROP THEN  0 MAX MIN ;   \ negative from the end, held to 0..len
: SLICE-AB ( args n --- a b )   \ slice's start and end, held to 0..n and the end not before the start
  OVER 1 ARGN D-NUMERIC D>N OVER SLICE-IDX >R  OVER #ARGS 3 = IF SWAP 2 ARGN D-NUMERIC D>N SWAP SLICE-IDX ELSE NIP THEN
  R> SWAP 2DUP > IF DROP DUP THEN ;
: SLICE-OF ( args --- )   \ $v slice start [end]: a list's items from start up to end, not it, put one by one - [@($l slice ..)]
  \ a new list - or a text's characters, one text; negative from the end, held to the length; no end, to the end (909)
  DUP #ARGS DUP 2 < SWAP 3 > OR IF DROP S" cm: slice takes a start, and an end or none - $v slice 1 3" R-FAIL THEN
  DUP 0 ARGN  DUP D-KIND K-TEXT = IF
    D-TEXT SWAP OVER R-T@ U-COUNT SLICE-AB                          ( t a b )
    >R >R  DUP R-T@ R> U-START  OVER R-T@ R> U-START  R-TSLICE K-TEXT R-BOX PUT EXIT  THEN
  D-LIST SWAP OVER R-LEN SLICE-AB                                   ( l a b )
  SWAP ?DO  DUP I R-AT PUT  LOOP DROP ;          \ a list's items put one by one, as split's and keys' are (888)
: KIND$ ( k --- c-addr u )   \ a kind's name, as kind says it
  DUP K-NUM = IF DROP S" number" EXIT THEN  DUP K-TEXT = IF DROP S" text" EXIT THEN  DUP K-BOOL = IF DROP S" bool" EXIT THEN
  DUP K-LIST = IF DROP S" list" EXIT THEN  DUP K-REC = IF DROP S" map" EXIT THEN  K-BLOCK = IF S" block" EXIT THEN  S" other" ;
: KIND-OF ( args --- )   \ kind value: text, number, bool, list, map or block (886)
  DUP #ARGS 1 <> IF S" cm: kind takes one value" R-FAIL THEN  0 ARGN D-KIND KIND$ TXT PUT ;
VARIABLE JOB                                       \ $job: the last job & started - its last stage's pid (905)
VARIABLE DONE  VARIABLE DONE#  VARIABLE DONE-CAP   \ jobs a plain wait reaped: [job][status] each, for a wait $job after
: DONE+ ( job status --- )
  DONE# @ DONE-CAP @ = IF  DONE-CAP @ 2* 8 MAX DUP DONE-CAP !  2* CELLS DONE @ ?DUP IF SWAP RESIZE ELSE ALLOCATE THEN THROW DONE !  THEN
  DONE @ DONE# @ 2* CELLS + TUCK CELL+ ! !  1 DONE# +! ;
: DONE? ( job --- status -1 | 0 )
  DONE# @ 0 ?DO  DONE @ I 2* CELLS +  2DUP @ = IF NIP CELL+ @ -1 UNLOOP EXIT THEN DROP  LOOP DROP 0 ;
: JOB-WAIT ( slot --- status )   \ a job's stages waited for: the rightmost failing stage's status, as a pipeline's
  0  OVER CELLS JB-NP + @ 0 ?DO  OVER I JB-PID @ R-WAIT R-DECODE ?DUP IF NIP THEN  LOOP  NIP ;
: JB-FIND ( job --- slot | -1 )   -1  JB-N @ 0 ?DO  OVER JB-KEY I CELLS + @ = IF DROP I LEAVE THEN  LOOP NIP ;
: JB-DROP ( slot --- )   \ its row taken out, those after it moved up
  >R  JB-KEY R@ 1+ CELLS +  JB-KEY R@ CELLS +  JB-N @ R@ - 1- CELLS MOVE
  JB-NP R@ 1+ CELLS +  JB-NP R@ CELLS +  JB-N @ R@ - 1- CELLS MOVE
  R@ 1+ 0 JB-PID  R@ 0 JB-PID  JB-N @ R> - 1- PL-MAX * CELLS MOVE  -1 JB-N +! ;
: WAIT-OF ( args --- )   \ wait: every job & started waited for, the status the last ended with (874); wait $job:
  PAD 0 1 WRITE DROP                               \ that one, its status - reaped by a plain wait before, kept (905)
  DUP #ARGS 0= IF  DROP  0  JB-N @ 0 ?DO  DROP I JOB-WAIT  JB-KEY I CELLS + @ OVER DONE+  LOOP  0 JB-N !  STATUS ! EXIT  THEN
  DUP #ARGS 1 > IF DROP S" cm: wait takes one job - $job - or none" R-FAIL THEN
  0 ARGN D>N  DUP JB-FIND  DUP 0< IF DROP DONE? IF STATUS ! EXIT THEN S" cm: wait: no such job" R-FAIL THEN
  NIP DUP JOB-WAIT SWAP JB-DROP STATUS ! ;
: CD-OF ( args --- )   \ cd dir - with none, $env[HOME]: a failure said, status 1, the script going on (873)
  DUP #ARGS DUP 1 > IF S" cm: cd takes one directory" R-FAIL THEN
  IF 0 ARGN D-TEXT ELSE DROP S" HOME" R-TEXT R-ENV THEN
  DUP R-CSTR CHDIR IF R-ERR> ." cm: cd: cannot change to " R-T@ TYPE R-ERR-NL 1 ELSE DROP 0 THEN STATUS ! ;
: EXIT-OF ( args --- )   \ exit [n]: the script ends - or the prompt - with n, else the last status (873)
  DUP #ARGS DUP 1 > IF S" cm: exit takes one status" R-FAIL THEN
  IF 0 ARGN D-NUMERIC D>N ELSE DROP STATUS @ THEN  R-EXIT ;
: HAS-OF ( args --- )   \ $m has key, $l has value: status 0 if the map has the key, the list the value (865) - a
  \ status, as match's, since $( ) is text (896): `if $m has $k { }`, not `if $($m has $k) { }`
  DUP #ARGS 2 <> IF S" cm: has takes one value - $m has key, $l has v" R-FAIL THEN  DUP 1 ARGN SWAP 0 ARGN D-IN D-TRUE? 0= 1 AND STATUS ! ;
: FOR-ONE ( args --- args )   \ for x $l: one value, a list - @ spreads it
  DUP #ARGS 1 = IF DUP 0 ARGN D-KIND K-LIST = IF S" cm: for over one list - @ spreads it" R-FAIL THEN THEN ;

\ ---- calls ----
: BLK-TAIL ( xt --- )   \ a block's body with return in it: its return caught, its activation put back (929)
  FP @ >R  CTL# @ >R  CATCH  R> CTL# !  R> FP !
  0 LS@ D>N  OVER T-RETURN = OVER T-TARGET @ = AND IF 2DROP 0 ELSE DROP THEN
  ACT-POP  THROW ;
CREATE CALLING 2 CELLS ALLOT                      \ the def a call with @ binds, named by its code: for an error (907)
: BIND-S ( a1 .. ak k mask --- )   \ slots k..1 from the stack's top down - in an upvalue where mask's bit is set (868)
  SWAP BEGIN ?DUP WHILE  >R  DUP 1 R@ 1- LSHIFT AND IF SWAP UPV-NEW ELSE SWAP THEN  R@ LS!  R> 1-  REPEAT DROP ;
: BIND-K ( a1 .. ak count k mask --- )   \ a block's arguments, as many as it has parameters (930)
  >R 2DUP <> IF  R-ERR> ." cm: " CALLING 2@ TYPE ."  wants " R-.N ." , given " R-.N R-ERR-NL -4004 THROW  THEN
  DROP R> BIND-S ;
: TESTING+ ( --- )   1 TESTING +! ;   : TESTING- ( --- )   -1 TESTING +! ;
: ?FAIL ( --- )   \ a statement's command failed, its status untested: the script ends there, with it (927)
  FAIL-ON @ 0= TESTING @ OR IF EXIT THEN
  STATUS @ R-STATUS !  R-ERR> ." cm: status " STATUS @ . ." - the script stops" R-ERR-NL  -4000 THROW ;
\ ---- a value's operations (967): $v op words - the value the command, the operation its subcommand, as a
\ program's: git commit. A list's, a map's, a text's; a block runs, a bool is its status, a number has none
: OP-NAMES ( --- c-addr u )   S" count has slice join keys merge split upper lower match" ;
10 CONSTANT OPS#
1 K-TEXT LSHIFT CONSTANT B-T   1 K-LIST LSHIFT CONSTANT B-L   1 K-REC LSHIFT CONSTANT B-M
CREATE OP-MASKS   \ the kinds each is for, a bit each
  B-L B-M OR B-T OR DUP , ,  B-L B-T OR ,  B-L ,  B-M DUP , ,  B-T DUP , DUP , DUP , ,
: OP-MASK ( i --- mask )   CELLS OP-MASKS + @ ;
: OP-NAME ( i --- c-addr u )   OP-NAMES ROT 0 ?DO  BL SCAN 1 /STRING  LOOP  2DUP BL SCAN NIP - ;
: OP# ( c-addr u --- i | -1 )   \ an operation's number
  OPS# 0 DO  2DUP I OP-NAME COMPARE 0= IF 2DROP I UNLOOP EXIT THEN  LOOP 2DROP -1 ;
: OPS. ( kind --- )   \ the operations a kind has, a blank between
  1 SWAP LSHIFT 0  OPS# 0 DO  OVER I OP-MASK AND IF DUP IF SPACE THEN I OP-NAME TYPE 1+ THEN  LOOP 2DROP ;
: OPS-SAY ( kind --- )   \ an error's end: the operations the kind has
  DUP K-NUM = IF DROP ."  - a number has no operations; $(( )) does its arithmetic" EXIT THEN
  DUP K-BOOL = IF DROP ."  - a bool has no operations; alone, as a command, it is its status" EXIT THEN
  1 OVER LSHIFT B-L B-M OR B-T OR AND 0= IF DROP ."  - it has no operations" EXIT THEN
  ."  - its operations: " OPS. ;
: A-KIND. ( kind --- )   DUP 1 8 WITHIN IF ." a " KIND$ TYPE ELSE DROP ." the value" THEN ;
: NO-OP ( kind c-addr u --- )   \ $v op: an operation its kind has not
  R-ERR> ." cm: " ROT DUP A-KIND. ."  has no " ROT ROT TYPE OPS-SAY R-ERR-NL -4004 THROW ;
: NOT-CMD ( args item --- )   \ a value as a command, no operation of its named: what it is, what it has
  D-KIND DUP K-TEXT <> IF  OVER #ARGS IF  OVER 0 ARGN DUP D-KIND K-TEXT = IF  D-TEXT R-T@ NO-OP  THEN DROP  THEN  THEN
  NIP  R-ERR> ." cm: " DUP A-KIND. ."  is a value, not a command"
  DUP K-TEXT = IF ." ; run $t runs the program it names" THEN  DUP OPS-SAY
  K-LIST = IF ." ; [ -f x ] is test -f x; @(cmd) takes a command's values, a list needs no @( )" THEN  R-ERR-NL -4004 THROW ;
DEFER OP-RUN ( args i --- )   \ the operation's word: below, once they all are
: OP-DO ( args i --- )   \ the operation, args[0] its value - of a kind it is for; the status 0, has's and match's theirs
  OVER 0 ARGN D-KIND  1 OVER LSHIFT  2 PICK OP-MASK AND 0= IF  SWAP OP-NAME NO-OP  THEN DROP
  0 STATUS !  OP-RUN ;
: OP-HINT ( c-addr u --- )   \ count, has... as a program: a value's operations - said so (967)
  2DUP OP# 0< IF 2DROP EXIT THEN  ."  - " 2DUP TYPE ."  is a value's operation: $v " TYPE ;
: ARG0! ( item args --- )   CELL+ @ R-ITEMS ! ;
: CALL-ITEM ( args item --- )   \ rule 11: a value as a command's first word - a block run, given the words after it;
  \ a bool its status; a list's, a map's or a text's operation, the word after it its name (967)
  DUP D-KIND K-BLOCK = IF BLK-CALL EXIT THEN
  OVER #ARGS IF  OVER 0 ARGN DUP D-KIND K-TEXT = IF
      D-TEXT R-T@ OP# DUP 0< 0= IF  >R OVER ARG0! R> OP-DO EXIT THEN  THEN DROP  NOT-CMD  THEN
  DUP D-KIND K-BOOL = IF NIP D-TRUE? 0= 1 AND STATUS ! EXIT THEN   \ false: status 1, not -1 (869)
  NOT-CMD ;
: CALL-VALUE ( args item --- )   S" the block" CALLING 2!  CALL-ITEM ;   \ $b x: BIND-K says "the block" (967: it said
\ the last function called by name, or faulted with none called yet)
: CALL-NAMED ( args item c-addr u --- )   \ a function called by its name (929): its arity said with the name
  CALLING 2!  DUP 0= IF  R-ERR> ." cm: " CALLING 2@ TYPE ."  is called before it is set" R-ERR-NL -4004 THROW  THEN
  CALL-ITEM ;
: PACK-ARGS ( a1 .. ak k --- list )   ARGL SWAP DUP 0 ?DO  DUP 1+ ROLL  ROT SWAP ARG SWAP  LOOP DROP ;
: CALL-NAMED-S ( a1 .. ak k item c-addr u --- )   \ the same, its arguments on the stack - none a spread (930)
  CALLING 2!  DUP 0= IF  R-ERR> ." cm: " CALLING 2@ TYPE ."  is called before it is set" R-ERR-NL -4004 THROW  THEN
  DUP D-KIND K-BLOCK = IF BLK-RUN EXIT THEN  >R PACK-ARGS R> CALL-ITEM ;

\ ---- programs (859): a command whose first word names no builtin, def or value - its words as texts
: ARG-TEXTS ( args --- l )   \ each as a text - a number its digits, true or false; a list, map or block an error (rule 12)
  ARGL SWAP  DUP #ARGS 0 ?DO  DUP I ARGN  DUP D-KIND  DUP K-LIST = OVER K-REC = OR SWAP K-BLOCK = OR
    IF  R-ERR> ." cm: a list, map or block given to a program - @ spreads a list's items"
      DROP DUP 0 ARGN D-TEXT R-T@ OP-HINT  R-ERR-NL -4004 THROW  THEN   \ count $l: count, a program, and a hint (967)
    D-STR  ROT SWAP ARG SWAP  LOOP DROP  CELL+ @ ;   \ a number given as it was (870: head -n 1 faulted)
: RD-FILE ( item mode fd --- )   ROT D-STR CELL+ @ ROT ROT R-RD-FILE ;
: PSTAGE ( args last? --- )   >R ARG-TEXTS R> PL-STAGE-L ;
: PIPE-END ( --- )   PL-CAPR @ -1 <> >R  PL-END STATUS !  R> IF R-T@ CT+ THEN ;   \ read for a $( ) (896)
: TRIM-NLS ( t --- t )   \ every trailing newline off (rule 4 of C.1)
  BEGIN  DUP @ DUP IF OVER CELL+ + 1- C@ 10 = THEN  WHILE  -1 OVER +!  REPEAT ;   \ an empty text: its 0 the flag (881:
\ it was left under one, so a capture of nothing - $(printf "") - made a broken value and the next use crashed)
: PIPE-TEXT ( --- item )   PL-END STATUS !  TRIM-NLS K-TEXT R-BOX ;
: NL-AT ( c-addr u --- i )   \ the first newline's place, or u
  TUCK 0 ?DO  DUP I + C@ 10 = IF 2DROP I UNLOOP EXIT THEN  LOOP  DROP ;
: LINES+ ( list c-addr u --- list )   \ each line of the text, a text, onto the list
  BEGIN DUP WHILE
    2DUP NL-AT  >R  OVER R@ TXT  3 PICK SWAP ARG DROP                    ( list c-addr u )  ( R: i )
    R> 1+ OVER MIN  TUCK - >R + R>                                      ( list c-addr' u' )
  REPEAT 2DROP ;
: TEXT-LINES ( item --- list )   CELL+ @ R-T@  ARGL ROT ROT LINES+ ;   \ a text's lines, each a text
: PIPE-LINES ( --- list )   PIPE-TEXT TEXT-LINES ;   \ @( ): a program's lines

\ ---- trap { block } [EXIT INT TERM HUP] (910): the block run when the script ends - normally, by exit, by an
\ error, or by a signal it names, which then ends it, status 128 + the signal - as sh's trap is mostly used, to
\ clean up. A new trap replaces the last. Rill's on EXIT's machinery: R-ON-EXIT-XT, run by R-BOOT
: TRAP-RUN ( --- )   TRAP-BLK @ ?DUP IF  0 TRAP-BLK !  MAIN-TOP @ LS# @ MAX LS# !  0 SINK# !  0 CT-ON !  0 CT-LEN !
  0 CT-HELD !  -1 CT-ARM !
  0 SWAP BLK-RUN  THEN ;   \ to stdout, as the prompt's next line goes: an error inside $( ) had left its capture on (961)
VARIABLE TRAP-XT   ' TRAP-RUN TRAP-XT !XT
: TRAP-SIG ( c-addr u --- )
  2DUP S" EXIT" COMPARE 0= IF 2DROP EXIT THEN
  2DUP S" INT" COMPARE 0= IF 2DROP 2 ELSE 2DUP S" TERM" COMPARE 0= IF 2DROP 15 ELSE 2DUP S" HUP" COMPARE 0= IF 2DROP 1
  ELSE 2DROP S" cm: trap: EXIT, INT, TERM or HUP" R-FAIL THEN THEN THEN  2 SIGNAL-ACTION DROP  -1 SIG-ON ! ;
: TRAP-OF ( args --- )
  DUP #ARGS 0= IF DROP S" cm: trap { block } EXIT INT TERM HUP" R-FAIL THEN
  DUP 0 ARGN DUP D-KIND K-BLOCK <> IF 2DROP S" cm: trap takes a block first" R-FAIL THEN  TRAP-BLK !
  DUP #ARGS 1 ?DO  DUP I ARGN D-TEXT R-T@ TRAP-SIG  LOOP DROP
  TRAP-XT @XT R-ON-EXIT-XT !  0 STATUS ! ;

\ ---- upper text, lower text (913): each character mapped by Unicode's simple case mapping - cm/case.4, made
\ by tools/gen-case.py: É from é, Ж from ж, Σ from σ and ς; a character with none, as it is; ß stays ß, as a
\ simple mapping keeps a text's length in characters. A stray byte is itself, as count and slice have it
VARIABLE C-CP  VARIABLE C-B
: C-ENT ( i --- e )   CELLS C-B @ + @ ;
: CASE-OF ( cp tbl --- cp' )   \ the range whose start is the last at or before cp: its delta, if cp is in it
  SWAP C-CP !  DUP CELL+ C-B !  @  0 SWAP                                     ( lo hi )
  BEGIN 2DUP < WHILE  2DUP + 2/  DUP C-ENT 2097151 AND C-CP @ > IF NIP ELSE 1+ ROT DROP SWAP THEN  REPEAT
  DROP 1-  DUP 0< IF DROP C-CP @ EXIT THEN  C-ENT                               ( e )
  DUP 2097151 AND  C-CP @ SWAP -                                              ( e off )
  OVER 21 RSHIFT 2047 AND OVER < IF 2DROP C-CP @ EXIT THEN                    \ past its length
  OVER 32 RSHIFT 1 AND IF DUP 1 AND IF 2DROP C-CP @ EXIT THEN THEN           \ every other point only
  DROP 33 RSHIFT 524288 -  C-CP @ + ;
: U-PUT ( cp --- )   \ its UTF-8 bytes, into the text being made (TXT-C)
  DUP 128 < IF TXT-C EXIT THEN
  DUP 2048 < IF DUP 6 RSHIFT 192 OR TXT-C 63 AND 128 OR TXT-C EXIT THEN
  DUP 65536 < IF DUP 12 RSHIFT 224 OR TXT-C DUP 6 RSHIFT 63 AND 128 OR TXT-C 63 AND 128 OR TXT-C EXIT THEN
  DUP 18 RSHIFT 240 OR TXT-C DUP 12 RSHIFT 63 AND 128 OR TXT-C DUP 6 RSHIFT 63 AND 128 OR TXT-C 63 AND 128 OR TXT-C ;
VARIABLE CASE-T
: CASE-MAP ( c-addr u tbl --- item )   \ the text, each character mapped
  CASE-T !  TXT(
  BEGIN DUP WHILE  2DUP U-CP >R  CASE-T @ CASE-OF U-PUT  R> /STRING  REPEAT 2DROP  )TXT ;
: CASE-ARG ( args --- c-addr u )   DUP #ARGS 1 <> IF DROP S" cm: upper and lower take no words after them - $t upper" R-FAIL THEN  0 ARGN D-TEXT R-T@ ;
: UPPER-OF ( args --- )   CASE-ARG CASE-UP CASE-MAP PUT ;
: LOWER-OF ( args --- )   CASE-ARG CASE-LO CASE-MAP PUT ;
: JOIN-M ( args --- )   \ $l join sep: one text, sep between the list's items' texts - in one buffer (917)
  DUP #ARGS 2 <> IF S" cm: join takes one separator - $l join ', '" R-FAIL THEN
  DUP 0 ARGN D-LIST  TXT(
  DUP R-LEN 0 ?DO  I IF OVER 1 ARGN D-TEXT R-T@ TXT+ THEN  DUP I R-AT D-TEXT R-T@ TXT+  LOOP  2DROP  )TXT PUT ;
CREATE OP-XTS  OPS# CELLS ALLOT   \ each operation's word, in OP-NAMES' order - as offsets (!XT): the image is reloaded
: OP-XT! ( xt i --- )   CELLS OP-XTS + !XT ;
' COUNT-OF 0 OP-XT!  ' HAS-OF 1 OP-XT!  ' SLICE-OF 2 OP-XT!  ' JOIN-M 3 OP-XT!  ' KEYS-OF 4 OP-XT!
' MERGE-OF 5 OP-XT!  ' SPLIT-OF 6 OP-XT!  ' UPPER-OF 7 OP-XT!  ' LOWER-OF 8 OP-XT!  ' MATCH-OF 9 OP-XT!
: OP-RUN' ( args i --- )   CELLS OP-XTS + @XT EXECUTE ;   ' OP-RUN' IS OP-RUN
: NO-PROG ( c-addr u --- )   2DUP R-NO-PROG' OP-HINT ;   ' NO-PROG IS R-NO-PROG
: CALL-METHOD ( args i --- )   \ $v op words, op a bare word naming an operation: args[0] the value, then the words -
  OVER CELL+ @ R-ITEMS @ D-KIND  1 OVER LSHIFT  2 PICK OP-MASK AND IF  DROP 0 STATUS ! OP-RUN' EXIT THEN   \ its kind's, run
  K-BLOCK = IF  OVER 0 ARGN >R  OP-NAME TXT OVER ARG0!  R> CALL-VALUE EXIT THEN  OP-DO ;   \ a block given op; else the error
