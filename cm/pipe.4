\ cm/pipe.4 - the command model's runtime, step 4 decided for size (862): pipelines with functions
\ in them, buffered - docs/COMMAND-MODEL.md, "Step 4, decided for size". Loaded after cm/lib.4.
\ A function stage runs to its end in the shell's process, keeping its side effects; its input is a
\ list, read with each. Its values go on as a list to a function after it; to a program after it, its
\ output - values as lines, echo's text with them, in order - goes to a temporary file the program
\ reads. A program before a function is read whole, its lines the function's input.

64 CONSTANT IN-MAX
IN-MAX CELLS BUFFER: INS   VARIABLE IN#
VARIABLE IN-CAP  IN-MAX IN-CAP !   ' INS >BODY START @ - CONSTANT INS'   \ grown when full (891)
: INPUT ( --- list|0 )   IN# @ IF INS IN# @ 1- CELLS + @ ELSE 0 THEN ;   \ a stage's; 0, none: stdin (977)
: IN-PUSH ( list --- )
  IN# @ IN-CAP @ < 0= IF  INS' BODY-OF BUF-GROW  IN-CAP @ 2* IN-CAP !  THEN  INS IN# @ CELLS + !  1 IN# +! ;
VARIABLE HELD                                      \ runtime words holding the arena by hand while user code runs (918)
: LINE-IN ( --- item -1 | 0 )   \ a line of stdin, any length, a byte at a time - what follows left for the
  PAD 0 1 WRITE DROP  TXT( 0                         \ next reader, as read's; none at the end (977)
  BEGIN  PAD 1 0 READ 1 = WHILE  PAD C@ DUP 10 = IF 2DROP )TXT -1 EXIT THEN  TXT-C 1+  REPEAT
  )TXT SWAP IF -1 ELSE DROP 0 THEN ;
\ each name { body } (977): a loop, as for's - the stage's values, or stdin's lines where there is no stage's
\ input: a pipeline's first stage, a function not in a pipeline, the script. Its body had been a block called
\ with each value - break an error in it, return its continue - and with no stage's input it read nothing
: C-EACH-IN ( elem id xt --- )   \ stdin's lines; break, continue and return as for's
  >R  ACT-PUSH D-NUM SWAP LS!                                       ( elem )  ( R: xt )
  BEGIN  LINE-IN  WHILE
    OVER LS!  R@ CATCH  ?DUP IF
      DUP T-BREAK MINE? IF 2DROP R> DROP ACT-POP EXIT THEN
      DUP T-CONTINUE MINE? 0= IF NIP R> DROP ACT-POP THROW THEN  DROP
    THEN
  REPEAT  DROP R> DROP ACT-POP ;
: C-EACH-IN-PLAIN ( elem xt --- )   >R BEGIN LINE-IN WHILE OVER LS! R@ EXECUTE REPEAT DROP R> DROP ;
: C-EACH ( src elem id xt --- )   INPUT ?DUP IF 4 PICK LS! C-FOR EXIT THEN  2SWAP NIP ROT ROT C-EACH-IN ;
: C-EACH-PLAIN ( src elem xt --- )   INPUT ?DUP IF 3 PICK LS! C-FOR-PLAIN EXIT THEN  ROT DROP C-EACH-IN-PLAIN ;
VARIABLE TMP#
: TMP-PATH ( --- text )   1 TMP# +!  S" /tmp/cm" TXT GETPID D-NUM JOIN S" ." TXT JOIN TMP# @ D-NUM JOIN ;
: PATH$ ( text --- c-addr u )   CELL+ @ R-T@ ;
: DEL-PATH ( text --- )   PATH$ DELETE-FILE DROP ;
: HD-FILE ( item --- path )   \ a here-document (963): its text in a temporary file - opened, and taken away, by the
  TMP-PATH >R  R@ PATH$ W/O CREATE-FILE IF S" cm: cannot make a temporary file" R-FAIL THEN    \ redirection
  SWAP D-STR CELL+ @ R-T@ 2 PICK WRITE-FILE DROP  CLOSE-FILE DROP  R> ;                     \ (RR-OPEN, mode -2)
\ A function's stage after another (882): its input, a list, is its stdin too while it runs - its lines in
\ a temporary file - so a program in it reads them, as `cmd | f` does in sh; each reads the list. The
\ first stage's input is 0: none, stdin as it was.
CREATE LF1 10 C,
: IN-FILE ( list --- path )   \ the input's lines in a temporary file
  TMP-PATH >R  R@ PATH$ W/O CREATE-FILE IF S" cm: cannot make a temporary file" R-FAIL THEN    ( list fid )
  OVER #ARGS 0 ?DO  OVER I ARGN D-STR CELL+ @ R-T@ 2 PICK WRITE-FILE DROP  LF1 1 2 PICK WRITE-FILE DROP  LOOP
  CLOSE-FILE DROP DROP R> ;
: STAGE-IN ( list|0 --- list' saved path | 0 0 0 )   \ the stage's stdin from its input, the old one kept;
  ?DUP 0= IF 0 0 0 EXIT THEN                           \ none, the first stage's: 0 - stdin as it was, each's (977)
  DUP IN-FILE  DUP PATH$ R/O OPEN-FILE IF S" cm: cannot read a temporary file" R-FAIL THEN   ( list path fid )
  PAD 0 1 WRITE DROP  0 10 DUP-FROM  OVER 0 DUP2 DROP  SWAP CLOSE-FILE DROP  SWAP ;        ( list saved path )
: STAGE-OUT ( saved path --- )   ?DUP IF  OVER 0 DUP2 DROP  SWAP CLOSE-FILE DROP  DEL-PATH  ELSE DROP THEN ;
\ A pipeline's status (968): its rightmost failing stage's, every stage's counted - a function's or a builtin's as a
\ program's. PST holds it for a pipeline with a function's stage: PST( first, PST+ after each stage, )PST last -
\ the outer pipeline's kept on the stack meanwhile; a function's stage keeps it round itself, for a pipeline
\ inside it left by a throw. A pipeline of programs alone: PL-END's, as it was. Before 968, `false | cat` was 0
VARIABLE PST
: PST( ( --- old )   PST @  0 PST ! ;
: PST+ ( --- )   STATUS @ ?DUP IF PST ! THEN ;
: )PST ( old --- )   PST @ STATUS !  PST ! ;
: )PST-V ( old item --- item )   SWAP )PST ;   \ ended in a capture's value
: FN-RUN ( list|0 xt --- )   \ a function stage, its values to the output it is in
  PST @ >R  SWAP STAGE-IN >R >R  IN-PUSH  CATCH  -1 IN# +!  R> R> STAGE-OUT  R> PST !  THROW ;
VARIABLE XT-CAPTURE  ' CAPTURE XT-CAPTURE !XT      \ !XT and @XT: an xt that survives a saved image (742)
VARIABLE XT-FN-RUN   ' FN-RUN XT-FN-RUN !XT
: OUT-TO ( path --- kept fid )   \ stdout to a new file at path, the old one kept
  PATH$ W/O CREATE-FILE IF S" cm: cannot make a temporary file" R-FAIL THEN
  PAD 0 1 WRITE DROP  1 10 DUP-FROM  OVER 1 DUP2 DROP  SWAP ;
: OUT-BACK ( kept fid --- )   PAD 0 1 WRITE DROP  CLOSE-FILE DROP  DUP 1 DUP2 DROP  CLOSE-FILE DROP ;
: FN-LIST ( list|0 xt --- list' )   \ a function stage before another function: its values a list for it, and
  TMP-PATH DUP >R OUT-TO >R >R                     \ after them the lines it prints - echo's, its programs' (882)
  SWAP STAGE-IN >R >R  IN-PUSH  CT-ON @ >R 0 CT-ON !  PST @ >R  XT-CAPTURE @XT CATCH  R> PST !  R-OUT-BACK  R> CT-ON !
  -1 IN# +!  R> R> STAGE-OUT
  R> R> OUT-BACK
  ?DUP IF NIP R> DEL-PATH THROW THEN
  R@ PATH$ R-SLURP 2DUP >R >R LINES+  R> R> DROP FREE DROP  R> DEL-PATH ;
: FN>FILE ( list xt --- path )   \ a function stage before a program: its output into a temporary file
  0 SINK+                         \ its values printed, as at the terminal: into the file - pushed first, as its
  TMP-PATH >R                     \ depth's check may fail (961: after the redirection, it left stdout the file)
  R@ PATH$ W/O CREATE-FILE IF S" cm: cannot make a temporary file" R-FAIL THEN    ( list xt fid )
  PAD 0 1 WRITE DROP  1 10 DUP-FROM  OVER 1 DUP2 DROP                          ( list xt fid kept )
  2SWAP CT-ON @ >R 0 CT-ON !  XT-FN-RUN @XT CATCH  R-OUT-BACK  R> CT-ON !  DUP IF >R 2DROP R> THEN   \ into its file (896);
  \ FN-RUN keeps PST round it
  -1 SINK# +!  PAD 0 1 WRITE DROP  OVER 1 DUP2 DROP  SWAP CLOSE-FILE DROP      ( fid code )
  SWAP CLOSE-FILE DROP  R> SWAP ?DUP IF OVER DEL-PATH NIP THROW THEN ;
: CAPTURE-TEXT ( i*x xt --- j*x item )   \ $( ) of all but a pipeline ending in a program (896): what it prints -
  \ echo's, its programs', the values nobody takes, in their printed form - one text, trailing newlines off,
  \ as sh's $( ) and a program's; @( ) takes values. Had been one value, an error for none or several (868).
  \ Made in CT-BUF, after what an outer one has made so far, and taken off it at the end
  0 SINK+  CT-OWN  CT-ARM @ >R  -1 CT-ARM !  CT-LEN @ >R  CT-ON @ >R  -1 CT-ON !   \ the sink first: its depth's
  CATCH  -1 SINK# +!                                                              \ check may fail (961)
  R-OUT-BACK                                         \ an error told inside: its telling undone here
  R> CT-ON !
  ?DUP IF  R> CT-LEN !  R> CT-ARM !  0 CT-HELD !  THROW  THEN   \ a number an inner one held, gone with it (964)
  CT-BUF @ R@ +  CT-LEN @ R@ -  R-TEXT  R> CT-LEN !  R> CT-ARM !  TRIM-NLS K-TEXT R-BOX ;
: CAPTURE-TEXT-P ( i*x xt --- j*x item )   \ CAPTURE-TEXT with no break, continue or return inside: no CATCH -
  0 SINK+  CT-OWN  CT-ARM @ >R  -1 CT-ARM !  CT-LEN @ >R  CT-ON @ >R  -1 CT-ON !   \ an error goes up to the top,
  EXECUTE  -1 SINK# +!  R> CT-ON !                                         \ which puts CT-ON and CT-LEN back
  CT-BUF @ R@ +  CT-LEN @ R@ -  R-TEXT  R> CT-LEN !  R> CT-ARM !  TRIM-NLS K-TEXT R-BOX ;
: CAPTURE-NUM ( i*x xt --- j*x item )   \ $( ) in (( )) (964): CAPTURE-TEXT-P's, but its first put, a number made
  0 SINK+  CT-OWN  CT-ARM @ >R  CT-LEN @ DUP CT-ARM ! >R  CT-ON @ >R  -1 CT-ON !       \ before any byte, held
  EXECUTE  -1 SINK# +!  R> CT-ON !
  CT-HELD @ ?DUP IF  0 CT-HELD !  R> DROP  R> CT-ARM !  EXIT THEN    \ nothing made after it: the number itself, the
  CT-BUF @ R@ +  CT-LEN @ R@ -  R-TEXT  R> CT-LEN !  R> CT-ARM !  TRIM-NLS K-TEXT R-BOX ;   \ text it prints as read

\ ---- a loop's turn (917): its signal look, and a collection when nothing holds the arena by hand. A loop at the
\ script's top level - its frame the main one, no capture, no function stage, no text being made - holds
\ only slots' numbers on the stacks between turns, so the collector may move what it likes; elsewhere, as
\ before, only between top-level statements. A text grown a character at a time in such a loop had run
\ out of the arena's 128 MB: nothing was collected until the loop ended
: R-TURN ( --- )   SIG-ON @ IF R-SIG-POLL THEN       \ in a def or a block too (918): what holds the arena by
  SINK# @ 0= IN# @ 0= AND CT-ON @ 0= AND HELD @ 0= AND IF R-GC? THEN ;   \ hand - a capture, a stage, each - says so

\ ---- forth words values... (924): Forth run in rill3's own image - its words, and any the script defined
\ before, there by name. The values go first onto Forth's stack: a whole number, or a text that reads as
\ one, a cell; another text its address and length; true and false -1 and 0. The words are then
\ EVALUATEd, and the cells they leave above the values' are put, deepest first, as numbers. What Forth
\ prints is the command's output - inside $( ), written to a file and read back, as TYPE is the engine's.
\ An error - an undefined word, an abort - says the kernel's message and fails the command
VARIABLE FT-ARGS  VARIABLE FT-BASE  VARIABLE FT-N  VARIABLE FT-PATH  VARIABLE FT-FID  VARIABLE FT-KEPT  VARIABLE XT-EVAL   ' EVALUATE XT-EVAL !XT
: FT-PUSH ( item --- x | c-addr u )
  D-NUMERIC  DUP 1 AND IF 2/ EXIT THEN
  DUP D-KIND K-NUM = IF D>N EXIT THEN  DUP D-KIND K-TEXT = IF D-TEXT R-T@ EXIT THEN
  DUP D-KIND K-BOOL = IF D-TRUE? EXIT THEN
  DROP S" cm: forth's values are numbers, texts, true and false" R-FAIL ;
: FT-RUN ( --- x* code )   \ the values pushed, the words run: its THROW code, or 0, above what it left
  DEPTH FT-BASE !  FT-ARGS @ #ARGS 1 ?DO  FT-ARGS @ I ARGN FT-PUSH  LOOP
  FT-ARGS @ 0 ARGN D-TEXT R-T@  XT-EVAL @XT CATCH ;
: FT-RESULTS ( x* --- )   \ what it left, put as numbers, deepest first
  DEPTH FT-BASE @ - DUP 0< IF S" cm: forth took more from its stack than it was given" R-FAIL THEN  FT-N !
  FT-N @ 0 ?DO  FT-N @ 1- I - PICK N>ITEM-D PUT  LOOP  FT-N @ 0 ?DO DROP LOOP ;
: FT-FAILED ( code --- )   \ the command fails, status 1, as a program would - the script goes on
  >R  BEGIN DEPTH FT-BASE @ > WHILE DROP REPEAT
  R-ERR> ." cm: forth: error " R> DUP >R ABS 0 <# #S R> SIGN #> TYPE R-ERR-NL R-OUT-BACK  1 STATUS ! ;
: FORTH-OF ( args --- )
  DUP #ARGS 0= IF DROP S" cm: forth takes Forth's words, then values for its stack" R-FAIL THEN  FT-ARGS !
  CT-ON @ IF                                             \ in $( ): Forth's TYPE to a file, then into the text
    TMP-PATH DUP FT-PATH !  OUT-TO FT-FID ! FT-KEPT !  0 CT-ON !  FT-RUN  -1 CT-ON !  FT-KEPT @ FT-FID @ OUT-BACK
    FT-PATH @ PATH$ R-SLURP 2DUP CT+ DROP FREE DROP  FT-PATH @ DEL-PATH
  ELSE FT-RUN THEN
  ?DUP IF FT-FAILED EXIT THEN  FT-RESULTS  0 STATUS ! ;
