\ cm/pipe.4 - the command model's runtime, step 4 decided for size (862): pipelines with functions
\ in them, buffered - docs/COMMAND-MODEL.md, "Step 4, decided for size". Loaded after cm/lib.4.
\ A function stage runs to its end in the shell's process, keeping its side effects; its input is a
\ list, read with each. Its values go on as a list to a function after it; to a program after it, its
\ output - values as lines, echo's text with them, in order - goes to a temporary file the program
\ reads. A program before a function is read whole, its lines the function's input.

64 CONSTANT IN-MAX
IN-MAX CELLS BUFFER: INS   VARIABLE IN#
VARIABLE IN-CAP  IN-MAX IN-CAP !   ' INS >BODY START @ - CONSTANT INS'   \ grown when full (891)
: INPUT ( --- list )   IN# @ IF INS IN# @ 1- CELLS + @ ELSE ARGL THEN ;
: IN-PUSH ( list --- )
  IN# @ IN-CAP @ < 0= IF  INS' BODY-OF BUF-GROW  IN-CAP @ 2* IN-CAP !  THEN  INS IN# @ CELLS + !  1 IN# +! ;
: EACH-OF ( args --- )   \ each {|x| ... }: the block, run with each value of the function's input
  DUP #ARGS 1 <> IF S" cm: each takes one block" R-FAIL THEN  0 ARGN  INPUT
  DUP #ARGS 0 ?DO  ARGL OVER I ARGN ARG  2 PICK BLK-CALL  LOOP 2DROP ;
VARIABLE TMP#
: TMP-PATH ( --- text )   1 TMP# +!  S" /tmp/cm" TXT GETPID D-NUM JOIN S" ." TXT JOIN TMP# @ D-NUM JOIN ;
: PATH$ ( text --- c-addr u )   CELL+ @ R-T@ ;
: DEL-PATH ( text --- )   PATH$ DELETE-FILE DROP ;
\ A function's stage after another (882): its input, a list, is its stdin too while it runs - its lines in
\ a temporary file - so a program in it reads them, as `cmd | f` does in sh; each reads the list. The
\ first stage's input is 0: none, stdin as it was.
CREATE LF1 10 C,
: IN-FILE ( list --- path )   \ the input's lines in a temporary file
  TMP-PATH >R  R@ PATH$ W/O CREATE-FILE IF S" cm: cannot make a temporary file" R-FAIL THEN    ( list fid )
  OVER #ARGS 0 ?DO  OVER I ARGN D-STR CELL+ @ R-T@ 2 PICK WRITE-FILE DROP  LF1 1 2 PICK WRITE-FILE DROP  LOOP
  CLOSE-FILE DROP DROP R> ;
: STAGE-IN ( list|0 --- list' saved path | list' 0 0 )   \ the stage's stdin from its input, the old one kept
  ?DUP 0= IF ARGL 0 0 EXIT THEN
  DUP IN-FILE  DUP PATH$ R/O OPEN-FILE IF S" cm: cannot read a temporary file" R-FAIL THEN   ( list path fid )
  PAD 0 1 WRITE DROP  0 10 DUP-FROM  OVER 0 DUP2 DROP  SWAP CLOSE-FILE DROP  SWAP ;        ( list saved path )
: STAGE-OUT ( saved path --- )   ?DUP IF  OVER 0 DUP2 DROP  SWAP CLOSE-FILE DROP  DEL-PATH  ELSE DROP THEN ;
: FN-RUN ( list|0 xt --- )   \ a function stage, its values to the output it is in
  SWAP STAGE-IN >R >R  IN-PUSH  CATCH  -1 IN# +!  R> R> STAGE-OUT  THROW ;
VARIABLE XT-CAPTURE  ' CAPTURE XT-CAPTURE !XT      \ !XT and @XT: an xt that survives a saved image (742)
VARIABLE XT-FN-RUN   ' FN-RUN XT-FN-RUN !XT
: OUT-TO ( path --- kept fid )   \ stdout to a new file at path, the old one kept
  PATH$ W/O CREATE-FILE IF S" cm: cannot make a temporary file" R-FAIL THEN
  PAD 0 1 WRITE DROP  1 10 DUP-FROM  OVER 1 DUP2 DROP  SWAP ;
: OUT-BACK ( kept fid --- )   PAD 0 1 WRITE DROP  CLOSE-FILE DROP  DUP 1 DUP2 DROP  CLOSE-FILE DROP ;
: FN-LIST ( list|0 xt --- list' )   \ a function stage before another function: its values a list for it, and
  TMP-PATH DUP >R OUT-TO >R >R                     \ after them the lines it prints - echo's, its programs' (882)
  SWAP STAGE-IN >R >R  IN-PUSH  CT-ON @ >R 0 CT-ON !  XT-CAPTURE @XT CATCH  R> CT-ON !  -1 IN# +!  R> R> STAGE-OUT
  R> R> OUT-BACK
  ?DUP IF NIP R> DEL-PATH THROW THEN
  R@ PATH$ R-SLURP 2DUP >R >R LINES+  R> R> DROP FREE DROP  R> DEL-PATH ;
: FN>FILE ( list xt --- path )   \ a function stage before a program: its output into a temporary file
  TMP-PATH >R
  R@ PATH$ W/O CREATE-FILE IF S" cm: cannot make a temporary file" R-FAIL THEN    ( list xt fid )
  PAD 0 1 WRITE DROP  1 10 DUP-FROM  OVER 1 DUP2 DROP                          ( list xt fid kept )
  0 SINK+                                               \ its values printed, as at the terminal: into the file
  2SWAP CT-ON @ >R 0 CT-ON !  XT-FN-RUN @XT CATCH  R> CT-ON !  DUP IF >R 2DROP R> THEN   \ into its file (896)                               ( fid kept code )
  -1 SINK# +!  PAD 0 1 WRITE DROP  OVER 1 DUP2 DROP  SWAP CLOSE-FILE DROP      ( fid code )
  R-OUT-KEPT @ ?DUP IF CLOSE-FILE DROP 0 R-OUT-KEPT ! THEN   \ an error told inside: its keeping undone
  SWAP CLOSE-FILE DROP  R> SWAP ?DUP IF OVER DEL-PATH NIP THROW THEN ;
: CAPTURE-TEXT ( i*x xt --- j*x item )   \ $( ) of all but a pipeline ending in a program (896): what it prints -
  \ echo's, its programs', the values nobody takes, in their printed form - one text, trailing newlines off,
  \ as sh's $( ) and a program's; @( ) takes values. Had been one value, an error for none or several (868).
  \ Made in CT-BUF, after what an outer one has made so far, and taken off it at the end
  CT-LEN @ >R  CT-ON @ >R  -1 CT-ON !  0 SINK+
  CATCH  -1 SINK# +!
  DUP IF  R-OUT-KEPT @ IF R-OUT-BACK THEN  THEN     \ an error told inside: its telling undone here
  R> CT-ON !
  ?DUP IF  R> CT-LEN !  THROW  THEN
  CT-BUF @ R@ +  CT-LEN @ R@ -  R-TEXT  R> CT-LEN !  TRIM-NLS K-TEXT R-BOX ;
: CAPTURE-TEXT-P ( i*x xt --- j*x item )   \ CAPTURE-TEXT with no break, continue or return inside: no CATCH -
  CT-LEN @ >R  CT-ON @ >R  -1 CT-ON !  0 SINK+        \ an error goes up to the top, which puts CT-ON and CT-LEN back
  EXECUTE  -1 SINK# +!  R> CT-ON !
  CT-BUF @ R@ +  CT-LEN @ R@ -  R-TEXT  R> CT-LEN !  TRIM-NLS K-TEXT R-BOX ;

\ ---- a loop's turn (917): its signal look, and a collection when nothing holds the arena by hand. A loop at the
\ script's top level - its frame the main one, no capture, no function stage, no text being made - holds
\ only slots' numbers on the stacks between turns, so the collector may move what it likes; elsewhere, as
\ before, only between top-level statements. A text grown a character at a time in such a loop had run
\ out of the arena's 128 MB: nothing was collected until the loop ended
: R-TURN ( --- )   SIG-ON @ IF R-SIG-POLL THEN
  FP @ MFP @ = SINK# @ 0= AND IN# @ 0= AND CT-ON @ 0= AND IF R-GC? THEN ;
