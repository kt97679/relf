# examples/rill/run-utf8.rill - tests/shell/run-utf8 in Rill (Iterations 731, 787)
# UTF-8 and stray high bytes through the shell under test ($THIS_SH): each
# case's stdout must be dash's, byte for byte - tests/shell/utf8-cases.txt
# holds one case a line (HEREDOC stands for a here-document with a command
# substitution in it), tests/shell/utf8.expected dash's stdout for each in
# hex, recorded with LC_ALL=C. A function named é is refused: its status.
# tests/shell/lib.sh's two helpers are here, not loaded: one file, read whole.
def check what want got -> number {   # lib.sh's assert_output_equals: 1 when it failed
    if ($got == $want) { return 0 }
    echo "FAIL: $what"
    echo "  expected exactly:"
    for l in lines($want) { echo "    $l" }
    echo "  actual:"
    for l in lines($got) { echo "    $l" }
    return 1
}
here = "{dir(dir(dir(abs($script))))}/tests/shell"   # examples/rill/ is two below the top
sh = abs(env(THIS_SH))
t = $(mktemp -d)
on EXIT { rm -rf $t }
cd $t
mkdir g; touch g/é g/ü g/aé
want = lines(read("$here/utf8.expected"))
run = 0
failed = 0
for n, line in lines(read("$here/utf8-cases.txt")) {
    if ($line == HEREDOC) { printf 'cat << EOF\né ü 日本 $(echo ä)\nEOF\n' out> case.sh } else { write(case.sh, "$line\n") }
    got = $(env LC_ALL=C $sh case.sh err> /dev/null < /dev/null | od -An -v -tx1 | tr -d ' \n')
    run += 1
    failed += check("utf8 case {$n + 1}: $line", $want[$n], $got)
}
st = code((env LC_ALL=C $sh -c 'é() { echo f; }' err> /dev/null))
run += 1
failed += check("utf8: a function named é is a syntax error, status 2", "2", "$st")
echo "$run assertions, $failed failed (run-utf8)"
if ($failed > 0) { exit 1 }
