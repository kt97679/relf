# examples/rill/intrfuzz-stress.rill - tools/intrfuzz-stress.sh in Rill (Iteration 731)
rounds = number(at($args, 0, "5"))
jobs = number(at($args, 1, $(nproc)))
out = "bench/reports/intrfuzz-stress-$(hostname)-$(date -u +%Y%m%dT%H%MZ).txt"
tmp = $(mktemp -d)
on EXIT { rm -rf $tmp }

def seed(r, j) -> number {
    if ($j == 1) { return 598 }
    return 598 + ($r - 1) * $jobs + $j - 1
}

def stress() {
    echo "intrfuzz stress, $(date -u '+%Y-%m-%d %H:%M UTC'), $(git log --oneline -1 | cut -c1-72)"
    echo "cpu: $(nproc) cores; ROUNDS=$rounds JOBS=$jobs; 20 cases a run"
    for sh in [relfsh, relfshasm64, relfsh-native] {
        if (not (test -x ./$sh)) { echo "$sh: not built, skipped"; continue }
        runs = 0; bad = 0
            for r in range(1, $rounds + 1) {
                ps = [spawn((timeout 600 python3 tools/intrfuzz.py 20 {seed($r, $j)} ./$sh all> "$tmp/out.$j")) for j in range(1, $jobs + 1)]
                for p in $ps { wait($p) }                    # the jobs side by side (819; sh -c with & and wait from 799)
                for j in range(1, $jobs + 1) {
                    runs = $runs + 1
                    f = $(sed -n 's/.*cases, \([0-9]*\) failures.*/\1/p' "$tmp/out.$j")
                    if ($f != "0") {
                        bad = $bad + 1
                        echo "--- $sh, round $r, seed {seed($r, $j)}: {default($f, 'no summary (timed out?)')} failures"
                        grep -A14 '^FAIL' "$tmp/out.$j" | head -45 ?? true   # no FAIL line (a timeout): grep says 1 (795)
                    }
                }
            }
        echo "$sh: $runs runs ({$runs * 20} cases), $bad with failures"
    }
}

stress err>out | tee $out ?? true                      # the report either way (795: a pipeline fails as its stages do)
echo "report: $out"
