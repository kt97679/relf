# examples/rill/native-by-source.rill - tools/size-research/native-by-source.py in Rill (Iteration 735)
words = {}
on = false
for l in lines($(tr a-z A-Z < /tmp/sz/budget-all.txt)) {   # the names upper case: one tr, not one a word (799)
    if (starts($l, "THE 3000 LARGEST WORDS")) { on = true; continue }
    m = match($l, '^\s+(\d+)\s+(\S+)\s+(\d+) (\d+) (\d+) (\d+) (\d+) (\d+)')
    if ($on and len($m) > 0) { words[$m[2]] = {bytes: number($m[1]), cls: [number($x) for x in slice($m, 3)]} }
}
files = [forth/extend.4, forth/safety.4, forth/pool.4, forth/shadow.4, forth/save-system.4, forth/save-system-native.4, shell/shell.4, shell/edit.4, shell/tree.4]
where = {}
for f in $files {
    section = "(start)"; ls = lines(read("/home/claude/relf/$f")); i = 0; names = []; secs = []
    while ($i < len($ls)) {
        l = $ls[$i]
        if (starts($l, '\ ====') and $i + 2 < len($ls) and starts($ls[$i + 2], '\ ====')) {
            section = slice(trim(sub($ls[$i + 1], '^[\\ ]*', "")), 0, 60); i = $i + 3
        } else {
            code = sub(sub($l, '\\ .*$|\\$', ""), '\( [^)]*\)', "")
            for d in all($code, '(?:^|\s)(?::|CODE|NCODE|VARIABLE|2VARIABLE|CONSTANT|VALUE|CREATE|DEFER|BUFFER:)\s+(\S+)') { push($names, $d); push($secs, $section) }
            i = $i + 1
        }
    }
    if ($names) {   # the names upper case, one tr for the file (799)
        for ni, nu in lines($(printf '%s\n' @names | tr a-z A-Z)) { where[$nu] = {file: $f, section: $secs[$ni]} }
    }
}
def add-to(acc, v) -> record { return {bytes: $acc[bytes] + $v[bytes], n: $acc[n] + 1, cls: [$acc[cls][$k] + $v[cls][$k] for k in range(6)]} }
byfile = {}; bysec = {}
for w, v in $words {
    at = at($where, $w, {file: kernel, section: ""})
    if ($w == "(RUNTIME)") { at = {file: runtime, section: ""} }
    byfile[$at[file]] = add-to(at($byfile, $at[file], {bytes: 0, n: 0, cls: [0, 0, 0, 0, 0, 0]}), $v)
    if (starts($at[file], shell/)) { bysec["{$at[file]} {$at["section"]}"] = add-to(at($bysec, "{$at[file]} {$at["section"]}", {bytes: 0, n: 0, cls: [0, 0, 0, 0, 0, 0]}), $v) }
}
tot = sum([$s[bytes] for f, s in $byfile])
echo "total code $tot bytes in {len($words)} words"
for f, s in $byfile { s[file] = $f }   # sort-by sorts a list of records (799)
for s in sort-by([$s for f, s in $byfile], bytes, desc) {
    printf '  %-28s %7d  %5.1f %%  %4d words   stack %4.1f %%  call %4.1f %%\n' $s[file] $s[bytes] {100.0 * $s[bytes] / $tot} $s[n] {100.0 * $s[cls][1] / max([$s[bytes], 1])} {100.0 * $s[cls][0] / max([$s[bytes], 1])}
}
echo; echo "shell sections, largest first:"
for k, s in $bysec { s[key] = $k }
for s in slice(sort-by([$s for k, s in $bysec], bytes, desc), 0, 60) { printf '  %7d %4d  %-14s %s\n' $s[bytes] $s[n] {sub(words($s[key])[0], '^.*/', '')} {slice($s[key], len(words($s[key])[0]) + 1)} }
