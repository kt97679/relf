# examples/rill/pack-results.rill - tools/pack-results.sh in Rill (Iteration 735)
cd {dir(dir(abs($script)))}
setenv(LC_ALL, C)
self = $script
opts = {clean: true, verify: false, profile: true, bench: true, apply: true}
for a in $args {
    case $a {
        --no-apply { opts[apply] = false }
        --no-clean { opts[clean] = false }
        --no-bench { opts[bench] = false }
        --no-profile { opts[profile] = false }
        --verify { opts[verify] = true }
        --no-verify { opts[verify] = false }
        -h --help { sed -n '2,/^opts = /s/^# \{0,1\}//p' $self; exit 0 }
        * { warn "pack-results: unknown argument: $a (--help lists them)"; exit 2 }
    }
}

def note text { echo $text >> "$stage/SUMMARY.txt" }
def step name cmd -> number {
    warn "== $name =="
    t0 = now()
    st = code(($cmd all> "$stage/$name.log"))
    note "step $name: status $st, {now() - $t0} s"
    return $st
}
def new-report path -> bool {
    held = "bench/reports/{base($path)}"
    return not ((git ls-files --error-unmatch $held all> /dev/null) and (cmp -s $path $held))
}
def apply-bundle -> record {
    dir = default(env(BUNDLE_DIR), "{env(HOME)}/Downloads")
    best = ""; bestn = -1
    for f in $dir/relf-claude-iter*.bundle {
        n = number(default(first(all(base($f), '^relf-claude-iter([0-9]+)-')), "-1"))
        if ($n > $bestn or ($n == $bestn and base($f) > base($best))) { best = $f; bestn = $n }
    }
    if ($best == "") { return {applied: "none in $dir", changed: false} }
    b = base($best)
    git bundle verify $best all> /dev/null ?? fail "pack-results: $best: git cannot read it whole - not applied"
    new = $(git bundle list-heads $best refs/heads/master | cut -d' ' -f1)
    if ($new == "") { fail "pack-results: $best has no master - not applied" }
    if (git merge-base --is-ancestor $new HEAD err> /dev/null) { return {applied: "$b: master already has it", changed: false} }
    if ($(git symbolic-ref -q --short HEAD ?? true) != master) { fail "pack-results: the checkout is not on master - $b not applied" }
    if ($(git status --porcelain --untracked-files=no) != "") {
        git status --short --untracked-files=no out>err
        fail "pack-results: tracked files are changed - $b not applied; commit or stash them, or --no-apply"
    }
    old = $(git rev-parse HEAD); before = $(git hash-object $self)
    try { git fetch -q $best master err> /dev/null; git merge -q --ff-only FETCH_HEAD all> /dev/null }
    else { fail "pack-results: $b does not fast-forward master (master has commits it lacks?) - not applied" }
    git fetch -q $best article-2026:article-2026 err> /dev/null ?? true
    applied = "$b applied: $(git rev-parse --short $old) -> $(git rev-parse --short HEAD)"
    warn "== $applied =="
    return {applied: $applied, changed: $(git hash-object $self) != $before}
}

git rev-parse --git-dir all> /dev/null ?? fail "pack-results: not a git checkout"
if (not $opts.apply) { applied = "not looked for (--no-apply)" }
else if (env(PACK_REEXEC) != "") { applied = "{default(env(PACK_APPLIED), '?')}; this script changed with it, and ran again" }
else {
    r = apply-bundle()
    applied = $r.applied
    if ($r.changed) {
        warn "== $self changed with the bundle: running the new one =="
        exit code((env PACK_REEXEC=1 PACK_APPLIED=$applied rill $self @args))
    }
}
host = $(uname -n); utc = $(date -u +%Y%m%dT%H%MZ); commit = $(git rev-parse --short HEAD)
pack = "$(pwd)/relf-results-$host-$commit-$utc.tar.gz"
on INT { exit 130 }
on TERM { exit 130 }
stage = $(mktemp -d)                 # the defs above read it when they run, as Python's (785)
on EXIT { rm -rf $stage }
sum = "$stage/SUMMARY.txt"
note "relf results, $(date -u)"
note "host: $host ($(uname -srm))"
note "commit: $(git log -1 --format='%H %s' | cut -c1-120)"
note "bundle: $applied"
note "arguments: {default(join($args, ' '), 'none')}; SCALE={default(env(SCALE), '25')} ROUNDS={default(env(ROUNDS), '7')}"
note "checkout before - tracked files changed (results then are not the commit's):"
git status --porcelain --untracked-files=no | sed 's/^/    /' >> $sum
mkdir -p "$stage/reports"
for r in bench-report-*.txt {
    if (new-report($r)) { cp $r "$stage/reports/"; note "report not in bench/reports/ yet, packed: $r" }
    else { note "report already in bench/reports/: $r" }
}
if ($opts.clean) {
    warn "== clean =="
    untracked = lines($(git clean -ndx | sed -n 's/^Would remove //p'))
    write("$stage/untracked.txt", join($untracked, "\n"))
    rm -rf .clean-trash.old
    if (test -d .clean-trash) { mv .clean-trash .clean-trash.old }
    mkdir -p .clean-trash
    cleaned = []
    for p in $untracked {
        case $p {
            .clean-trash/ .clean-trash.old/ { continue }
            bench-report-*.txt { if (new-report($p)) { note "clean kept: $p"; continue } }
            bench/reports/* relf-results-*.tar.gz *.bundle { note "clean kept: $p"; continue }
        }
        mkdir -p ".clean-trash/{dir($p)}"
        mv ./$p ".clean-trash/{trim-end($p, '/')}"; push($cleaned, $p)
    }
    write("$stage/cleaned.txt", join($cleaned, "\n"))
    rm -rf .clean-trash.old
    note "clean: {len($untracked)} untracked paths, {len($cleaned)} moved to .clean-trash/ (cleaned.txt)"
} else {
    untracked = lines($(git status --porcelain --ignored | sed -n -e 's/^?? //p' -e 's/^!! //p'))
    write("$stage/untracked.txt", join($untracked, "\n"))
    note "clean: skipped (--no-clean); untracked paths: {len($untracked)} (untracked.txt)"
}
if ($opts.bench) {
    report = "$(pwd)/bench-report-$host-$utc.txt"
    warn "   (tools/bench-report.sh: about ten minutes)"
    step bench (env REPORT=$report sh tools/bench-report.sh)
    if (test -f $report) { cp $report "$stage/reports/"; note "this run's report: reports/{base($report)}" }
} else {
    note "bench: skipped (--no-bench)"
    step build (make all relfsh-native)
}
if (test -x ./relfsh-native) {
    step native-written (python3 tools/native-written.py ./relfsh-native)
    if ($opts.profile) {
        wl = $(mktemp -d)
        for f in tests/bench-vm/*.sh { write("$wl/{base($f)}", sub(read($f), '-lt ([0-9]+)', '-lt \100')) }
        for w in [fn arith str realistic] { step profile-$w (python3 tools/native-prof.py ./relfsh-native "$wl/$w.sh") }
        rm -rf $wl
    }
} else { note "no relfsh-native (not x86-64, or its build failed): no memory decomposition, no profile" }
if ($opts.verify) {
    warn "   (tests/verify: some minutes)"
    step verify (sh tests/verify)
    note "verify's lines other than ok, and its last line:"
    grep -v -e '^ok ' -e '^==' -e '^$' "$stage/verify.log" | sed 's/^/    /' >> $sum
}
note "checkout after - each line should be explained (prompts/07):"
git status --porcelain | sed 's/^/    /' >> $sum
failed = all(read($sum), 'step (\S+): status [1-9]')
if (len($failed) > 0) { note "steps that failed: {join($failed, ' ')}" }
tar czf $pack -C $stage . ?? fail "pack-results: tar failed; the results were in $stage"
cat $sum
echo
if (len($failed) > 0) { echo "steps that failed: {join($failed, ' ')} - their logs are in the pack" }
echo "pack: $pack"
