# examples/rill/gen-opcodes.rill - tools/gen-opcodes.sh in Rill (Iteration 733)
dir = $(realpath "$(dirname $script)/../..")   # examples/rill/ is two below the top
tab = "$dir/engine/opcodes.tab"
ops = []
for l in lines(read($tab)) {
    w = words($l)
    if (len($w) > 0 and not starts($l, "#")) {
        push($ops, {kind: $w[0], raw: $w[1], num: number($w[1]), name: $w[2], lab: at($w, 3, ""), fmt: at($w, 4, "")})
    }
}
def byname n -> record {   # the opcode named n, or {} (782: a loop that returns)
    for x in $ops { if ($x[name] == $n and $x[kind] != escaped) { return $x } }
    return {}
}

def wrap items -> text {
    out = ""; line = "   "
    for i, p in $items {
        if (len($line) + len($p) + 3 > 76) { out = "$out$line \\\n"; line = "   " }
        sep = ","; if ($i == len($items) - 1) { sep = "" }
        line = "$line $p$sep"
    }
    return "$out$line"
}

def generate {
    d = ["&&{$x[lab]}" for x in $ops if $x[kind] == direct]
    e = ["&&{$x[lab]}" for x in $ops if $x[kind] == escaped]
    o = ["[{$x[raw]}] = &&{$x[lab]}" for x in $ops if $x[kind] not in [direct escaped]]
    echo "/*  engine/cv8-ops.h - GENERATED from engine/opcodes.tab by tools/gen-opcodes.sh."
    echo " *  Do not edit: change engine/opcodes.tab and run make. The engine's"
    echo " *  dispatch tables - the direct primitives in order, the escaped"
    echo " *  ones in order, every other opcode at its number (CV8.md 2.2).  */"
    echo "#define NDIRECT {len($d)}"; echo "#define NESC    {len($e)}"
    echo "#define CV8_OPS_DIRECT \\"; echo {wrap($d)}
    echo "#define CV8_OPS_ESCAPED \\"; echo {wrap($e)}
    echo "#define CV8_OPS_OTHER \\"; echo {wrap($o)}
    echo "#define OPC_BRANCH8 {byname(BRANCH8)[raw]}   /* the loop opcodes step over it */"
}

def rows items {
    row = ""
    for i, l in $items { row = "$row$l 0 Q,+  "; if ($i % 4 == 3) { echo $row; row = "" } }
    if ($row != "") { echo $row }
}

def forth-ops {
    op = {}; esc = []
    for x in $ops { if ($x[kind] == escaped) { push($esc, $x[lab]) } else { op[$x[num]] = $x[lab] } }
    echo '\ engine/relfasm-ops.4 - GENERATED from engine/opcodes.tab by tools/gen-opcodes.sh'
    echo "\\ --forth-ops; do not edit. The engine's two dispatch tables."
    echo "8 ALIGN,"; echo "dispatch256 L:"
    rows([at($op, $i, L_badop) for i in range(128)])
    echo ": CALL-ENTRIES ( --- ) 128 0 DO do_call 0 Q,+ LOOP ;  CALL-ENTRIES"
    echo "esc_tab L:"
    rows($esc)
    echo ": BAD-ESCAPES ( --- ) {256 - len($esc)} 0 DO L_badesc 0 Q,+ LOOP ;  BAD-ESCAPES"
}

def forth-consts {
    echo '\ engine/relfasm-consts.4 - GENERATED from engine/opcodes.tab by tools/gen-opcodes.sh'
    echo '\ --forth-consts; do not edit.'
    echo "{byname(BRANCH8)[num]} CONSTANT OPC_BRANCH8      \\ the loop opcodes step over it"
}

mode = at($args, 0, "")
if ($mode == --forth-ops) { forth-ops; exit 0 }
if ($mode == --forth-consts) { forth-consts; exit 0 }
if ($mode != --check) { generate; exit 0 }

bad = []
nd = 0; ne = 0
for x in $ops {
    if ($x[kind] == direct) { if ($x[num] != $nd) { push($bad, "direct {$x[name]} is not at $nd") }; nd = $nd + 1 }
    if ($x[kind] == escaped) { if ($x[num] != $ne) { push($bad, "selector {$x[name]} is not $ne") }; ne = $ne + 1 }
    if ($x[kind] == synth and $x[name] == LIT32 and $x[num] != $nd) { push($bad, "LIT32 is not at the direct count $nd") }
    if ($x[kind] != escaped and $x[fmt] not in ['-' u8 i8 u16 i32 u64 b8 b16 slot sel data]) { push($bad, "{$x[name]} has no known operand format (\"{$x[fmt]}\")") }
}
k4 = lines(read("$dir/forth/kernel.4"))
tabnames = [$x[name] for x in $ops if $x[kind] in [direct escaped]]
knames = [words($l)[1] for l in $k4 if match($l, '^PRIMITIVE[ \t]')]
if ($tabnames != $knames) {
    push($bad, "forth/kernel.4's PRIMITIVE lines differ from engine/opcodes.tab's direct and escaped rows:")
    for i, n in $tabnames {   # the first name that differs (782: in Rill, not diff on two process substitutions)
        if ($i >= len($knames)) { push($bad, "    $n: not in forth/kernel.4"); break }
        if ($knames[$i] != $n) { push($bad, "    engine/opcodes.tab has $n where forth/kernel.4 has {$knames[$i]}"); break }
    }
}
kdirect = 0
for l in $k4 { if (starts($l, ESCAPED)) { break }; if (match($l, '^PRIMITIVE[ \t]')) { kdirect = $kdirect + 1 } }
if ($kdirect != $nd) { push($bad, "forth/kernel.4 has $kdirect primitives before ESCAPED, engine/opcodes.tab $nd direct ones") }
for x in $ops {
    if ($x[kind] == tiny and not (grep -q "^{$x[num]} OPCODE {$x[name]}[ \t]" "$dir/forth/kernel.4")) {
        push($bad, "forth/kernel.4 does not declare `{$x[num]} OPCODE {$x[name]}`, as engine/opcodes.tab has it")
    }
}
for c in [[cross.4 EXIT-OP EXIT] [cross.4 LIT16-OP LIT] [cross.4 BRANCH-OP BRANCH] [cross.4 0BRANCH-OP ?BRANCH]
          [cross.4 LIT0-OP push0] [cross.4 VAR@-OP VAR@] [cross.4 VAR!-OP VAR!] [cross.4 ADDI-OP ADDI] [cross.4 EQI-OP EQI]
          [cross.4 LIT64-OP LIT64] [cross.4 ESC-OP ESC] [cross.4 LOOP-OP '(LOOP)'] [cross.4 BRANCH8-OP BRANCH8]
          [cross.4 0BRANCH8-OP ?BRANCH8] [shadow.4 LSAVE-OP LSAVE] [shadow.4 LRESTORE-OP LRESTORE] [shadow.4 L!-OP L!]
          [shadow.4 LZERO-OP LZERO]] {
    x = byname($c[2])
    if (len(keys($x)) == 0) { push($bad, "engine/opcodes.tab has no opcode {$c[2]}"); continue }
    if (not (grep -qE "^[ \t]*{$x[num]} CONSTANT {$c[1]}([ \t]|\$)" "$dir/forth/{$c[0]}")) { push($bad, "forth/{$c[0]}'s {$c[1]} is not {$x[num]} ({$c[2]} in engine/opcodes.tab)") }
}
if (not (generate | cmp -s - "$dir/engine/cv8-ops.h")) { push($bad, "engine/cv8-ops.h is not what engine/opcodes.tab makes: run make") }
for m in $bad { echo "gen-opcodes: $m" out>err }
if (len($bad) > 0) { echo "gen-opcodes: {len($bad)} problem(s)" out>err; exit 1 }
echo "gen-opcodes: engine/opcodes.tab, forth/kernel.4, forth/cross.4, forth/shadow.4 and engine/cv8-ops.h agree"
