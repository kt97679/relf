#!/bin/sh
# relfsh - convenience wrapper around `relf kernel.img`, giving RelF's
# shell (shell.4) a normal single-executable invocation:
#
#   relfsh -c 'command'    run one command non-interactively, exit with
#                          its status (matches `sh -c '...'`)
#   relfsh script.sh       run script.sh's contents line by line, exit
#                          with the last command's status (matches
#                          `sh script.sh`)
#   relfsh                interactive read-eval loop (matches plain `sh`)
#   ... | relfsh           script commands piped on stdin, read one per
#                          line by the interactive loop until "exit"
#
# Exists mainly so test harnesses that expect a single "the shell under
# test" executable (e.g. bash's own tests/, parameterized via a THIS_SH
# environment variable - see PROGRESS.md) can point at RelF the same
# way they'd point at any other shell binary, rather than needing to
# know RelF's own two-step "load kernel.img, then load+invoke shell.4"
# bootstrap.
#
# Startup: relfsh runs a PREBUILT image (see save-system.4), not
# kernel.img plus a source bootstrap. Compiling shadow.4 + shell.4 from
# source took ~253ms of every ~254ms invocation - measured, 50 runs
# each: this script 12.68s, bare `relf kernel.img` 0.061s. The prebuilt
# image starts in ~1.8ms, ~128x faster, which is also what makes the
# shell test suite bearable to run. The image boots straight into
# tree.4's MAIN via kernel.4's BOOT hook, so relf's own "Welcome to
# Forth" banner and QUIT's "OK" acknowledgements never appear - stdout
# is now exactly what the shell itself writes, which is what the
# mrsh-suite's byte-for-byte comparison against bash needs.
#
# The image is BUILT, never committed. A committed binary derived from
# shell.4 is a second source of truth that goes stale silently the
# moment someone edits the shell; rebuilding whenever any input is
# newer costs one 250ms compile and removes that failure mode
# entirely.
#
# How this works: relf's own argv beyond the image path (e.g. "-c",
# "command", or a script path) is exposed to Forth via the
# SYS-ARGC/SYS-ARG primitives; tree.4's MAIN word inspects those and
# either runs one command via SH-C, runs a script file via SH-FILE, or
# falls through to the ordinary interactive SH loop - see shell.4 for
# that logic. This script's job is just to feed relf the two-line
# Forth bootstrap ("load shell.4 and tree.4, then call MAIN") ahead of whatever
# else is on stdin, via `cat`, so interactive/piped-script use still
# sees its own input afterward rather than that input being consumed
# by the bootstrap step.

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1

# Overridable so the same wrapper can drive either cell-width build
# (e.g. RELF_BIN=./relf32 RELF_IMG=./kernel32.img for the i386 image -
# see tests/run_tests.sh) without needing a second copy of this script.
# bash, running a non-interactive script, clears PS1 and PS2 from the
# environment before it execs anything - so a prompt handed to this
# wrapper is lost wherever /bin/sh is bash, which is most distributions
# other than Debian's (Iteration 400 found it; 404 gives it a way
# through). RELF_PS1 and RELF_PS2 are special to no shell and survive.
if [ -n "${RELF_PS1:-}" ]; then PS1=$RELF_PS1; export PS1; fi
if [ -n "${RELF_PS2:-}" ]; then PS2=$RELF_PS2; export PS2; fi

RELF_BIN=${RELF_BIN:-"$DIR/relf"}

# Which image the native engine can actually run. A cell is a pointer:
# on a 64-bit host that is kernel.img, on a 32-bit one - ARMv7, i386 -
# it is kernel32.img, and handing the 8-byte image to a 4-byte engine
# gets "not a RelF image, or built for a different encoding or cell
# width", which is what `make` on an ARMv7 board reported
# (Iteration 397).
#
# The Makefile leaves the answer in .relf-native-img, which costs a
# builtin read; without it - a checkout that has not been built yet -
# ask getconf, which costs a process, but only that once.
if [ -z "${RELF_IMG:-}" ]; then
    if [ -f "$DIR/.relf-native-img" ]; then
        read RELF_IMG < "$DIR/.relf-native-img"
        case "$RELF_IMG" in /*) ;; *) RELF_IMG="$DIR/$RELF_IMG" ;; esac
    else
        case $(getconf LONG_BIT 2>/dev/null) in
            32) RELF_IMG="$DIR/kernel32.img" ;;
            *)  RELF_IMG="$DIR/kernel.img" ;;
        esac
    fi
fi

# Resolved against the caller's directory now, because build_shell_img
# runs the engine from a subshell that has cd'd to $DIR. A relative
# override (RELF_BIN=./relf32) would otherwise be interpreted against
# the wrong directory there. Absolute values are left untouched.
case "$RELF_BIN" in /*) ;; *) RELF_BIN="$PWD/$RELF_BIN" ;; esac
case "$RELF_IMG" in /*) ;; *) RELF_IMG="$PWD/$RELF_IMG" ;; esac

# Derived from the image name, so the same script drives either cell
# width without collision (kernel.img -> kernel-shell.img,
# kernel32.img -> kernel32-shell.img).
SHELL_IMG="${RELF_IMG%.img}-shell.img"

needs_rebuild() {
    [ -f "$SHELL_IMG" ] || return 0
    for f in "$DIR/extend.4" "$DIR/pool.4" "$DIR/shadow.4" "$DIR/save-system.4" "$DIR/shell.4" "$DIR/edit.4" "$DIR/tree.4" \
             "$RELF_IMG" "$RELF_BIN"; do
        [ "$f" -nt "$SHELL_IMG" ] && return 0
    done
    return 1
}

build_shell_img() {
    # Built to a temporary name and moved into place, so two concurrent
    # relfsh invocations can't observe a half-written image.
    #
    # The bootstrap is fed as RELATIVE filenames from a subshell that has
    # cd'd to $DIR, rather than as "$DIR/pool.4" and friends. That is not
    # cosmetic. This kernel's QUERY reads a line with `TIB 80 ACCEPT`, so
    # an input line over 80 characters loses its tail SILENTLY - no
    # diagnostic, no status. With absolute paths the longest generated
    # line was
    #     S" $DIR/kernel-shell.img.tmp.$$" SAVE-SYSTEM
    # whose length is 38 + len($DIR) + len($$), so the build broke once
    # the repository sat deeper than ~36-38 characters. Worse, the PID's
    # digit count is part of that sum, so the same checkout built or
    # failed depending on the PID it happened to get. When it failed,
    # the fallback below silently substituted the ~128x slower source
    # bootstrap, which also prints the Forth banner to stdout and so
    # breaks every output-comparing test at once, nowhere near the cause.
    #
    # Relative names make every line a fixed length, independent of where
    # the repository lives. The subshell keeps the cd local: the parent
    # must stay in the caller's directory, or a "relfsh script.sh"
    # argument would resolve against the wrong place.
    tmp_base="$(basename "$SHELL_IMG").tmp.$$"
    tmp="$DIR/$tmp_base"
    (
        cd "$DIR" || exit 1
        printf 'S" extend.4" INCLUDED\nS" pool.4" INCLUDED\nS" shadow.4" INCLUDED\nS" save-system.4" INCLUDED\nS" shell.4" INCLUDED\nS" edit.4" INCLUDED\nS" tree.4" INCLUDED\n%s MAIN SET-BOOT\nS" %s" SAVE-SYSTEM\nBYE\n' \
            "'" "$tmp_base" \
            | "$RELF_BIN" "$RELF_IMG" > "$tmp_base.log" 2>&1
    )
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp" "$tmp.log"
        return 1                        # nothing written: the fallback applies
    fi
    # Written is not the same as working. A definition that aborts part
    # way through a source file leaves every later word undefined, and
    # SAVE-SYSTEM still writes an image - with the default boot word, so
    # it starts the bare Forth prompt instead of the shell. That is what
    # the first build of ^R did (Iteration 409), and `make` reported
    # success, because the log went to /dev/null and a non-empty file
    # was the whole test. So the new image is asked to be a shell before
    # it is installed, and if it is not, the build says why (Iteration
    # 410). stdout only: a preload the loader rejects writes to stderr.
    probe=$("$RELF_BIN" "$tmp" -c 'echo relf-shell-ok' 2>/dev/null </dev/null)
    # ... and the build must not have complained at all: a definition
    # that aborts at the END of a file leaves a working shell with one
    # word missing, which the probe cannot see.
    complaint=$(tr -d '\r' < "$tmp.log" |
        grep -E 'Undefined word|[Uu]nderflow|[Oo]verflow|Can.t |not unique' | head -1)
    if [ "$probe" != relf-shell-ok ] || [ -n "$complaint" ]; then
        {
            if [ "$probe" != relf-shell-ok ]; then
                echo "relfsh: $SHELL_IMG built, but it does not start the shell."
            else
                echo "relfsh: $SHELL_IMG built, but the build reported errors."
            fi
            echo "relfsh: the build said:"
            tr -d '\r' < "$tmp.log" |
                grep -vE '^(Redefining: |OK$|Welcome to Forth)' |
                grep -v '^[[:space:]]*$' | head -20 | sed 's/^/    /'
        } >&2
        rm -f "$tmp" "$tmp.log"
        return 2                        # the sources are broken: no fallback
    fi
    mv -f "$tmp" "$SHELL_IMG"
    rm -f "$tmp.log"
    return 0
}

build_rc=0
if needs_rebuild; then
    build_shell_img || build_rc=$?
fi
# A build that WORKED but produced something other than a shell means the
# sources are broken, and the source bootstrap below would only fail the
# same way, more slowly and with the Forth banner on stdout. Stop.
if [ "$build_rc" = 2 ]; then
    exit 1
fi
if [ "$build_rc" != 0 ]; then
    # Fall back to the original source-bootstrap path rather than
    # failing outright, so a broken/unwritable image directory
    # degrades to "slow" instead of "no shell at all".
    if [ -n "$1" ]; then
        printf 'S" %s/extend.4" INCLUDED\nS" %s/pool.4" INCLUDED\nS" %s/shadow.4" INCLUDED\nS" %s/shell.4" INCLUDED\nS" %s/edit.4" INCLUDED\nS" %s/tree.4" INCLUDED\nMAIN\n' "$DIR" "$DIR" "$DIR" "$DIR" "$DIR" "$DIR" \
            | exec "$RELF_BIN" "$RELF_IMG" "$@"
    else
        {
            printf 'S" %s/extend.4" INCLUDED\nS" %s/pool.4" INCLUDED\nS" %s/shadow.4" INCLUDED\nS" %s/shell.4" INCLUDED\nS" %s/edit.4" INCLUDED\nS" %s/tree.4" INCLUDED\nMAIN\n' "$DIR" "$DIR" "$DIR" "$DIR" "$DIR" "$DIR"
            cat
        } | exec "$RELF_BIN" "$RELF_IMG" "$@"
    fi
fi

# The prebuilt image boots straight into MAIN, so there is no bootstrap
# to feed in and stdin belongs entirely to the shell - no `cat` chaining
# needed for the interactive/piped case any more.
# The name this shell was invoked by, for $0 under -s and interactively
# - the engine sees only its own path. The shell takes it out of the
# environment at startup (Iteration 435).
RELF_ARGV0=$0; export RELF_ARGV0
exec "$RELF_BIN" "$SHELL_IMG" "$@"
