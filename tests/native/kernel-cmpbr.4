\ tests/native/kernel-cmpbr.4 - a compare of two stack cells, or of one
\ with 0, fused with the IF, WHILE or UNTIL after it (Iteration 661):
\ each compare the native compiler fuses - = < > U< <> 0= 0< - on values
\ either side of every edge, signed and unsigned, under each branch word,
\ nested, in a DO loop, inside a word inlined into others, and the depth
\ after. Native, CV8-asm and CV8-C print the same.
1 63 LSHIFT CONSTANT MIN-N   MIN-N 1- CONSTANT MAX-N
CREATE VALS  MIN-N , -2 , -1 , 0 , 1 , 2 , MAX-N ,
: V ( i --- x )  CELLS VALS + @ ;
: T=  ( a b --- )  = IF ." T" ELSE ." F" THEN ;
: T<  ( a b --- )  < IF ." T" ELSE ." F" THEN ;
: T>  ( a b --- )  > IF ." T" ELSE ." F" THEN ;
: TU< ( a b --- )  U< IF ." T" ELSE ." F" THEN ;
: T<> ( a b --- )  <> IF ." T" ELSE ." F" THEN ;
: T0= ( a --- )  0= IF ." T" ELSE ." F" THEN ;
: T0< ( a --- )  0< IF ." T" ELSE ." F" THEN ;
: ALL2 ( xt --- )  7 0 DO 7 0 DO J V I V 2 PICK EXECUTE LOOP LOOP DROP CR ;
: ALL1 ( xt --- )  7 0 DO I V OVER EXECUTE LOOP DROP CR ;
' T= ALL2  ' T< ALL2  ' T> ALL2  ' TU< ALL2  ' T<> ALL2  ' T0= ALL1  ' T0< ALL1
: W< ( n --- c )  0 BEGIN 2DUP > WHILE 1+ REPEAT SWAP DROP ;
: U= ( n --- c )  0 BEGIN 1+ 2DUP = UNTIL SWAP DROP ;
: U0= ( n --- c )  0 SWAP BEGIN SWAP 1+ SWAP 1- DUP 0= UNTIL DROP ;
: W0< ( n --- c )  0 SWAP BEGIN DUP 0< WHILE 1+ SWAP 1+ SWAP REPEAT DROP ;
5 W< .  0 W< .  7 U= .  4 U0= .  -6 W0< .  3 W0< .  DEPTH . CR
: NEST ( a b c d --- )
  < IF = IF ." A" ELSE ." B" THEN ELSE + 0= IF ." C" ELSE ." D" THEN THEN ;
1 1 2 3 NEST  1 2 2 3 NEST  1 -1 3 2 NEST  1 2 3 2 NEST  DEPTH . CR
: DOCMP ( lim --- n )  0 10 0 DO OVER I < IF 1+ THEN LOOP SWAP DROP ;
3 DOCMP .  -1 DOCMP .  9 DOCMP .  DEPTH . CR
: MAX2 ( a b --- m )  2DUP < IF SWAP THEN DROP ;
: USE-MAX ( --- )  3 7 MAX2 .  -5 -9 MAX2 .  MIN-N MAX-N MAX2 .  -1 1 MAX2 . ;
USE-MAX  4 2 ' MAX2 EXECUTE .  DEPTH . CR
.( end) CR   \ the last line: verify's native_cmp wants it (656)
BYE
