#!/bin/sh
# tests/interactive/run - the interactive cases, on a pseudo-terminal.
# THIS_SH selects the shell (default ../../relfsh); --record SHELL
# rewrites expected/ from that shell, which is how they were taken from
# dash. Needs python3 for pty.fork; the other suites do not.
here=$(cd "$(dirname "$0")" && pwd)
# The transcript cases, then the ^R checks: those are assertions rather
# than transcripts, since dash - which the transcripts are recorded from
# - has no ^R to record (Iteration 409). A failed probe turns into a
# failed case in the summary line tests/verify reads.
out=$(python3 "$here/run_cases.py" "$@"); rc=$?
if [ $# -eq 0 ]; then
    probe=$(python3 "$here/search-probe.py" 2>&1); prc=$?
    # TAB completion, the same way (Iteration 410)
    probe2=$(python3 "$here/complete-probe.py" 2>&1); prc2=$?
    probe=$(printf '%s\n%s\n' "$probe" "$probe2"); prc=$((prc + prc2))
    printf '%s\n' "$probe" | grep '^FAIL' || true
    if [ "$prc" -ne 0 ]; then
        out=$(printf '%s\n' "$out" | awk -v n="$prc" '
            /^[0-9]+ passed, [0-9]+ failed/ { $3 = $3 + n; $1 = $1 } { print }')
        rc=1
    fi
fi
printf '%s\n' "$out"
exit $rc
