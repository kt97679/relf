# the same program in Rill and in Rill 2 (838): side.rill and side.r2 print side.expected, both
x = 7
y = $x * 2 + 1
echo $y
name = "ada"
echo "hello $name, twice {$x * 2}"
l = [3, 1, 2]
echo {$l[0]} {len($l)} {$l[-1]}
p = {name: "ada", born: 1815}
echo {$p[born]} {born in $p}
for i in range(3) { if ($i != 1) { echo "i $i" } }
def sq(n) -> number { return $n * $n }
echo {sq(9)}
dir = /tmp
ls $dir out> /dev/null
n = $(printf 'a\nb\n' | wc -l)
echo "lines $n"
false ?? echo "failed"
echo {-7 / 2} {-7 % 2} {7 / 2}
c = 0
c = $c + 1
echo $c
