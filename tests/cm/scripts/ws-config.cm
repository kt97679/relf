# a whole script (908), as one would write it
# merge a user's config over defaults, both key=value files; print the result sorted by key
printf '%s\n' 'color=blue' 'size=10' '# a comment' 'mode=fast' > /tmp/cm-ws3-defaults.conf
printf '%s\n' 'size=12' 'name=ada' '' > /tmp/cm-ws3-user.conf
var load {|file|
    var conf [:]
    for line @(cat $file) {
        if $line match '#*' { continue }
        if $line match '*=*' {
            var kv [@($line split =)]
            $conf set $kv[0] $kv[1]
        }
    }
    put $conf
}
var merged @([@(load /tmp/cm-ws3-defaults.conf)][0] merge @(load /tmp/cm-ws3-user.conf))
for k @($merged keys | sort) { echo "$k = $merged[$k]" }
rm /tmp/cm-ws3-defaults.conf /tmp/cm-ws3-user.conf
