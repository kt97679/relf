# a def sees the script's variables declared before it (884), in the main frame: reads them, sets them,
# and a block made in it captures them as any block does
var count 0
var name relf
def bump { set count $(( $count + 1 )) }
def greet {|who| echo hello $who from $name }
bump
bump
echo count $count
greet Ada
var n 10
def mk { put { echo n is $n } }
var b $(mk)
$b
set n 11
$b
