# a whole script (903), as one would write it
# a memoised function: results kept in a map a closure holds
var memoize {|f| var seen [:]; put {|n| if $seen has $n { put $seen[$n] } else { var v @($f $n); $seen set $n $v; put $v } } }
var calls 0
var slow-square {|n| set calls $(( $calls + 1 )); put $(( $n * $n )) }
var fast @(memoize { |n| slow-square $n })
for n @(range 3) { $fast $n }
for n @(range 3) { $fast $n }
echo calls $calls
