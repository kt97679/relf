# a whole script (916), as one would write it
# ten thousand lines: totals per key, through a program, a def and a program
var keyed { each line { var f [@($line split ' ')]; put "$f[0] $f[1]" } }
var totals [:]
for line @(seq 1 10000 | awk '{ print "k" ($1 % 7), $1 }') {
    var f [@($line split ' ')]
    if $totals has $f[0] { $totals set $f[0] $(( $totals[$f[0]] + $f[1] )) } else { $totals set $f[0] $f[1] }
}
for k @($totals keys) { echo "$k $totals[$k]" } | sort
echo streamed: $(seq 1 100000 | awk '{ print "k", $1 }' | keyed | wc -l)
