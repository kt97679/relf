# a whole script (912), as one would write it
# a command-line tool with subcommands
var usage { echo 'usage: tool add NAME | list | remove NAME' >&2; exit 2 }
var db /tmp/cm-ws4-tool.db
touch $db
var cmd-add {|name| echo $name >> $db; echo "added $name" }
var cmd-list { var n 0; for line @(cat $db) { set n $(( $n + 1 )); echo "$n. $line" } }
var cmd-remove {|name|
    var kept []
    for line @(cat $db) { if $(( $line != $name )) { $kept append $line } }
    printf '%s\n' @kept > $db
    echo "removed $name"
}
var dispatch {|argv|
    if $(( $($argv count) == 0 )) { usage }
    var sub $argv[0]
    case $sub {
        add { cmd-add $argv[1] }
        list { cmd-list }
        remove { cmd-remove $argv[1] }
        * { usage }
    }
}
dispatch [add ada]
dispatch [add grace]
dispatch [add ken]
dispatch [remove grace]
dispatch [list]
rm $db
