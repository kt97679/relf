# steps with their output logged (962): each step a function, its output into a log of its own by `>`;
# the third fails, and the trap - on the terminal, which 961 found going into the failed step's log -
# says what each log holds and takes the directory away
var dir /tmp/cm-ws-steplogs
rm -rf $dir
mkdir -p $dir
trap {
    var logs [@(glob "$dir/*.log")]
    echo "trap: $($logs count) logs"
    for f @logs { echo "  $(basename $f): $(head -1 $f), $(wc -l < $f | tr -d ' ') in all" }
    rm -rf $dir
    echo "trap: $dir removed"
}
var fetch { echo fetching; put [a b c] }
var build { echo building; for i @(range 3) { echo "  item $i" } }
var check { echo checking; var want [1 2]; echo "the third is $want[2]" }
var ship { echo shipping }
fetch > "$dir/fetch.log"
build > "$dir/build.log"
echo two steps done
check > "$dir/check.log"
ship > "$dir/ship.log"
echo not reached
