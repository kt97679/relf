# a whole script (908), as one would write it
# fill {{name}} placeholders from a map
var render {|text vars|
    var out $text
    for k @($vars keys) { set out $([@($out split "{{$k}}")] join $vars[$k]) }
    put $out
}
echo $(render 'Dear {{name}}, your order {{id}} ships {{when}}.' [name: Ada  id: 42  when: today])
