# a whole script (885): files grouped by extension, a map of lists - it found append's target could not
# have a key: append groups[$ext] $name
var dir /tmp/cm-885-g
rm -rf $dir
mkdir $dir
touch "$dir/a.txt" "$dir/b.md" "$dir/c.txt" "$dir/d.cm" "$dir/e.md" "$dir/README"
var groups [:]
for f @(glob "$dir/*") {
    var name $(basename $f)
    var ext none
    if $name match '*.*' { set ext $(echo $name | sed 's/.*\.//') }
    if $groups has $ext { append groups[$ext] $name } else { set groups[$ext] [$name] }
}
for k @($groups keys) { echo "$k:" $($groups[$k] join ", ") }
rm -rf $dir
