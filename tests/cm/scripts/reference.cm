# the reference's examples, run (900): docs/REFERENCE.md shows each with what it prints here -
# tools/reference-check.py, in tests/cm/run, fails if an example line there is not one here
# -- words and values
var b { }   # echo of a block itself is an error (976): {a,b} is not bash's braces here
echo plain 'single quoted' "double quoted" 42 -7 1.5 true [a b] [k: v] $b
echo $(kind hello) $(kind 42) $(kind 1.5) $(kind true) $(kind [a]) $(kind [k: v]) $(kind { })
printf '%s\n' a \
    b
# -- variables
var name ada
var l [3 1 2]
var m [name: ada  born: 1815]
set name grace
$m set born 1906
$l append 4 5
echo $name $l $l[0] $l[-1] $m[born] $($l count) $($m count) $($name count)
echo [a b c][-1] [k: v  j: w][j] $(printf hello)[0] @('a,b,c' split ,)[2]
# -- texts
var k 3
echo "name: $name, first: $l[0], sum: $(( $l[0] + $l[1] )), line ${k}d" 'no $subst here'
echo "tab:\tend" "quote: \" backslash: \\"
# -- arithmetic and comparison
echo $(( 7 / 2 )) $(( -7 % 2 )) $(( 2 * (3 + 4) )) $(( 3 > 2 )) $(( "abc" == "abc" && !(1 > 2) ))
# -- control
for i @(range 4) { if $(( $i == 1 )) { continue } elif $(( $i == 3 )) { break } else { echo i $i } }
var n 0
while $(( $n < 3 )) { set n $(( $n + 1 )) }
case report.md { *.txt *.md { echo text } * { echo other } }
case '*' { '[*]' { echo a star } * { echo other } }
echo n $n
# -- functions
var greet {|who| echo hello $who }
var sq {|x| put $(( $x * $x )) }
var pair { put a b }
greet world
echo $(sq 7) [@(pair)] $([@(pair)] count)
var both [@(pair)]
var one @(sq 3)
echo $both $one $(kind $one)
var find {|x| for v @l { if $(( $v == $x )) { return 0 } }; return 1 }
if find 4 { echo 4 is in l }
find 9 || echo 9 is not
var need {|f| test -f $f || { echo no $f; return 1 }; echo have $f }
need /no/such || echo need: $status
# -- blocks
var twice {|f x| $f $($f $x) }
echo $($twice { |v| put $(( $v * 2 )) } 5)
var counter {|start| var c $start; put [inc: { set c $(( $c + 1 )); put $c }] }
var ctr @(counter 10)
$ctr[inc]; $ctr[inc]
echo counter at $($ctr[inc])
# -- library
echo $([@('a,b,,c' split ,)] join -) $([x y z] join ", ")
for key @([b: 2  a: 1] keys) { echo key $key }
echo $([a: 1  b: 2] merge [b: 3])
if [a: 1] has a { echo has a }
if 'file.txt' match '*.txt' { echo matches }
put x y | each v { echo each $v }
echo $(range 3) @(range 3)
# -- a value's operations (967)
echo $($m count) $($name upper) [@($l slice 1 3)] $($l join -) @('a,b' split ,) @([b: 1  a: 2] keys)
if $m has born { echo has born }
var langs [forth rill3]; $langs set 1 sh; $langs append awk; $langs del 0; echo $langs
# [sh awk]
'notes.txt' match '*.txt' && echo a text file
# -- programs, pipes and redirections
printf 'b\na\n' | sort
echo $(printf 'x\ny\n' | wc -l) @(printf 'p\nq\n')
pair | tr a-z A-Z
printf 'one\ntwo\n' | each line { echo got $line }
grep x /no/such 2> /dev/null || echo status $status
echo saved > /tmp/cm-ref.txt; echo more >> /tmp/cm-ref.txt; cat < /tmp/cm-ref.txt
each line { echo read $line } < /tmp/cm-ref.txt               # read saved, read more
greet file > /tmp/cm-ref.txt
cat /tmp/cm-ref.txt
sleep 0 & 
wait
echo waited, status $status
var out $(grep x /no/such 2>&1) || echo var status $status
var greet-all {
    cat << END
        hello $name, $($l count) numbers
          last $l[-1]
        END
}
greet-all
tr a-z A-Z << 'END' | cat
as $written
END
# -- the environment and arguments
$env set CM_REF hello
sh -c 'echo program sees $CM_REF'
echo args $args $($args count)
echo $(glob "/tmp/cm-ref.*")
rm /tmp/cm-ref.txt
