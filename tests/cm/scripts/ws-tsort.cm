# a build order by topological sort (962): what must come before what, as tsort(1) reads it - a pair a
# line - put in order by Kahn's way, the first ready by name each time; checked against every pair, and
# against tsort's own order; then a loop added, found and named, as tsort refuses it
var deps 'libc compiler
libc kernel
kernel drivers
compiler stdlib
libc stdlib
stdlib app
drivers app
stdlib tests
app release
tests release
docs release'
var order {|text|
    var before [:]
    var need [:]
    for line @(split $text "\n") {
        var p @(split $line ' ')[0]
        var q @(split $line ' ')[1]
        for v $p $q { if ! has $need $v { set need[$v] 0; set before[$v] [] } }
        append before[$p] $q
        set need[$q] $(( $need[$q] + 1 ))
    }
    var out []
    while $(( $(count $need) > 0 )) {
        var ready [@(keys $need | each {|v| if $(( $need[$v] == 0 )) { put $v } })]
        if $(( $(count $ready) == 0 )) {
            echo "a loop among: $(join ' ' @(keys $need | sort))" >&2
            return 1
        }
        var v $(put @ready | sort | head -1)
        append out $v
        for q @before[$v] { set need[$q] $(( $need[$q] - 1 )) }
        del need[$v]
    }
    put $out
}
var valid {|text o|
    var at [:]
    for i @(range $(count $o)) { set at[$o[$i]] $i }
    for line @(split $text "\n") {
        var p @(split $line ' ')[0]
        var q @(split $line ' ')[1]
        if $(( $at[$p] > $at[$q] )) { echo "$p after $q"; return 1 }
    }
    return 0
}
var o @(order $deps)
echo order: @o
valid $deps $o && echo every pair kept
var theirs [@(echo $deps | tsort)]
valid $deps $theirs && echo "tsort's order kept too: $(count $theirs) names, the same set: $(( $(join ' ' @(put @o | sort)) == $(join ' ' @(put @theirs | sort)) ))"
var looped "$deps
release libc"
order $looped || echo order: status $status
echo $looped | tsort > /dev/null 2> /dev/null || echo tsort: status $status
