# a build order by topological sort (962): what must come before what, as tsort(1) reads it - a pair a
# line - put in order by Kahn's way, the first ready by name each time; checked against every pair, and
# against tsort's own order; then a loop added, found and named, as tsort refuses it
var deps 'libc compiler
libc kernel
kernel drivers
compiler stdlib
libc stdlib
stdlib app
drivers app
stdlib tests
app release
tests release
docs release'
var order {|text|
    var before [:]
    var need [:]
    for line @($text split "\n") {
        var p @($line split ' ')[0]
        var q @($line split ' ')[1]
        for v $p $q { if ! $need has $v { $need set $v 0; $before set $v [] } }
        $before[$p] append $q
        $need set $q $(( $need[$q] + 1 ))
    }
    var out []
    while $(( $($need count) > 0 )) {
        var ready [@($need keys | each v { if $(( $need[$v] == 0 )) { put $v } })]
        if $(( $($ready count) == 0 )) {
            echo "a loop among: $([@($need keys | sort)] join ' ')" >&2
            return 1
        }
        var v $(put @ready | sort | head -1)
        $out append $v
        for q @before[$v] { $need set $q $(( $need[$q] - 1 )) }
        $need del $v
    }
    put $out
}
var valid {|text o|
    var at [:]
    for i @(range $($o count)) { $at set $o[$i] $i }
    for line @($text split "\n") {
        var p @($line split ' ')[0]
        var q @($line split ' ')[1]
        if $(( $at[$p] > $at[$q] )) { echo "$p after $q"; return 1 }
    }
    return 0
}
var o @(order $deps)
echo order: @o
valid $deps $o && echo every pair kept
var theirs [@(echo $deps | tsort)]
valid $deps $theirs && echo "tsort's order kept too: $($theirs count) names, the same set: $(( $([@(put @o | sort)] join ' ') == $([@(put @theirs | sort)] join ' ') ))"
var looped "$deps
release libc"
order $looped || echo order: status $status
echo $looped | tsort > /dev/null 2> /dev/null || echo tsort: status $status
