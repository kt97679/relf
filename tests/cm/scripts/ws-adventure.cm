# a whole script (917), as one would write it
# a tiny adventure: rooms in a map, moves read from stdin
var rooms [hall: [desc: 'a cold hall'  north: library  east: kitchen]
           library: [desc: 'dusty shelves'  south: hall]
           kitchen: [desc: 'a smell of bread'  west: hall  item: key]]
var here hall
var bag []
var look { echo "You are in $rooms[$here][desc]."; if $rooms[$here] has item { echo "There is a $rooms[$here][item] here." } }
var play {
    var cmd ''
    look
    while read cmd {
        var w [@($cmd split ' ')]
        case $w[0] {
            go {
                if $rooms[$here] has $w[1] { set here $rooms[$here][$w[1]]; look } else { echo 'You cannot go that way.' }
            }
            take {
                if $rooms[$here] has item && $rooms[$here][item] match $w[1] {
                    $bag append $w[1]; $rooms[$here] del item; echo "Taken: $w[1]."
                } else { echo 'Nothing like that here.' }
            }
            bag { echo "You carry: $bag" }
            quit { break }
            * { echo "I do not know $w[0]." }
        }
    }
}
printf 'go north\ngo west\ngo south\ngo east\ntake key\ntake key\nbag\ndance\nquit\n' | play
