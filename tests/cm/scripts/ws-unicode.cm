# a whole script (916), as one would write it
# texts beyond Latin: counted, sliced, reversed, cased
var t 'naïve 日本語 😀👍 Ωmega'
echo $(count $t) characters
echo $(slice $t 6 9) $(slice $t 10 12) $(slice $t -5)
var rev {|s| var r ''; for i @(range $(count $s)) { set r "$(slice $s $i $(( $i + 1 )))$r" }; put $r }
echo $(rev $t)
echo $(upper $t) $(lower 'ΣΟΦΊΑ ΩMEGA')
echo [@(split $t ' ')][2] $t[2]
if match $t '*😀*' { echo has a smile }
