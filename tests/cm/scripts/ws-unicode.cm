# a whole script (916), as one would write it
# texts beyond Latin: counted, sliced, reversed, cased
var t 'naïve 日本語 😀👍 Ωmega'
echo $($t count) characters
echo $($t slice 6 9) $($t slice 10 12) $($t slice -5)
var rev {|s| var r ''; for i @(range $($s count)) { set r "$($s slice $i $(( $i + 1 )))$r" }; put $r }
echo $(rev $t)
echo $($t upper) $('ΣΟΦΊΑ ΩMEGA' lower)
echo [@($t split ' ')][2] $t[2]
if $t match '*😀*' { echo has a smile }
