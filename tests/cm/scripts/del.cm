# del name[k]: an item out of a list or a map, in place (905) - a list had no removal, ws-rpn popped by
# rebuilding it; a map none at all. Its target as set's; a negative index from the end; out of range, an error
var l [a b c d e]
del l[0]
del l[-1]
del l[1]
echo $l $(count $l)
var m [x: 1  y: 2  z: 3]
del m[y]
echo $m $(count $m)
var big [:]
for i @(range 40) { set big["k$i"] $i }
del big[k7]
echo $(count $big) $big[k8] $big[k39]
has $big k7 || echo k7 gone
var nest [inner: [1 2 3]]
del nest[inner][0]
echo $nest
var stack [1 2 3]
var top $stack[-1]
del stack[-1]
echo "popped $top, left $stack"
sh -c 'exit 3' &
del l[9]
