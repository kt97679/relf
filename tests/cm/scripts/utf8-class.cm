# [...] in match and glob takes characters, not bytes (909): é, a range of Cyrillic, a negated class -
# they had compared one byte of a two-byte character
'é' match '[éa]' && echo class-ok || echo class-fails
'é' match '[!a]' && echo neg-ok || echo neg-fails
'ж' match '[а-я]' && echo cyr-range-ok || echo cyr-range-fails
'z' match '[а-я]' && echo bad || echo z-not-in-range
'café' match 'caf[ée]' && echo mixed-ok
'b' match '[a-c]' && echo ascii-ok
']' match '[]a]' && echo bracket-ok
'[' match '[' && echo literal-ok
