# formatting: columns padded, money with two decimals from cents - sourced by ws-shop.cm (a library, not a test)
var pad {|t w| var s "$t"; while $(( $($s count) < $w )) { set s "$s " }; put $s }
var rpad {|t w| var s "$t"; while $(( $($s count) < $w )) { set s " $s" }; put $s }
var money {|cents| var c $(( $cents % 100 )); if $(( $c < 10 )) { set c "0$c" }; put "$(( $cents / 100 )).$c" }
