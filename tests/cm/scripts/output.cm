# values put and captured, bytes echoed and never captured, the printed form
put 42 "hello world" [a "b c" [1 2]] [name: ada  tags: [x y]] [:] { }
def three { put 1; put 2; put 3 }
var all [@(three)]
echo all: $all count: $(count $all)
def noisy { echo noise; put 7 }
var seven $(noisy)
echo seven: $seven
var m $(merge [a: 1  b: 2] [b: 3  c: 4])
put $m
var big [1 2]
append big 3 @all
put $big
