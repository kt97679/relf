# a whole script (915), as one would write it
# indented key: value lines into nested maps
var text 'server:
  host: example.org
  port: 8080
log:
  level: debug'
var conf [:]
var section ''
for line @($text split "\n") {
    var parts [@($line split ': ')]
    if $line match '  *' {
        set conf[$section][$($parts[0] slice 2)] $parts[1]
    } else {
        set section $($parts[0] slice 0 -1)
        set conf[$section] [:]
    }
}
echo $conf
echo "port: $conf[server][port], level: $($conf[log][level] upper)"
