# texts are UTF-8 (879): count and [i] count characters, not bytes; match's ? takes a character
var h "héllo wörld"
echo $($h count) $h[1] $h[-1] $h[7] "[$($h slice 20 30)]"   # past the end: a slice clamps, an index is an error (966)
'héllo' match 'h?llo' && echo "h?llo matches héllo"
var j 日本語
echo $($j count) $j[1]
