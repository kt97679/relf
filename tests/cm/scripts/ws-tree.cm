# a whole script (914), as one would write it
# print a directory tree, indented
var root /tmp/cm-ws5-tree
rm -rf $root
mkdir -p "$root/src/lib" "$root/docs"
touch "$root/README" "$root/src/main.cm" "$root/src/lib/util.cm" "$root/docs/guide.md"
var base {|path| put [@(split $path /)][-1] }
var show {|dir indent|
    for p @(glob "$dir/*") {
        if test -d $p { echo "$indent$(base $p)/"; show $p "$indent  " } else { echo "$indent$(base $p)" }
    }
}
echo "$(base $root)/"
show $root '  '
rm -rf $root
