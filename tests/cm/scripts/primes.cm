# a whole script (885): the primes below 100 by trial division - continue, break, a boolean variable
var primes []
for n @(range 100) {
    if $(( $n < 2 )) { continue }
    var prime true
    for p @primes {
        if $(( $p * $p > $n )) { break }
        if $(( $n % $p == 0 )) { set prime false; break }
    }
    if $prime { $primes append $n }
}
echo $($primes count) primes: $($primes join " ")
