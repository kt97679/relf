# a whole script (908), as one would write it
# sell items: take out what sells out
var stock [apples: 3  pears: 1  plums: 2]
var sell {|item n|
    if ! $stock has $item { echo "no $item"; return 1 }
    var left $(( $stock[$item] - $n ))
    if $(( $left < 0 )) { echo "only $stock[$item] $item"; return 1 }
    if $(( $left == 0 )) { $stock del $item; echo "$item sold out" } else { $stock set $item $left }
}
sell pears 1
sell apples 5 || echo "(not sold)"
sell plums 2
sell kiwis 1 || echo "(not sold)"
echo left: $stock
