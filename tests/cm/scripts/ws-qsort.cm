# a whole script (916), as one would write it
# quicksort over a list of numbers, recursively
var qsort {|l|
    if $(( $($l count) <= 1 )) { put $l; return 0 }
    var pivot $l[0]
    var less []
    var more []
    for x @($l slice 1) { if $(( $x < $pivot )) { $less append $x } else { $more append $x } }
    put [@(qsort $less)[0] $pivot @(qsort $more)[0]]
}
var sorted @(qsort [33 4 15 8 42 16 23 4])
echo $sorted
