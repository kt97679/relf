# run (967): the program a text names, as run $EDITOR file - a text first in a command had been that (907),
# and is a value's operation now; and del env[NAME] unsets it for programs after; setenv holds more than 32 names
var ed echo
run $ed hi from a text value
var p printf
run $p '%s-%s\n' a b
var cmd [tr a-z A-Z]
echo shout | run @cmd
echo "captured: $(run $ed x y)"
run "/bin/echo" a path, quoted
set env[CM907] here
sh -c 'echo child sees ${CM907:-nothing}'
del env[CM907]
sh -c 'echo after del: ${CM907:-nothing}'
echo "read back: [$($env get CM907 '')]"
set env[CM907] again
sh -c 'echo set again: $CM907'
for i @(range 40) { set env["CM907_$i"] $i }
sh -c 'echo 40 names: $CM907_39'
var two {|a b| echo $a $b }
var l [1]
