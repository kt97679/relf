# a whole script (882): keep the newest 3 of 5 backups, a sorted list indexed by $i
var dest /tmp/cm-882-bk
rm -rf $dest
mkdir -p $dest
for n @(range 5) { touch "$dest/backup-2026-10-0$n.tar.gz" }
var all [@(ls $dest | sort)]
var keep 3
var n $($all count)
if $(( $n > $keep )) {
    for i @(range $(( $n - $keep ))) { echo removing $all[$i]; rm "$dest/$all[$i]" }
}
ls $dest
rm -rf $dest
