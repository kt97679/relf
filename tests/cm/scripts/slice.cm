# slice v start [end] (909): a list's items from start up to end - put one by one, [@( )] a list - or a
# text's characters; negative from the end, held to the length, no end the end; a copy, del takes out in place
var l [a b c d e]
var mid [@(slice $l 1 3)]
echo $mid [@(slice $l 2)] [@(slice $l -2)] [@(slice $l 0 -1)] [@(slice $l 4 2)] [@(slice $l 9)]
for x @(slice $l 3) { echo each $x }
echo $(slice 'héllo wörld' 0 5) "[$(slice 'héllo wörld' -5)]" "[$(slice abc 1 1)]"
var i 1
var j 4
echo $(slice abcdef $i $j) $l
var first @(slice $l 0 1)
echo first $first
