# slice v start [end] (909): a list's items from start up to end - put one by one, [@( )] a list - or a
# text's characters; negative from the end, held to the length, no end the end; a copy, del takes out in place
var l [a b c d e]
var mid [@($l slice 1 3)]
echo $mid [@($l slice 2)] [@($l slice -2)] [@($l slice 0 -1)] [@($l slice 4 2)] [@($l slice 9)]
for x @($l slice 3) { echo each $x }
echo $('héllo wörld' slice 0 5) "[$('héllo wörld' slice -5)]" "[$('abc' slice 1 1)]"
var i 1
var j 4
echo $('abcdef' slice $i $j) $l
var first @($l slice 0 1)
echo first $first
