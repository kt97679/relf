# a whole script (908), as one would write it
# wrap a paragraph at a width
var wrap {|text width|
    var line ''
    for w @($text split ' ') {
        if $(( $($line count) == 0 )) { set line $w }
        elif $(( $($line count) + 1 + $($w count) <= $width )) { set line "$line $w" }
        else { echo $line; set line $w }
    }
    if $(( $($line count) > 0 )) { echo $line }
}
wrap 'the quick brown fox jumps over the lazy dog and keeps on running far away' 20
