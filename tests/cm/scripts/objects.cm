# objects: methods calling each other through a captured self - the draft's account, as written
var account {|owner|
    var balance 0
    var self [:]
    $self set deposit {|amount| set balance $(( $balance + $amount )) }
    $self set twice {|amount| $self[deposit] $amount; $self[deposit] $amount }
    $self set report { echo $owner has $balance }
    put $self
}
var a @(account ada)
$a[twice] 50
$a[report]

# inheritance by filling a given map: an inherited method reaches the override through self
var animal {|self name|
    $self set speak { echo $name makes a sound }
    $self set greet { echo hello; $self[speak] }
}
var dog {|self name|
    animal $self $name
    $self set speak { echo $name barks }
}
var d [:]
dog $d rex
$d[greet]
var plain [:]
animal $plain tom
$plain[greet]
