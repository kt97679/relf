# a whole script (916), as one would write it
# matrices as lists of rows: transpose and multiply
var transpose {|m|
    var t []
    for j @(range $($m[0] count)) {
        var row []
        for r @m { $row append $r[$j] }
        $t append $row
    }
    put $t
}
var mul {|a b|
    var bt @(transpose $b)
    var out []
    for r @a {
        var row []
        for c @bt {
            var s 0
            for k @(range $($r count)) { set s $(( $s + $r[$k] * $c[$k] )) }
            $row append $s
        }
        $out append $row
    }
    put $out
}
var a [[1 2] [3 4]]
var b [[5 6] [7 8]]
for row @(mul $a $b) { echo @row }
echo $(transpose [[1 2 3] [4 5 6]])
