# trap { block } EXIT (910): the block runs when the script ends - at its end, at exit, after an error; $status
# in it the status it ends with (974)
var tmp /tmp/cm-910-trap.txt
echo data > $tmp
trap { echo "the trap sees the exit status, $status"; rm -f $tmp; echo "cleaned, exit status kept" } EXIT
test -f $tmp && echo file there
exit 3
