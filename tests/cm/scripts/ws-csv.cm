# a whole script (914), as one would write it
# a small table from a CSV: totals per region, the header in capitals
var csv 'region,item,amount
north,apples,12
south,pears,7
north,plums,5
south,apples,3'
var lines [@($csv split "\n")]
var header [@($lines[0] split ,)]
var totals [:]
for line @($lines slice 1) {
    var f [@($line split ,)]
    if $totals has $f[0] { set totals[$f[0]] $(( $totals[$f[0]] + $f[2] )) } else { set totals[$f[0]] $f[2] }
}
echo "$($header[0] upper) $($header[2] upper)"
for r @($totals keys) { echo "$r $totals[$r]" }
echo "first item: $($lines[1] slice 6 12), $([@($lines slice 1)] count) rows"
