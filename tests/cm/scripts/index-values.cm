# an index after a value written in one word (913): a list or map literal, a text, a capture - as $name[key] is a
# variable's; @(cmd)[k] the k-th of its values, spread if a list; inside quotes too (914), \[ a bracket
var line 'GET /index.html 200'
var level [@(split $line ' ')][1]
echo $level
echo [a b c][-1] [k: v  j: w][j] [[1 2] [3 4]][1][0]
echo $(printf 'hello') $(printf 'hello')[0] "quoted"[1] 'single'[0]
def pairs { put [1 2] [3 4] }
echo @(split 'a,b,c' ,)[2] @(pairs)[1] [@(pairs)][0]
var m [list: [p q r]]
echo $m[list][1]
for f [@(split $line ' ')][0] { echo one word: $f }
echo "inside quotes too: $(printf xyz)[1] - and \[ writes a bracket: $(printf x)\[0]"
