# a whole script (912), as one would write it
# a work queue: take from the front, add follow-up work at the back
var queue [build test]
var done []
while $(( $($queue count) > 0 )) {
    var job $queue[0]
    $queue del 0
    $done append $job
    case $job {
        build { $queue append package }
        package { $queue append publish }
    }
}
echo order: @done
