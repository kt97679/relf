# a whole script (915), as one would write it
# words counted case-blind, punctuation stripped, the top three
var text 'The cat and THE dog. The end, the END!'
var counts [:]
for w @($text split ' ') {
    var word $($w lower)
    case $word { *. *, *! { set word $($word slice 0 -1) } }
    if $counts has $word { set counts[$word] $(( $counts[$word] + 1 )) } else { set counts[$word] 1 }
}
for k @($counts keys) { echo "$counts[$k] $k" } | sort -rn | head -3
