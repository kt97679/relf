# a whole script (903), as one would write it
# an RPN calculator: tokens from stdin, a list as the stack
var stack []
var pop {
    var n $($stack count)
    if $(( $n == 0 )) { echo stack empty >&2; exit 1 }
    var top $stack[-1]
    var rest []
    for i @(range $(( $n - 1 ))) { $rest append $stack[$i] }
    set stack $rest
    put $top
}
var calc {
  var line ''
  while read line {
    for tok @($line split ' ') {
        if $tok match '[0-9]*' { $stack append $tok } elif $tok match '[-+*/]' {
            var b @(pop)
            var a @(pop)
            if $tok match '+' { $stack append $(( $a + $b )) } elif $tok match '-' { $stack append $(( $a - $b )) } elif $tok match '[*]' { $stack append $(( $a * $b )) } else { $stack append $(( $a / $b )) }
        } else { echo "unknown token: $tok" >&2 }
    }
    echo "= $stack[-1]"
  }
}
printf '3 4 +\n5 *\n2 -\n7 2 /\n1 x\n' | calc 2>&1
