# a whole script (915), as one would write it
# number the lines of what comes in, as nl does, skipping blank ones
def number {
    var n 0
    var line ''
    while read line {
        if $(( $(count $line) == 0 )) { echo; continue }
        set n $(( $n + 1 ))
        echo "$n  $line"
    }
}
printf 'alpha\n\nbeta\ngamma\n' | number
