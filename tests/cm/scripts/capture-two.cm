# a function that puts two values and echoes between them: $( ) takes all it prints, in order, one text;
# @( ) takes its values; var takes one value - @( ) of two is an error there (896)
var two { put 1; echo between; put 2; echo after }
var x $(two)
echo "[$x]" $(count $x)
var l [@(two)]
echo $l
var y @(two)
echo never
