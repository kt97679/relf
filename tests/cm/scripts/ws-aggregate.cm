# a whole script (919), as one would write it
# a def that reads a program's output line by line and returns a summary map
var summarise {|n|
    var sums [:]
    for line @(seq 1 $n | awk '{ print ($1 % 3 == 0 ? "fizz" : "other"), $1 }') {
        var f [@($line split ' ')]
        if $sums has $f[0] { $sums set $f[0] $(( $sums[$f[0]] + $f[1] )) } else { $sums set $f[0] $f[1] }
    }
    put $sums
}
var s @(summarise 30000)
echo fizz $s[fizz] other $s[other]
