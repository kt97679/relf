# a whole script (915), as one would write it
# a task runner: tasks with dependencies, each run once, in order
var deps [build: [compile assets]  compile: [fetch]  assets: [fetch]  fetch: []  test: [build]]
var cmds [fetch: 'echo fetching'  compile: 'echo compiling'  assets: 'echo bundling assets'  build: 'echo linking'  test: 'echo testing']
var done [:]
var run-task {|name|
    if $done has $name { return 0 }
    if ! $deps has $name { echo "no task $name" >&2; return 1 }
    for d @deps[$name] { run-task $d || return 1 }
    var words [@($cmds[$name] split ' ')]
    run @words
    $done set $name true
}
run-task test
echo ran: @($done keys)
