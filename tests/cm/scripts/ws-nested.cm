# a nested list read back from its printed form (962): [1 [2 [3 ...]]] 2,000 deep, made by a loop and
# printed, then read by a recursive-descent reader, a call a level - the same list, as == says; then a
# text with a fault in it, said with where
var depth 2000
var l []
for i @(range $depth) { set l [$(( $depth - $i )) $l] }
var text "$l"
echo "$($text count) characters: $($text slice 0 24)...$($text slice -12)"
var pos 0
var read-value {
    if $(( $text[$pos] == '[' )) {
        set pos $(( $pos + 1 ))
        var items []
        while $(( $text[$pos] != ']' )) {
            if $(( $text[$pos] == ' ' )) { set pos $(( $pos + 1 )); continue }
            var v [@(read-value)] || return 1
            $items append $v[0]
        }
        set pos $(( $pos + 1 ))
        put $items
        return 0
    }
    var start $pos
    while $(( $pos < $($text count) )) && $text[$pos] match '[0-9]' { set pos $(( $pos + 1 )) }
    if $(( $pos == $start )) { echo "a number or [ wanted at $pos, not '$text[$pos]'" >&2; return 1 }
    put $(( $($text slice $start $pos) + 0 ))
}
var back @(read-value)
echo "read back the same: $(( $back == $l )), $pos characters read"
var d 0
var p $back
while $(( $($p count) > 0 )) { set d $(( $d + 1 )); set p $p[1] }
echo "$d levels, the first three numbers $back[0] $back[1][0] $back[1][1][0]"
set text '[1 [2 [3 x] 4]]'
set pos 0
var bad [@(read-value)] || echo "read: status $status, $($bad count) values"
