# == and != on lists (961): item by item, each as == takes it - Rill's R-CMP had taken cm's tagged
# numbers for boxes, and [1 2] == [1 2] faulted (cm: error -9); a map entry by entry since 973, a block only itself
var a [1 2]
var b [1 2]
echo $(( $a == $b )) $(( $a != $b ))
var c [1 [2 x] [k: v]]
var d [1 [2 x] $c[2]]
echo $(( $c == $d ))
$d[1] set 1 y
echo $(( $c == $d ))
var e ["1" 2]
var one [1]
echo $(( $a == $e )) $(( $a == $one ))
var m [k: v]
var n [k: v]
echo $(( $m == $n )) $(( $m == $m ))
[[1 2] [3]] has [3] && echo has a list
[$a] has $e && echo has as == takes it
