# a whole script (914), as one would write it
# compare and sort version numbers
var newer {|a b|
    var x [@($a split .)]
    var y [@($b split .)]
    for i @(range 3) {
        if $(( $x[$i] > $y[$i] )) { return 0 }
        if $(( $x[$i] < $y[$i] )) { return 1 }
    }
    return 1
}
var versions [1.10.0 1.2.3 2.0.0 1.2.10 0.9.9]
var sorted []
for v @versions {
    var out []
    var placed false
    for s @sorted {
        if ! $placed && newer $s $v { $out append $v; set placed true }
        $out append $s
    }
    if ! $placed { $out append $v }
    set sorted $out
}
echo oldest first: @sorted
echo "newest: $sorted[-1], its major:" [@($sorted[-1] split .)][0]
