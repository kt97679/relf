# an element set (881; $m set k v since 976): a key any word - $k, $(...), a number - for maps and lists, nested
var counts [:]
for w @(printf "x\ny\nx\n") { if $counts has $w { $counts set $w $(( $counts[$w] + 1 )) } else { $counts set $w 1 } }
echo $counts
var l [a b c]
var i 1
$l set $i B
$l set -1 C
echo $l
var m [inner: [k: 1]]
var key k
$m[inner] set $key 2
$m[inner] set "new$i" 3
echo $m
$env set CM_881 yes
sh -c 'echo $CM_881'
