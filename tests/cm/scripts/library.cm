# the library (870): split, join, keys - with has, count, range, merge, each before it; $env and $args
var line "a,b,,c"
var parts [@($line split ,)]
echo $parts $($parts count)
echo $($parts join -) "$([x y z] join ', ')"
var m [b: 2  a: 1]
for k @($m keys) { echo $k is $m[$k] }
if "hello world" has "lo w" { echo has lo w }       # has gives a status, as match does (896)
$m has c || echo no c
set env[CM_870] hello
sh -c 'echo a program sees $CM_870'
echo $env[CM_870] "$env[CM_870_NOT_SET]."
echo args: $args $($args count)
