# the library (870): split, join, keys - with has, count, range, merge, each before it; $env and $args
var line "a,b,,c"
var parts [@(split $line ,)]
echo $parts $(count $parts)
echo $(join - @parts) "$(join ', ' x y z)"
var m [b: 2  a: 1]
for k @(keys $m) { echo $k is $m[$k] }
if has "hello world" "lo w" { echo has lo w }       # has gives a status, as match does (896)
has $m c || echo no c
set env[CM_870] hello
sh -c 'echo a program sees $CM_870'
echo $env[CM_870] $env[CM_870_NOT_SET]"."
echo args: $args $(count $args)
