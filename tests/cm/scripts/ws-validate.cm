# a whole script (919), as one would write it
# records checked, every problem collected, a summary at the end however the script ends
var problems []
trap { echo "$($problems count) problems"; for p @problems { echo " - $p" } } EXIT
var check {|rec|
    var ok true
    if ! $rec has name { append problems "a record with no name"; set ok false }
    if $rec has age && ! "$rec[age]" match '[0-9]*' { append problems "$rec[name]: age is not a number"; set ok false }
    $ok
}
var good 0
for r @[[name: ada  age: 36] [age: 5] [name: bob  age: old] [name: cy]] { check $r && set good $(( $good + 1 )) }
echo "$good good"
