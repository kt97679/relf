# a whole script (908), as one would write it
# start workers in the background, then wait for each and report its own status
var jobs [:]
for name fast slow broken {
    if $name match broken { sh -c 'exit 4' & } else { sh -c "sleep 0.1; exit 0" & }
    $jobs set $name $job
}
var failed 0
for name @($jobs keys) {
    var s 0
    wait $jobs[$name] || set s $status
    if $(( $s == 0 )) { echo "$name: ok" } else { echo "$name: failed with $s"; set failed $(( $failed + 1 )) }
}
echo "$failed failed"
