# calls without CATCH (878): a def with no return in it is called with no activation and no CATCH, a capture
# with no break, continue or return in it with no CATCH - both behave as before
var sq {|n| put $(( $n * $n )) }
var first-big {|limit| for x 1 5 10 20 { if $(( $x > $limit )) { put $x; return } } ; put none }
echo $(sq 7) $(first-big 6) $(first-big 100)
for x 1 2 3 4 {
    var v $( if $(( $x == 3 )) { break }; put $x )
    echo got $v
}
var deep {|n| if $(( $n == 0 )) { put 0 } else { put $(( $(deep $(( $n - 1 ))) + 1 )) } }
echo deep: $(deep 50)
