# a whole script (916), as one would write it
# merge nested maps: b's values over a's, maps merged all the way down
var deep {|a b|
    var out [:]
    for k @($a keys) { set out[$k] $a[$k] }
    for k @($b keys) {
        if $out has $k && $(kind $out[$k]) match map && $(kind $b[$k]) match map {
            set out[$k] @(deep $out[$k] $b[$k])
        } else { set out[$k] $b[$k] }
    }
    put $out
}
var base [db: [host: localhost  port: 5432]  debug: false]
var mine [db: [port: 6543  user: ada]  debug: true]
echo @(deep $base $mine)
