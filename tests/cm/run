#!/bin/sh
# tests/cm/run - the command model's suite (871: the language's own; Rill's and Rill 2's suites retired with
# them, tests/rill/run's command-model checks moved here). Its image built (tools/build-cm-image.sh); in it,
# the runtime's own tests (tests/cm/*.4, driven from Forth - Forth's CR, its \r taken out), the scripts
# (tests/cm/scripts/*.cm, each with its output and status, as written: a \r in it a failure, 883)
# and the prompt's sessions (tests/cm/prompt/*.in, piped). Besides: the Forth lint,
# the syntax features' table, and no word of the runtime unreached (tools/cm-reach.py). RILL_GC_STRESS=1 runs it all with a collection at every safe point.
cd "$(dirname "$0")/../.." || exit 2
E=${CM_ENGINE:-./relf64}   # the engine (923): ./relf64, or ./relfasm64 - the verify runs both
python3 tools/rill-forth-lint.py > /dev/null || { python3 tools/rill-forth-lint.py; echo 'FAIL rill-forth-lint'; exit 1; }   # 742
pass=0 fail=0
if python3 tools/syntax-space.py 1000 > /tmp/cm-out.$$ 2>&1; then pass=$((pass + 1))   # the syntax features' table (864)
else fail=$((fail + 1)); echo "FAIL tools/syntax-space.py"; grep -v '^genomes\|^a uniform\|has .* values' /tmp/cm-out.$$ | head -5; fi
if python3 tools/cm-reach.py > /tmp/cm-out.$$ 2>&1; then pass=$((pass + 1))      # no runtime word unreached (873)
else fail=$((fail + 1)); echo "FAIL tools/cm-reach.py"; cat /tmp/cm-out.$$; fi
if python3 tools/reference-check.py > /tmp/cm-out.$$ 2>&1; then pass=$((pass + 1))   # the reference's examples, each run (900)
else fail=$((fail + 1)); echo "FAIL tools/reference-check.py"; cat /tmp/cm-out.$$; fi
if python3 tools/reference-check.py docs/TUTORIAL.md tests/cm/scripts/tutorial.cm > /tmp/cm-out.$$ 2>&1; then pass=$((pass + 1))   # the tutorial's (932)
else fail=$((fail + 1)); echo "FAIL tools/reference-check.py docs/TUTORIAL.md"; cat /tmp/cm-out.$$; fi
if sh tools/build-cm-image.sh "$E" forth/kernel64.img /tmp/cm.$$.img > /dev/null 2>&1; then
    for t in tests/cm/*.4; do                                           # the runtime, driven from Forth (855-857)
        printf 'S" %s" INCLUDED\n' "$t" > /tmp/cm-run.$$.4
        timeout 60 "$E" /tmp/cm.$$.img /tmp/cm-run.$$.4 2>&1 | tr -d '\r' > /tmp/cm-out.$$
        if cmp -s /tmp/cm-out.$$ "${t%.4}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t"; diff "${t%.4}.expected" /tmp/cm-out.$$ | head -5; fi
    done
    for t in tests/cm/scripts/*.cm; do                                  # the scripts (858-)
        { timeout 60 "$E" /tmp/cm.$$.img "$t" 2>&1; echo "status $?"; } > /tmp/cm-out.$$   # no \r stripped (883)
        if cmp -s /tmp/cm-out.$$ "${t%.cm}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t"; diff "${t%.cm}.expected" /tmp/cm-out.$$ | head -5; fi
    done
    for t in tests/cm/prompt/*.in; do                                   # the prompt (869): a session's lines, piped
        { timeout 60 "$E" /tmp/cm.$$.img < "$t" 2>&1; echo "status $?"; } > /tmp/cm-out.$$
        if cmp -s /tmp/cm-out.$$ "${t%.in}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t"; diff "${t%.in}.expected" /tmp/cm-out.$$ | head -5; fi
    done
    if python3 tools/cm-tab-check.py /tmp/cm.$$.img > /tmp/cm-out.$$ 2>&1; then pass=$((pass + 1))    # TAB at the prompt, in a terminal (911) - on the image built here (933)
    else fail=$((fail + 1)); echo "FAIL tools/cm-tab-check.py"; cat /tmp/cm-out.$$; fi
else fail=$((fail + 1)); echo "FAIL tools/build-cm-image.sh"; fi
rm -f /tmp/cm.$$.img /tmp/cm-run.$$.4 /tmp/cm-out.$$
echo "$pass passed, $fail failed (tests/cm)"
[ "$fail" = 0 ]
