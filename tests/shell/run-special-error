#!/bin/sh
# tests/shell/run-special-error - XCU 2.8.1: an error in a special
# builtin ends a non-interactive shell (Iteration 376). Not a
# differential case, because tests/diff compares against bash, which
# applies this rule only in POSIX mode; dash, mrsh and yash's POSIX
# suite all agree with what is checked here.
. "$(dirname "$0")/lib.sh"

check() {   # check NAME SCRIPT EXPECTED-OUTPUT
    got=$(printf '%s\n' "$2" | "$THIS_SH" 2>/dev/null)
    assert_output_equals "$1" "$3" "$got"
}

check "shift past the end stops the script" \
      'set -- a; shift 5; echo REACHED' ""
check "assigning to a readonly stops it" \
      'readonly R=1; R=2; echo REACHED' ""
check "an invalid option to set stops it" \
      'set -q; echo REACHED' ""
check "unset of a readonly stops it" \
      'readonly R=1; unset R; echo REACHED' ""
check "a syntax error in eval stops it" \
      'eval fi; echo REACHED' ""
check "an unset parameter with ? stops it" \
      'unset a; echo ${a?}; echo REACHED' ""

# ... but a non-zero STATUS from a special builtin is not an error of
# the builtin, and the shell carries on.
check "eval false is not an error of eval" \
      'eval false; echo REACHED' "REACHED"
check "a false in a dot script is not an error of dot" \
      'echo false > /tmp/relf-376-dot.sh; . /tmp/relf-376-dot.sh; echo REACHED; rm -f /tmp/relf-376-dot.sh' \
      "REACHED"
check "an ordinary builtin error does not stop it" \
      'cd /no/such/dir; echo REACHED' "REACHED"
check "a failed external command does not stop it" \
      'nosuchcommand-xyz; echo REACHED' "REACHED"

# Inside a subshell it is the subshell that ends.
check "a subshell absorbs it" \
      '(set -- a; shift 5) 2>/dev/null; echo REACHED' "REACHED"
check "... and reports a non-zero status" \
      '(set -- a; shift 5) 2>/dev/null; [ $? -ne 0 ] && echo NONZERO' "NONZERO"

# XCU 2.9.1: an assignment before a SPECIAL builtin persists after it,
# while one before any other command does not (Iteration 379).
check "an assignment before : persists" \
      'v=keep; v=tmp :; echo "$v"' "tmp"
check "... before eval too" \
      'v=keep; v=tmp eval echo x; echo "$v"' "x
tmp"
check "... and before export" \
      'v=keep; v=tmp export w=1; echo "$v$w"' "tmp1"
check "but not before an ordinary builtin" \
      'v=keep; v=tmp cd .; echo "$v"' "keep"
check "nor before an external command" \
      'v=keep; v=tmp /bin/true; echo "$v"' "keep"
check "nor before a function" \
      'f() { :; }; v=keep; v=tmp f; echo "$v"' "keep"

# A redirection that fails on a special builtin is an error in that
# builtin, so it ends the shell too (Iteration 383).
check "a failed redirection on : stops the script" \
      ': < /nonexistent; echo REACHED' ""
check "... on eval as well" \
      'eval echo x < /nonexistent; echo REACHED' ""
check "a subshell absorbs that too" \
      '( : < /nonexistent ) 2>/dev/null; echo REACHED' "REACHED"
check "an ordinary builtin carries on" \
      'cd / < /nonexistent 2>/dev/null; echo REACHED' "REACHED"
check "and so does an external command" \
      '/bin/true < /nonexistent 2>/dev/null; echo REACHED' "REACHED"

# An assignment that failed means the command does not run at all: a
# non-interactive shell has already ended, and an interactive one skips
# it rather than running it without the assignment (Iteration 383).
got=$(printf 'readonly a=1\na=2 set\necho reached\n' | "$THIS_SH" -i +m 2>/dev/null)
assert_output_equals "a failed assignment skips the command" "reached" "$got"
# break and continue need a positive count (Iteration 421, from yash).
# The count was clamped to 1, so `break 0` quietly broke one loop; now it
# is an error, and a special builtin's error ends the shell.
out=$("$THIS_SH" -c 'for i in 1; do break 0; done; echo after' 2>&1); st=$?
assert_output_contains "break 0 is reported" "bad number" "$out"
assert_output_equals "... and ends a non-interactive shell" "2" "$st"
out=$("$THIS_SH" -c 'for i in 1 2; do continue abc; done; echo after' 2>&1)
assert_output_contains "continue abc is reported" "bad number" "$out"
out=$("$THIS_SH" -c 'for i in 1 2; do for j in a b; do break 2; done; echo no; done; echo ok' 2>&1)
assert_output_equals "a valid count still works" "ok" "$out"
# `command` takes a special builtin's special properties away (XCU
# command; Iteration 424, from busybox's ash-vars/readonly1): its error
# is reported and the shell goes on, where without `command` it ends.
out=$("$THIS_SH" -c 'readonly x=1; command eval x=2; echo "after:$?"' 2>/dev/null)
assert_output_equals "command eval on a readonly variable goes on" "after:2" "$out"
out=$("$THIS_SH" -c 'command shift 5; echo "after:$?"' 2>/dev/null)
assert_output_equals "command shift past the end goes on" "after:2" "$out"
out=$("$THIS_SH" -c 'readonly x=1; eval x=2; echo NOT-REACHED' 2>/dev/null)
assert_output_equals "... while bare eval still ends the shell" "" "$out"
# An arithmetic error is an expansion error, and ends a non-interactive
# shell with status 2 (XCU 2.8.1; Iteration 427, found by the fuzzer as
# a script that ran on past one into an infinite loop).
out=$("$THIS_SH" -c 'echo $((1/0)); echo after' 2>/dev/null); st=$?
assert_output_equals "division by zero ends the shell" "" "$out"
assert_output_equals "... with status 2" "2" "$st"
out=$("$THIS_SH" -c 'x=$((5%0)); echo after' 2>/dev/null); st=$?
assert_output_equals "a remainder by zero in an assignment ends it too" "" "$out"
assert_output_equals "... with status 2" "2" "$st"
out=$("$THIS_SH" -c 'echo $(( 1 ? 2 : 1/0 )); echo ok' 2>&1)
assert_output_equals "... but a branch not taken is not an error" "2
ok" "$out"
# The dot builtin (Iteration 432, yash dot-p.tst): $? inside the script
# starts as the status before it, an empty file gives 0, and a file that
# cannot be read ends a non-interactive shell - but not under `command`.
# (No `cd`: run-all passes THIS_SH as a relative path.)
dd=$(mktemp -d); printf 'echo $?\n(exit 3)\n' > "$dd/f1"; : > "$dd/empty"
out=$("$THIS_SH" -c '(exit 5); . "$1"/f1; echo "st=$?"' sh "$dd")
assert_output_equals "the dot script sees the status before it" "5
st=3" "$out"
out=$("$THIS_SH" -c '(exit 1); . "$1"/empty; echo "st=$?"' sh "$dd")
assert_output_equals "an empty dot script gives 0" "st=0" "$out"
out=$("$THIS_SH" -c '. "$1"/nosuch; echo reached' sh "$dd" 2>/dev/null); st=$?
assert_output_equals "a missing dot script ends the shell" "" "$out"
assert_output_equals "... with status 2" "2" "$st"
out=$("$THIS_SH" -c 'command . "$1"/nosuch; echo "reached:$?"' sh "$dd" 2>/dev/null)
assert_output_equals "... but not under command" "reached:2" "$out"
rm -rf "$dd"
# Only a variable can be assigned by ${name:=word}: a positional or a
# special parameter is an error that ends the shell, as in dash (bash
# warns and goes on). Iteration 434, yash param-p.tst:198, :202.
out=$("$THIS_SH" -c 'echo ${1:=x}; echo after' 2>&1)
assert_output_contains "\${1:=x} is an error" "bad variable name" "$out"
case $out in *after*) reached=yes ;; *) reached=no ;; esac
assert_output_equals "... that ends the shell" "no" "$reached"
out=$("$THIS_SH" -c 'set -- a; echo ${1:=x}; echo after' 2>&1)
assert_output_equals "... but not when nothing would be assigned" "a
after" "$out"
# `command exec` with nothing to run keeps its redirections, as exec does
# (Iteration 438, yash command-p.tst:42); with a command it still replaces
# the shell.
out=$("$THIS_SH" -c 'command exec 3<<END
here
END
cat <&3' 2>&1)
assert_output_equals "command exec 3<<END keeps fd 3" "here" "$out"
out=$("$THIS_SH" -c 'command exec echo replaced; echo not-reached' 2>&1)
assert_output_equals "command exec CMD still replaces the shell" "replaced" "$out"
# An operator with no operand is an arithmetic error - $((1 +)), $((-)),
# $((--)), $(( () )) - and ends the shell; a blank expression is still 0
# (Iteration 440, yash arith-p.tst:367).
for e in '1 +' '-' '--' '()' '1+()'; do
    out=$("$THIS_SH" -c "echo \$(($e)); echo reached" 2>/dev/null)
    assert_output_equals "\$(($e)) is an error that ends the shell" "" "$out"
done
out=$("$THIS_SH" -c 'x=5; echo $(( )) $((--x)) $((x++)) $x' 2>&1)
assert_output_equals "... while blank, --x and x++ still work" "0 4 4 5" "$out"
report
