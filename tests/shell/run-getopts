#!/bin/sh
# tests/shell/run-getopts - the getopts builtin, and 'set --'
# (Iteration 61). Each case is also checked against bash by hand; the
# assertions below encode those answers.
. "$(dirname "$0")/lib.sh"
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT

printf 'set -- -a -b val -c rest\nwhile getopts "abc:" opt\ndo\n  echo "opt=$opt arg=$OPTARG"\ndone\necho "ind=$OPTIND"\n' > "$t/a.sh"
out=$("$THIS_SH" "$t/a.sh" 2>/dev/null)
assert_output_contains "flag option"                  "opt=a arg=" "$out"
assert_output_contains "second flag option"           "opt=b arg=" "$out"
assert_output_contains "stops at the first non-option" "ind=3"      "$out"

printf 'set -- -c val -a -z\nwhile getopts "abc:" opt\ndo\n  echo "opt=$opt arg=$OPTARG"\ndone\n' > "$t/b.sh"
out=$("$THIS_SH" "$t/b.sh" 2>/dev/null)
assert_output_contains "option taking a separate argument" "opt=c arg=val" "$out"
assert_output_contains "OPTARG cleared for a flag option" "opt=a arg=" "$out"
assert_output_contains "unknown option reported as ?"     "opt=? arg=" "$out"

printf 'set -- -ab -cX\nwhile getopts "abc:" o\ndo\n  echo "o=$o a=$OPTARG"\ndone\n' > "$t/c.sh"
out=$("$THIS_SH" "$t/c.sh" 2>/dev/null)
assert_output_contains "clustered options (1)"            "o=a a="  "$out"
assert_output_contains "clustered options (2)"            "o=b a="  "$out"
assert_output_contains "argument attached to its option"  "o=c a=X" "$out"

# Only the FIRST '--' is consumed - verified against bash, which also
# reports '--' here. The point of 'set --' is that the NEXT word is
# taken literally even if it starts with '-'.
printf 'set -- -x\necho "1=[$1]"\n' > "$t/d.sh"
out=$("$THIS_SH" "$t/d.sh" 2>/dev/null)
assert_output_contains "'set --' takes a leading-dash value literally" "1=[-x]" "$out"

printf 'set -- -- -x\necho "1=[$1] 2=[$2]"\n' > "$t/e.sh"
out=$("$THIS_SH" "$t/e.sh" 2>/dev/null)
assert_output_contains "a second -- is an ordinary parameter" "1=[--] 2=[-x]" "$out"
# OPTIND below 1 is a fresh start (Iteration 421). GO-SLOT counts from
# 1, so OPTIND=0 read positional parameter -1 and getopts segfaulted -
# found by the busybox triage, pinned with gdb. And OPTIND that is not a
# number is an error, not an index: `abc` used to read as 5451.
out=$("$THIS_SH" -c 'set -- -w 1; OPTIND=0; getopts "w:" v; echo "st=$? v=$v OPTARG=$OPTARG OPTIND=$OPTIND"' 2>&1)
assert_output_equals "OPTIND=0 starts again, as dash does" "st=0 v=w OPTARG=1 OPTIND=3" "$out"
out=$("$THIS_SH" -c 'set -- -a; OPTIND=abc; getopts a v; echo "st=$?"' 2>&1)
assert_output_contains "OPTIND=abc is reported" "bad number" "$out"
assert_output_contains "... and getopts fails with 2" "st=2" "$out"
report
