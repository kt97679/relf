#!/bin/sh
# run-unset - unset removes an exported environment variable; a
# subsequent expansion of it produces the empty string, matching an
# unset variable's behavior, and a child process no longer sees it in
# its environment either.
cd "$(dirname "$0")" || exit 1
. ./lib.sh

out=$(printf 'export FOO=bar123\necho $FOO\nunset FOO\necho $FOO\nexit\n' | "$THIS_SH" 2>&1)
assert_output_contains "FOO is set before unset" "bar123" "$out"

last_line=$(echo "$out" | tail -1 | tr -d '\r')
TESTS_RUN=$((TESTS_RUN + 1))
if [ -n "$last_line" ] && echo "$last_line" | grep -q "bar123"; then
    TESTS_FAILED=$((TESTS_FAILED + 1))
    echo "FAIL: \$FOO expands to empty after unset"
    echo "  actual output:"
    echo "$out" | sed 's/^/    /'
fi

out=$(printf 'export FOO=bar123\nunset FOO\nenv\nexit\n' | "$THIS_SH" 2>&1)
TESTS_RUN=$((TESTS_RUN + 1))
if echo "$out" | grep -q "^FOO="; then
    TESTS_FAILED=$((TESTS_FAILED + 1))
    echo "FAIL: unset variable is not visible to a child process (env)"
    echo "  actual output:"
    echo "$out" | sed 's/^/    /'
fi

# unsetting a variable that was never set is not an error
"$THIS_SH" -c "unset NEVERSET_XYZ" < /dev/null > /dev/null 2>&1
assert_status "unsetting an already-unset name is not an error" 0 "$?"

# unset moves the table's last entry into the hole. Its readonly flag
# stayed behind until Iteration 252, so here b stopped being readonly.
# (The refusal message itself still goes to stdout - GOALS.md.)
out=$(printf 'a=1\nb=2\nreadonly b\nunset a\nb=3\necho "b=$b"\n' | "$THIS_SH" 2>/dev/null | grep '^b=')
assert_output_equals "unset keeps another variable's readonly flag" "b=2" "$out"

# More variables than the table's starting 32, then unset among them.
out=$("$THIS_SH" -c 'v1=1 ; v2=2 ; v3=3 ; v4=4 ; v5=5 ; v6=6 ; v7=7 ; v8=8 ; v9=9 ; v10=10 ; v11=11 ; v12=12 ; v13=13 ; v14=14 ; v15=15 ; v16=16 ; v17=17 ; v18=18 ; v19=19 ; v20=20 ; v21=21 ; v22=22 ; v23=23 ; v24=24 ; v25=25 ; v26=26 ; v27=27 ; v28=28 ; v29=29 ; v30=30 ; v31=31 ; v32=32 ; v33=33 ; v34=34 ; v35=35 ; unset v2 ; v36=36 ; echo "$v1 ${v2:-gone} $v33 $v35 $v36"' 2>&1)
assert_output_equals "the variable table grows past 32, and unset still works" "1 gone 33 35 36" "$out"

report
