#!/bin/sh
# run-unset - unset removes an exported environment variable; a
# subsequent expansion of it produces the empty string, matching an
# unset variable's behavior, and a child process no longer sees it in
# its environment either.
cd "$(dirname "$0")" || exit 1
. ./lib.sh

out=$(printf 'export FOO=bar123\necho $FOO\nunset FOO\necho $FOO\nexit\n' | "$THIS_SH" 2>&1)
assert_output_contains "FOO is set before unset" "bar123" "$out"

last_line=$(echo "$out" | tail -1 | tr -d '\r')
TESTS_RUN=$((TESTS_RUN + 1))
if [ -n "$last_line" ] && echo "$last_line" | grep -q "bar123"; then
    TESTS_FAILED=$((TESTS_FAILED + 1))
    echo "FAIL: \$FOO expands to empty after unset"
    echo "  actual output:"
    echo "$out" | sed 's/^/    /'
fi

out=$(printf 'export FOO=bar123\nunset FOO\nenv\nexit\n' | "$THIS_SH" 2>&1)
TESTS_RUN=$((TESTS_RUN + 1))
if echo "$out" | grep -q "^FOO="; then
    TESTS_FAILED=$((TESTS_FAILED + 1))
    echo "FAIL: unset variable is not visible to a child process (env)"
    echo "  actual output:"
    echo "$out" | sed 's/^/    /'
fi

# unsetting a variable that was never set is not an error
"$THIS_SH" -c "unset NEVERSET_XYZ" < /dev/null > /dev/null 2>&1
assert_status "unsetting an already-unset name is not an error" 0 "$?"

report
