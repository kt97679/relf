#!/bin/sh
# tests/shell/run-round-trips - what POSIX calls suitable for re-input
# reads back as itself (Iteration 563; TESTING-IDEAS.md 2): the listings
# of set, export -p, trap and alias, with values holding a quote, double
# quotes, a backslash, $, backquotes, a newline, nothing, spaces, * and ~.
# A first shell lists, a fresh one reads the list in and lists again, and
# the two must be the same text. PPID differs between processes, as it
# should, and is left out; alias lines are operands of alias, not commands.
. "$(dirname "$0")/lib.sh"
t=$(mktemp -d)
setup='q="it'\''s"; d='\''a"b'\''; b='\''back\slash'\''; m='\''dollar $HOME'\''; k='\''tick `x`'\''; n="new
line"; e=; s="  lead"; g="*"; h="~"'
rt() {   # $1 what, $2 the setup, $3 the listing, $4 how it is read back in
    env -i "$THIS_SH" -c "$2; $3" > "$t/1" 2>&1
    env -i "$THIS_SH" -c "$4; $3" > "$t/2" 2>&1
    if cmp -s "$t/1" "$t/2"; then r=same; else r="differs: $(diff "$t/1" "$t/2" | head -3 | tr '\n' ' ')"; fi
    assert_output_equals "$1 reads back as itself" "same" "$r"
}
rt "set" "$setup" 'set | grep -v "^PPID="' "eval \"\$(cat $t/1)\""
rt "export -p" "$setup; export q d b m k n e s g h" 'export -p' "eval \"\$(cat $t/1)\""
rt "trap" "trap 'echo \"it'\\''s\"; x=1' INT; trap '' USR1; trap 'a\\b \$y' HUP" 'trap' "eval \"\$(cat $t/1)\""
rt "alias" "alias a='echo \"it'\\''s\"'; alias b='ls -l | cat'; alias c='x=\$y'" 'alias' "eval \"\$(sed 's/^/alias /' $t/1)\""
# readonly -p (Iteration 569): it printed values unquoted, so a blank in
# one broke the re-input the others' listings pass
rt "readonly -p" "$setup; readonly q d b m s" 'readonly -p' "eval \"\$(cat $t/1)\""
rm -rf "$t"
report
