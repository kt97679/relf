#!/bin/sh
# run-assign - standalone "NAME=value" assignment (the whole line,
# no command following) sets a shell-local variable: it expands via
# $NAME/${NAME} but, unlike `export NAME=value`, is never inherited
# by a child process. A quoted "NAME=value" is a literal argument,
# not an assignment - same reasoning ARGV-QUOTED already applies to
# operators and builtin names elsewhere in this shell.
cd "$(dirname "$0")" || exit 1
. ./lib.sh

out=$(printf 'FOO=bar123\necho $FOO\nexit\n' | "$THIS_SH" 2>&1)
assert_output_contains "standalone assignment expands via \$VAR" "bar123" "$out"

out=$(printf 'FOO=bar123\nFOO=baz456\necho $FOO\nexit\n' | "$THIS_SH" 2>&1)
assert_output_contains "re-assignment updates the value" "baz456" "$out"

out=$(printf 'A=1\nB=2\nC=3\necho $A$B$C\nexit\n' | "$THIS_SH" 2>&1)
assert_output_contains "multiple shell-local variables coexist" "123" "$out"

out=$(printf 'FOO=bar123\n/usr/bin/env\nexit\n' | "$THIS_SH" 2>&1)
TESTS_RUN=$((TESTS_RUN + 1))
if echo "$out" | grep -q "^FOO="; then
    TESTS_FAILED=$((TESTS_FAILED + 1))
    echo "FAIL: an unexported shell-local variable is not inherited by a child"
    echo "  actual output:"
    echo "$out" | sed 's/^/    /'
fi

out=$(printf 'FOO=bar123\nexport FOO\n/usr/bin/env\nexit\n' | "$THIS_SH" 2>&1)
assert_output_contains "bare 'export NAME' exports an existing shell-local variable" "FOO=bar123" "$out"

out=$(printf 'FOO=bar123\necho \$FOO\nunset FOO\necho \$FOO\nexit\n' | "$THIS_SH" 2>&1)
last_echo=$(echo "$out" | tail -1 | tr -d '\r')
TESTS_RUN=$((TESTS_RUN + 1))
if [ -n "$last_echo" ] && echo "$last_echo" | grep -q "bar123"; then
    TESTS_FAILED=$((TESTS_FAILED + 1))
    echo "FAIL: unset also removes the shell-local copy, not just the environment one"
    echo "  actual output:"
    echo "$out" | sed 's/^/    /'
fi

"$THIS_SH" -c "'FOO=bar123'" < /dev/null > /dev/null 2>&1
assert_status "a quoted 'NAME=value' alone is a literal command, not an assignment" 127 "$?"

"$THIS_SH" -c "FOO=bar123" < /dev/null > /dev/null 2>&1
assert_status "a successful standalone assignment exits 0" 0 "$?"

# Startup and export (Iteration 422, from yash): IFS and OPTIND are set
# at startup, an inherited IFS is replaced, and export takes EVERY operand.
out=$(env -i PATH="$PATH" IFS=Q RELF_BIN="${RELF_BIN:-}" RELF_IMG="${RELF_IMG:-}" "$THIS_SH" -c 'printf "[%s]" "$IFS"' | od -An -c | tr -d ' ')
assert_output_equals "IFS starts as space, tab, newline" '[\t\n]' "$out"
out=$("$THIS_SH" -c 'echo "$OPTIND"')
assert_output_equals "OPTIND starts at 1" "1" "$out"
out=$("$THIS_SH" -c 'old=$IFS; IFS=:; IFS=$old; set -- "x y"; set -- $1; echo $#')
assert_output_equals "saving and restoring IFS keeps splitting" "2" "$out"
out=$("$THIS_SH" -c 'a=X b=B c=X; export a=A b c=C; sh -c "echo \$a \$b \$c"')
assert_output_equals "export takes every operand" "A B C" "$out"
# Assignments the shell makes are assignments, so `set -a` exports them:
# read, the for variable, getopts (Iteration 432; yash read-p.tst:55).
out=$(printf 'A B\n' | "$THIS_SH" -c 'set -a; read a b; sh -c "echo [\$a] [\$b]"')
assert_output_equals "set -a exports what read assigns" "[A] [B]" "$out"
out=$("$THIS_SH" -c 'set -a; for fv in x; do :; done; sh -c "echo [\$fv]"')
assert_output_equals "... and the for variable" "[x]" "$out"
out=$("$THIS_SH" -c 'set -a; getopts a: gv -a val; sh -c "echo [\$gv] [\$OPTARG]"')
assert_output_equals "... and getopts' variable and OPTARG" "[a] [val]" "$out"
out=$(printf 'Q\n' | "$THIS_SH" -c 'read q; sh -c "echo [\$q]"')
assert_output_equals "... and without set -a, nothing" "[]" "$out"
report
