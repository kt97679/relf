#!/bin/sh
# tests/shell/run-encoded - the expander (EXPANSION-PLAN.md). Until
# Stage C (Iteration 282) this ran the battery through both the encoded
# and the scanning path and required them to agree; the scanning path is
# gone, so it now checks the battery against bash. The cases are the ones
# the two paths disagreed on while both existed: quoting, field
# splitting, IFS, "$@", operator forms, patterns and pathname expansion.
. "$(dirname "$0")/lib.sh"
case "$THIS_SH" in /*) SH=$THIS_SH ;; *) SH=$(pwd)/$THIS_SH ;; esac
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
cat > "$t/battery.sh" <<'BAT'
x=hello; y='a b'; z=; unset u
echo plain a-b.c "$x" '$x' "pre${x}post" "a$x-b"
echo $x $y "$y" ${x} ${#x} ${#y} "$z" [$z] "${z}x" $u "${u}" ${#u}
set -- p1 "p 2" p3
echo $# $1 "$1" $@ "$@" $* "$*" ${#1} "$@$x" "${x}${y}"
printf '[%s]' $y; echo
printf '[%s]' "$y"; echo
IFS=:; v=a::b:; printf '[%s]' $v; echo; v2='x y'; printf '[%s]' $v2; echo; unset IFS
echo 'q'"$x"'r' "\$x" "\\" '\' "a""b" '' ""
echo ${x:-d} ${u:-d} ${u:=e} ${x#h} ${x%o} ~ $((1+1)) $(echo s) `echo b`
w='a*b'; echo "$w" $w
touch f1.txt f2.txt && echo *.txt "*.txt" $x*.txt
g() { echo "in g: $1 $# $*"; }
g one two
echo "end $? $#"
BAT
out1=$(cd "$t" && "$SH" battery.sh 2>&1)
if command -v bash > /dev/null 2>&1; then
    outb=$(cd "$t" && bash battery.sh 2>&1)
    assert_output_equals "the battery gives what bash gives" "$outb" "$out1"
fi
report
