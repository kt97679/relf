#!/bin/sh
# tests/shell/run-ifs - $IFS actually controls field splitting
# (Iteration 67). It used to be hardcoded to space/tab.
. "$(dirname "$0")/lib.sh"
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT

printf "IFS=':'\nfor c in \$(echo a:s:d)\ndo\n  echo \"[\$c]\"\ndone\n" > "$t/a.sh"
out=$("$THIS_SH" "$t/a.sh" 2>/dev/null)
assert_output_contains "IFS=':' splits on colon (first)" "[a]" "$out"
assert_output_contains "IFS=':' splits on colon (last)"  "[d]" "$out"

printf "IFS=':'\nv='x y'\nfor c in \$v\ndo\n  echo \"<\$c>\"\ndone\n" > "$t/b.sh"
out=$("$THIS_SH" "$t/b.sh" 2>/dev/null)
assert_output_contains "with IFS=':', a space no longer splits" "<x y>" "$out"

printf "v='a b'\nfor c in \$v\ndo\n  echo \"<\$c>\"\ndone\n" > "$t/c.sh"
out=$("$THIS_SH" "$t/c.sh" 2>/dev/null)
assert_output_contains "default IFS still splits on space (1)" "<a>" "$out"
assert_output_contains "default IFS still splits on space (2)" "<b>" "$out"
report
