# break, continue and return, in and out of loops (779): as Python - tests/rill/flow.py
n = 0
while ($n < 10) { n = $n + 1; if ($n == 3) { break } }
echo a $n
s = 0
n = 0
while ($n < 6) { n = $n + 1; if ($n == 3) { continue }; s = $s + $n }
echo b $s
for i in range(3) { m = 0; while ($m < 10) { m = $m + 1; if ($m == 2) { break } }; echo c $i $m }
def first-big(xs) -> number {
    for x in $xs { if ($x > 5) { return $x } }
    return -1
}
echo d {first-big([1, 7, 3, 9])} {first-big([1, 2])}
def find-at(n) -> number {
    for i in range(10) { if ($i * $i > $n) { return $i } }
    return -1
}
echo e {find-at(20)} {find-at(200)}
def skip-small(xs) -> number {
    for x in $xs { if ($x < 5) { continue }; return $x }
    return -1
}
echo f {skip-small([1, 7, 3, 9])} {skip-small([1, 2])}
def pair(xs) -> text {
    for x in $xs { for y in $xs { if ($x * $y == 12) { return "{$x}x{$y}" } } }
    return "none"
}
echo g {pair([2, 3, 4, 6])} {pair([1, 5])}
def wloop(n) -> number {
    i = 0
    while ($i < $n) { i = $i + 1; if ($i == 4) { return $i * 10 } }
    return 0
}
echo h {wloop(9)} {wloop(2)}
def wcont(n) -> number {
    i = 0
    t = 0
    while ($i < $n) { i = $i + 1; if ($i % 2 == 0) { continue }; if ($i > 6) { return $t }; t = $t + $i }
    return $t
}
echo i {wcont(10)} {wcont(4)}
def deep(xs) -> text {
    for x in $xs {
        if ($x == 0) { continue }
        for k, v in {a: 1, b: $x} { if ($v == 7) { return "{$k} at {$x}" } }
    }
    return "no"
}
echo j {deep([0, 3, 7, 9])} {deep([1, 2])}
total = 0
for i in range(5) { j = 0; while (true) { j = $j + 1; if ($j > $i) { break } ; if ($j == 2) { continue }; total = $total + $j } }
echo k $total
