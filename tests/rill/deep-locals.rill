# recursion of a def with locals past the engine's save stack (818): Rill's error with its line - it
# was shadow.4's `shadow: save stack overflow`, then `rill: error -2`; some 2,000 levels fit
def walk(l, n) {
    if ($n == 0) { return }
    push($l, "x")
    walk($l, $n - 1)
}
l = []
walk($l, 1000)
echo {len($l)}
walk($l, 100000)
echo not reached
