# glob(pattern): the paths it matches, sorted (786) - tests/rill/glob.py
tmp = $(mktemp -d)
cd $tmp {
    mkdir -p docs sub
    touch a.txt b.txt c.md .hidden.txt docs/one.md docs/two.md docs/three.txt sub/x1 sub/x22
    for p in ["*.txt" "*" "docs/*.md" "docs/t*" "sub/x?" "[ab]*" ".*" "nomatch*" "a.txt" "missing.txt" "docs/*.none"] {
        echo "$p: {join(glob($p), ' ')}"
    }
}
n = len(glob("$tmp/*.txt"))
echo "$n under an absolute path"
rm -rf $tmp
