# format(f, a, ...): Python's % formatting (781) - tests/rill/format.py
echo {format("%5d|%-5d|%05d|%+d|% d|%d", 42, 42, 42, 42, 42, -7)}
echo {format("%x %X %5x %-6X| %x %.4d", 255, 255, 4096, 171, -255, 12)}
echo {format("%.3f|%8.2f|%-8.1f|%08.3f|%.0f|%f", 3.14159, 2.5, -1.26, -3.5, 7.7, 0.1)}
echo {format("%s|%10s|%-10s|%.2s|%5.1s|", "abc", "right", "left", "truncate", "xyz")}
echo {format("%s has %d items (%.1f%%)", "list", 3, 42.857)}
echo {format("%s and %s", 42, 2.5)}
echo {format("no conversions at all")}
rows = [["alpha" 1.5 3] ["beta" 12.25 41] ["gamma-delta" 0.333 7]]
for r in $rows { echo {format("%-11s %8.3f %4d", $r[0], $r[1], $r[2])} }
n = 3
t = format("%d%%", $n * 10)
echo $t {len($t)}
echo {format("%+.2f %+d % .1f", 1.006, 0, 2.24)}
