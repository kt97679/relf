# tests/rill/range.rill - range as Python's: up to, not with, its end; a step; a loop's variable after it (770)
echo {join(range(5), " ")}
echo {join(range(2, 5), " ")}
echo "[{join(range(5, 2), ' ')}]"
echo "[{join(range(3, 3), ' ')}]"
echo {join(range(0, 10, 3), " ")}
echo {join(range(10, 0, -3), " ")}
echo {join(range(5, 0, -1), " ")}
for i in range(4) { echo i $i }
echo after $i
for j in range(7, 3) { echo never }
for k in range(2, 6) { if ($k == 4) { break } }
echo k $k
n = 0
for i in range(1, 11) { n = $n + $i }
echo sum $n
l = [a, b, c]
for i in range(len($l)) { echo $i $l[$i] }
echo {len(range(100))}
for m in range(10, 0, -4) { echo m $m }
echo "[{join([$x * $x for x in range(4)], ' ')}]"
