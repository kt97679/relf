# pipelines, output captured, ports redirected (stage 1b)
printf 'b\na\nc\n' | sort | head -2
n = $(printf 'x\ny\nz\n' | wc -l)
echo lines: $n
echo "today has {$(echo 3)} parts and $(echo inline) text"
t = /tmp/rill-pipes-test.txt
echo first > $t
echo second >> $t
cat < $t
ls /nonexistent err> /dev/null ?? echo "ls failed quietly"
sh -c 'echo to-err 1>&2' err>out | tr a-z A-Z
sh -c 'echo both; echo again 1>&2' all> $t
wc -l < $t
rm $t
