# the prompt (824): a session's lines, each compiled and run in turn - variables and defs kept
x = 1 +
echo "a compile error, and on: {1 + 1}"
y = 1 / 0
echo $y
def f(a) -> number { return $a + 1 }
echo {f(1)}
def f(a, b) -> number { return $a * $b }
echo {f(3, 4)}
def g(n) -> number { return f($n, $n) + 1 }
echo {g(5)}
l = []
push($l, "one")

push($l, "two")
echo {len($l)} {join($l, "+")}
squares = [$i * $i for i in range(4)]
echo $squares
c = $(echo captured | tr a-z A-Z)
echo $c
printf '%s\n' b a | sort | head -1
j = spawn((sh -c 'exit 7'))
echo "job: {wait($j)}"
big = [range(1000)]
echo {len($l)} {$l[1]} $c
