# the everyday functions (798): + joins lists and texts; pop, delete, find, sort-by on lists, in on texts - tests/rill/everyday.py
a = [1 2]
b = $a + [3 4]
echo {join($b, ",")} {len($a)}
name = "build"
echo {$name + ".log"} {"a" + "b"}
def tag x -> text { return $x + "!" }
echo {tag("hi")}
l = [1 2 3 4]
echo {pop($l)} {join($l, ",")}
delete($l, 0)
delete($l, -1)
echo {join($l, ",")}
r = {a: 1, b: 2, c: 3}
delete($r, "b")
echo {join(keys($r), ",")} {"b" in $r}
echo {find("hello", "l")} {find("hello", "z")} {find([10 20 30], 20)} {find([10 20], 5)}
echo {"ell" in "hello"} {"xyz" in "hello"} {"ell" not in "hello"}
rows = [{n: "c", v: 3} {n: "a", v: 1} {n: "b", v: 2} {n: "d", v: 1}]
s = sort-by($rows, v)
echo {join([$x.n for x in $s], " ")}
d = sort-by($rows, n, desc)
echo {join([$x.n for x in $d], " ")}
echo {join(sort([2 1.5 1 3]), " ")}
big = {}
for i in range(20) { big["k{$i}"] = $i }
delete($big, k3)
echo {len(keys($big))} $big.k19 {"k3" in $big} {"k4" in $big}
