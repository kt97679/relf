#!/bin/sh
# tests/rill/run - each tests/rill/*.rill compiled by tools/rillc.py, run on
# Rill's image, its output compared with *.expected (Iteration 736).
cd "$(dirname "$0")/../.." || exit 2
[ -f kernel64-rill.img ] || sh tools/build-rill-image.sh > /dev/null || exit 2
python3 tools/rill-forth-lint.py > /dev/null || { python3 tools/rill-forth-lint.py; echo 'FAIL rill-forth-lint'; exit 1; }   # 742
pass=0 fail=0
for t in tests/rill/*.rill; do
    f=${t%.rill}
    python3 tools/rillc.py "$t" > "$f.4.tmp" 2> "$f.err" &&
        timeout 30 ./relf64 kernel64-rill.img "$f.4.tmp" < /dev/null > "$f.out" 2>&1
    if cmp -s "$f.out" "$f.expected"; then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL $t"; diff "$f.expected" "$f.out" | head -5; fi
    rm -f "$f.4.tmp" "$f.err" "$f.out"
done
# programs both compilers must reject, each with the message in its .expected (762)
for e in tests/rill/errors/*.rill; do
    want=$(cat "${e%.rill}.expected")
    py=$(python3 tools/rillc.py "$e" 2>&1 >/dev/null); im=$(./relf64 kernel64-rill.img "$e" < /dev/null 2>&1)
    case "$py" in *"$want"*) ;; *) fail=$((fail + 1)); echo "FAIL $e: rillc.py said: $py"; continue ;; esac
    case "$im" in *"$want"*) pass=$((pass + 1)) ;; *) fail=$((fail + 1)); echo "FAIL $e: the image said: $im" ;; esac
done
# Rill at work (782): examples/rill/gen-opcodes.rill --check says what tools/gen-opcodes.sh --check says
sh tools/gen-opcodes.sh --check > /tmp/rill-go-sh.$$ 2>&1
timeout 60 ./relf64 kernel64-rill.img examples/rill/gen-opcodes.rill --check < /dev/null > /tmp/rill-go-rl.$$ 2>&1
if cmp -s /tmp/rill-go-sh.$$ /tmp/rill-go-rl.$$; then pass=$((pass + 1))
else fail=$((fail + 1)); echo "FAIL examples/rill/gen-opcodes.rill --check"; diff /tmp/rill-go-sh.$$ /tmp/rill-go-rl.$$ | head -5; fi
rm -f /tmp/rill-go-sh.$$ /tmp/rill-go-rl.$$
# on EXIT when TERM stops the script, and its status 143 (786)
timeout 20 ./relf64 kernel64-rill.img tests/rill/signals/interrupt.rill < /dev/null > /tmp/rill-int.$$ 2>&1 & rp=$!
sleep 0.6; kill -TERM $rp; wait $rp; rs=$?
if [ "$rs" = 143 ] && [ "$(cat /tmp/rill-int.$$)" = "$(printf 'started\ncleanup ran')" ]; then pass=$((pass + 1))
else fail=$((fail + 1)); echo "FAIL tests/rill/signals/interrupt.rill: status $rs"; cat /tmp/rill-int.$$; fi
rm -f /tmp/rill-int.$$
timeout 20 ./relf64 kernel64-rill.img tests/rill/signals/spin.rill < /dev/null > /tmp/rill-int.$$ 2>&1 & rp=$!
sleep 0.4; kill -INT $rp; wait $rp; rs=$?
if [ "$rs" = 130 ] && [ "$(cat /tmp/rill-int.$$)" = "cleanup ran" ]; then pass=$((pass + 1))
else fail=$((fail + 1)); echo "FAIL tests/rill/signals/spin.rill: status $rs"; cat /tmp/rill-int.$$; fi
rm -f /tmp/rill-int.$$
# Rill at work (788): examples/rill/run-utf8.rill says what tests/shell/run-utf8 says, against ./relfsh
(cd tests/shell && THIS_SH=../../relfsh sh ./run-utf8) > /tmp/rill-u8-sh.$$ 2>&1; us=$?
THIS_SH=./relfsh timeout 60 ./relf64 kernel64-rill.img examples/rill/run-utf8.rill < /dev/null > /tmp/rill-u8-rl.$$ 2>&1; ur=$?
if [ "$us" = "$ur" ] && cmp -s /tmp/rill-u8-sh.$$ /tmp/rill-u8-rl.$$; then pass=$((pass + 1))
else fail=$((fail + 1)); echo "FAIL examples/rill/run-utf8.rill: status $ur, the shell's $us"; diff /tmp/rill-u8-sh.$$ /tmp/rill-u8-rl.$$ | head -5; fi
rm -f /tmp/rill-u8-sh.$$ /tmp/rill-u8-rl.$$
# bin/rill (797): a #! script without .rill through PATH, its arguments and status; -c through a link; --forth
lt=$(mktemp -d); printf '#!/usr/bin/env rill\necho "{len($args)} args: {join($args, ",")}"\nexit 3\n' > $lt/greet; chmod +x $lt/greet
ln -s "$PWD/bin/rill" $lt/rill-link
lo=$(PATH="$PWD/bin:$PATH" $lt/greet a "b c"; echo "status $?"; $lt/rill-link -c 'echo {6 * 7} $args' x; bin/rill --forth $lt/greet | grep -c R-MAIN)
if [ "$lo" = "$(printf '2 args: a,b c\nstatus 3\n42 x\n2')" ]; then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL bin/rill:"; echo "$lo"; fi
rm -rf $lt
# jobs (813): a job's stdin is /dev/null; a job not waited for gets TERM when the script ends; INT or
# TERM while the script waits for one ends it at once, 143, its job with it. Gone: no process, or a
# zombie. Output into files, not $(...): a job left running holds a pipe open, and the check waited
# for it; TERM straight to relf64, not through timeout, which sends it to the whole group (813).
gone() { s=$(ps -o stat= -p "$1" 2>/dev/null); [ -z "$s" ] || [ "${s#Z}" != "$s" ]; }
jt=$(mktemp -d); jlate=
printf 'j = spawn((readlink /proc/self/fd/0 out> %s/in))\nwait($j)\n' "$jt" > $jt/in.rill
printf 'j = spawn((sleep 30))\necho $j\n' > $jt/end.rill
printf 'j = spawn((sleep 30))\necho $j\nwait($j)\necho not reached\n' > $jt/sig.rill
timeout 20 ./relf64 kernel64-rill.img $jt/in.rill < tests/rill/jobs.rill > /dev/null 2>&1; jin=$(cat $jt/in 2>/dev/null)
./relf64 kernel64-rill.img $jt/end.rill < /dev/null > $jt/end.out 2>&1; jend=$(head -1 $jt/end.out); sleep 0.3
gone "$jend" || { kill "$jend" 2>/dev/null; jend="$jend still running"; }
./relf64 kernel64-rill.img $jt/sig.rill < /dev/null > $jt/sig.out 2>&1 & jp=$!
n=0; while [ ! -s $jt/sig.out ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n + 1)); done
kill -TERM $jp; n=0; while kill -0 $jp 2>/dev/null && [ $n -lt 30 ]; do sleep 0.1; n=$((n + 1)); done
kill -0 $jp 2>/dev/null && { kill -KILL $jp; jlate=' - still waiting 3 s after TERM'; }
wait $jp; jst=$?; jsp=$(head -1 $jt/sig.out); sleep 0.3
gone "$jsp" || { kill "$jsp" 2>/dev/null; jsp="$jsp still running"; }
if [ "$jin" = /dev/null ] && [ "$jend" -gt 0 ] 2>/dev/null && [ "$jst" = 143 ] && [ -z "$jlate" ] && [ "$jsp" -gt 0 ] 2>/dev/null && [ -z "$(sed -n 2p $jt/sig.out)" ]
then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL jobs: stdin [$jin], end [$jend], signal status $jst$jlate [$jsp] [$(sed -n 2p $jt/sig.out)]"; fi
rm -rf $jt
# the prompt (824): a session's lines on stdin, rill with no script - its output, then its status
for p in tests/rill/prompt/*.in; do
    { (ulimit -v 400000 2>/dev/null; timeout 30 ./relf64 kernel64-rill.img < "$p" 2>&1); echo "status $?"; } > /tmp/rill-prompt.$$   # in 400 MB (828)
    if cmp -s /tmp/rill-prompt.$$ "${p%.in}.expected"; then pass=$((pass + 1))
    else fail=$((fail + 1)); echo "FAIL $p"; diff "${p%.in}.expected" /tmp/rill-prompt.$$ | head -5; fi
done
rm -f /tmp/rill-prompt.$$
# the prompt at a terminal (825): relfsh's line editor, on a pseudo-terminal where python3 has pty
if python3 -c 'import pty' 2>/dev/null; then
    if timeout 60 python3 tests/rill/prompt-probe.py > /tmp/rill-probe.$$ 2>&1; then pass=$((pass + 1))
    else fail=$((fail + 1)); cat /tmp/rill-probe.$$; fi
    rm -f /tmp/rill-probe.$$
fi
# the pilots' Forth versions still load (829): 799 took R-UPPER, R-LOG and R-EXP from the runtime and
# two of them stopped, unseen - each loaded, its last line - MAIN - left out, and nothing undefined
for f in examples/rill/*.fth; do
    sed '$d' "$f" > /tmp/rill-fth.$$.4; printf 'S" /tmp/rill-fth.%s.4" INCLUDED\n' $$ > /tmp/rill-fth.$$.run
    if [ "$(grep -v '^[[:space:]]*$' "$f" | tail -1)" = MAIN ] && ! ./relf64 kernel64-rill.img /tmp/rill-fth.$$.run 2>&1 | grep -q "Undefined word\|rill: error"
    then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL $f: does not load, or does not end MAIN"; fi
done
rm -f /tmp/rill-fth.$$.4 /tmp/rill-fth.$$.run
# the scripting vocabulary's sketch (829): its parse-dump.4 prints what parse-dump.rill prints
printf 'S" examples/forth-script/vocab.4" INCLUDED  S" examples/forth-script/parse-dump.4" INCLUDED\n' > /tmp/rill-fs.$$.4
if [ "$(./relf64 kernel64-rill.img /tmp/rill-fs.$$.4 2>&1 | grep -v Redefining | tail -1 | tr -d '\r')" = "$(./relf64 kernel64-rill.img examples/forth-script/parse-dump.rill 2>&1 | tail -1)" ]
then pass=$((pass + 1)); else fail=$((fail + 1)); echo "FAIL examples/forth-script: parse-dump.4 and parse-dump.rill differ"; fi
rm -f /tmp/rill-fs.$$.4
# Rill 2 (834, docs/RILL2.md): its image built, then each tests/rill2/*.r2 and errors/*.r2 run in it -
# its output, then its status, as its .expected has them
if sh tools/build-rill2-image.sh ./relf64 forth/kernel64.img /tmp/rill2.$$.img > /dev/null 2>&1; then
    for t in tests/rill2/*.r2 tests/rill2/errors/*.r2; do
        { RILL2_TOUR=set timeout 30 ./relf64 /tmp/rill2.$$.img "$t" 2>&1; echo "status $?"; } > /tmp/rill2-out.$$
        if cmp -s /tmp/rill2-out.$$ "${t%.r2}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t"; diff "${t%.r2}.expected" /tmp/rill2-out.$$ | head -5; fi
    done
    for t in tests/rill2/*.r2; do                                       # stack mode off: the same output (837)
        { RILL2_STACK=0 RILL2_TOUR=set timeout 30 ./relf64 /tmp/rill2.$$.img "$t" 2>&1; echo "status $?"; } > /tmp/rill2-out.$$
        if cmp -s /tmp/rill2-out.$$ "${t%.r2}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t, RILL2_STACK=0"; diff "${t%.r2}.expected" /tmp/rill2-out.$$ | head -5; fi
    done
    for t in tests/rill2/compare/side.rill tests/rill2/compare/side.r2; do   # Rill and Rill 2: one program each, one output (838)
        case $t in *.rill) img=kernel64-rill.img ;; *) img=/tmp/rill2.$$.img ;; esac
        { timeout 30 ./relf64 "$img" "$t" 2>&1; echo "status $?"; } > /tmp/rill2-out.$$
        if cmp -s /tmp/rill2-out.$$ tests/rill2/compare/side.expected; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t"; diff tests/rill2/compare/side.expected /tmp/rill2-out.$$ | head -5; fi
    done
    for t in tests/rill2/prompt/*.in; do                                # the prompt, piped (835)
        { (ulimit -v 400000 2>/dev/null; timeout 30 ./relf64 /tmp/rill2.$$.img < "$t" 2>&1); echo "status $?"; } > /tmp/rill2-out.$$
        if cmp -s /tmp/rill2-out.$$ "${t%.in}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t"; diff "${t%.in}.expected" /tmp/rill2-out.$$ | head -5; fi
    done
    if python3 -c 'import pty' 2>/dev/null; then                         # and at a terminal (835)
        if timeout 60 python3 tests/rill2/prompt-probe.py /tmp/rill2.$$.img > /tmp/rill2-out.$$ 2>&1; then pass=$((pass + 1))
        else fail=$((fail + 1)); cat /tmp/rill2-out.$$; fi
    fi
    for t in tests/cm/*.4; do                                           # the command model's prototype (855): its runtime, driven from Forth
        printf 'S" %s" INCLUDED\n' "$t" > /tmp/cm-run.$$.4
        timeout 60 ./relf64 /tmp/rill2.$$.img /tmp/cm-run.$$.4 2>&1 | tr -d '\r' > /tmp/rill2-out.$$
        if cmp -s /tmp/rill2-out.$$ "${t%.4}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t"; diff "${t%.4}.expected" /tmp/rill2-out.$$ | head -5; fi
    done
    rm -f /tmp/cm-run.$$.4
else fail=$((fail + 1)); echo "FAIL tools/build-rill2-image.sh"; fi
if sh tools/build-cm-image.sh ./relf64 forth/kernel64.img /tmp/cm.$$.img > /dev/null 2>&1; then
    for t in tests/cm/scripts/*.cm; do                                  # the command model's scripts, in its own image (863; its one front end, cm/cmc.4, 867)
        { timeout 60 ./relf64 /tmp/cm.$$.img "$t" 2>&1; echo "status $?"; } | tr -d '\r' > /tmp/rill2-out.$$
        if cmp -s /tmp/rill2-out.$$ "${t%.cm}.expected"; then pass=$((pass + 1))
        else fail=$((fail + 1)); echo "FAIL $t, in kernel64-cm.img"; diff "${t%.cm}.expected" /tmp/rill2-out.$$ | head -5; fi
    done
else fail=$((fail + 1)); echo "FAIL tools/build-cm-image.sh"; fi
rm -f /tmp/rill2.$$.img /tmp/cm.$$.img /tmp/rill2-out.$$
# the syntax features' table (864): its rules fit every system it names, and name only its values
if python3 tools/syntax-space.py 1000 > /tmp/rill-syntax.$$ 2>&1; then pass=$((pass + 1))
else fail=$((fail + 1)); echo "FAIL tools/syntax-space.py"; grep -v '^genomes\|^a uniform\|has .* values' /tmp/rill-syntax.$$ | head -5; fi
rm -f /tmp/rill-syntax.$$
# memory kept for good, by any feature of the runtime (778): each in a loop at N and 10 N rounds
if python3 tools/rill-memcheck.py --check > /tmp/rill-memcheck.out 2>&1; then pass=$((pass + 1))
else fail=$((fail + 1)); echo "FAIL rill-memcheck"; grep -E "KEPT|fails" /tmp/rill-memcheck.out; fi
echo "$pass passed, $fail failed (tests/rill)"
[ "$fail" = 0 ]
