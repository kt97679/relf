# jobs (813, QUESTIONS.md A36): spawn((cmd args)) starts a pipeline and returns at once - its last
# stage's pid - and wait($job) gives its status as the pipeline's would be; a job waited for is gone
f = "/tmp/rill-jobs-813"
rm -f "$f.a" "$f.b" "$f.p"
a = spawn((sh -c 'while [ ! -f "$1" ]; do sleep 0.02; done; echo a saw b' sh "$f.b" out> "$f.a"))
b = spawn((touch "$f.b"))
echo "b: {wait($b)}, a: {wait($a)} - {trim(read("$f.a"))}"
c = spawn((sh -c 'exit 3'))
p = spawn((printf 'x\ny\n' | wc -l out> "$f.p"))
q = spawn((false | true))
echo "c {wait($c)}, p {wait($p)} {trim(read("$f.p"))}, q {wait($q)}"
rm -f "$f.a" "$f.b" "$f.p"
echo {wait($c)}
