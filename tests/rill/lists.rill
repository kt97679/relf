# lists and records (stage 2)
refs = [HEAD, master]
push($refs, article)
echo {len($refs)} refs: $refs
nums = [3, 1, 4, 1, 5]
total = 0
for x in $nums { total = $total + $x }
echo sum $total
for i, x in $nums { if ($i == 2) { echo "third is $x" } }
squares = [$x * $x for x in $nums if $x > 1]
echo squares $squares
w = words("  the quick  brown fox ")
echo {len($w)} words, last {$w[3]}, joined {join($w, "+")}
if (fox in $w) { echo has fox }
if (cat not in $w) { echo no cat }
host = {name: relf, port: 8080, 'S"': quote}
echo "{$host[name]}:{$host[port]}"
host[port] = 9090
echo port now {$host[port]} and {$host['S"']}
for k, v in $host { echo field $k = $v }
for n in range(1, 5) { echo n $n }
first3 = slice($nums, 0, 3)
echo first three: $first3, shifted {pop($first3, 0)}, left $first3
lines = lines("a
b
c")
echo {len($lines)} lines
def count-big(xs) -> number {
    n = 0
    for x in $xs { if ($x > 2) { n = $n + 1 } }
    return $n
}
echo big: {count-big($nums)}
