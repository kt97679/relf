# a comprehension's variables are its own, as Python 3's (808): they were the script's
r = {a: 1, b: 2}
names = [$k for k, c in $r]
x = {a: {c: 7}}
echo {join($names, ",")} $x[a][c]
k = 5
ks = [$k for k, v in $r]
echo $k {join($ks, "")}
y = "keep"
ys = [$y for y in ["p", "q"]]
echo $y {join($ys, "")}
m = [[1, 2], [3]]
echo {join([len([$z for z in $z]) for z in $m], " ")}
for i in range(2) {
    echo $i {join([$i for i in ["s", "t"]], "")}
}
def double(l) -> list {
    return [$w * 2 for w in $l]
}
w = "w stays"
echo {join(double([1, 2]), " ")} $w
q = [$q for q in [1]]
echo q {len($q)}
echo {join([$e for e in ["u", "v"] if $e != "u"], "")} e
