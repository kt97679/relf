# selection workload (749): a record counting words
voc = words("alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega")
counts = {}; i = 0
while ($i < 20000) {
    w = $voc[($i * 7) % len($voc)]
    if ($w in $counts) { counts[$w] = $counts[$w] + 1 } else { counts[$w] = 1 }
    i = $i + 1
}
echo records {len($counts)} {$counts[alpha]} {$counts[omega]}
