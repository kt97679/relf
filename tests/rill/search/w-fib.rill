# selection workload (749): a def that only computes, called deep - purestack, dupnip, short
def fib n -> number {
    if ($n < 2) { return $n }
    return fib($n - 1) + fib($n - 2)
}
def gcd a b -> number {
    if ($b == 0) { return $a }
    return gcd($b, $a % $b)
}
total = 0; i = 1
while ($i < 4000) { total = $total + gcd($i * 7919, 104729 % $i + 1); i = $i + 1 }
echo fib {fib(25)} gcd-sum $total
