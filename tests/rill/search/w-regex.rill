# selection workload (749): the same few patterns over many lines - rxcache
bs = '\\ comment'
hits = 0; subs = ""; i = 0
while ($i < 1500) {
    line = "  $i FOO-$i  12 3 4 : WORD$i ( a b ) $bs"
    m = match($line, '^\s+(\d+)\s+(\S+)\s+(\d+) (\d+)')
    if (len($m) > 0) { hits = $hits + 1 }
    hits = $hits + len(all($line, '(?:^|\s)(?::|VARIABLE)\s+(\S+)'))
    subs = sub(sub($line, '\\ .*$', ""), '\( [^)]*\)', "")
    i = $i + 1
}
echo regex $hits [$subs]
