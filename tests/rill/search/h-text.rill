# held out (749): never selected on - texts built, split and joined, a two-parameter computation
parts = []; i = 0
while ($i < 6000) { push($parts, "item-$i"); i = $i + 1 }
text = join($parts, " ")
ws = words($text)
def collatz(n, steps) -> number {
    if ($n == 1) { return $steps }
    if ($n % 2 == 0) { return collatz($n / 2, $steps + 1) }
    return collatz(3 * $n + 1, $steps + 1)
}
longest = 0
for k in range(1, 3001) { c = collatz($k, 0); if ($c > $longest) { longest = $c } }
echo text {len($ws)} {len($text)} $longest
