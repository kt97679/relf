# held out (749): tokens of Forth-like lines into records and lists, with patterns
names = {}; refs = []
i = 0
while ($i < 1500) {
    bs = '\\ the word'
    line = ": WORD$i DUP WORD{$i / 2} + ; $bs $i"
    toks = words(sub($line, '\\ .*$', ""))
    if ($toks[0] == ":") { names[$toks[1]] = $i }
    for t in slice($toks, 2) { if ($t in $names) { push($refs, $t) } }
    i = $i + 1
}
echo mix {len($names)} {len($refs)}
