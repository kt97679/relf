# case subject { patterns { block } ... }: the shell's patterns, the first arm that matches (783) - tests/rill/case.sh
for a in ["--no-apply", "-h", "--help", "file.txt", "x", "abc", "a1", "[x]", "", "*", "other"] {
    case $a {
        --no-apply { echo "$a: apply off" }
        -h --help { echo "$a: help" }
        *.txt { echo "$a: a text file" }
        ? { echo "$a: one character" }
        [a-c]?? [!0-9]1 { echo "$a: a class" }
        '[x]' { echo "$a: brackets, quoted" }
        "" { echo "$a: empty" }
        \* { echo "$a: a star" }
        * { echo "$a: anything else" }
    }
}
want = "abc"
case abc { $want { echo "a variable as the pattern" } }
case nothing { a { echo never } }
echo done
