# the core of stage 1a
name = world
echo hello $name "and {2 + 3} more"
n = 10
total = 0
while ($n > 0) { total = $total + $n; n = $n - 1 }
echo sum $total
def fib n -> number {
    if ($n < 2) { return $n }
    return fib($n - 1) + fib($n - 2)
}
echo "fib 20 = {fib(20)}"
if ($total == 55 and not ($name != world)) { echo yes } else { echo no }
