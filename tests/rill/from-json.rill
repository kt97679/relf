# JSON (811, QUESTIONS.md A36): from-json(t) reads a value, json(x) writes one - compact, as Python's
# json.dumps(x, separators=(',', ':'), ensure_ascii=False); null reads as an empty text; a number as
# decimal() reads it: an integer a number, a fraction or an exponent a decimal of six places, truncated
t = '{"name": "relf", "n": 3, "pi": 3.14159, "ok": true, "off": false, "none": null, "tags": ["a", "b\u00e9\ud83d\ude00"], "deep": {"x": [1, [2, {"y": -0.5}]]}}'
v = from-json($t)
echo $v[name] $v[n] $v[pi] $v[ok] $v[off] "[{$v[none]}]" {len($v[tags])} $v[tags][1] $v[deep][x][1][1][y]
echo {json($v)}
nums = from-json('[0, -7, 9223372036854775807, 1e3, 2.5E+2, -1.25e-2, 0.1234567, 1.0, 10]')
echo {json($nums)}
echo {$nums[2] - 1} {$nums[3] + 1} {$nums[6] * 2}
w = from-json(' [ {"k": "v", "k": "w", "a b": [ ] , "q\"": {}} ] ')
echo {json($w)} {len($w[0])} $w[0][k]
r = {name: "x", 'a "q"': [1, 2.5, true], ctl: "a\tb\n\u0001"}
echo {json($r)}
echo {json("plain")} {json(42)} {json(-1.5)} {json(false)} {json([])} {json({})}
echo {json(from-json(json($r))) == json($r)}
