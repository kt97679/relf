# a list's items are expressions, spaces or commas between them (796) - tests/rill/listexpr.py
x = 5
l = [$x - 1, $x * 2]
echo {len($l)} {join($l, ",")}
m = [$x - 1 $x + 1]
echo {len($m)} {join($m, ",")}
n = [1 -2 3]
echo {len($n)} {join($n, ",")}
p = [a b c]
echo {join($p, "")}
q = [--flag value]
echo {join($q, " ")}
d = 2.5
echo {- $d} {-$x} {0 - $x}
w = ['-' '*' u8]
echo {join($w, " ")}
r = [($x > 3) $x == 5]
echo {join($r, " ")}
item = $l[0]
echo {- $item} {[- $item][0] * 2}
