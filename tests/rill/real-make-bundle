#!/bin/sh
# tests/rill/real-make-bundle - the first paper rewrite run for real (Iteration 744).
#
# examples/rill/make-bundle.rill and tools/make-bundle.sh, each run in
# this repository into a directory of its own: both bundles must verify,
# carry the same heads, and both runs print the same lines on the err
# port. Slow (two bundles, two clones), so not in tests/rill/run.
cd "$(dirname "$0")/../.." || exit 2
[ -f kernel64-rill.img ] || sh tools/build-rill-image.sh > /dev/null || exit 2
d=$(mktemp -d) || exit 2
trap 'rm -rf "$d"' EXIT
mkdir "$d/rill" "$d/sh"
a=$(./relf64 kernel64-rill.img examples/rill/make-bundle.rill "$d/rill" < /dev/null 2> "$d/rill.err") || { echo "FAIL: the Rill run, status $?"; cat "$d/rill.err"; exit 1; }
b=$(sh tools/make-bundle.sh "$d/sh" 2> "$d/sh.err") || { echo "FAIL: the sh run"; exit 1; }
git bundle verify "$a" > /dev/null 2>&1 || { echo "FAIL: the Rill bundle does not verify"; exit 1; }
git bundle list-heads "$a" > "$d/a.heads"; git bundle list-heads "$b" > "$d/b.heads"
cmp -s "$d/a.heads" "$d/b.heads" || { echo "FAIL: different heads"; exit 1; }
cmp -s "$d/rill.err" "$d/sh.err" || { echo "FAIL: different err-port lines"; exit 1; }
echo "make-bundle.rill: the same bundle heads and messages as make-bundle.sh"
