# abs, dir, == on lists and records, at on lists, comprehension filters, [ ] across lines, number of 0x (782) - tests/rill/library2.py
echo {abs(-7)} {abs(7)} {abs(-2.5)}
a = [1, 2, [3, 4]]
b = [1, 2, [3, 4]]
c = [1, 2, [3, 5]]
echo {$a == $b} {$a == $c} {$a != $c} {[1] == [1.0]} {[] == []}
r = {x: 1, y: [1, 2]}
s = {y: [1, 2], x: 1}
echo {$r == $s} {$r == {x: 1}} {$r != {x: 2, y: [1, 2]}}
w = words("direct 0x02 LIT")
echo {at($w, 1, "-")} {at($w, 5, "-")} {at($w, -1, "-")} {at($w, -9, "-")}
item = $a[2]
echo {at($item, 1, 0)} {at($item, 2, 0)} {at({k: 5}, "k", 0)} {at({k: 5}, "z", 0)}
lines = ["", "PRIMITIVE DUP", "other", "PRIMITIVE SWAP", ""]
echo {len([$l for l in $lines if $l])} {join([words($l)[1] for l in $lines if match($l, '^PRIMITIVE ')], ",")}
long = [
    "one", "two",
    "three"
]
echo {len($long)} {join($long, "+")}
echo {number("0x1f")} {number("-0x10")} {number("12")} {number("0X0A")}
