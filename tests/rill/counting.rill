# tests/rill/counting.rill - x[i] += v and -= v: counting into records and lists, as Python's (774)
counts = {}
for w in words("a b a c b a") { if ($w in $counts) { counts[$w] += 1 } else { counts[$w] = 1 } }
for k, v in $counts { echo $k $v }
l = [10 20 30]
l[0] += 5
l[-1] -= 10
l[1] += 0.5
echo {join($l, ' ')}
d = [0.5]
d[0] += 0.25
echo $d[0]
totals = {a: 1.5}
totals[a] += 0.5
echo $totals.a
i = 2
l[$i] += $i * 2
echo $l[2]
