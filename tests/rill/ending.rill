# fail, exit, on EXIT, the script's arguments, env, default, a spread (744)
on EXIT { echo "cleaning up" }
name = default(arg(1), nobody)
echo "hello $name"
echo {len($args)} args
home = env(HOME)
if ($home != "") { echo has a home }
files = [one two three]
printf '<%s>\n' @files
printf '%s=%s\n' first @files
false ?? echo "false failed"
fail "stopping here"
echo not reached
