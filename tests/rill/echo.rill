# echo is Rill's, however it runs (807): in the shell's process, piped, redirected or captured -
# no options, and @name spread; it was /bin/echo when plumbed, and the two differed
xs = ["a b", "c"]
echo @xs
echo @xs | cat
echo x @xs y | cat
flag = "-n"
echo $flag word
echo $flag word | cat
got = $(echo $flag word)
echo "captured [$got]"
e = "-e"
echo $e 'a\tb' | cat
echo --help | cat
echo | cat
echo "[$(echo in)]" x | cat
echo @xs out>err
f = "/tmp/rill-echo-807.txt"
echo one @xs out> $f
echo two out>> $f
echo {join(lines(read($f)), "/")}
rm $f
