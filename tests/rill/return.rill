# a bare return (805): leaves a def that names no kind - from an if, from a loop, from a body made a word
def note(x) {
    if ($x == "") {
        return
    }
    echo "note: $x"
}
note("")
note("one")
def first-big(l) {
    for x in $l {
        if ($x > 10) {
            echo "big: $x"
            return
        }
    }
    echo "none big"
}
first-big([1, 20, 30])
first-big([1, 2])
def evens-to-six(l) {
    for i, x in $l {
        if ($x % 2 == 1) { continue }
        if ($x > 6) { return }
        echo "even $i: $x"
    }
    echo "all even ones"
}
evens-to-six([1, 2, 3, 4, 8, 10])
evens-to-six([2, 4])
def until-zero(l) {
    i = 0
    while ($i < len($l)) {
        if ($l[$i] == 0) { break }
        if ($l[$i] < 0) { return }
        i = $i + 1
    }
    echo "stopped at $i"
}
until-zero([3, 0, 5])
until-zero([3, -1, 5])
def guard(a) {
    if ($a > 1) { return }
}
def sum3(a, b, c) -> number {
    guard($a)
    guard($b)
    return $a + $b + $c
}
total = 0
for k in range(3000) {
    total = $total + sum3($k, 2, 3)
}
echo "total $total"
def first-even(l) {
    for x in $l {
        if ($x % 2 == 1) { continue }
        return
    }
}
odds = [1, 3, 4]
for k in range(40000) { first-even($odds) }
echo "40000 calls, past the data stack's 32768 cells"
for j in range(2) { note("round $j") }
echo done
