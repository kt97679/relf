# an error's message goes to the err port (821) - it went to stdout, so `x = $(a-script)` took it as its
# value; on EXIT, run after it, still writes to stdout; the image's compile errors are the same
x = $(bin/rill -c 'echo out; echo {min([])}' ?? true)
echo "stdout only: [$x]"
y = $(bin/rill -c 'echo out; echo {min([])}' err>out ?? true)
echo "both: [$y]"
z = $(bin/rill -c 'x = (' ?? true)
echo "a compile error, stdout only: [$z]"
w = $(bin/rill -c 'on EXIT { echo cleanup }
echo {max([])}' err> /dev/null ?? true)
echo "on EXIT after an error, stdout: [$w]"
