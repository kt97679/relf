# setenv(name, value): env() and every command run after it see it (783)
echo "[{env(RILL_TEST_GREETING)}]"
setenv(RILL_TEST_GREETING, hello)
echo {env(RILL_TEST_GREETING)}
sh -c 'echo child sees $RILL_TEST_GREETING'
setenv(RILL_TEST_GREETING, "hi there")
o = $(sh -c 'echo $RILL_TEST_GREETING')
echo $o
setenv(RILL_TEST_OTHER, 2)
env | grep -c '^RILL_TEST_'
