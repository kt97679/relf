#!/bin/sh
# tests/bench - compare relfsh against reference shells on three shapes
# of work. Not run by tests/run_tests.sh; run it deliberately.
#
#   loop      pure interpretation, no external commands
#   spawn     a loop that runs /bin/true - dominated by fork/exec
#   startup   how long the shell takes to start and exit
#
# The three differ by orders of magnitude, and quoting only one of them
# would misrepresent the shell either way.
set -u
THIS_SH="${THIS_SH:-./relfsh}"
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT

cat > "$t/loop.sh" <<'X'
i=0
while [ $i -lt 2000 ]
do
  i=$((i+1))
done
X
cat > "$t/spawn.sh" <<'X'
i=0
while [ $i -lt 100 ]
do
  /bin/true
  i=$((i+1))
done
X

# A shell that cannot start looks tremendously fast: everything below
# redirects to /dev/null, so a failure is timed like a success. That
# happened for real in Iteration 116 - a git worktree with no built
# binary reported 6ms for a hundred fork/exec pairs, which is
# physically impossible, and the number was believed for a minute.
# Run it once first and refuse to report if it does not exit 0.
# Checked by output rather than by exit status: the raw engine row
# ("./relf kernel-shell.img") does not report a shell's exit status,
# so a status check would reject a working shell.
printf 'echo bench-probe\n' > "$t/probe.sh"
check_shell() {   # check_shell SHELL
    if [ "$($1 "$t/probe.sh" 2>/dev/null)" != "bench-probe" ]; then
        echo "bench: $1 cannot run a script - refusing to time it" >&2
        exit 1
    fi
}
time_it() {   # time_it SHELL SCRIPT -> milliseconds
    check_shell "$1"
    s=$(date +%s%N)
    $1 "$2" >/dev/null 2>&1
    e=$(date +%s%N)
    echo $(( (e - s) / 1000000 ))
}
time_start() {
    s=$(date +%s%N)
    i=0
    while [ $i -lt 100 ]; do $1 -c true >/dev/null 2>&1; i=$((i+1)); done
    e=$(date +%s%N)
    echo $(( (e - s) / 1000000 ))
}

printf '%-10s %10s %10s %10s\n' shell loop-ms spawn-ms start-ms
# The direct engine invocation is measured alongside the wrapper:
# relfsh is a /bin/sh script, and that fork costs more than loading the
# image does (Iteration 94).
for sh in "$THIS_SH" "./relf kernel-shell.img" /bin/dash /bin/bash; do
    set -- $sh; [ -x "$1" ] || continue
    printf '%-10s %10s %10s %10s\n' "$(basename "$1")" \
        "$(time_it "$sh" "$t/loop.sh")" \
        "$(time_it "$sh" "$t/spawn.sh")" \
        "$(time_start "$sh")"
done
