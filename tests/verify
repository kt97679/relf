#!/bin/sh
# tests/verify - one command that checks everything and compares the
# result against tests/BASELINE, so "did I break something" is a
# yes/no rather than four suites and a paragraph of prose.
#
# Written in Iteration 148, to freeze the shell before engine work
# starts. The engine change it froze for touched the engine, cross.4,
# save-system.4 and every position-independence assumption in the
# system, and ended with relf.c replaced by cv8.c (Iteration 243).
# What makes that survivable is a signal that is trusted: every
# number below must be exactly what BASELINE says, and any
# difference - better or worse - is reported and fails the run.
#
# A CHANGED line is not automatically a defect. Fixing one of the 21
# known POSIX failures will change a number, and the right response is
# to update BASELINE in the same commit as the fix, so the file always
# records what the tree actually does.
#
#   tests/verify              check everything
#   tests/verify --update     rewrite BASELINE from this run
#
# Not included: tests/bench. It takes minutes, and single runs on
# ordinary hardware differ by more than most changes do - see
# PROGRESS.md's Iteration 129 entry for the method it needs instead.

# The suite's own stdin is closed: a case that runs this shell without
# redirecting stdin would otherwise inherit the TERMINAL and wait there
# for ever - which is what `make verify` did on a real checkout, while
# in a container, where stdin is /dev/null, it had never once hung
# (Iteration 392). The interactive pty harness makes its own terminal
# and is unaffected.
exec < /dev/null
# Byte order and byte classes for every shell this suite runs: pathname
# expansion sorts by LC_COLLATE, `[a-z]` is a collation range and
# `[[:alpha:]]` is a locale's own idea of a letter. This shell has no
# locale support - it is always the C locale - so a suite that compares
# it with another shell, or with recorded output, has to say which
# locale it means. A checkout in en_US.UTF-8 saw the difference
# (Iterations 390 and 393).
LC_ALL=C
export LC_ALL
# A preload library the loader cannot use prints a line to stderr on
# every exec - Ubuntu and Mint set one system-wide (libgtk3-nocsd), and
# it cannot be loaded into the 32-bit engine at all. The tests capture
# stderr, so that line became part of what they compared, and every
# i386 assertion failed with the right answer one line down
# (Iteration 396). No test here wants a preload.
unset LD_PRELOAD
cd "$(dirname "$0")/.." || exit 1
BASE=tests/BASELINE
UPDATE=0
[ "$1" = "--update" ] && UPDATE=1
OUT=$(mktemp) || exit 1
trap 'rm -f "$OUT"' EXIT INT TERM

emit() { printf '%s %s\n' "$1" "$2" >> "$OUT"; }

# ---------------------------------------------------------------
# 1. Reproducible build. The images are tracked, so a rebuild that
#    does not reproduce them byte for byte means either the build is
#    nondeterministic or the committed image is stale. Both were true
#    before Iteration 148: SS-SCRUB did not know about shadow.4's
#    scratch variables or about #TIB, so every test run dirtied the
#    working tree and no diff could be trusted.
# ---------------------------------------------------------------
echo "== reproducible build =="
for i in kernel-shell.img kernel32-shell.img; do
    [ -e "$i" ] && cp "$i" "/tmp/verify-was-$i"
done
rm -f kernel-shell.img kernel32-shell.img
# run_tests.sh uses bash arrays and 'local'; it is not a POSIX script.
bash tests/run_tests.sh > /tmp/verify-run.log 2>&1
RT=$?
for i in kernel-shell.img kernel32-shell.img; do
    if [ -e "/tmp/verify-was-$i" ] && [ -e "$i" ]; then
        if cmp -s "/tmp/verify-was-$i" "$i"; then emit "rebuild:$i" reproduces
        else emit "rebuild:$i" DIFFERS; fi
    else
        emit "rebuild:$i" missing
    fi
    rm -f "/tmp/verify-was-$i"
done

# ---------------------------------------------------------------
# 1b. Reproducible from a DIFFERENT PATH, which is the property the
#     check above cannot see. Building twice in the same directory
#     cannot distinguish "the build leaks nothing" from "both builds
#     leaked the same thing" - and leaking the build path is the
#     specific failure save-system.4's header describes, where the
#     first prebuilt image carried the machine's directory and the
#     builder's PID. So SS-SCRUB's whole reason for existing was
#     untested until this check.
#
#     It also guards the 80-column input limit. QUERY reads with
#     `TIB 80 ACCEPT`, so an over-long line loses its tail silently;
#     relfsh's bootstrap used to interpolate $DIR into every line and
#     so stopped building past a ~36-character repository path, with
#     the PID's digit count deciding the exact cliff. A deliberately
#     long path here fails if that ever comes back.
# ---------------------------------------------------------------
CROSS=/tmp/relf-verify-crosspath-deliberately-long-directory-name-to-exceed-eighty-columns
rm -rf "$CROSS"
if mkdir -p "$CROSS" 2>/dev/null; then
    for f in relf relf32 kernel.img kernel32.img relfsh \
             extend.4 pool.4 shadow.4 save-system.4 shell.4 tree.4; do
        [ -e "$f" ] && cp "$f" "$CROSS/"
    done
    ( cd "$CROSS" && rm -f kernel-shell.img && ./relfsh -c true ) >/dev/null 2>&1
    if [ -s "$CROSS/kernel-shell.img" ] && [ -e kernel-shell.img ]; then
        if cmp -s "$CROSS/kernel-shell.img" kernel-shell.img
        then emit crosspath:kernel-shell.img reproduces
        else emit crosspath:kernel-shell.img DIFFERS; fi
    else
        emit crosspath:kernel-shell.img missing
    fi
    rm -rf "$CROSS"
else
    emit crosspath:kernel-shell.img skipped
fi

# ---------------------------------------------------------------
# 2. Core, shell and differential suites, both cell widths.
# ---------------------------------------------------------------
echo "== core, shell, differential =="
emit core:8byte  "$(grep -c 'PASS (8-byte cells):' /tmp/verify-run.log)"
emit shell:8byte "$(grep -c 'PASS (8-byte cells shell' /tmp/verify-run.log)"
# A host without a 32-bit toolchain skips the i386 half, and that is a
# property of the machine rather than of this shell: `skipped` says so,
# where a bare 0 looked like a failure (Iteration 394).
i386_state() {   # i386_state MARKER
    if grep -q 'SKIP: gcc -m32 not available' /tmp/verify-run.log ||
       grep -q 'SKIP: the i386 engine cannot run here' /tmp/verify-run.log; then
        echo skipped
    else
        grep -c "$1" /tmp/verify-run.log
    fi
}
emit core:4byte  "$(i386_state 'PASS (4-byte cells, i386):')"
emit shell:4byte "$(i386_state 'PASS (4-byte cells, i386 shell')"
emit ext:8byte    "$(grep -c 'PASS (8-byte cells extension suites)' /tmp/verify-run.log)"
emit ext:4byte    "$(i386_state 'PASS (4-byte cells, i386 extension suites)')"
emit io:8byte     "$(grep -c 'PASS (8-byte cells I/O suite)' /tmp/verify-run.log)"
emit io:4byte     "$(i386_state 'PASS (4-byte cells, i386 I/O suite)')"
emit core:okmarkers "$(sed -n 's/.*PASS (8-byte cells): \([0-9]*\) OK.*/\1/p' /tmp/verify-run.log | head -1)"
# Both base images are now regenerated from cross.4 + kernel.4 on every
# run and compared against the committed artifacts. The 8-byte one is
# the fixpoint the bootstrap rests on: it is simultaneously the image
# the cross-compiler PRODUCES and the image it RUNS ON. Nothing checked
# it before Iteration 155, so "cross.4 still produces what we ship" was
# unverified for the width the project develops on - the width the
# engine work is about to change.
emit image:8byte-fixpoint "$(sed -n 's/.*IMAGE-FIXPOINT (8-byte cells): \(.*\) ==/\1/p' /tmp/verify-run.log | head -1)"
emit image:4byte-fixpoint "$(sed -n 's/.*IMAGE-FIXPOINT (4-byte cells, i386): \(.*\) ==/\1/p' /tmp/verify-run.log | head -1)"
emit diff:failed "$(sed -n 's/.*differential case(s), \([0-9]*\) failed.*/\1/p' /tmp/verify-run.log | head -1)"
emit shell:assertions "$(bash tests/shell/run-all 2>/dev/null | awk '{s+=$1} END {print s+0}')"
emit shell:files "$(ls tests/shell/run-* 2>/dev/null | wc -l | tr -d ' ')"

# ---------------------------------------------------------------
# 3. The two acceptance suites.
# ---------------------------------------------------------------
echo "== mrsh and posix =="
M=$(bash tests/mrsh-suite/run.sh 2>&1 | sed -n 's/^\([0-9]*\) passed, \([0-9]*\) failed.*/\1 \2/p')
emit mrsh:passed "$(echo "$M" | cut -d' ' -f1)"
emit mrsh:failed "$(echo "$M" | cut -d' ' -f2)"
P=$(sh tests/posix/run.sh 2>&1 | sed -n 's/^\([0-9]*\) passed, \([0-9]*\) failed, \([0-9]*\) inconclusive.*/\1 \2 \3/p')
emit posix:passed       "$(echo "$P" | cut -d' ' -f1)"
emit posix:failed       "$(echo "$P" | cut -d' ' -f2)"
emit posix:inconclusive "$(echo "$P" | cut -d' ' -f3)"

echo "== interactive (a pseudo-terminal) =="
I=$(sh tests/interactive/run 2>&1 | sed -n 's/^\([0-9]*\) passed, \([0-9]*\) failed, \([0-9]*\) known-divergent.*/\1 \2 \3/p')
emit interactive:passed    "$(echo "$I" | cut -d' ' -f1)"
emit interactive:failed    "$(echo "$I" | cut -d' ' -f2)"
emit interactive:divergent "$(echo "$I" | cut -d' ' -f3)"
emit posix:cases "$(ls tests/posix/cases/*.sh 2>/dev/null | wc -l | tr -d ' ')"

# tests/parse: the command-tree parser (Iteration 263), its trees and its
# syntax verdicts against dash -n.
PR=$(sh tests/parse/run 2>&1 | sed -n 's/^== \([0-9]*\) passed, \([0-9]*\) encoded, \([0-9]*\) failed; verdicts: \([0-9]*\) agree, \([0-9]*\) disagree ==$/\1 \2 \3 \4 \5/p')
emit parse:passed           "$(echo "$PR" | cut -d' ' -f1)"
emit parse:encoded          "$(echo "$PR" | cut -d' ' -f2)"
emit parse:failed           "$(echo "$PR" | cut -d' ' -f3)"
emit parse:verdicts-agree   "$(echo "$PR" | cut -d' ' -f4)"
emit parse:verdicts-differ  "$(echo "$PR" | cut -d' ' -f5)"

# Unreachable definitions in the shell's sources (tools/dead-words.py):
# Iteration 265 removed 343 of them with the line-based shell; none should
# come back unnoticed.
emit shell:dead-words "$(python3 tools/dead-words.py shell.4 tree.4 2>/dev/null | grep -c .)"

# tests/matrix: every construct in every context, and the syntax errors,
# against bash and dash (Iteration 262). A regression - a case that fails
# and is not in KNOWN-FAILING - is reported whatever the totals say.
M=$(sh tests/matrix/run 2>&1)
MS=$(echo "$M" | sed -n 's/^== \([0-9]*\) passed, \([0-9]*\) failed, \([0-9]*\) inconclusive; \([0-9]*\) regressions, \([0-9]*\) fixed ==$/\1 \2 \3 \4 \5/p')
emit matrix:passed       "$(echo "$MS" | cut -d' ' -f1)"
emit matrix:failed       "$(echo "$MS" | cut -d' ' -f2)"
emit matrix:inconclusive "$(echo "$MS" | cut -d' ' -f3)"
emit matrix:regressions  "$(echo "$MS" | cut -d' ' -f4)"
emit matrix:known-failing "$(wc -l < tests/matrix/KNOWN-FAILING | tr -d ' ')"

# ---------------------------------------------------------------
# 4. Sizes. Cheap, and the number the engine work is chasing.
# ---------------------------------------------------------------
echo "== sizes =="
S=$(sh tests/sizes 2>/dev/null)
# tests/sizes prints one section per word size, with the row simply
# labelled "shell.4" inside each - so track which section we are in.
emit size:x86_64 "$(echo "$S" | awk '/^== x86-64/{s=1} /^== i386/{s=0} s && /^shell.4 /{print $5; exit}')"
emit size:i386   "$(echo "$S" | awk '/^== i386/{s=1} /^== not a shell/{s=0} s && /^shell.4 /{print $5; exit}')"
# The parts separately (Iteration 272): the totals above move in 4 KB
# steps whenever the stripped engine crosses a page, which hides what
# changed. The engine's code (size's text), and each shell image.
emit size:engine-code-x86_64 "$(size relf 2>/dev/null | awk 'NR==2 {print $1}')"
emit size:engine-code-i386   "$(size relf32 2>/dev/null | awk 'NR==2 {print $1}' || true)"
emit size:image-x86_64       "$([ -f kernel-shell.img ] && wc -c < kernel-shell.img | tr -d ' ' || echo missing)"
# `missing` rather than a shell error on stderr and an empty value: the
# i386 half is skipped wherever there is no 32-bit toolchain, and that
# is a normal state, not a broken one (Iteration 394).
emit size:image-i386         "$([ -f kernel32-shell.img ] && wc -c < kernel32-shell.img | tr -d ' ' || echo missing)"

# ---------------------------------------------------------------
# The scaffolding (Iteration 391)
# ---------------------------------------------------------------
# Shebangs against interpreters, the locale pins, and the bundle. Two
# reports from a real checkout found faults here that no suite watched.
echo "== the scaffolding ==" >&2
emit portability:problems "$(sh tests/portability 2>/dev/null | awk '/^portability:/ {print $4+0}')"

# Which compiler produced the binaries whose sizes are recorded below.
# The size lines mean nothing across toolchains, and this is how the
# comparison knows (Iteration 393).
CC_ID=$(${CC:-cc} --version 2>/dev/null | head -1)
emit toolchain:cc "$CC_ID"
# The flags matter as much as the compiler: a checkout reported a binary
# 35 KB larger with the SAME compiler string and the same `size` output
# for its code, which is what an exported CFLAGS - or a distribution's
# default hardening - does. Recorded so the size lines can tell "this
# project changed" from "this machine builds differently"
# (Iteration 396).
emit toolchain:cflags "${CFLAGS:-<unset>}"

# ---------------------------------------------------------------
# The deliverable itself (Iteration 369)
# ---------------------------------------------------------------
# Every session hands over a git bundle, and for 368 iterations none of
# them could be pulled: `git bundle create FILE master TAG` writes those
# refs and no HEAD, while `git pull FILE` asks for HEAD. The suites said
# nothing, because nothing tested the thing being handed over. This
# builds a bundle, clones it, and checks the clone has the same commit.
echo "== the bundle ==" >&2
bwork=$(mktemp -d)
if git bundle create "$bwork/t.bundle" HEAD master >/dev/null 2>&1 &&
   git clone -q "$bwork/t.bundle" "$bwork/clone" >/dev/null 2>&1 &&
   [ "$(git rev-parse HEAD)" = "$(git -C "$bwork/clone" rev-parse HEAD)" ]; then
    emit bundle:pullable 1
else
    emit bundle:pullable 0
fi
rm -rf "$bwork"

# ---------------------------------------------------------------
# Compare, or record.
# ---------------------------------------------------------------
sort -o "$OUT" "$OUT"
if [ "$UPDATE" = 1 ]; then
    cp "$OUT" "$BASE"
    echo ""
    echo "BASELINE updated:"
    sed 's/^/  /' "$BASE"
    exit 0
fi
if [ ! -e "$BASE" ]; then
    echo "no $BASE - run: tests/verify --update" >&2
    exit 2
fi

# Some of what this records is a property of the CODE and some is a
# property of the MACHINE. A byte size depends on the compiler that
# produced the binary; whether a POSIX case is inconclusive depends on
# whether the reference shells installed here agree about it. Comparing
# those against a baseline recorded elsewhere reports a difference that
# is true and useless - which is what a checkout on another machine saw
# (Iteration 393).
#
# So the size lines are compared only when the toolchain matches the one
# the baseline was recorded with, and the inconclusive counts are
# reported without being counted as a difference. `failed` and `passed`
# stay strict everywhere.
machine_dependent() {
    case $1 in
        size:*)
            [ "$CC_ID" = "$(awk '$1=="toolchain:cc" {sub(/^toolchain:cc /,""); print}' "$BASE")" ] &&
            [ "${CFLAGS:-<unset>}" = "$(awk '$1=="toolchain:cflags" {sub(/^toolchain:cflags /,""); print}' "$BASE")" ] &&
            return 1
            return 0 ;;
        # `passed` is `cases` minus `inconclusive` minus `failed`, and
        # the first two of those are already compared - strictly for
        # cases and failed, not at all for inconclusive, which counts
        # what the REFERENCE shells disagree about. Comparing `passed`
        # as well just repeats the machine's answer (Iteration 396).
        posix:inconclusive|matrix:inconclusive|posix:passed) return 0 ;;
        toolchain:cc|toolchain:cflags) return 0 ;;
        # `skipped` and `missing` are what a host without a 32-bit
        # toolchain reports; they are facts about the host.
        *) if [ "$2" = skipped ] || [ "$2" = missing ]; then return 0; fi
           return 1 ;;
    esac
}

echo ""
bad=0
while read -r k v; do
    # The rest of the line, not just the second field: a value may hold
    # spaces (the compiler's version string does).
    want=$(awk -v k="$k" '$1==k {sub(/^[^ ]+[ ]/,""); print}' "$BASE")
    if [ -z "$want" ]; then
        printf 'NEW      %-22s %s\n' "$k" "$v"; bad=1
    elif [ "$want" = "$v" ]; then
        printf 'ok       %-22s %s\n' "$k" "$v"
    elif machine_dependent "$k" "$v"; then
        printf 'machine  %-22s %s (baseline %s, not compared here)\n' "$k" "$v" "$want"
    else
        printf 'CHANGED  %-22s %s (baseline %s)\n' "$k" "$v" "$want"; bad=1
    fi
done < "$OUT"
while read -r k v; do
    awk -v k="$k" '$1==k {f=1} END {exit !f}' "$OUT" || {
        printf 'MISSING  %-22s (baseline %s)\n' "$k" "$v"; bad=1; }
done < "$BASE"

echo ""
if [ "$RT" != 0 ]; then
    echo "tests/run_tests.sh exited $RT. The last lines of its log:"
    echo ""
    # Printed here rather than pointed at: a report from another machine
    # is only as useful as what it contains (Iteration 393).
    # Not a loose grep: `no errors` matched the old pattern, so a
    # passing line was reported as the failure (Iteration 394).
    grep -nE '^(FAIL|SKIP)|^==.*(FAIL|SKIP)|No such file|Permission denied|command not found' \
        /tmp/verify-run.log | tail -12 | sed 's/^/    /'
    echo "    --- last 25 lines ---"
    tail -25 /tmp/verify-run.log | sed 's/^/    /'
    echo ""
    echo "    (the whole log is /tmp/verify-run.log)"
    bad=1
fi
if [ "$bad" = 0 ]; then echo "VERIFIED: everything matches $BASE"
else echo "DIFFERENCES ABOVE. If they are intended, commit the fix and"
     echo "tests/verify --update together."; fi
exit "$bad"
