#!/bin/sh
# tests/diff/run-all - differential tests: every script in cases/ is run
# through relfsh AND through a reference shell, and their stdout and
# exit status must match.
#
# Why this exists alongside tests/shell/: those assert expectations
# written by hand, and twice those expectations were simply wrong about
# POSIX ("set -- -- -x" in Iteration 61, an unquoted multi-line command
# substitution in 67) - the shell was right and the test was not. Here
# nothing is hand-written but the input, so that class of mistake
# cannot occur.
#
# Bash's own test files are NOT vendored: bash is GPLv3 and this
# project is GPLv2 (see GOALS.md), which is a licence incompatibility,
# and its tests exercise bash extensions this shell deliberately does
# not have. Using bash as a live oracle has neither problem.
set -u
THIS_SH="${THIS_SH:-./relfsh}"
REF_SH="${REF_SH:-/bin/bash}"
dir=$(dirname "$0")/cases
run=0; failed=0

if [ ! -x "$REF_SH" ]; then
    echo "tests/diff: no reference shell at $REF_SH - skipping"
    exit 0
fi

for c in "$dir"/*.sh; do
    [ -e "$c" ] || continue
    run=$((run + 1))
    # Each case runs in a scratch directory of its own. A case that
    # creates files relative to the current directory - or one run by a
    # half-built shell, where `$d` does not expand and `mkdir $d` makes
    # a directory called `$d` - cannot litter the tree that way
    # (Iteration 368: one such directory had been sitting in the
    # repository root).
    work=$(mktemp -d)
    case $THIS_SH in /*) sh_abs=$THIS_SH ;; *) sh_abs=$PWD/$THIS_SH ;; esac
    case $c in /*) case_abs=$c ;; *) case_abs=$PWD/$c ;; esac
    got=$(cd "$work" && timeout 10 "$sh_abs" "$case_abs" </dev/null 2>/dev/null); gs=$?
    want=$(cd "$work" && timeout 10 "$REF_SH" "$case_abs" </dev/null 2>/dev/null); ws=$?
    rm -rf "$work"
    if [ "$got" != "$want" ] || [ "$gs" != "$ws" ]; then
        failed=$((failed + 1))
        echo "FAIL: $(basename "$c")  (status $gs, want $ws)"
        printf '%s\n' "$want" | sed 's/^/    want: /' | head -6
        printf '%s\n' "$got"  | sed 's/^/    got:  /' | head -6
    fi
done
echo "$run differential case(s), $failed failed"
[ "$failed" -eq 0 ]
