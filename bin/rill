#!/bin/sh
# rill script.rill [args...]    run a Rill script; one starting #!/usr/bin/env rill runs as itself
# rill -c 'code' [args...]       run a line or two of Rill
# rill --forth script.rill       the Forth the script compiles to
# rill                           the prompt: Rill a line at a time (824)
#
# bin/rill (Iteration 797): put bin/ on PATH, or link bin/rill into a directory
# that is - a link is followed back here. The engine and the image are this
# checkout's (RILL_ENGINE, RILL_IMAGE, RILL_HOME say otherwise); the image is
# rebuilt when it is missing or older than Rill's sources.
self=$0
while [ -h "$self" ]; do
    link=$(readlink "$self")
    case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
top=${RILL_HOME:-$(cd "$(dirname "$self")/.." && pwd)}
engine=${RILL_ENGINE:-$top/relf64}
image=${RILL_IMAGE:-$top/kernel64-rill.img}
usage() { echo "usage: rill [script [args...] | -c 'code' [args...] | --forth script]" >&2; exit 2; }
case $1 in -h|--help) sed -n '2,5s/^# \{0,1\}//p' "$self"; exit 0 ;; esac   # no arguments: the prompt (824)
[ -x "$engine" ] || { echo "rill: no engine at $engine - build it: make relf64, in $top" >&2; exit 2; }
if [ -z "$RILL_IMAGE" ]; then
    stale=
    [ -f "$image" ] || stale=1
    for f in "$top"/rill/*.4 "$top"/rill/genes.tsv; do [ "$f" -nt "$image" ] && stale=1; done
    if [ -n "$stale" ]; then
        (cd "$top" && sh tools/build-rill-image.sh >&2) || { echo "rill: the image did not build" >&2; exit 2; }
    fi
fi
case $1 in
    -c) [ $# -ge 2 ] || usage
        tmp=$(mktemp "${TMPDIR:-/tmp}/rill-c.XXXXXX") || exit 2
        trap 'rm -f "$tmp" "$tmp.rill"' EXIT HUP INT TERM
        printf '%s\n' "$2" > "$tmp.rill"; shift 2
        "$engine" "$image" "$tmp.rill" "$@"; exit $? ;;
    --forth) [ $# -eq 2 ] || usage
        tmp=$(mktemp "${TMPDIR:-/tmp}/rill-f.XXXXXX") || exit 2
        trap 'rm -f "$tmp" "$tmp.4"' EXIT HUP INT TERM
        printf 'S" %s" R-SLURP R-COMPILE TYPE CR\n' "$2" > "$tmp.4"
        "$engine" "$image" "$tmp.4"; exit $? ;;
esac
exec "$engine" "$image" "$@"
