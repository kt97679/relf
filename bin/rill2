#!/bin/sh
# rill2 script.r2 [args...]    run a Rill 2 script (docs/RILL2.md); a script that starts
#                              #!/usr/bin/env rill2 runs as itself
# kernel64-rill2.img is built first when it is missing or older than its sources.
self=$0
while [ -h "$self" ]; do
    link=$(readlink "$self")
    case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd) || exit 2
img=$root/kernel64-rill2.img
for src in "$root/rill2/rill2.4" "$root/rill/rt.4" "$root/rill/regex.4"; do
    if [ ! "$img" -nt "$src" ]; then
        sh "$root/tools/build-rill2-image.sh" "$root/relf64" "$root/forth/kernel64.img" "$img" > /dev/null || exit 2
        break
    fi
done
exec "$root/relf64" "$img" "$@"
