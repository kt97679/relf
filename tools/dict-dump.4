BASE @ DECIMAL
VARIABLE PREVLINK
VARIABLE NFA
VARIABLE LNK
VARIABLE GO
VARIABLE BP
VARIABLE BE
: CELLB 1 CELLS ;
: DUMP
  HERE PREVLINK !
  FORTH-WORDLIST @ NFA !
  -1 GO !
  BEGIN GO @ WHILE
    NFA @ DUP C@ 31 AND 1+ ALIGNED + BP !
    PREVLINK @ BE !
    ." N " BE @ BP @ - . NFA @ 1+ NFA @ C@ 31 AND TYPE CR
    BEGIN BP @ BE @ < WHILE
      ." B " BP @ @ . CR
      BP @ CELLB + BP !
    REPEAT
    NFA @ CELLB - DUP PREVLINK ! @ LNK !
    LNK @ 0= IF 0 GO ! ELSE PREVLINK @ LNK @ + NFA ! THEN
  REPEAT ;
DUMP
BASE ! BYE
