# lib/json.cm - JSON in rill3 itself (927): `source json.cm`, found next to the script or in $RILL3_PATH
# (bin/cm puts this directory last there).
#   to-json value     puts the value's JSON text: a map an object, a list an array, a text a string,
#                     a number and true and false as they are
#   from-json text    puts the value the text is: an object a map, an array a list, a string a text;
#                     a whole number a number; any other number - 1.5, 2e3 - its text, rill3 having only
#                     whole numbers; null the empty text
# An error in the text stops the script, naming where it is.

var json-str {|t|
    var s $([@($t split '\')] join '\\')
    set s $([@($s split '"')] join '\"')
    set s $([@($s split "\n")] join '\n')
    set s $([@($s split "\t")] join '\t')
    set s $([@($s split "\r")] join '\r')
    put "\"$s\""
}

var to-json {|v|
    case $(kind $v) {
        map { var parts []; for k @($v keys) { $parts append "$(json-str $k):$(to-json $v[$k])" }; put "{$($parts join ,)}" }
        list { var parts []; for x @v { $parts append $(to-json $x) }; put "[$($parts join ,)]" }
        text { put $(json-str $v) }
        * { put "$v" }
    }
}

# the reader: the text, where it is, its length - one reading at a time
var jt ''
var ji 0
var jn 0
forth ': JSON-U8 ( cp --- ) DUP 128 < IF EMIT EXIT THEN DUP 2048 < IF DUP 6 RSHIFT 192 OR EMIT 63 AND 128 OR EMIT EXIT THEN DUP 12 RSHIFT 224 OR EMIT DUP 6 RSHIFT 63 AND 128 OR EMIT 63 AND 128 OR EMIT ;'
forth ': JSON-HEX ( c-addr u --- n ) BASE @ >R HEX 0 0 2SWAP >NUMBER 2DROP DROP R> BASE ! ;'   # its digits upper case: the kernel's

var j-fail {|what| echo "from-json: $what at character $ji" >&2; exit 2 }
var j-ws { while $(( $ji < $jn )) { case $jt[$ji] { ' ' "\n" "\t" "\r" { set ji $(( $ji + 1 )) } * { break } } } }
var j-take {|c|
    j-ws
    if $(( $ji >= $jn )) || ! $jt[$ji] match $c { j-fail "$c expected" }
    set ji $(( $ji + 1 ))
}
var j-word {|w|
    if $($jt slice $ji $(( $ji + $($w count) ))) match $w { set ji $(( $ji + $($w count) )) } else { j-fail "$w expected" }
}
var j-string {
    j-take '"'
    var s ''
    while true {
        if $(( $ji >= $jn )) { j-fail 'a string not ended' }
        var c $jt[$ji]
        set ji $(( $ji + 1 ))
        case $c {
            '"' { break }
            '\' {
                var e $jt[$ji]
                set ji $(( $ji + 1 ))
                case $e {
                    n { set s "$s\n" }
                    t { set s "$s\t" }
                    r { set s "$s\r" }
                    b f { }
                    u { set s "$s$(forth 'JSON-U8' @(forth 'JSON-HEX' $($($jt slice $ji $(( $ji + 4 ))) upper)))"; set ji $(( $ji + 4 )) }
                    * { set s "$s$e" }
                }
            }
            * { set s "$s$c" }
        }
    }
    put $s
}
var j-number {
    var start $ji
    while $(( $ji < $jn )) && $jt[$ji] match '[-+0-9.eE]' { set ji $(( $ji + 1 )) }
    var t $($jt slice $start $ji)
    if $t match '-[0-9]*' || $t match '[0-9]*' { if ! $t match '*[.eE+]*' { put $(( $t + 0 )); return 0 } }
    put $t
}
var j-value {
    j-ws
    if $(( $ji >= $jn )) { j-fail 'a value expected' }
    case $jt[$ji] {
        '{' {
            set ji $(( $ji + 1 ))
            var m [:]
            j-ws
            if $jt[$ji] match '}' { set ji $(( $ji + 1 )) } else {
                while true {
                    j-ws
                    var k @(j-string)
                    j-take ':'
                    $m set $k @(j-value)
                    j-ws
                    if $jt[$ji] match ',' { set ji $(( $ji + 1 )) } else { j-take '}'; break }
                }
            }
            put $m
        }
        '[' {
            set ji $(( $ji + 1 ))
            var l []
            j-ws
            if $jt[$ji] match ']' { set ji $(( $ji + 1 )) } else {
                while true {
                    $l append @(j-value)
                    j-ws
                    if $jt[$ji] match ',' { set ji $(( $ji + 1 )) } else { j-take ']'; break }
                }
            }
            put $l
        }
        '"' { put @(j-string) }
        t { j-word 'true'; put true }
        f { j-word 'false'; put false }
        n { j-word 'null'; put '' }
        * { put @(j-number) }
    }
}
var from-json {|text|
    set jt $text
    set ji 0
    set jn $($text count)
    var v @(j-value)
    j-ws
    if $(( $ji < $jn )) { j-fail 'more after the value' }
    put $v
}
