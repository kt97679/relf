# lib/args.cm - a script's options, in rill3 itself (927): `source args.cm`.
#   parse-args spec argv   puts a map: each option's value - its default unless given - and rest: a list
#                          of the words that are no options. spec is a map, option to default: a default
#                          true or false makes a flag (--name sets it true); any other a value, given as
#                          --name value or --name=value. --help not in spec prints the options and exits 0;
#                          an option not in spec, or a value missing, prints them and exits 2.
#   usage spec             the options and their defaults, to stderr
var usage {|spec| echo 'options:' >&2; for k @($spec keys) { echo "  --$k (default: $spec[$k])" >&2 } }

var parse-args {|spec argv|
    var out [:]
    for k @($spec keys) { $out set $k $spec[$k] }
    var rest []
    var i 0
    var n $($argv count)
    while $(( $i < $n )) {
        var a $argv[$i]
        set i $(( $i + 1 ))
        if ! $a match '--?*' { $rest append $a; continue }
        var name $($a slice 2)
        var value ''
        var given false
        if $name match '*=*' { var kv [@($name split =)]; set name $kv[0]; set value $([@($kv slice 1)] join =); set given true }
        if ! $spec has $name {
            if $name match help { usage $spec; exit 0 }
            echo "unknown option --$name" >&2; usage $spec; exit 2
        }
        if $(kind $spec[$name]) match bool { $out set $name true; continue }
        if ! $given {
            if $(( $i >= $n )) { echo "--$name wants a value" >&2; usage $spec; exit 2 }
            set value $argv[$i]
            set i $(( $i + 1 ))
        }
        $out set $name $value
    }
    $out set rest $rest
    put $out
}
