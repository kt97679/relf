\ shell.4 - a minimal POSIX-flavored shell built on RelF.
\
\ Load on top of an already-bootstrapped kernel.img:
\   S" shell.4" INCLUDED
\   SH
\
\ Scope (v0.1), deliberately limited - see PROGRESS.md for the phased
\ plan this fits into:
\   - word-splitting on whitespace only (no quoting/escaping)
\   - PATH-searched external commands via FORK/EXECVE/WAITPID
\   - builtins: cd, exit, export, pwd
\ NOT implemented yet (planned as separate, later increments):
\   pipes, redirection, $VAR expansion, $(...) command substitution,
\   control structures, functions, job control, quoting of any kind.

\ ---- sizes ----

256 CONSTANT LINE-MAX
64  CONSTANT MAX-ARGS
256 CONSTANT PATH-MAX

\ ---- buffers (fixed, allocated once - no dynamic sizing in v0) ----

CREATE LINE-BUF   LINE-MAX ALLOT
CREATE ARGV       MAX-ARGS CELLS ALLOT
CREATE PATHBUF    PATH-MAX ALLOT
CREATE CWDBUF     PATH-MAX ALLOT
CREATE ENVNAMBUF  64 ALLOT

VARIABLE ARGC          ( number of tokens in the current command line )
VARIABLE LAST-STATUS   ( exit status of the last foreground command, decoded to a plain 0-255 code regardless of whether it came from a builtin or WAITPID )

VARIABLE SUPPRESS-EXEC?  \ true when an enclosing if's own then/else
                          \ branch has already determined this whole
                          \ region shouldn't execute anything (either
                          \ because its own condition didn't permit
                          \ this branch, or because an even further
                          \ enclosing if was itself already
                          \ suppressed). A suppressed region still
                          \ needs to be *read* line by line, so a
                          \ nested if/while inside it correctly
                          \ consumes its own then/body/fi rather than
                          \ having its "fi" mistaken for the enclosing
                          \ if's own - it just must not actually run
                          \ anything while doing so. Checked at every
                          \ point that would otherwise execute a
                          \ command (DO-ASSIGN, RUN-SIMPLE-OR-PIPELINE)
                          \ rather than only gating whether
                          \ RUN-TOKENIZED-CALL is invoked at all, which
                          \ is what let a nested if inside a false
                          \ branch go unparsed and corrupt the
                          \ enclosing if's own fi/else detection -
                          \ found by testing directly, not by
                          \ inspection.
0 LAST-STATUS !        ( defensive: don't rely on a VARIABLE's initial content )

\ ==================================================================
\ C-string helpers
\ EXECVE/GETENV/SETENV/CHDIR all speak NUL-terminated C strings, not
\ Forth's own length-prefixed convention - these bridge the two.
\ ==================================================================

: CSTRLEN ( c-addr --- u )
  DUP BEGIN DUP C@ WHILE CHAR+ REPEAT SWAP - ;

: TYPE0 ( c-addr --- )
  DUP CSTRLEN TYPE ;

\ ==================================================================
\ String builder: append bytes/strings into a buffer via a cursor.
\ B-RESET points the cursor at a buffer; B-CHAR/B-CSTR/B-STR append;
\ B-FINISH NUL-terminates. Used for building "dir/cmd" PATH candidates
\ without any stack-juggling - a plain, explicit cursor is much harder
\ to get wrong than shuffling multiple addresses/lengths on the stack
\ (this session's testing of the new primitives found repeated
\ stack-order mistakes doing exactly that kind of shuffling).
\ ==================================================================

VARIABLE BUILD-P
VARIABLE B-SRC

: B-RESET ( addr --- )  BUILD-P ! ;
: B-CHAR ( c --- )  BUILD-P @ C! BUILD-P @ 1+ BUILD-P ! ;
: B-CSTR ( c-addr --- )
  BEGIN DUP C@ DUP WHILE B-CHAR CHAR+ REPEAT 2DROP ;
: B-STR ( c-addr u --- )
  \ u can be 0 (e.g. TRY-DIR called for an empty PATH component,
  \ which POSIX treats as meaning "."), guarded for the same reason
  \ as HAS-SLASH? above.
  SWAP B-SRC !
  DUP 0 > IF
    0 DO B-SRC @ I + C@ B-CHAR LOOP
  ELSE
    DROP
  THEN ;
: B-FINISH ( --- )  0 B-CHAR ;

\ ==================================================================
\ Forth-string equality (used for matching builtin names)
\ ==================================================================

VARIABLE SEQ-A
VARIABLE SEQ-ALEN
VARIABLE SEQ-B
VARIABLE SEQ-BLEN
VARIABLE SEQ-I

: STR= ( c-addr1 u1 c-addr2 u2 --- f )
  SEQ-BLEN ! SEQ-B ! SEQ-ALEN ! SEQ-A !
  SEQ-ALEN @ SEQ-BLEN @ <> IF 0 EXIT THEN
  0 SEQ-I !
  BEGIN SEQ-I @ SEQ-ALEN @ < WHILE
    SEQ-A @ SEQ-I @ + C@
    SEQ-B @ SEQ-I @ + C@
    <> IF 0 EXIT THEN
    SEQ-I @ 1+ SEQ-I !
  REPEAT
  -1 ;

\ Compare a Forth string against a NUL-terminated C string (used for
\ command-name matching, since ARGV entries are C strings post-tokenize).
: STR0= ( c-addr1 u1 c-addr2 --- f )
  DUP CSTRLEN STR= ;

: CSTR= ( c-addr1 c-addr2 --- f )  \ compares two NUL-terminated C
                                     \ strings (STR0= compares a
                                     \ length-prefixed one against a
                                     \ NUL-terminated one - this is for
                                     \ two NUL-terminated ones, e.g.
                                     \ shell-variable names below).
  SWAP DUP CSTRLEN ROT STR0= ;

VARIABLE SCN-SRC
VARIABLE SCN-LEN
VARIABLE SCN-DEST
VARIABLE SCN-MAX

: SAFE-COPY-NUL ( src-addr u dest-addr dest-max --- ok? )
  \ Copies u bytes from src-addr into dest-addr and NUL-terminates
  \ the result, but only if u+1 fits within dest-max - otherwise
  \ leaves dest-addr untouched and returns false, rather than
  \ truncating or overflowing a fixed-size slot. Explicit variables
  \ rather than stack-juggling for all four arguments, matching this
  \ shell's own established preference (see e.g. CMDSUB-* words).
  SCN-MAX ! SCN-DEST ! SCN-LEN ! SCN-SRC !
  SCN-LEN @ 1+ SCN-MAX @ > IF 0 EXIT THEN
  SCN-SRC @ SCN-DEST @ SCN-LEN @ MOVE
  0 SCN-DEST @ SCN-LEN @ + C!
  -1 ;

VARIABLE SCC-SRC
VARIABLE SCC-DEST
VARIABLE SCC-MAX

: SAFE-CSTR-COPY ( src-addr dest-addr dest-max --- ok? )
  \ Same as SAFE-COPY-NUL, but src-addr is already a NUL-terminated
  \ C string (its own length is computed here) rather than a
  \ separately-given (addr u) pair.
  SCC-MAX ! SCC-DEST ! SCC-SRC !
  SCC-SRC @ SCC-SRC @ CSTRLEN SCC-DEST @ SCC-MAX @ SAFE-COPY-NUL ;

\ ==================================================================
\ Shell-local variables: POSIX "shell parameters" distinct from the
\ OS environment - a standalone "NAME=value" line (see ASSIGNMENT-
\ EQPOS/DO-ASSIGN further down) sets one of these without exporting
\ it, so it expands via $NAME/${NAME} (see LOOKUP-VAR, used by
\ EXPAND-VAR below) but a child process never sees it - unlike
\ `export NAME=value`, which sets both this table and calls SETENV
\ (see DO-EXPORT). A simple linear table (name/value pairs copied
\ into fixed-size buffers, not just pointers - ARGV entries point
\ into LINE-BUF, which gets overwritten on the very next line) -
\ matches how this shell already avoids hashing/dynamic structures
\ everywhere else (ARGV, the PATH search, etc).
\ ==================================================================

32  CONSTANT MAX-SHVARS
64  CONSTANT SHVAR-NAME-MAX
256 CONSTANT SHVAR-VALUE-MAX
CREATE SHVAR-NAMES  MAX-SHVARS SHVAR-NAME-MAX * ALLOT
CREATE SHVAR-VALUES MAX-SHVARS SHVAR-VALUE-MAX * ALLOT
VARIABLE SHVAR-COUNT
0 SHVAR-COUNT !

: SHVAR-NAME-SLOT ( i --- addr )   SHVAR-NAME-MAX * SHVAR-NAMES + ;
: SHVAR-VALUE-SLOT ( i --- addr )  SHVAR-VALUE-MAX * SHVAR-VALUES + ;

VARIABLE FS-I

: FIND-SHVAR ( name-addr --- i | -1 )  \ linear scan; name-addr is a
                                         \ NUL-terminated C string.
  0 FS-I !
  BEGIN FS-I @ SHVAR-COUNT @ < WHILE
    DUP FS-I @ SHVAR-NAME-SLOT CSTR= IF
      DROP FS-I @ EXIT
    THEN
    FS-I @ 1+ FS-I !
  REPEAT
  DROP -1 ;

: GET-SHVAR ( name-addr --- value-addr | 0 )
  FIND-SHVAR
  DUP -1 = IF DROP 0 EXIT THEN
  SHVAR-VALUE-SLOT ;

VARIABLE SV-NAME
VARIABLE SV-VALUE
VARIABLE SV-IDX

: SET-SHVAR ( name-addr value-addr --- )  \ both NUL-terminated C
                                            \ strings. Updates an
                                            \ existing slot if the
                                            \ name is already present,
                                            \ otherwise appends a new
                                            \ one - silently does
                                            \ nothing if the table is
                                            \ full, or if either
                                            \ string doesn't fit its
                                            \ slot (SAFE-CSTR-COPY's
                                            \ own bounds check),
                                            \ matching this shell's
                                            \ sparse error handling
                                            \ elsewhere. Captures both
                                            \ arguments into variables
                                            \ immediately, rather than
                                            \ carrying them through the
                                            \ FIND-SHVAR/SHVAR-COUNT
                                            \ stack logic below them -
                                            \ the first version of this
                                            \ word didn't, and ended up
                                            \ feeding SAFE-CSTR-COPY
                                            \ the wrong address (found
                                            \ by testing directly: the
                                            \ name and value slots came
                                            \ out swapped).
  SV-VALUE ! SV-NAME !
  SV-NAME @ FIND-SHVAR
  DUP -1 = IF
    DROP
    SHVAR-COUNT @ MAX-SHVARS < 0= IF EXIT THEN
    SHVAR-COUNT @ DUP 1+ SHVAR-COUNT !
  THEN
  SV-IDX !
  SV-NAME @ SV-IDX @ SHVAR-NAME-SLOT SHVAR-NAME-MAX SAFE-CSTR-COPY DROP
  SV-VALUE @ SV-IDX @ SHVAR-VALUE-SLOT SHVAR-VALUE-MAX SAFE-CSTR-COPY DROP ;

: REMOVE-SHVAR ( name-addr --- )  \ shifts the last entry into the
                                    \ removed slot rather than
                                    \ shifting every following entry
                                    \ down - order doesn't matter for
                                    \ a lookup-only table. A no-op if
                                    \ the name isn't present.
  FIND-SHVAR
  DUP -1 = IF DROP EXIT THEN
  DUP SHVAR-COUNT @ 1- = IF
    DROP SHVAR-COUNT @ 1- SHVAR-COUNT !
    EXIT
  THEN
  SHVAR-COUNT @ 1- SHVAR-NAME-SLOT
  OVER SHVAR-NAME-SLOT SHVAR-NAME-MAX MOVE
  SHVAR-COUNT @ 1- SHVAR-VALUE-SLOT
  OVER SHVAR-VALUE-SLOT SHVAR-VALUE-MAX MOVE
  DROP
  SHVAR-COUNT @ 1- SHVAR-COUNT ! ;

: LOOKUP-VAR ( name-addr --- value-addr | 0 )  \ shell-local storage
                                                 \ first (covers every
                                                 \ assigned variable,
                                                 \ exported or not),
                                                 \ falling back to
                                                 \ GETENV (covers a
                                                 \ variable this shell
                                                 \ never itself
                                                 \ assigned but
                                                 \ inherited from its
                                                 \ own environment,
                                                 \ e.g. $HOME).
  DUP GET-SHVAR DUP 0= IF DROP GETENV ELSE SWAP DROP THEN ;

\ ==================================================================
\ Tokenizer: splits LINE-BUF (u chars from ACCEPT) on whitespace, in
\ place. Supports single quotes ('...', fully literal, no escapes
\ recognized inside), double quotes ("...", recognizing \" and \\ as
\ escapes for a literal " or \ - no $/`` handling, since there's no
\ expansion to apply them to), and backslash-escaping a single
\ character outside any quotes. Adjacent quoted/unquoted/escaped
\ spans concatenate into one token, matching real shell behavior
\ (e.g. 'ab'c"d e"f is one token, "abcd ef"). Quote/escape characters
\ themselves are stripped; what's left is compacted in place, which
\ is always safe here since compaction only ever shrinks a token
\ (removes bytes), never grows it. Each token's start address is
\ recorded into ARGV (NUL-terminated per EXECVE's own convention);
\ whether *any* part of a token came from inside quotes or an escape
\ is recorded in the parallel ARGV-QUOTED array, so a token like '<'
\ or "cd" that happens to match an operator or builtin name isn't
\ mistaken for one downstream (see PARSE-REDIRECTIONS, AT-PIPE?,
\ DISPATCH) - it stays a literal argument, matching real shells.
\ ==================================================================

VARIABLE TOK-POS
VARIABLE TOK-END
VARIABLE TOK-OUT
VARIABLE TOK-WAS-QUOTED?
CREATE ARGV-QUOTED MAX-ARGS ALLOT   ( one byte flag per ARGV entry )

: WS? ( c --- f )  DUP 32 = SWAP 9 = OR ;

: SKIP-WS ( --- )
  BEGIN
    TOK-POS @ TOK-END @ < IF TOK-POS @ C@ WS? ELSE 0 THEN
  WHILE TOK-POS @ 1+ TOK-POS ! REPEAT ;

: EMIT-TOK-CHAR ( c --- )
  TOK-OUT @ C!  TOK-OUT @ 1+ TOK-OUT ! ;

\ ==================================================================
\ $VAR expansion: $NAME, ${NAME}, $? (last exit status), $$ (this
\ shell's own PID). Recognized both outside quotes and inside double
\ quotes - not inside single quotes, which stay fully literal
\ (COPY-SINGLE-QUOTED never looks for $ at all, matching POSIX).
\ Deliberately narrow scope: no ${VAR:-default}-style modifiers, no
\ positional parameters ($1/$@/$#), no command substitution - just
\ environment-variable lookup (reusing GETENV, same as everywhere
\ else in this shell - there's no separate "shell variable" concept)
\ plus the two special forms. An expanded value is never re-split on
\ whitespace (unlike a real shell's unquoted expansion) - the whole
\ expansion becomes part of whichever token it's embedded in, and is
\ never re-interpreted as an operator/builtin name downstream, same
\ as quoted/escaped content (see ARGV-QUOTED).
\ ==================================================================

: NAME-CHAR? ( c --- f )  \ POSIX portable variable-name characters
  DUP 95 = IF DROP -1 EXIT THEN                  ( underscore )
  DUP 48 < 0= OVER 58 < AND IF DROP -1 EXIT THEN    ( 0-9 )
  DUP 65 < 0= OVER 91 < AND IF DROP -1 EXIT THEN    ( A-Z )
  DUP 97 < 0= OVER 123 < AND IF DROP -1 EXIT THEN   ( a-z )
  DROP 0 ;

CREATE VARNAME-BUF 64 ALLOT
VARIABLE VN-LEN
CREATE DIGIT-BUF 24 ALLOT
VARIABLE DIGIT-N

: EMIT-DECIMAL ( n --- )
  \ Appends n's decimal digits via EMIT-TOK-CHAR (used for $? and $$).
  \ An explicit divide/mod loop rather than the pictured-numeric-output
  \ words, to keep this self-contained and easy to verify directly.
  DUP 0< IF 45 EMIT-TOK-CHAR NEGATE THEN
  DUP 0= IF DROP 48 EMIT-TOK-CHAR EXIT THEN
  0 DIGIT-N !
  BEGIN DUP 0 > WHILE
    DUP 10 MOD 48 +  DIGIT-BUF DIGIT-N @ + C!
    DIGIT-N @ 1+ DIGIT-N !
    10 /
  REPEAT
  DROP
  DIGIT-N @ 0 DO
    DIGIT-BUF DIGIT-N @ 1- I - + C@ EMIT-TOK-CHAR
  LOOP ;

: TYPE0-TO-TOK ( c-addr --- )  \ copies a NUL-terminated C string's
                                 \ characters into the token being
                                 \ built - the expanded value, from GETENV
  BEGIN DUP C@ DUP WHILE EMIT-TOK-CHAR CHAR+ REPEAT 2DROP ;

\ ==================================================================
\ $(command) - command substitution
\ Runs the enclosed text as a single external command (no builtins,
\ same v0.7 scope limit as pipe segments not supporting builtins
\ either), captures its stdout via a pipe, strips trailing newlines
\ (matching POSIX), and splices the captured bytes into the token
\ being built - literally, with no further expansion or quote
\ processing applied to the captured output itself.
\
\ This runs *during* the outer line's own tokenization (SCAN-TOKEN or
\ COPY-DOUBLE-QUOTED call EXPAND-VAR, which calls this, while LINE-BUF/
\ ARGV/ARGC/TOK-POS/TOK-END/TOK-OUT are all still mid-scan for the
\ *outer* line) - reusing TOKENIZE/ARGV/LINE-BUF for the *inner*
\ command's own parsing would corrupt that in-progress outer state.
\ So this uses entirely separate, dedicated buffers and a small,
\ deliberately simple whitespace-only tokenizer for the inner command
\ text - no quoting, escaping, expansion, pipes, or redirection
\ *within* a $(...) command in v0.7 (same "no nesting" scope limit
\ as if/while), and no nested $(...) either (the first unescaped ")"
\ found closes it).
\
\ RUN-CMDSUB-CHILD needs COPY-ARGV/RUN-CHILD, both defined much later
\ in this file (in the pipe/path-search sections) - broken via the
\ same deferred-word pattern already used for RUN-TOKENIZED-CALL: a
\ stub here, patched to the real word's execution token once it's
\ defined below.
\ ==================================================================

CREATE CMDSUB-LINE-BUF LINE-MAX ALLOT
CREATE CMDSUB-ARGV MAX-ARGS CELLS ALLOT
VARIABLE CMDSUB-ARGC
VARIABLE CS-POS
VARIABLE CS-END
VARIABLE CS-COPY-I

256 CONSTANT CMDSUB-OUT-MAX
CREATE CMDSUB-OUT-BUF CMDSUB-OUT-MAX ALLOT
VARIABLE CMDSUB-OUT-LEN

: CMDSUB-WS? ( c --- f )  DUP 32 = SWAP 9 = OR ;

: CMDSUB-SKIP-WS ( --- )
  BEGIN
    CS-POS @ CS-END @ < IF CMDSUB-LINE-BUF CS-POS @ + C@ CMDSUB-WS? ELSE 0 THEN
  WHILE CS-POS @ 1+ CS-POS ! REPEAT ;

: CMDSUB-TOKENIZE ( u --- )  \ CMDSUB-LINE-BUF holds u raw bytes
  \ CS-END is a plain length (matching CS-POS's own offset
  \ convention, added to CMDSUB-LINE-BUF explicitly at every use) -
  \ NOT an absolute address. Storing "CMDSUB-LINE-BUF + u" here was
  \ the actual bug: it silently mixed an address into what every
  \ comparison against CS-POS treats as a plain offset, making the
  \ "CS-POS @ CS-END @ <" bounds check compare an offset (0, 1, 2...)
  \ against a huge address - always true, so the scan ran unbounded
  \ past the buffer until it happened to hit something that looked
  \ like whitespace in whatever memory followed. Found by tracing a
  \ diagnostic copy of the inner scan loop (loaded via INCLUDED, not
  \ typed interactively - a long line typed directly at relf's
  \ interactive stdin was itself a separate, unrelated pitfall: it
  \ truncated mid-word and threw an "Undefined word" error).
  CS-END !
  0 CS-POS !
  0 CMDSUB-ARGC !
  BEGIN
    CMDSUB-SKIP-WS
    CS-POS @ CS-END @ <
  WHILE
    CMDSUB-ARGC @ MAX-ARGS 1- < IF
      CMDSUB-LINE-BUF CS-POS @ + CMDSUB-ARGV CMDSUB-ARGC @ CELLS + !
      CMDSUB-ARGC @ 1+ CMDSUB-ARGC !
    THEN
    BEGIN
      CS-POS @ CS-END @ < IF CMDSUB-LINE-BUF CS-POS @ + C@ CMDSUB-WS? 0= ELSE 0 THEN
    WHILE CS-POS @ 1+ CS-POS ! REPEAT
    \ NUL-terminate this token unconditionally, even if it ran all the
    \ way to the end of input with no trailing separator - CMDSUB-
    \ LINE-BUF has room for this one extra byte (LINE-MAX is well past
    \ any realistic $(...) command). Guarding this write with a bounds
    \ check here was the exact bug already found and fixed in the main
    \ TOKENIZE back in Iteration 8 - reintroduced by accident by
    \ copying the pre-fix pattern as a "simple" reference for this
    \ separate tokenizer.
    0 CMDSUB-LINE-BUF CS-POS @ + C!
    CS-POS @ 1+ CS-POS !
  REPEAT
  0 CMDSUB-ARGV CMDSUB-ARGC @ CELLS + ! ;

VARIABLE RUN-CMDSUB-CHILD-XT

: RUN-CMDSUB-CHILD-CALL ( --- )
  RUN-CMDSUB-CHILD-XT @ EXECUTE ;

VARIABLE CS-FD
VARIABLE CMDSUB-PIPE-RD
VARIABLE CMDSUB-PIPE-WR
VARIABLE CMDSUB-PID

: READ-ALL-CMDSUB-OUTPUT ( fd --- )
  \ Reads everything available from fd into CMDSUB-OUT-BUF, up to its
  \ fixed capacity - output beyond that is silently truncated rather
  \ than overflowing the buffer.
  CS-FD !
  0 CMDSUB-OUT-LEN !
  BEGIN
    CMDSUB-OUT-MAX CMDSUB-OUT-LEN @ - 0 >
  WHILE
    CMDSUB-OUT-BUF CMDSUB-OUT-LEN @ +
    CMDSUB-OUT-MAX CMDSUB-OUT-LEN @ -
    CS-FD @ READ-FILE DROP
    DUP 0 = IF DROP EXIT THEN
    CMDSUB-OUT-LEN @ + CMDSUB-OUT-LEN !
  REPEAT ;

: EXPAND-CMDSUB ( --- )
  \ TOK-POS is at the '(' immediately following '$'.
  TOK-POS @ 1+ TOK-POS !            ( skip '(' )
  0 CS-COPY-I !
  BEGIN
    TOK-POS @ TOK-END @ < IF TOK-POS @ C@ 41 <> ELSE 0 THEN
  WHILE
    CS-COPY-I @ LINE-MAX 1- < IF
      TOK-POS @ C@ CMDSUB-LINE-BUF CS-COPY-I @ + C!
      CS-COPY-I @ 1+ CS-COPY-I !
    THEN
    TOK-POS @ 1+ TOK-POS !
  REPEAT
  TOK-POS @ TOK-END @ < IF TOK-POS @ 1+ TOK-POS ! THEN   ( skip closing paren )
  CS-COPY-I @ CMDSUB-TOKENIZE
  CMDSUB-ARGC @ 0 > IF
    PIPE DROP CMDSUB-PIPE-WR ! CMDSUB-PIPE-RD !
    FORK DUP CMDSUB-PID !
    0 = IF
      CMDSUB-PIPE-WR @ 1 DUP2 DROP
      CMDSUB-PIPE-WR @ CLOSE-FILE DROP
      CMDSUB-PIPE-RD @ CLOSE-FILE DROP
      RUN-CMDSUB-CHILD-CALL
      127 SYS-EXIT
    THEN
    CMDSUB-PIPE-WR @ CLOSE-FILE DROP
    CMDSUB-PIPE-RD @ READ-ALL-CMDSUB-OUTPUT
    CMDSUB-PIPE-RD @ CLOSE-FILE DROP
    CMDSUB-PID @ WAITPID DROP DROP
    BEGIN                                    ( strip trailing newlines )
      CMDSUB-OUT-LEN @ 0 > IF
        CMDSUB-OUT-BUF CMDSUB-OUT-LEN @ 1- + C@ 10 =
      ELSE 0 THEN
    WHILE
      CMDSUB-OUT-LEN @ 1- CMDSUB-OUT-LEN !
    REPEAT
    \ CMDSUB-OUT-LEN can genuinely be 0 here (the substituted command
    \ produced no output at all, e.g. $(true) or $(printf)) - guarded
    \ explicitly rather than relying on "0 0 DO ... LOOP" to mean
    \ zero iterations. It doesn't in this kernel: DO/LOOP here treats
    \ start=limit as wrapping through the *entire* unsigned range
    \ rather than skipping the loop, so an unguarded zero-length splice
    \ here read (and wrote, via EMIT-TOK-CHAR) billions of bytes past
    \ CMDSUB-OUT-BUF until it hit unmapped memory and segfaulted -
    \ found via mrsh's async.sh (see PROGRESS.md's crash-hardening
    \ entry) and reproduced down to a single command: `echo $(true)`.
    CMDSUB-OUT-LEN @ 0 > IF
      CMDSUB-OUT-BUF CMDSUB-OUT-LEN @ 0 DO
        DUP I + C@ EMIT-TOK-CHAR
      LOOP DROP
    THEN
  THEN ;

: EXPAND-VAR ( --- )
  \ TOK-POS is at the '$' character.
  -1 TOK-WAS-QUOTED? !
  TOK-POS @ 1+ TOK-POS !
  TOK-POS @ TOK-END @ < 0= IF 36 EMIT-TOK-CHAR EXIT THEN
  TOK-POS @ C@
  DUP 63 = IF                     ( $? )
    DROP TOK-POS @ 1+ TOK-POS !
    LAST-STATUS @ EMIT-DECIMAL
    EXIT
  THEN
  DUP 36 = IF                     ( $$ )
    DROP TOK-POS @ 1+ TOK-POS !
    GETPID EMIT-DECIMAL
    EXIT
  THEN
  DUP 40 = IF                     ( $( - command substitution )
    DROP EXPAND-CMDSUB
    EXIT
  THEN
  DUP 123 = IF                    ( ${NAME} )
    DROP TOK-POS @ 1+ TOK-POS !
    0 VN-LEN !
    BEGIN
      TOK-POS @ TOK-END @ < IF TOK-POS @ C@ 125 <> ELSE 0 THEN
    WHILE
      TOK-POS @ C@ VARNAME-BUF VN-LEN @ + C!
      VN-LEN @ 1+ VN-LEN !
      TOK-POS @ 1+ TOK-POS !
    REPEAT
    TOK-POS @ TOK-END @ < IF TOK-POS @ 1+ TOK-POS ! THEN
    0 VARNAME-BUF VN-LEN @ + C!
    VARNAME-BUF LOOKUP-VAR DUP 0= IF DROP ELSE TYPE0-TO-TOK THEN
    EXIT
  THEN
  DUP NAME-CHAR? 0= IF
    DROP 36 EMIT-TOK-CHAR          ( $ not followed by a name: literal $ )
    EXIT
  THEN
  DROP
  0 VN-LEN !
  BEGIN
    TOK-POS @ TOK-END @ < IF TOK-POS @ C@ NAME-CHAR? ELSE 0 THEN
  WHILE
    TOK-POS @ C@ VARNAME-BUF VN-LEN @ + C!
    VN-LEN @ 1+ VN-LEN !
    TOK-POS @ 1+ TOK-POS !
  REPEAT
  0 VARNAME-BUF VN-LEN @ + C!
  VARNAME-BUF LOOKUP-VAR DUP 0= IF DROP ELSE TYPE0-TO-TOK THEN ;

: COPY-SINGLE-QUOTED ( --- )
  \ TOK-POS is at the opening '. Copies everything up to (not
  \ including) the matching closing ' verbatim - no escapes at all
  \ recognized inside single quotes, matching POSIX. An unterminated
  \ quote just consumes to the end of the input rather than erroring
  \ (a real shell would prompt for a continuation line - not done
  \ here yet).
  -1 TOK-WAS-QUOTED? !
  TOK-POS @ 1+ TOK-POS !
  BEGIN
    TOK-POS @ TOK-END @ < IF TOK-POS @ C@ 39 <> ELSE 0 THEN
  WHILE
    TOK-POS @ C@ EMIT-TOK-CHAR
    TOK-POS @ 1+ TOK-POS !
  REPEAT
  TOK-POS @ TOK-END @ < IF TOK-POS @ 1+ TOK-POS ! THEN ;

: COPY-DOUBLE-QUOTED ( --- )
  \ Like COPY-SINGLE-QUOTED, but recognizes \" and \\ as escapes for a
  \ literal " or \. Any other backslash (e.g. \n) is passed through
  \ as-is (backslash and the following character both kept), matching
  \ POSIX's own rule that backslash is only special before specific
  \ characters inside double quotes.
  -1 TOK-WAS-QUOTED? !
  TOK-POS @ 1+ TOK-POS !
  BEGIN
    TOK-POS @ TOK-END @ < IF TOK-POS @ C@ 34 <> ELSE 0 THEN
  WHILE
    TOK-POS @ C@ 92 = IF
      TOK-POS @ 1+ TOK-END @ < IF
        TOK-POS @ 1+ TOK-POS !
        TOK-POS @ C@
        DUP 34 = OVER 92 = OR IF
          EMIT-TOK-CHAR
        ELSE
          92 EMIT-TOK-CHAR EMIT-TOK-CHAR
        THEN
        TOK-POS @ 1+ TOK-POS !
      ELSE
        92 EMIT-TOK-CHAR
        TOK-POS @ 1+ TOK-POS !
      THEN
    ELSE TOK-POS @ C@ 36 = IF
      EXPAND-VAR
    ELSE
      TOK-POS @ C@ EMIT-TOK-CHAR
      TOK-POS @ 1+ TOK-POS !
    THEN THEN
  REPEAT
  TOK-POS @ TOK-END @ < IF TOK-POS @ 1+ TOK-POS ! THEN ;

: COPY-ESCAPED-CHAR ( --- )
  \ TOK-POS is at a backslash outside any quotes: makes the next
  \ character literal (e.g. \| for a literal pipe character).
  -1 TOK-WAS-QUOTED? !
  TOK-POS @ 1+ TOK-POS !
  TOK-POS @ TOK-END @ < IF
    TOK-POS @ C@ EMIT-TOK-CHAR
    TOK-POS @ 1+ TOK-POS !
  THEN ;

: SCAN-TOKEN ( --- )
  \ Reads from TOK-POS, writing the *unquoted* content via
  \ EMIT-TOK-CHAR (at TOK-OUT, which only ever trails or equals
  \ TOK-POS, so writing in place is always safe), until unquoted
  \ whitespace or the end of input.
  BEGIN
    TOK-POS @ TOK-END @ < IF TOK-POS @ C@ WS? 0= ELSE 0 THEN
  WHILE
    TOK-POS @ C@
    DUP 39 = IF DROP COPY-SINGLE-QUOTED
    ELSE DUP 34 = IF DROP COPY-DOUBLE-QUOTED
    ELSE DUP 92 = IF DROP COPY-ESCAPED-CHAR
    ELSE DUP 36 = IF DROP EXPAND-VAR
    ELSE
      EMIT-TOK-CHAR
      TOK-POS @ 1+ TOK-POS !
    THEN THEN THEN THEN
  REPEAT ;

: TOKENIZE ( u --- )  \ LINE-BUF holds the line; u is its length
  LINE-BUF + TOK-END !
  LINE-BUF TOK-POS !
  0 ARGC !
  BEGIN
    SKIP-WS
    TOK-POS @ TOK-END @ <
  WHILE
    TOK-POS @ TOK-OUT !      ( always safe to compact in place, even
                                if this token won't end up recorded )
    0 TOK-WAS-QUOTED? !
    ARGC @ MAX-ARGS 1- < IF
      TOK-POS @ ARGV ARGC @ CELLS + !
      SCAN-TOKEN
      0 EMIT-TOK-CHAR
      TOK-WAS-QUOTED? @ ARGV-QUOTED ARGC @ + C!
      ARGC @ 1+ ARGC !
    ELSE
      SCAN-TOKEN
      0 EMIT-TOK-CHAR
    THEN
    \ SCAN-TOKEN stops exactly at the next unquoted-whitespace
    \ separator (or end of input) without consuming it. Advance past
    \ it here so the next SKIP-WS actually finds whitespace to skip -
    \ the NUL-termination write just above lands at TOK-OUT, which for
    \ an uncompacted/unquoted token coincides with this very separator
    \ position, overwriting it; without this advance TOK-POS would be
    \ left sitting on that now-NUL byte, and the next iteration would
    \ record an empty token there instead of moving on.
    TOK-POS @ TOK-END @ < IF TOK-POS @ 1+ TOK-POS ! THEN
  REPEAT
  0 ARGV ARGC @ CELLS + ! ;

: ARGV@ ( i --- c-addr )  CELLS ARGV + @ ;
: ARGV-QUOTED@ ( i --- f )  ARGV-QUOTED + C@ ;

\ ==================================================================
\ Redirection: <, >, >>
\ Scans the tokenized ARGV for these operators; each one found records
\ the filename token that follows it into a dedicated variable, and
\ both tokens are excluded from the argv the command itself will see.
\ Built as a fresh copy into a second array (ARGV2/ARGC2) rather than
\ shifting ARGV in place - an earlier attempt at this (see PROGRESS.md,
\ Iteration 5) got tangled trying to do in-place index shifting with
\ unverified stack tricks; a plain copy-excluding-some-entries pass is
\ far harder to get wrong, at the cost of one extra small buffer.
\ At most one of each operator is honored per command line (a second
\ ">" just overwrites the first's recorded filename); combining
\ multiple output redirections isn't meaningful anyway without pipes.
\ ==================================================================

CREATE ARGV2 MAX-ARGS CELLS ALLOT
VARIABLE ARGC2
VARIABLE REDIR-IN-FILE      ( c-addr, or 0 for none - "<" )
VARIABLE REDIR-OUT-FILE     ( c-addr, or 0 for none - ">" truncate )
VARIABLE REDIR-APPEND-FILE  ( c-addr, or 0 for none - ">>" append )
VARIABLE PR-I

: PARSE-REDIRECTIONS ( --- )
  0 REDIR-IN-FILE !  0 REDIR-OUT-FILE !  0 REDIR-APPEND-FILE !
  0 ARGC2 !
  0 PR-I !
  BEGIN PR-I @ ARGC @ < WHILE
    PR-I @ ARGV@ DUP CSTRLEN
    2DUP S" <" STR= PR-I @ ARGV-QUOTED@ 0= AND IF
      2DROP
      PR-I @ 1+ ARGC @ < IF
        PR-I @ 1+ ARGV@ REDIR-IN-FILE !
        PR-I @ 2 + PR-I !
      ELSE
        PR-I @ 1+ PR-I !          ( malformed: "<" with no filename )
      THEN
    ELSE 2DUP S" >>" STR= PR-I @ ARGV-QUOTED@ 0= AND IF
      2DROP
      PR-I @ 1+ ARGC @ < IF
        PR-I @ 1+ ARGV@ REDIR-APPEND-FILE !
        PR-I @ 2 + PR-I !
      ELSE
        PR-I @ 1+ PR-I !
      THEN
    ELSE 2DUP S" >" STR= PR-I @ ARGV-QUOTED@ 0= AND IF
      2DROP
      PR-I @ 1+ ARGC @ < IF
        PR-I @ 1+ ARGV@ REDIR-OUT-FILE !
        PR-I @ 2 + PR-I !
      ELSE
        PR-I @ 1+ PR-I !
      THEN
    ELSE
      2DROP
      PR-I @ ARGV@ ARGV2 ARGC2 @ CELLS + !
      ARGC2 @ 1+ ARGC2 !
      PR-I @ 1+ PR-I !
    THEN THEN THEN
  REPEAT
  0 ARGV2 ARGC2 @ CELLS + !
  \ Copy ARGV2/ARGC2 back into ARGV/ARGC, so nothing downstream (PATH
  \ search, DISPATCH's builtin-name checks, EXECVE) needs to know
  \ redirection parsing happened at all.
  0 PR-I !
  BEGIN PR-I @ ARGC2 @ < WHILE
    ARGV2 PR-I @ CELLS + @  ARGV PR-I @ CELLS + !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV ARGC2 @ CELLS + !
  ARGC2 @ ARGC ! ;

: OPEN-FOR ( c-addr fam --- fid ok? )
  SWAP DUP CSTRLEN ROT OPEN-FILE 0= ;

: APPLY-REDIRECTIONS ( --- )
  \ Runs in the forked child, before RUN-CHILD/EXECVE. v0.1/v0.2
  \ simplification: a redirection that fails to open (e.g. "<" on a
  \ missing file) is silently skipped rather than aborting the
  \ command - no error reporting for this yet, matching how sparse
  \ error handling is everywhere else in this shell so far.
  REDIR-IN-FILE @ IF
    REDIR-IN-FILE @ R/O OPEN-FOR IF
      DUP 0 DUP2 DROP CLOSE-FILE DROP
    ELSE DROP THEN
  THEN
  REDIR-OUT-FILE @ IF
    REDIR-OUT-FILE @ W/O OPEN-FOR IF
      DUP 1 DUP2 DROP CLOSE-FILE DROP
    ELSE DROP THEN
  THEN
  REDIR-APPEND-FILE @ IF
    REDIR-APPEND-FILE @ A/O OPEN-FOR IF
      DUP 1 DUP2 DROP CLOSE-FILE DROP
    ELSE DROP THEN
  THEN ;

\ ==================================================================
\ PATH search + exec
\ ==================================================================

: HAS-SLASH? ( c-addr u --- f )
  \ u can be 0 in principle (an empty ARGV[0], however unlikely in
  \ practice) - guarded explicitly, same reasoning as EXPAND-CMDSUB's
  \ splice loop: this kernel's DO/LOOP doesn't treat start=limit as
  \ zero iterations.
  DUP 0 > IF
    0 DO DUP I + C@ 47 = IF UNLOOP DROP -1 EXIT THEN LOOP
    DROP 0
  ELSE
    2DROP 0
  THEN ;

VARIABLE PATH-CUR
VARIABLE PATH-END2

\ Try one PATH directory (c-addr u, no trailing slash) against ARGV[0].
\ Builds "dir/cmd" into PATHBUF and attempts EXECVE. Only returns if
\ that attempt failed.
: TRY-DIR ( c-addr u --- )
  PATHBUF B-RESET
  B-STR
  47 B-CHAR
  ARGV @ B-CSTR
  B-FINISH
  ARGV PATHBUF EXECVE DROP ;

: SEARCH-PATH ( --- )  \ only returns if every PATH candidate failed
  S" PATH" ENVNAMBUF SWAP MOVE 0 ENVNAMBUF 4 + C!  ( NUL-terminate "PATH" )
  ENVNAMBUF GETENV
  DUP 0= IF DROP EXIT THEN
  DUP CSTRLEN OVER + PATH-END2 !
  PATH-CUR !
  BEGIN PATH-CUR @ PATH-END2 @ < WHILE
    PATH-CUR @             ( start of this dir entry )
    BEGIN
      PATH-CUR @ PATH-END2 @ < IF PATH-CUR @ C@ 58 <> ELSE 0 THEN
    WHILE PATH-CUR @ 1+ PATH-CUR ! REPEAT
    ( start ) PATH-CUR @ OVER -   ( start len )
    TRY-DIR
    PATH-CUR @ PATH-END2 @ < IF PATH-CUR @ 1+ PATH-CUR ! THEN
  REPEAT ;

: RUN-CHILD ( --- )  \ resolve ARGV[0] and exec it; only returns on total failure
  ARGV @ DUP CSTRLEN HAS-SLASH? IF
    ARGV ARGV @ EXECVE DROP
  ELSE
    SEARCH-PATH
  THEN ;

\ ==================================================================
\ Builtins - these must run in the shell's own process (not a forked
\ child), since their whole point is to change *this* process's own
\ state (cwd, environment) in a way a child's changes couldn't
\ propagate back from.
\ ==================================================================

: DO-CD ( --- )
  ARGC @ 1 > IF
    ARGV 1 CELLS + @ CHDIR
    IF ." cd: no such directory" CR 1 LAST-STATUS ! ELSE 0 LAST-STATUS ! THEN
  ELSE
    S" HOME" ENVNAMBUF SWAP MOVE 0 ENVNAMBUF 4 + C!
    ENVNAMBUF GETENV DUP 0= IF
      DROP 0 LAST-STATUS !
    ELSE
      CHDIR IF 1 ELSE 0 THEN LAST-STATUS !
    THEN
  THEN ;

: DO-PWD ( --- )
  CWDBUF PATH-MAX GETCWD DROP CWDBUF SWAP TYPE CR
  0 LAST-STATUS ! ;

: DO-EXPORT ( --- )
  \ export NAME=VALUE - finds '=' in ARGV[1], splits it, records it
  \ as both a shell-local variable (SET-SHVAR) and an environment
  \ variable (SETENV) - so subsequently-expanded $NAME sees the same
  \ value whether or not it's also inherited by a child process.
  \ export NAME (no '=') exports an already-set shell-local variable
  \ into the environment too, if there is one - a no-op otherwise (no
  \ "mark for future export" tracking yet, a real but small gap
  \ against full POSIX export semantics).
  ARGC @ 1 > IF
    ARGV 1 CELLS + @ DUP CSTRLEN
    \ u (ARGV[1]'s length) can be 0 (e.g. `export ""`), guarded for
    \ the same reason as HAS-SLASH?/B-STR above.
    ( c-addr u ) DUP 0 > IF
      0 DO
        DUP I + C@ 61 = IF          ( found '=' at offset I within c-addr )
          DUP I + 0 SWAP C!         ( NUL the '=' in place: c-addr )
          DUP I CHARS + CHAR+       ( c-addr value-addr )
          2DUP SET-SHVAR
          SWAP SETENV DROP
          0 LAST-STATUS !
          UNLOOP EXIT
        THEN
      LOOP
      DROP
      ( no '=' found: bare NAME - export an existing shell-local value )
      ARGV 1 CELLS + @ GET-SHVAR
      DUP 0 <> IF
        ARGV 1 CELLS + @ SETENV DROP
      ELSE
        DROP
      THEN
    ELSE
      2DROP
    THEN
  THEN
  0 LAST-STATUS ! ;

VARIABLE PARSE-N

: PARSE-DECIMAL ( c-addr u --- n )
  \ Parses a simple non-negative decimal integer from (c-addr u) - no
  \ sign handling, matching how exit codes are conventionally
  \ unsigned small integers. An explicit multiply/accumulate loop
  \ rather than the standard >NUMBER, to keep this self-contained and
  \ easy to verify directly, matching EMIT-DECIMAL's own reasoning
  \ above. u can be 0 (e.g. `exit ""`), guarded the same way as
  \ Iteration 15's crash-hardening fixes - this kernel's DO/LOOP
  \ doesn't treat start=limit as zero iterations.
  0 PARSE-N !
  DUP 0 > IF
    0 DO
      DUP I + C@ 48 -
      PARSE-N @ 10 * + PARSE-N !
    LOOP
    DROP
  ELSE
    2DROP
  THEN
  PARSE-N @ ;

: DO-UNSET ( --- )
  \ unset NAME - removes an exported environment variable and, if
  \ present, a shell-local one (REMOVE-SHVAR) too. Silently does
  \ nothing if given no argument or a name that was never set
  \ (matching real shells: unsetting an already-unset name isn't an
  \ error).
  ARGC @ 1 > IF
    ARGV 1 CELLS + @ DUP REMOVE-SHVAR UNSETENV
    IF 1 ELSE 0 THEN LAST-STATUS !
  ELSE
    0 LAST-STATUS !
  THEN ;

: DISPATCH ( --- f )  \ f = -1 if handled as a builtin, 0 if not
  ARGC @ 0 > 0 ARGV-QUOTED@ 0= AND IF
    S" cd"     ARGV @ STR0= IF DO-CD -1 EXIT THEN
    S" pwd"    ARGV @ STR0= IF DO-PWD -1 EXIT THEN
    S" export" ARGV @ STR0= IF DO-EXPORT -1 EXIT THEN
    S" unset"  ARGV @ STR0= IF DO-UNSET -1 EXIT THEN
    S" exit"   ARGV @ STR0= IF
      ARGC @ 1 > IF
        ARGV 1 CELLS + @ DUP CSTRLEN PARSE-DECIMAL SYS-EXIT
      ELSE
        LAST-STATUS @ SYS-EXIT
      THEN
    THEN
  THEN
  0 ;

\ ==================================================================
\ Main loop
\ ==================================================================

: RUN-EXTERNAL ( --- )
  FORK
  DUP 0 = IF
    DROP APPLY-REDIRECTIONS RUN-CHILD 127 SYS-EXIT
  ELSE
    WAITPID DROP           ( raw wait status )
    8 RSHIFT 255 AND       ( decode WEXITSTATUS - the normal-exit case only;
                              a signal-terminated child isn't distinguished
                              from one that exited with that same low byte
                              in v0.1 - see PROGRESS.md )
    LAST-STATUS !
  THEN ;

: SH-PROMPT ( --- )
  ." $ " ;

\ ==================================================================
\ Pipes: a single "cmd1 | cmd2" per line
\ Split off into its own pass, run *before* redirection parsing, and
\ deliberately mutually exclusive with it for v0.2: if a line has a
\ "|", redirection syntax on either side is left untouched (passed
\ through as a literal argument) rather than risked - combining the
\ two correctly (figuring out which side a "<"/">" belongs to) is
\ real complexity better tackled once each piece is independently
\ solid, not solved speculatively alongside the first pipe support.
\ Builtins aren't supported on either side of a pipe in v0.2 either -
\ both sides always run via RUN-CHILD (PATH search + exec), reusing
\ that already-proven logic unchanged by copying each side's own argv
\ into the *global* ARGV/ARGC from within that side's own forked
\ child - safe, since fork() gives each child an independent copy of
\ all memory, so overwriting ARGV there can't affect the parent or
\ the other child.
\ ==================================================================

CREATE ARGV-L MAX-ARGS CELLS ALLOT
CREATE ARGV-R MAX-ARGS CELLS ALLOT
VARIABLE ARGC-L
VARIABLE ARGC-R
VARIABLE PIPE-PRESENT?

: AT-END? ( --- f )  PR-I @ ARGC @ < 0= ;

\ ==================================================================
\ ';' - multiple commands per line, run in sequence regardless of
\ each one's own exit status (unlike '&&'/'||', not yet implemented).
\ Same whitespace-delimited-token convention as '|' below (';' only
\ acts as a separator when it's its own token - "a;b" is one literal
\ argument, same as "a|b" already is). Splits off *only* the first
\ ';' each call, leaving everything after it (which may itself
\ contain further ';'s) in ARGV-SEMI-REST for RUN-TOKENIZED to feed
\ back through this same logic on its next call - see RUN-TOKENIZED
\ for how the two pieces get run in turn.
\ ==================================================================

CREATE ARGV-SEMI-LEFT MAX-ARGS CELLS ALLOT
CREATE ARGV-SEMI-REST MAX-ARGS CELLS ALLOT
VARIABLE ARGC-SEMI-LEFT
VARIABLE ARGC-SEMI-REST

: AT-SEMI? ( --- f )
  AT-END? IF 0 EXIT THEN
  PR-I @ ARGV-QUOTED@ IF 0 EXIT THEN
  PR-I @ ARGV@ DUP CSTRLEN S" ;" STR= ;

: SPLIT-SEMI ( --- f )  \ f = -1 if a ';' token was found (the part
                          \ before it is in ARGV-SEMI-LEFT/ARGC-SEMI-
                          \ LEFT, the part after in ARGV-SEMI-REST/
                          \ ARGC-SEMI-REST - either can be empty, e.g.
                          \ a leading or trailing ';'), 0 otherwise
                          \ (neither buffer is touched).
  0 PR-I !
  0 ARGC-SEMI-LEFT !
  BEGIN AT-END? AT-SEMI? OR 0= WHILE
    PR-I @ ARGV@ ARGV-SEMI-LEFT ARGC-SEMI-LEFT @ CELLS + !
    ARGC-SEMI-LEFT @ 1+ ARGC-SEMI-LEFT !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV-SEMI-LEFT ARGC-SEMI-LEFT @ CELLS + !
  AT-SEMI? 0= IF 0 EXIT THEN
  PR-I @ 1+ PR-I !                    ( skip the ";" token itself )
  0 ARGC-SEMI-REST !
  BEGIN AT-END? 0= WHILE
    PR-I @ ARGV@ ARGV-SEMI-REST ARGC-SEMI-REST @ CELLS + !
    ARGC-SEMI-REST @ 1+ ARGC-SEMI-REST !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV-SEMI-REST ARGC-SEMI-REST @ CELLS + !
  -1 ;

: AT-PIPE? ( --- f )
  AT-END? IF 0 EXIT THEN
  PR-I @ ARGV-QUOTED@ IF 0 EXIT THEN
  PR-I @ ARGV@ DUP CSTRLEN S" |" STR= ;

: SPLIT-PIPE ( --- )
  0 PIPE-PRESENT? !
  0 ARGC-L !  0 ARGC-R !
  0 PR-I !
  BEGIN AT-END? AT-PIPE? OR 0= WHILE
    PR-I @ ARGV@ ARGV-L ARGC-L @ CELLS + !
    ARGC-L @ 1+ ARGC-L !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV-L ARGC-L @ CELLS + !
  AT-PIPE? IF
    -1 PIPE-PRESENT? !
    PR-I @ 1+ PR-I !               ( skip the "|" token itself )
    BEGIN AT-END? 0= WHILE
      PR-I @ ARGV@ ARGV-R ARGC-R @ CELLS + !
      ARGC-R @ 1+ ARGC-R !
      PR-I @ 1+ PR-I !
    REPEAT
    0 ARGV-R ARGC-R @ CELLS + !
  THEN ;

VARIABLE CA-SRC
VARIABLE CA-N

: COPY-ARGV ( src-argv src-argc --- )  \ overwrite the global ARGV/ARGC
  CA-N !  CA-SRC !
  CA-N @ ARGC !
  \ CA-N can be 0 (e.g. an empty pipeline segment), guarded for the
  \ same reason as HAS-SLASH?/B-STR/DO-EXPORT above - nothing else is
  \ on the data stack around this loop, so no ELSE/2DROP is needed.
  CA-N @ 0 > IF
    CA-N @ 0 DO
      CA-SRC @ I CELLS + @ ARGV I CELLS + !
    LOOP
  THEN
  0 ARGV CA-N @ CELLS + ! ;

: RUN-CMDSUB-CHILD ( --- )  \ resolves CMDSUB-ARGV[0] and execs it -
                              \ only returns on total failure. Runs
                              \ within a freshly forked child (see
                              \ EXPAND-CMDSUB), so overwriting the
                              \ global ARGV/ARGC here is safe, same
                              \ reasoning as RUN-PIPELINE's own use of
                              \ COPY-ARGV.
  CMDSUB-ARGV CMDSUB-ARGC @ COPY-ARGV
  RUN-CHILD ;
' RUN-CMDSUB-CHILD RUN-CMDSUB-CHILD-XT !

VARIABLE PIPE-RD
VARIABLE PIPE-WR
VARIABLE LEFT-PID
VARIABLE RIGHT-PID

: RUN-PIPELINE ( --- )
  PIPE DROP PIPE-WR ! PIPE-RD !
  FORK DUP LEFT-PID !
  0 = IF
    PIPE-WR @ 1 DUP2 DROP
    PIPE-WR @ CLOSE-FILE DROP
    PIPE-RD @ CLOSE-FILE DROP
    ARGV-L ARGC-L @ COPY-ARGV
    RUN-CHILD
    127 SYS-EXIT
  THEN
  FORK DUP RIGHT-PID !
  0 = IF
    PIPE-RD @ 0 DUP2 DROP
    PIPE-RD @ CLOSE-FILE DROP
    PIPE-WR @ CLOSE-FILE DROP
    ARGV-R ARGC-R @ COPY-ARGV
    RUN-CHILD
    127 SYS-EXIT
  THEN
  PIPE-WR @ CLOSE-FILE DROP
  PIPE-RD @ CLOSE-FILE DROP
  LEFT-PID @ WAITPID DROP DROP     ( left side's status isn't reported -
                                      a real shell exposes it via
                                      PIPESTATUS/similar; not done here )
  RIGHT-PID @ WAITPID DROP         ( pipeline's own status is the right
                                      side's, matching normal shells )
  8 RSHIFT 255 AND LAST-STATUS ! ;

\ ==================================================================
\ '&&'/'||' - a pipeline runs only if the operator connecting it to
\ the previous one permits it, based on the previous pipeline's own
\ exit status: '&&' requires success (0), '||' requires failure
\ (nonzero). Left-associative, evaluated left to right, same
\ precedence for both (POSIX gives them equal, left-to-right
\ precedence, tighter than ';' but looser than '|' - RUN-TOKENIZED
\ calls SPLIT-ANDOR only after ';' and the assignment-word check have
\ already ruled themselves out, and RUN-SIMPLE-OR-PIPELINE below,
\ which SPLIT-PIPE's own '|' handling lives inside of, is what each
\ &&/||-separated piece is run through). Same whitespace-delimited-
\ token convention '|'/';' already have - a quoted '&&' or '||' is a
\ literal argument, not an operator (AT-AND?/AT-OR? both check
\ ARGV-QUOTED@, same as AT-PIPE?/AT-SEMI?).
\ ==================================================================

CREATE ARGV-AO-LEFT MAX-ARGS CELLS ALLOT
CREATE ARGV-AO-REST MAX-ARGS CELLS ALLOT
VARIABLE ARGC-AO-LEFT
VARIABLE ARGC-AO-REST
VARIABLE ANDOR-OP        ( 1 = && was found, 2 = || was found )
VARIABLE AO-PENDING-OP   \ which of the above applies to the NEXT
                          \ piece about to be considered
VARIABLE AO-CONTINUE

: AT-AND? ( --- f )
  AT-END? IF 0 EXIT THEN
  PR-I @ ARGV-QUOTED@ IF 0 EXIT THEN
  PR-I @ ARGV@ DUP CSTRLEN S" &&" STR= ;

: AT-OR? ( --- f )
  AT-END? IF 0 EXIT THEN
  PR-I @ ARGV-QUOTED@ IF 0 EXIT THEN
  PR-I @ ARGV@ DUP CSTRLEN S" ||" STR= ;

: SPLIT-ANDOR ( --- f )  \ f = -1 if a && or || token was found in the
                          \ *global* ARGV/ARGC (not touched by this
                          \ word itself, only scanned) - the piece
                          \ before it is in ARGV-AO-LEFT/ARGC-AO-LEFT,
                          \ which operator it was in ANDOR-OP, and
                          \ everything after it (which may itself
                          \ contain further &&/||, not yet split) in
                          \ ARGV-AO-REST/ARGC-AO-REST. f = 0 if
                          \ neither was found at all (nothing touched
                          \ except ARGC-AO-LEFT, harmlessly reset).
  0 PR-I !
  0 ARGC-AO-LEFT !
  BEGIN AT-END? AT-AND? OR AT-OR? OR 0= WHILE
    PR-I @ ARGV@ ARGV-AO-LEFT ARGC-AO-LEFT @ CELLS + !
    ARGC-AO-LEFT @ 1+ ARGC-AO-LEFT !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV-AO-LEFT ARGC-AO-LEFT @ CELLS + !
  AT-END? IF 0 EXIT THEN
  AT-AND? IF 1 ANDOR-OP ! ELSE 2 ANDOR-OP ! THEN
  PR-I @ 1+ PR-I !                    ( skip the "&&"/"||" token itself )
  0 ARGC-AO-REST !
  BEGIN AT-END? 0= WHILE
    PR-I @ ARGV@ ARGV-AO-REST ARGC-AO-REST @ CELLS + !
    ARGC-AO-REST @ 1+ ARGC-AO-REST !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV-AO-REST ARGC-AO-REST @ CELLS + !
  -1 ;

: AO-SHOULD-RUN? ( --- f )  \ does AO-PENDING-OP (the operator right
                              \ before the piece about to be
                              \ considered) permit running it, given
                              \ the previous piece's own LAST-STATUS?
  AO-PENDING-OP @ 0 = IF -1 EXIT THEN
  AO-PENDING-OP @ 1 = IF LAST-STATUS @ 0= EXIT THEN
  LAST-STATUS @ 0 <> ;

: RUN-SIMPLE-OR-PIPELINE ( --- )  \ runs whatever's currently in the
                                    \ global ARGV/ARGC as one pipeline
                                    \ (or simple command) - the logic
                                    \ that used to be inline at the end
                                    \ of RUN-TOKENIZED, factored out
                                    \ here so RUN-AND-OR-CHAIN below
                                    \ can call it once per &&/||-
                                    \ separated piece. A no-op if
                                    \ SUPPRESS-EXEC? is set - this line
                                    \ is being read only to correctly
                                    \ consume a skipped if/while
                                    \ branch's own body, not actually
                                    \ run.
  SUPPRESS-EXEC? @ IF EXIT THEN
  SPLIT-PIPE
  PIPE-PRESENT? @ IF
    ARGC-L @ 0 > ARGC-R @ 0 > AND IF RUN-PIPELINE THEN
  ELSE
    PARSE-REDIRECTIONS
    ARGC @ 0 > IF
      DISPATCH 0= IF RUN-EXTERNAL THEN
    THEN
  THEN ;

: RUN-AND-OR-CHAIN ( --- )
  \ Called right after RUN-TOKENIZED's own SPLIT-ANDOR call has
  \ already found at least one &&/|| in the current segment -
  \ ARGV-AO-LEFT/ARGC-AO-LEFT holds the first piece, ANDOR-OP the
  \ operator right after it, ARGV-AO-REST/ARGC-AO-REST everything
  \ beyond that. The first piece always runs unconditionally - there's
  \ no operator before it to make it conditional on.
  ARGV-AO-LEFT ARGC-AO-LEFT @ COPY-ARGV
  RUN-SIMPLE-OR-PIPELINE
  ANDOR-OP @ AO-PENDING-OP !
  ARGV-AO-REST ARGC-AO-REST @ COPY-ARGV
  -1 AO-CONTINUE !
  BEGIN AO-CONTINUE @ WHILE
    SPLIT-ANDOR IF
      ( more &&/|| ahead: this piece is in ARGV-AO-LEFT, the operator
        after it in ANDOR-OP, the remainder in ARGV-AO-REST )
      AO-SHOULD-RUN? IF
        ARGV-AO-LEFT ARGC-AO-LEFT @ COPY-ARGV
        RUN-SIMPLE-OR-PIPELINE
      THEN
      ANDOR-OP @ AO-PENDING-OP !
      ARGV-AO-REST ARGC-AO-REST @ COPY-ARGV
    ELSE
      ( no more &&/|| - the global ARGV IS the final piece, already
        copied in by the previous iteration )
      AO-SHOULD-RUN? IF RUN-SIMPLE-OR-PIPELINE THEN
      0 AO-CONTINUE !
    THEN
  REPEAT ;


\ ==================================================================
\ Control structures: if/then/else/fi
\ Deliberately minimal for v0.5: no nesting support (a body containing
\ another if will misbehave - see PROGRESS.md), and then/else/fi must
\ each be alone on their own line (no ";"-separated forms, since there
\ is no ";" support at all yet). The condition is whatever follows
\ "if" on the same line - run via the normal command path, including
\ its own pipe/redirection handling. then/else bodies are read one
\ line at a time directly from stdin and executed immediately as
\ they're read, not buffered and re-scanned - this works for if
\ precisely because each body line only ever needs running once,
\ unlike a loop body (which is why while/for aren't attempted here -
\ they'd need a genuinely different, buffer-and-replay approach).
\
\ RUN-TOKENIZED (below) needs to detect "if" and hand off to DO-IF,
\ but DO-IF needs to run its own body lines through the same "act on
\ tokenized ARGV" logic RUN-TOKENIZED provides - a genuine mutual
\ dependency. Broken via a small deferred-word indirection
\ (RUN-TOKENIZED-CALL, patched to RUN-TOKENIZED's own execution token
\ once that word is defined below) rather than trying to reorder
\ around it.
\ ==================================================================

VARIABLE RUN-TOKENIZED-XT

: RUN-TOKENIZED-CALL ( --- )
  RUN-TOKENIZED-XT @ EXECUTE ;

\ ==================================================================
\ '( list )' subshells and '{ list ; }' brace groups. Both require
\ whitespace around '(', ')', '{', '}' (this shell's established
\ convention for every operator so far - '|', ';', '&&', '||' all
\ need it too - though real POSIX shells don't require it around '('
\ specifically; a real gap against mrsh's own tests, which write
\ "(cmd)" with no spaces, but a deliberate, consistent scope choice
\ here rather than a special-cased tokenizer change). A subshell
\ forks: the body runs in a child process, so cd/variable/export
\ changes inside it don't affect this shell, and the parent takes the
\ child's exit status as its own (same FORK/WAITPID shape
\ RUN-PIPELINE already uses). A brace group runs its body directly in
\ this shell instead - no fork - so changes inside it persist
\ afterward, which is the entire reason it exists as a distinct
\ construct from a subshell. Neither supports nesting (a body
\ containing another '(' or '{' will misbehave - the same "no nesting"
\ scope limit if/while already have, and for the same reason: this
\ shell doesn't yet have real per-invocation state for control
\ structures, only shared globals). Detected by ARGV[0] alone (reusing
\ LINE-IS?, exactly as if/while already are) - this check runs *before*
\ ';'/'&&'/'||' splitting, since a group's own ';'/'&&'/'||' (used
\ inside its body) must stay scoped to that body rather than being
\ split as if it belonged to the outer line.
\ ==================================================================

CREATE ARGV-GROUP-BODY MAX-ARGS CELLS ALLOT
VARIABLE ARGC-GROUP-BODY
VARIABLE GROUP-PID

: AT-CLOSE-PAREN? ( --- f )
  AT-END? IF 0 EXIT THEN
  PR-I @ ARGV-QUOTED@ IF 0 EXIT THEN
  PR-I @ ARGV@ DUP CSTRLEN S" )" STR= ;

: AT-CLOSE-BRACE? ( --- f )
  AT-END? IF 0 EXIT THEN
  PR-I @ ARGV-QUOTED@ IF 0 EXIT THEN
  PR-I @ ARGV@ DUP CSTRLEN S" }" STR= ;

: SPLIT-GROUP-PAREN ( --- f )
  \ ARGV[0] is assumed to already be "(" (checked by the caller, see
  \ RUN-TOKENIZED). Scans ARGV[1..] for the matching ")" - if found
  \ (f = -1), ARGV-GROUP-BODY/ARGC-GROUP-BODY holds everything
  \ between them (may be empty, e.g. "( )"). If the line ends first
  \ (f = 0, an unterminated group), nothing is touched - not yet
  \ reported as an error, matching this shell's sparse error handling
  \ elsewhere.
  1 PR-I !
  0 ARGC-GROUP-BODY !
  BEGIN AT-END? AT-CLOSE-PAREN? OR 0= WHILE
    PR-I @ ARGV@ ARGV-GROUP-BODY ARGC-GROUP-BODY @ CELLS + !
    ARGC-GROUP-BODY @ 1+ ARGC-GROUP-BODY !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV-GROUP-BODY ARGC-GROUP-BODY @ CELLS + !
  AT-CLOSE-PAREN? 0= IF 0 EXIT THEN
  -1 ;

: SPLIT-GROUP-BRACE ( --- f )  \ same as SPLIT-GROUP-PAREN, for "{"/"}"
  1 PR-I !
  0 ARGC-GROUP-BODY !
  BEGIN AT-END? AT-CLOSE-BRACE? OR 0= WHILE
    PR-I @ ARGV@ ARGV-GROUP-BODY ARGC-GROUP-BODY @ CELLS + !
    ARGC-GROUP-BODY @ 1+ ARGC-GROUP-BODY !
    PR-I @ 1+ PR-I !
  REPEAT
  0 ARGV-GROUP-BODY ARGC-GROUP-BODY @ CELLS + !
  AT-CLOSE-BRACE? 0= IF 0 EXIT THEN
  -1 ;

: DO-SUBSHELL ( --- )
  \ SPLIT-GROUP-PAREN has already run (see RUN-TOKENIZED), leaving the
  \ body in ARGV-GROUP-BODY/ARGC-GROUP-BODY. Forks; the child copies
  \ the body into the global ARGV/ARGC (safe - COPY-ARGV inside a
  \ freshly forked child is the same pattern RUN-PIPELINE's own sides
  \ already use) and runs it via RUN-TOKENIZED-CALL, so the body's own
  \ ';'/'&&'/'||'/'|' all work normally, then exits with whatever
  \ LAST-STATUS that left behind. The parent waits and takes the
  \ child's exit status as this command's own.
  FORK DUP GROUP-PID !
  0 = IF
    ARGV-GROUP-BODY ARGC-GROUP-BODY @ COPY-ARGV
    RUN-TOKENIZED-CALL
    LAST-STATUS @ SYS-EXIT
  THEN
  GROUP-PID @ WAITPID DROP
  8 RSHIFT 255 AND LAST-STATUS ! ;

: DO-BRACE-GROUP ( --- )
  \ Same as DO-SUBSHELL, but no fork - the body runs directly in this
  \ shell, so any cd/variable/export changes inside it persist
  \ afterward. That's the whole reason a brace group exists as a
  \ separate construct from a subshell.
  ARGV-GROUP-BODY ARGC-GROUP-BODY @ COPY-ARGV
  RUN-TOKENIZED-CALL ;

: LINE-IS? ( c-addr u --- f )  \ does the current tokenized ARGV[0]
                                 \ equal this literal, exactly, and
                                 \ unquoted? (a quoted 'if'/'then'/etc
                                 \ is just a literal argument, same
                                 \ reasoning as ARGV-QUOTED elsewhere)
  ARGC @ 0 = IF 2DROP 0 EXIT THEN
  0 ARGV-QUOTED@ IF 2DROP 0 EXIT THEN
  ARGV @ STR0= ;

\ ==================================================================
\ Shell-local variable assignment: a standalone "NAME=value" line
\ (the *entire* line - not a command with an assignment-looking
\ argument, and not "NAME=value command args..." either, which POSIX
\ treats as a *temporary* assignment scoped to just that one command's
\ execution - not implemented yet, a real, deliberate scope limit for
\ now) sets a shell-local variable via SET-SHVAR rather than being
\ looked up as a command name.
\ ==================================================================

VARIABLE AW-I

: FIND-EQ-OR-END ( c-addr --- offset )  \ offset of the first '=' in
                                          \ c-addr, or its CSTRLEN if
                                          \ none is found before the
                                          \ terminating NUL.
  0 AW-I !
  BEGIN
    DUP AW-I @ + C@ DUP 0 <> SWAP 61 <> AND
  WHILE
    AW-I @ 1+ AW-I !
  REPEAT
  DROP AW-I @ ;

: VALID-NAME? ( c-addr u --- f )  \ is (c-addr u) a non-empty,
                                    \ POSIX-valid variable name? (first
                                    \ character not a digit, every
                                    \ character NAME-CHAR? - which
                                    \ itself does allow digits, correct
                                    \ for every character *after* the
                                    \ first).
  DUP 0= IF 2DROP 0 EXIT THEN
  OVER C@ DUP 48 < 0= SWAP 58 < AND IF 2DROP 0 EXIT THEN
  0 DO
    DUP I + C@ NAME-CHAR? 0= IF UNLOOP DROP 0 EXIT THEN
  LOOP
  DROP -1 ;

: ASSIGNMENT-EQPOS ( c-addr --- eqpos | -1 )  \ c-addr: a NUL-
                                                \ terminated string
                                                \ (ARGV[0]). The offset
                                                \ of its first '=' if
                                                \ everything before it
                                                \ forms a valid,
                                                \ non-empty POSIX name
                                                \ - else -1 (not an
                                                \ assignment word at
                                                \ all).
  DUP FIND-EQ-OR-END
  2DUP + C@ 61 <> IF 2DROP -1 EXIT THEN
  2DUP VALID-NAME? 0= IF 2DROP -1 EXIT THEN
  SWAP DROP ;

CREATE ASSIGN-NAME-BUF SHVAR-NAME-MAX ALLOT
CREATE ASSIGN-VALUE-BUF SHVAR-VALUE-MAX ALLOT

: DO-ASSIGN ( eqpos --- )  \ ARGV[0] is a validated "NAME=value"
                            \ assignment word (see ASSIGNMENT-EQPOS)
                            \ and eqpos is its '='s offset. Splits it
                            \ into ASSIGN-NAME-BUF/ASSIGN-VALUE-BUF and
                            \ records it via SET-SHVAR - does NOT
                            \ export it (see DO-EXPORT for how export
                            \ interacts with this). A no-op (not even
                            \ touching LAST-STATUS) if SUPPRESS-EXEC?
                            \ is set - this line is being read only to
                            \ correctly consume a skipped if/while
                            \ branch's own body, not actually run.
  SUPPRESS-EXEC? @ IF DROP EXIT THEN
  DUP ARGV @ SWAP ASSIGN-NAME-BUF SHVAR-NAME-MAX SAFE-COPY-NUL DROP
  DUP 1+ ARGV @ +
  SWAP ARGV @ CSTRLEN SWAP - 1-
  ASSIGN-VALUE-BUF SHVAR-VALUE-MAX SAFE-COPY-NUL DROP
  ASSIGN-NAME-BUF ASSIGN-VALUE-BUF SET-SHVAR
  0 LAST-STATUS ! ;

CREATE ARGV-SHIFT MAX-ARGS CELLS ALLOT
VARIABLE ARGC-SHIFT

: SHIFT-ARGV-DOWN ( --- )  \ copies ARGV[1..ARGC-1] into
                            \ ARGV-SHIFT[0..] - "the rest of this
                            \ line" as its own command, used to run
                            \ if's condition (the part after "if").
  0 ARGC-SHIFT !
  ARGC @ 1 > IF
    ARGC @ 1 DO
      I ARGV@ ARGV-SHIFT ARGC-SHIFT @ CELLS + !
      ARGC-SHIFT @ 1+ ARGC-SHIFT !
    LOOP
  THEN
  0 ARGV-SHIFT ARGC-SHIFT @ CELLS + ! ;

: RUN-SHIFTED ( --- )  \ runs ARGV-SHIFT/ARGC-SHIFT the same way a
                        \ normal top-level line would be
  ARGV-SHIFT ARGC-SHIFT @ COPY-ARGV
  RUN-TOKENIZED-CALL ;

CREATE RAW-LINE-BUF LINE-MAX ALLOT
VARIABLE RAW-LINE-LEN

VARIABLE SHFILE-FID
VARIABLE SHFILE-ACTIVE?   \ true while running via SH-FILE, so
                            \ READ-NEXT-INPUT-LINE below knows to read
                            \ from SHFILE-FID rather than the real
                            \ process stdin - if/while's own internal
                            \ body-line reading (READ-LINE-INTO-ARGV)
                            \ goes through that same word, so this is
                            \ what makes if/while work at all when a
                            \ script is run via `relfsh script.sh`
                            \ rather than piped into stdin - found and
                            \ fixed as a real, pre-existing bug:
                            \ without this, DO-IF/DO-WHILE always read
                            \ from the real stdin regardless of where
                            \ the script actually came from, so "if"'s
                            \ own "then"/body/"fi" lines were never
                            \ seen at all when invoked this way, and
                            \ the whole command was silently a no-op.

: READ-NEXT-INPUT-LINE ( c-addr max --- u2 )
  \ Reads one line of "current input" - from the real process stdin
  \ via ACCEPT (preserving its backspace/delete editing, which matters
  \ for a genuinely interactive session) when not running via
  \ SH-FILE, or from the open script file via READ-LINE (discarding
  \ its own flag/ior - EOF just gives u2=0, the same as running out
  \ of lines already meant here) when SHFILE-ACTIVE? is true.
  SHFILE-ACTIVE? @ IF
    SHFILE-FID @ READ-LINE DROP DROP
  ELSE
    ACCEPT
  THEN ;

: READ-LINE-INTO-ARGV ( --- )  \ reads one line from stdin, tokenizes
                                 \ it into ARGV/ARGC - no redirect/pipe
                                 \ parsing or dispatch, just enough to
                                 \ inspect ARGV[0] for a keyword.
                                 \ Also stashes a raw (pre-tokenize,
                                 \ pre-expansion) copy in RAW-LINE-BUF,
                                 \ needed by DO-WHILE below to capture
                                 \ a loop's condition/body text so it
                                 \ can be re-expanded fresh on every
                                 \ iteration rather than frozen at its
                                 \ first reading.
  LINE-BUF LINE-MAX READ-NEXT-INPUT-LINE
  SHFILE-ACTIVE? @ 0= IF CR THEN
  DUP RAW-LINE-LEN !
  LINE-BUF RAW-LINE-BUF RAW-LINE-LEN @ MOVE
  TOKENIZE ;

VARIABLE COND-TRUE?

: DO-IF ( --- )
  \ ARGV[0] is "if"; the rest of the line is the condition command.
  \ Supports nesting, including inside a branch that itself doesn't
  \ execute: COND-TRUE? and SUPPRESS-EXEC? are both saved on the
  \ return stack at entry (COND-TRUE? first, then SUPPRESS-EXEC? on
  \ top of it) and restored right before every exit. Every body line
  \ is always run through RUN-TOKENIZED-CALL regardless of whether
  \ this branch should actually execute anything - what changes is
  \ SUPPRESS-EXEC?'s own value beforehand, which DO-ASSIGN and
  \ RUN-SIMPLE-OR-PIPELINE both check before actually doing anything.
  \ This is what lets a nested if/while inside a *skipped* branch
  \ still correctly consume its own then/body/fi (so its "fi" is never
  \ mistaken for this if's own) without actually running anything
  \ inside it - unlike only gating whether RUN-TOKENIZED-CALL itself
  \ gets called, which is what an earlier version of this fix did
  \ before testing directly surfaced that it broke exactly this case.
  \ (while/do/done does NOT support nesting yet - its condition/body
  \ are buffered as raw text across possibly many buffer-sized values,
  \ not simple scalars, so nesting it would need considerably more
  \ than this; left for its own future iteration.)
  COND-TRUE? @ >R
  SUPPRESS-EXEC? @ >R
  SUPPRESS-EXEC? @ IF
    0 COND-TRUE? !
  ELSE
    SHIFT-ARGV-DOWN
    RUN-SHIFTED
    LAST-STATUS @ 0 = COND-TRUE? !
  THEN
  READ-LINE-INTO-ARGV
  S" then" LINE-IS? 0= IF
    ." if: expected 'then'" CR
    R> SUPPRESS-EXEC? ! R> COND-TRUE? ! EXIT
  THEN
  R@ COND-TRUE? @ 0= OR SUPPRESS-EXEC? !
  BEGIN
    READ-LINE-INTO-ARGV
    S" fi" LINE-IS? IF R> SUPPRESS-EXEC? ! R> COND-TRUE? ! EXIT THEN
    S" else" LINE-IS? IF
      R@ COND-TRUE? @ OR SUPPRESS-EXEC? !
      BEGIN
        READ-LINE-INTO-ARGV
        S" fi" LINE-IS? IF R> SUPPRESS-EXEC? ! R> COND-TRUE? ! EXIT THEN
        RUN-TOKENIZED-CALL
      0 UNTIL
    THEN
    RUN-TOKENIZED-CALL
  0 UNTIL ;

\ ==================================================================
\ while/do/done
\ Unlike if, a loop body has to run more than once - stdin is a
\ one-pass stream, so it can't just be read-and-discarded like if's
\ body could be. This buffers the RAW (pre-tokenize, pre-expansion)
\ text of both the condition and the body once, the first time
\ through, then re-copies and re-tokenizes that saved text into
\ LINE-BUF fresh on every iteration. Re-tokenizing fresh each time -
\ rather than reusing the already-tokenized ARGV from the first
\ reading - matters: it's what lets $?/$$/$VAR in the condition
\ reflect each iteration's own current state rather than a value
\ frozen from before the loop even started (e.g. "while test $? -eq
\ 0" needs $? to update every time to be meaningful at all).
\ Same v0.5 limitations as if: no nesting, no ";"-separated forms.
\ ==================================================================

CREATE WHILE-COND-BUF LINE-MAX ALLOT
VARIABLE WHILE-COND-LEN
4096 CONSTANT WHILE-BODY-MAX
CREATE WHILE-BODY-BUF WHILE-BODY-MAX ALLOT   ( raw body lines, NUL-separated )
VARIABLE WHILE-BODY-LEN
VARIABLE RAW-SKIP-I

: SAVE-WHILE-COND ( --- )
  \ RAW-LINE-BUF/RAW-LINE-LEN holds the raw "while ..." line just
  \ read. Skips its own leading whitespace, the literal "while" (5
  \ characters), and more whitespace, then saves whatever remains
  \ into WHILE-COND-BUF (NUL-terminated) - the condition text, with
  \ no expansion applied yet (that happens fresh each iteration when
  \ it's re-tokenized).
  0 RAW-SKIP-I !
  BEGIN
    RAW-SKIP-I @ RAW-LINE-LEN @ < IF RAW-LINE-BUF RAW-SKIP-I @ + C@ WS? ELSE 0 THEN
  WHILE RAW-SKIP-I @ 1+ RAW-SKIP-I ! REPEAT
  RAW-SKIP-I @ 5 + RAW-SKIP-I !
  BEGIN
    RAW-SKIP-I @ RAW-LINE-LEN @ < IF RAW-LINE-BUF RAW-SKIP-I @ + C@ WS? ELSE 0 THEN
  WHILE RAW-SKIP-I @ 1+ RAW-SKIP-I ! REPEAT
  RAW-LINE-LEN @ RAW-SKIP-I @ > IF
    RAW-LINE-LEN @ RAW-SKIP-I @ - WHILE-COND-LEN !
    RAW-LINE-BUF RAW-SKIP-I @ + WHILE-COND-BUF WHILE-COND-LEN @ MOVE
  ELSE
    0 WHILE-COND-LEN !
  THEN
  0 WHILE-COND-BUF WHILE-COND-LEN @ + C! ;

: APPEND-RAW-LINE-TO-BODY ( --- )
  \ Appends the current RAW-LINE-BUF/RAW-LINE-LEN (NUL-terminated) to
  \ the end of WHILE-BODY-BUF - but only if it fits (+1 for the NUL);
  \ a body line that would overflow the fixed-size buffer is silently
  \ dropped rather than corrupting whatever dictionary data follows
  \ it in memory. A dropped line means that loop iteration's body is
  \ incomplete - no error is reported for this yet.
  WHILE-BODY-LEN @ RAW-LINE-LEN @ + 1+ WHILE-BODY-MAX < IF
    RAW-LINE-BUF WHILE-BODY-BUF WHILE-BODY-LEN @ + RAW-LINE-LEN @ MOVE
    WHILE-BODY-LEN @ RAW-LINE-LEN @ + WHILE-BODY-LEN !
    0 WHILE-BODY-BUF WHILE-BODY-LEN @ + C!
    WHILE-BODY-LEN @ 1+ WHILE-BODY-LEN !
  THEN ;

VARIABLE RSL-LEN

: RUN-STORED-LINE ( c-addr --- )
  \ Copies a NUL-terminated stored line into LINE-BUF, tokenizes it
  \ fresh (including fresh $VAR/$?/$$ expansion), and runs it.
  DUP CSTRLEN RSL-LEN !
  LINE-BUF RSL-LEN @ MOVE
  RSL-LEN @ TOKENIZE
  RUN-TOKENIZED-CALL ;

VARIABLE WHILE-BODY-I
VARIABLE WHILE-BODY-CUR

: DO-WHILE-BODY ( --- )
  \ Runs each stored, NUL-separated body line once, in order.
  0 WHILE-BODY-I !
  BEGIN WHILE-BODY-I @ WHILE-BODY-LEN @ < WHILE
    WHILE-BODY-BUF WHILE-BODY-I @ + WHILE-BODY-CUR !
    WHILE-BODY-CUR @ RUN-STORED-LINE
    WHILE-BODY-I @ WHILE-BODY-CUR @ CSTRLEN + 1+ WHILE-BODY-I !
  REPEAT ;

: DO-WHILE ( --- )
  \ ARGV[0] is "while"; RAW-LINE-BUF holds the raw line just read.
  SAVE-WHILE-COND
  READ-LINE-INTO-ARGV
  S" do" LINE-IS? 0= IF
    ." while: expected 'do'" CR EXIT
  THEN
  0 WHILE-BODY-LEN !
  BEGIN
    READ-LINE-INTO-ARGV
    S" done" LINE-IS? 0= WHILE
    APPEND-RAW-LINE-TO-BODY
  REPEAT
  BEGIN
    WHILE-COND-BUF LINE-BUF WHILE-COND-LEN @ MOVE
    WHILE-COND-LEN @ TOKENIZE
    RUN-TOKENIZED-CALL
    LAST-STATUS @ 0 =
  WHILE
    DO-WHILE-BODY
  REPEAT ;

\ ==================================================================
\ for VAR in word1 word2 ... / do / <body> / done
\ Requires "do" on its own, separate line, matching if/while's own
\ established convention here ("for VAR in ...; do" on one line isn't
\ supported, same as "if cond; then" isn't). Reuses while's own
\ body-capture/replay machinery (WHILE-BODY-BUF/APPEND-RAW-LINE-TO-
\ BODY/DO-WHILE-BODY) - the mechanics of "store body lines, then
\ replay them" are identical; only the iteration control differs (a
\ fixed word list, expanded once here at the "for ... in ..." line
\ itself, matching POSIX - not re-evaluated each iteration the way
\ while's own condition is). Does NOT support nesting a for/while
\ inside a for's own body (the same shared buffer would be clobbered,
\ the same underlying reason while doesn't support nesting either).
\ Does not validate that ARGV[2] is actually "in" (matching this
\ shell's sparse error handling elsewhere) - it's simply skipped over.
\ ==================================================================

256 CONSTANT FOR-WORDS-MAX
CREATE FOR-WORDS-BUF FOR-WORDS-MAX ALLOT   ( word list, NUL-separated )
VARIABLE FOR-WORDS-LEN
CREATE FOR-VARNAME-BUF 64 ALLOT
VARIABLE FW-I
VARIABLE FW-WORDLEN

: SAVE-FOR-WORDS ( --- )
  \ ARGV[1] (the loop variable name) into FOR-VARNAME-BUF; ARGV[3..]
  \ (the word list, skipping ARGV[2]'s assumed "in") into
  \ FOR-WORDS-BUF/FOR-WORDS-LEN.
  ARGV 1 CELLS + @ FOR-VARNAME-BUF 64 SAFE-CSTR-COPY DROP
  0 FOR-WORDS-LEN !
  3 FW-I !
  BEGIN FW-I @ ARGC @ < WHILE
    FW-I @ ARGV@ DUP CSTRLEN FW-WORDLEN !
    FW-WORDLEN @
    FOR-WORDS-BUF FOR-WORDS-LEN @ +
    FOR-WORDS-MAX FOR-WORDS-LEN @ -
    SAFE-COPY-NUL IF
      FOR-WORDS-LEN @ FW-WORDLEN @ + 1+ FOR-WORDS-LEN !
    THEN
    FW-I @ 1+ FW-I !
  REPEAT ;

VARIABLE FOR-WORD-I
VARIABLE FOR-WORD-CUR

: DO-FOR-ITERATE ( --- )
  \ For each stored word (NUL-separated in FOR-WORDS-BUF/
  \ FOR-WORDS-LEN), sets the loop variable (SET-SHVAR) and replays the
  \ stored body (DO-WHILE-BODY, shared with while - see above). A
  \ no-op if SUPPRESS-EXEC? is set - this whole for loop sits inside a
  \ skipped if/else branch, so do/body/done were still correctly
  \ consumed above, but nothing should actually run.
  SUPPRESS-EXEC? @ IF EXIT THEN
  0 FOR-WORD-I !
  BEGIN FOR-WORD-I @ FOR-WORDS-LEN @ < WHILE
    FOR-WORDS-BUF FOR-WORD-I @ + FOR-WORD-CUR !
    FOR-VARNAME-BUF FOR-WORD-CUR @ SET-SHVAR
    DO-WHILE-BODY
    FOR-WORD-I @ FOR-WORD-CUR @ CSTRLEN + 1+ FOR-WORD-I !
  REPEAT ;

: DO-FOR ( --- )
  \ ARGV[0] is "for"; ARGV[1] is the loop variable name; ARGV[3..] is
  \ the word list (ARGV[2], assumed "in", is skipped over).
  SAVE-FOR-WORDS
  READ-LINE-INTO-ARGV
  S" do" LINE-IS? 0= IF
    ." for: expected 'do'" CR EXIT
  THEN
  0 WHILE-BODY-LEN !
  BEGIN
    READ-LINE-INTO-ARGV
    S" done" LINE-IS? 0= WHILE
    APPEND-RAW-LINE-TO-BODY
  REPEAT
  DO-FOR-ITERATE ;

: RUN-TOKENIZED ( --- )
  \ Acts on the currently-tokenized ARGV/ARGC: '(' / '{' group
  \ detection first of all (see DO-SUBSHELL/DO-BRACE-GROUP - a
  \ group's own ';'/'&&'/'||' must stay scoped to its body rather than
  \ being split as if it belonged to the outer line, so this has to
  \ run before any of that), then ';' splitting (so each ';'-separated
  \ piece gets the full treatment below on its own - see SPLIT-SEMI),
  \ then control-structure keywords, then assignment detection, then
  \ &&/|| splitting (see SPLIT-ANDOR/RUN-AND-OR-CHAIN - POSIX gives
  \ '&&'/'||' equal, left-to-right precedence, tighter than ';' but
  \ looser than '|'), then a plain pipeline/simple command
  \ (RUN-SIMPLE-OR-PIPELINE, which is what each &&/||-separated piece
  \ above also runs through). Shared by RUN-LINE (after its own
  \ TOKENIZE call, below) and DO-IF's own body-line handling above (via
  \ RUN-TOKENIZED-CALL, patched to this word's xt right after it's
  \ defined).
  S" (" LINE-IS? IF
    SPLIT-GROUP-PAREN IF DO-SUBSHELL THEN
    EXIT
  THEN
  S" {" LINE-IS? IF
    SPLIT-GROUP-BRACE IF DO-BRACE-GROUP THEN
    EXIT
  THEN
  SPLIT-SEMI IF
    ARGV-SEMI-LEFT ARGC-SEMI-LEFT @ COPY-ARGV
    RUN-TOKENIZED-CALL
    ARGV-SEMI-REST ARGC-SEMI-REST @ COPY-ARGV
    RUN-TOKENIZED-CALL
    EXIT
  THEN
  S" if" LINE-IS? IF DO-IF EXIT THEN
  S" while" LINE-IS? IF DO-WHILE EXIT THEN
  S" for" LINE-IS? IF DO-FOR EXIT THEN
  ARGC @ 1 = 0 ARGV-QUOTED@ 0= AND IF
    ARGV @ ASSIGNMENT-EQPOS
    DUP -1 <> IF DO-ASSIGN EXIT THEN
    DROP
  THEN
  SPLIT-ANDOR IF
    RUN-AND-OR-CHAIN
    EXIT
  THEN
  RUN-SIMPLE-OR-PIPELINE ;
' RUN-TOKENIZED RUN-TOKENIZED-XT !

\ ==================================================================
\ Operator normalization: ';', '|', '&', '<', '>' (and their doubled
\ forms '&&', '||', '>>') are, in real POSIX shells, self-delimiting
\ operator characters - "true;echo" and "a>file" parse correctly with
\ no whitespace needed around the operator at all. Every operator
\ this shell has implemented so far (Iterations 7, 18, 19) instead
\ took the shortcut of requiring surrounding whitespace, a deliberate,
\ consistently-documented scope limit - but re-reading mrsh's own test
\ files directly showed this blocking real progress: "if true; then",
\ "( echo hi )" written as "(echo hi)", and similar fused-operator
\ style are the norm in real scripts, not the exception.
\
\ Rather than rewrite SCAN-TOKEN/TOKENIZE's own in-place compaction
\ logic to recognize operators mid-scan (which turned out to risk a
\ real hazard: an unquoted word's NUL-termination write lands exactly
\ where a following fused operator character would sit, destroying it
\ before it could ever be read as its own token), this runs as a
\ pre-pass over the raw line text, inserting a literal space before
\ and after every *unquoted* operator character found (tracking
\ single/double quote state so an operator character *inside* a quote
\ is left untouched - quoted operators are literal text, not
\ operators, matching real shells) - "true;echo" becomes "true ; echo"
\ before TOKENIZE (entirely unmodified) ever sees it. Re-normalizing
\ an already-spaced-out operator is harmless (just adds a redundant
\ extra space either side, which SKIP-WS already tolerates fine) -
\ relevant since a while loop's condition gets re-tokenized fresh every
\ iteration, and would otherwise go through this twice.
\
\ Deliberately out of scope for now: '(', ')', '{', '}'. Unlike the
\ five operators above, blindly spacing every unquoted paren/brace
\ would break $(...) command substitution outright - EXPAND-VAR's own
\ detection needs "$(" with no space in between - and doing this
\ correctly needs tracking "am I currently inside a $(...) construct"
\ during this same pre-pass, which is real additional complexity left
\ for its own future iteration rather than risking this one.
\ ==================================================================

: OP-CHAR? ( c --- f )
  DUP 59 = IF DROP -1 EXIT THEN    ( ; )
  DUP 124 = IF DROP -1 EXIT THEN   ( | )
  DUP 38 = IF DROP -1 EXIT THEN    ( & )
  DUP 60 = IF DROP -1 EXIT THEN    ( < )
  DUP 62 = IF DROP -1 EXIT THEN    ( > )
  DROP 0 ;

: NORM-DOUBLED-OP? ( c --- f )  \ one of &, |, > - the three operator
                                  \ characters with a two-character
                                  \ doubled form (&&, ||, >>)
  DUP 38 = IF DROP -1 EXIT THEN
  DUP 124 = IF DROP -1 EXIT THEN
  62 = ;

512 CONSTANT NORM-MAX
CREATE NORM-BUF NORM-MAX ALLOT
VARIABLE NORM-LEN
VARIABLE NORM-I
VARIABLE NORM-U
VARIABLE NORM-IN-SQ?
VARIABLE NORM-IN-DQ?
VARIABLE NORM-C

: NORM-EMIT ( c --- )
  NORM-LEN @ NORM-MAX 1- < IF
    NORM-BUF NORM-LEN @ + C!
    NORM-LEN @ 1+ NORM-LEN !
  THEN ;

: NORM-PEEK ( offset --- c )  \ byte at LINE-BUF[NORM-I + offset], or
                                \ 0 if that would be beyond NORM-U
  NORM-I @ + DUP NORM-U @ < IF
    LINE-BUF SWAP + C@
  ELSE
    DROP 0
  THEN ;

: NORMALIZE-OPERATORS ( u --- u2 )  \ LINE-BUF holds u raw bytes;
                                      \ result (u2 bytes) is in
                                      \ NORM-BUF, not LINE-BUF itself -
                                      \ the caller copies it back.
  NORM-U !
  0 NORM-LEN !
  0 NORM-IN-SQ? !
  0 NORM-IN-DQ? !
  0 NORM-I !
  BEGIN NORM-I @ NORM-U @ < WHILE
    0 NORM-PEEK NORM-C !
    NORM-IN-SQ? @ IF
      NORM-C @ 39 = IF 0 NORM-IN-SQ? ! THEN
      NORM-C @ NORM-EMIT
      NORM-I @ 1+ NORM-I !
    ELSE NORM-IN-DQ? @ IF
      NORM-C @ 34 = IF 0 NORM-IN-DQ? ! THEN
      NORM-C @ NORM-EMIT
      NORM-I @ 1+ NORM-I !
    ELSE NORM-C @ 39 = IF
      -1 NORM-IN-SQ? !
      NORM-C @ NORM-EMIT
      NORM-I @ 1+ NORM-I !
    ELSE NORM-C @ 34 = IF
      -1 NORM-IN-DQ? !
      NORM-C @ NORM-EMIT
      NORM-I @ 1+ NORM-I !
    ELSE NORM-C @ 92 = IF
      ( a backslash outside quotes escapes the next character -
        copied verbatim, including if it happens to be an operator
        character, so it stays unspaced/literal like everywhere else
        this shell already treats a backslash-escaped char )
      NORM-C @ NORM-EMIT
      NORM-I @ 1+ NORM-I !
      NORM-I @ NORM-U @ < IF
        0 NORM-PEEK NORM-EMIT
        NORM-I @ 1+ NORM-I !
      THEN
    ELSE NORM-C @ OP-CHAR? IF
      32 NORM-EMIT
      NORM-C @ NORM-EMIT
      NORM-I @ 1+ NORM-I !
      NORM-C @ NORM-DOUBLED-OP? IF
        0 NORM-PEEK NORM-C @ = IF
          NORM-C @ NORM-EMIT
          NORM-I @ 1+ NORM-I !
        THEN
      THEN
      32 NORM-EMIT
    ELSE
      NORM-C @ NORM-EMIT
      NORM-I @ 1+ NORM-I !
    THEN THEN THEN THEN THEN THEN
  REPEAT
  NORM-LEN @ ;

: RUN-LINE ( u --- )  \ LINE-BUF already holds u bytes: tokenize, then
                        \ act on it via RUN-TOKENIZED.
                        \ Shared by the interactive loop (SH1) and -c
                        \ mode (SH-C) below, so both go through
                        \ identical logic. Note: redirection only
                        \ applies to external commands (see
                        \ APPLY-REDIRECTIONS) - "pwd > file" doesn't
                        \ redirect the builtin's own output in v0.2.
                        \ Also stashes a raw copy, same reason as
                        \ READ-LINE-INTO-ARGV above - taken *before*
                        \ operator normalization, so it holds the
                        \ line exactly as given, unmodified.
  DUP RAW-LINE-LEN !
  LINE-BUF RAW-LINE-BUF RAW-LINE-LEN @ MOVE
  NORMALIZE-OPERATORS
  DUP LINE-MAX < IF
    DUP NORM-BUF LINE-BUF ROT MOVE
    TOKENIZE
  ELSE
    ( normalized text wouldn't fit LINE-BUF - fall back to tokenizing
      the original, unmodified line: operators fused to adjacent text
      won't be recognized in this rare case, matching the pre-existing
      behavior rather than truncating or corrupting anything )
    DROP
    RAW-LINE-LEN @ TOKENIZE
  THEN
  RUN-TOKENIZED-CALL ;

: SH1 ( --- )  \ process one interactively-read line; returns either way
  SH-PROMPT
  LINE-BUF LINE-MAX ACCEPT
  CR
  RUN-LINE ;

: SH ( --- )
  BEGIN SH1 0 UNTIL ;

: SH-FILE ( c-addr --- )  \ c-addr: a NUL-terminated file path (from
                            \ SYS-ARG). Opens it read-only, runs each
                            \ line through RUN-LINE the same way SH1
                            \ does for one interactively-read line
                            \ (READ-LINE's own u2 lines up exactly with
                            \ what RUN-LINE expects), and exits with
                            \ the last command's status once EOF is
                            \ reached - matching `sh script.sh`. An
                            \ "exit" mid-script still exits immediately
                            \ via SYS-EXIT inside RUN-LINE's own
                            \ DISPATCH, same as everywhere else. No
                            \ error message on a missing/unreadable
                            \ file, just a nonzero exit status -
                            \ matching this shell's existing sparse
                            \ error handling elsewhere (see
                            \ APPLY-REDIRECTIONS).
  R/O OPEN-FOR 0= IF 127 SYS-EXIT THEN
  SHFILE-FID !
  -1 SHFILE-ACTIVE? !
  BEGIN
    LINE-BUF LINE-MAX SHFILE-FID @ READ-LINE DROP
  WHILE
    RUN-LINE
  REPEAT
  DROP
  SHFILE-FID @ CLOSE-FILE DROP
  LAST-STATUS @ SYS-EXIT ;

VARIABLE SHC-LEN

: SH-C ( c-addr --- )  \ c-addr: a NUL-terminated command string (from
                        \ SYS-ARG). Runs it once and exits with its status -
                        \ never returns. The same one logical line SH1
                        \ would read - ';'/'&&'/'||' chaining all work
                        \ (RUN-LINE/RUN-TOKENIZED handle those, not
                        \ TOKENIZE itself), but no if/while/for, which
                        \ need multiple lines.
  DUP CSTRLEN SHC-LEN !
  LINE-BUF SHC-LEN @ MOVE
  SHC-LEN @ RUN-LINE
  LAST-STATUS @ SYS-EXIT ;

: MAIN ( --- )  \ entry point once shell.4 is loaded: `relf kernel.img -c
                  \ "cmd"` (via SYS-ARGC/SYS-ARG, exposing relf's own argv
                  \ beyond the image path) runs one command non-interactively
                  \ and exits with its status - matching invoking any real
                  \ shell binary as `sh -c "cmd"`. `relf kernel.img
                  \ script.sh` (via relfsh) runs script.sh's contents line
                  \ by line and exits with the last command's status -
                  \ matching `sh script.sh` (see SH-FILE). Any further
                  \ arguments beyond the script path are currently ignored
                  \ (shell.4 has no positional-parameter support yet).
                  \ No args at all falls through to the ordinary
                  \ interactive loop.
  SYS-ARGC 2 = IF
    S" -c" 0 SYS-ARG STR0= IF
      1 SYS-ARG SH-C
    THEN
  THEN
  SYS-ARGC 0 > IF
    0 SYS-ARG SH-FILE
  THEN
  SH ;
