\ ==================================================================
\ Redirections on builtins and functions (Iteration 255)
\ ==================================================================
\ A builtin runs in the shell itself, so its redirections must be
\ undone afterwards - Ramey's "undo list". Until now they were parsed and
\ then ignored: `read x < file` read the shell's own input, `pwd > f`
\ wrote to the terminal, `f > out` for a function f likewise.
\
\ Each descriptor a redirection will replace is first copied to a spare
\ descriptor from UNDO-BASE up; afterwards every copy is put back, last
\ first, and closed. A copy that could not be made means the descriptor
\ was closed, so putting it back fails too, and the descriptor is closed
\ instead. The descriptor list is kept on the DATA stack, not in the
\ REDIR tables: a function's body parses its own redirections and
\ overwrites them, and a builtin leaves the stack as it found it.
\
\ The engine buffers terminal output, so it is flushed before descriptors
\ change hands in either direction - otherwise a builtin's output would
\ follow whichever descriptor 1 is when the buffer happens to fill.


: FLUSH-OUTPUT ( --- )   PAD 0 1 WRITE DROP ;   \ WRITE flushes first

: REDIRECT-SAVE ( --- fd0 .. fdn-1 n base )
  REDIR-N @ 0 ?DO  REDIR-FD I CELLS + @  LOOP
  REDIR-N @  UNDO-BASE @
  REDIR-N @ 0 ?DO  REDIR-FD I CELLS + @  OVER I + DUP2 DROP  LOOP
  DUP REDIR-N @ + UNDO-BASE ! ;

: REDIRECT-RESTORE ( fd0 .. fdn-1 n base --- )
  UNDO-BASE !
  BEGIN DUP WHILE
    1- SWAP                         ( .. i fd )
    OVER UNDO-BASE @ +              ( .. i fd copy )
    2DUP SWAP DUP2 IF               \ no copy: the descriptor was closed
      OVER CLOSE-FILE DROP
    THEN
    CLOSE-FILE DROP DROP            ( .. i )
  REPEAT DROP ;

: BEGIN-REDIRECT ( --- undo )
  0 HD-WRITER !
  REDIR-N @ IF FLUSH-OUTPUT REDIRECT-SAVE APPLY-REDIRECTIONS
  ELSE 0 0 0 REDIR-FAILED? ! THEN ;

: REDIRECT-FORGET ( fd0 .. fdn-1 n base --- )   \ keep them: close the copies
  UNDO-BASE !
  BEGIN DUP WHILE
    1- SWAP DROP
    DUP UNDO-BASE @ + CLOSE-FILE DROP
  REPEAT DROP ;

: END-REDIRECT ( undo --- )
  OVER IF
    FLUSH-OUTPUT
    KEEP-REDIRECTS? @ IF REDIRECT-FORGET ELSE REDIRECT-RESTORE THEN
  ELSE 2DROP THEN
  0 KEEP-REDIRECTS? !
  \ A here-document writer (a body over 4 KB) ends once the pipe's read
  \ end is closed, which the restore just did.
  HD-WRITER @ ?DUP IF WAITPID 2DROP 0 HD-WRITER ! THEN ;

VARIABLE EXEC-LAST?   \ see RUN-EXTERNAL

: SPECIAL-BUILTIN? ( c-addr --- f )
  \ XCU 2.14: the special builtins are found BEFORE functions and
  \ everything else after, so a function may override `true` but not
  \ `exit`. This shell looked up every builtin first, so no function
  \ could override one at all (Iteration 330).
  DUP CSTRLEN                                  ( a u )
  2DUP S" break"    STR= IF 2DROP -1 EXIT THEN
  2DUP S" :"        STR= IF 2DROP -1 EXIT THEN
  2DUP S" continue" STR= IF 2DROP -1 EXIT THEN
  2DUP S" ."        STR= IF 2DROP -1 EXIT THEN
  2DUP S" eval"     STR= IF 2DROP -1 EXIT THEN
  2DUP S" exec"     STR= IF 2DROP -1 EXIT THEN
  2DUP S" exit"     STR= IF 2DROP -1 EXIT THEN
  2DUP S" export"   STR= IF 2DROP -1 EXIT THEN
  2DUP S" readonly" STR= IF 2DROP -1 EXIT THEN
  2DUP S" return"   STR= IF 2DROP -1 EXIT THEN
  2DUP S" set"      STR= IF 2DROP -1 EXIT THEN
  2DUP S" shift"    STR= IF 2DROP -1 EXIT THEN
  2DUP S" times"    STR= IF 2DROP -1 EXIT THEN
  2DUP S" trap"     STR= IF 2DROP -1 EXIT THEN
  2DUP S" unset"    STR= IF 2DROP -1 EXIT THEN
  2DROP 0 ;

: RUN-A-BUILTIN ( xt --- )
  0 EXEC-LAST? !
  >R BEGIN-REDIRECT R>
  \ A redirection that fails on a SPECIAL builtin ends a non-interactive
  \ shell, like any other error in one (XCU 2.8.1): `: < /nonexistent`
  \ stops the script (Iteration 383). Everywhere else the status stays
  \ 1, which is bash's and what this project's cases compare against;
  \ dash reports 2, and POSIX asks only for non-zero.
  REDIR-FAILED? @ IF
    DROP
    ARGC @ 0 > IF ARGV @ SPECIAL-BUILTIN? ELSE 0 THEN IF
      2 SPECIAL-ERROR
    ELSE
      1 LAST-STATUS !
    THEN
  ELSE EXECUTE THEN
  END-REDIRECT ;

: RUN-A-FUNCTION ( i --- )
  0 EXEC-LAST? !
  >R BEGIN-REDIRECT R>
  REDIR-FAILED? @ IF DROP 1 LAST-STATUS ! ELSE RUN-FUNC-BODY-CALL THEN
  END-REDIRECT ;

: DISPATCH ( --- f )  \ f = -1 if handled here, 0 if not
  \ A quoted 'cd' is a literal argument, not the builtin - same
  \ reasoning as ARGV-QUOTED everywhere else. Builtins and functions are
  \ found whether or not the name was quoted or came from an expansion
  \ (`"echo" x`, `$cmd x`); reserved words are the parser's business
  \ since the command tree (Iteration 269).
  ARGC @ 0 = IF 0 EXIT THEN
  ARGV @ SPECIAL-BUILTIN? IF
    ARGV @ FIND-BUILTIN-CALL ?DUP IF RUN-A-BUILTIN -1 EXIT THEN
  THEN
  NO-FUNCTIONS? @ IF -1 ELSE ARGV @ FIND-FUNC THEN DUP -1 <> IF
    RUN-A-FUNCTION -1 EXIT
  THEN
  DROP
  ARGV @ FIND-BUILTIN-CALL ?DUP IF RUN-A-BUILTIN -1 EXIT THEN
  0 ;

\ ==================================================================
\ Main loop
\ ==================================================================

\ Exec without forking when nothing follows the command in this process
\ - dash's EV_EXIT (Iteration 269; DASH-COMPARISON.md): a pipeline stage's
\ or a subshell's only command, the last of a script. tree.4 decides; the
\ flag is set only once the words are expanded, and DISPATCH clears it
\ before a builtin or a function runs.

DEFER FG-STOPPED-CALL   ( pid --- )   \ the job table, defined below
VARIABLE FG-PID

: FOREGROUND-CHILD ( pid --- )
  \ Hands the terminal to the child's group, waits for it to finish or
  \ stop, and takes the terminal back. A stopped command becomes a job,
  \ reported as dash reports it (Iteration 321).
  DUP FG-PID !
  \ The parent sets it too, since either side may run first. Written
  \ `DUP 0 SWAP SETPGID` it read setpgid(0, child) - the SHELL joining
  \ the child's group, which is the opposite of the intent.
  DUP DUP SETPGID DROP                         ( pid )
  0 FG-PID @ TCSETPGRP DROP
  FG-PID @ WAIT-JOB                            ( pid' status )
  0 SHELL-PGID @ TCSETPGRP DROP
  OVER 0< IF 2DROP DROP 0 LAST-STATUS ! EXIT THEN
  DUP 127 AND 127 = IF                         \ stopped, not finished
    2DROP                                      ( pid )
    FG-STOPPED-CALL
  ELSE
    \ Killed by ^C or ^\ : the terminal echoed it, and dash starts the
    \ next prompt on a fresh line. The shell no longer sees the signal
    \ itself now that the job has its own process group (Iteration 322).
    DUP 127 AND DUP 2 = SWAP 3 = OR IF ERR-NL THEN
    NIP WAIT->STATUS LAST-STATUS !  DROP
  THEN ;

: RUN-EXTERNAL ( --- )
  ARGV @ DUP CSTRLEN HAS-SLASH? IF 0 ELSE ARGV @ LOCATE-COMMAND THEN CMD-RESOLVED !
  EXEC-LAST? @ IF
    0 EXEC-LAST? !
    APPLY-REDIRECTIONS
    REDIR-FAILED? @ IF 1 SYS-EXIT THEN
    RUN-CHILD 127 SYS-EXIT
  THEN
  FORK
  DUP 0 = IF
    DROP
    \ Job control: the command gets its own process group, so ^Z and ^C
    \ from the terminal reach it rather than the shell (Iteration 321).
    JOB-CONTROL? @ IF 0 0 SETPGID DROP CHILD-RESET-JOB-SIGNALS THEN
    APPLY-REDIRECTIONS
    REDIR-FAILED? @ IF 1 SYS-EXIT THEN
    RUN-CHILD 127 SYS-EXIT
  ELSE
    JOB-CONTROL? @ IF FOREGROUND-CHILD ELSE
      WAITPID DROP           ( raw wait status )
      WAIT->STATUS
      LAST-STATUS !
    THEN
  THEN ;

CREATE PS1-NM  CSTR," PS1"
CREATE PS2-NM  CSTR," PS2"
CREATE PS1-DEFAULT  CSTR," $ "   \ "$ "
CREATE PS2-DEFAULT  CSTR," > "   \ "> "

DEFER EXPAND-DQ-TEXT-CALL   ( c-addr u --- c-addr' u' )   \ tree.4

\ ---- bash's prompt escapes (Iteration 412) ----
\
\ A PS1 inherited from the environment is nearly always written for
\ bash - byobu exports one full of `\[\e[38;5;202m\]` and `\u@\h:\w` -
\ and printing it verbatim, as dash does, showed a line of escape codes
\ where a prompt should be. Iteration 389 decided to leave these alone
\ because dash does; a user looking at the result on an Ubuntu laptop
\ is the evidence that decided otherwise. POSIX specifies expansion of
\ PS1 and says nothing of backslashes, so decoding them breaks nothing
\ a conforming script can see. They are decoded BEFORE parameter
\ expansion, as bash does:
\
\   \u user  \h host  \H full host  \w cwd, ~ for HOME  \W its last part
\   \$ # for root, else $   \n \r \a \e \\   \nnn octal   \s the shell
\   \[ \] around bytes that take no room on screen
\
\ `\[` and `\]` decode to the bytes 1 and 2, which is readline's own
\ trick: they survive expansion, so the width can be measured on the
\ FINAL text, command substitutions and all, and then they are removed.
\ The editor needs that width to put the cursor in the right column.
\ Anything else after a backslash is left as it was. \! and \# (the
\ history number), a real effective-uid test for \$, and the time and
\ date escapes - from a clock primitive the engine gained for them - all
\ came in Iteration 417.

512 BUFFER: PD-BUF               \ the decoded prompt
VARIABLE PD-N
VARIABLE PD-SRC
VARIABLE PD-LEN
VARIABLE PD-I
VARIABLE PD-A
VARIABLE PD-U
VARIABLE PD-H
VARIABLE PD-HL
VARIABLE PD-J
VARIABLE PD-INV
VARIABLE PROMPT-WIDTH            \ columns the last prompt takes on screen
64 BUFFER: PD-HOST
VARIABLE PD-HOST#
CREATE PD-USER-NM  CSTR," USER"
CREATE PD-HOME-NM  CSTR," HOME"
CREATE PD-PWD-NM   CSTR," PWD"

: PD-C ( c --- )   PD-N @ 2 + ENSURE-BUFFER PD-BUF  PD-BUF PD-N @ + C!  1 PD-N +! ;
: PD-S ( c-addr u --- )   0 ?DO DUP I + C@ PD-C LOOP DROP ;
: PD-VAR ( name-cstr --- )   LOOKUP-VAR ?DUP IF DUP CSTRLEN PD-S THEN ;
: PD-NEXT ( --- c )   PD-SRC @ PD-I @ + C@  1 PD-I +! ;

: PD-HOSTNAME ( --- c-addr u )   \ the kernel's, read once
  PD-HOST# @ IF PD-HOST PD-HOST# @ EXIT THEN
  S" /proc/sys/kernel/hostname" R/O OPEN-FILE IF DROP PD-HOST 0 EXIT THEN
  >R  PD-HOST 63 R@ READ-FILE DROP  R> CLOSE-FILE DROP
  DUP IF DUP 1- PD-HOST + C@ 10 = IF 1- THEN THEN
  DUP PD-HOST# !  PD-HOST SWAP ;

: PD-SHORT ( c-addr u --- c-addr u' )   \ up to the first dot
  DUP 0 ?DO OVER I + C@ 46 = IF DROP I UNLOOP EXIT THEN LOOP ;

: PD-TILDE ( --- )   \ \w: PWD, with HOME shown as ~
  PD-PWD-NM LOOKUP-VAR ?DUP 0= IF EXIT THEN  DUP CSTRLEN PD-U !  PD-A !
  PD-HOME-NM LOOKUP-VAR ?DUP IF DUP CSTRLEN PD-HL !  PD-H ! ELSE 0 PD-HL ! THEN
  PD-HL @ IF PD-U @ PD-HL @ < 0= IF
    PD-A @ PD-HL @ PD-H @ PD-HL @ COMPARE 0= IF
      PD-U @ PD-HL @ =  PD-A @ PD-HL @ + C@ 47 =  OR IF
        126 PD-C  PD-A @ PD-HL @ +  PD-U @ PD-HL @ -  PD-S  EXIT
  THEN THEN THEN THEN
  PD-A @ PD-U @ PD-S ;

: PD-BASENAME ( --- )   \ \W: the last part of PWD, ~ for HOME
  PD-PWD-NM LOOKUP-VAR ?DUP 0= IF EXIT THEN  DUP CSTRLEN PD-U !  PD-A !
  PD-HOME-NM LOOKUP-VAR ?DUP IF
    DUP CSTRLEN PD-A @ PD-U @ COMPARE 0= IF 126 PD-C EXIT THEN
  THEN
  PD-U @ 1 = IF PD-A @ 1 PD-S EXIT THEN
  PD-U @ BEGIN DUP 0> WHILE
    DUP 1- PD-A @ + C@ 47 = IF PD-A @ OVER +  PD-U @ ROT -  PD-S EXIT THEN
    1-
  REPEAT
  DROP PD-A @ PD-U @ PD-S ;

: PD-OCTAL ( n --- )   \ \nnn: up to two more octal digits
  2 0 DO
    PD-I @ PD-LEN @ < IF
      PD-SRC @ PD-I @ + C@ DUP 48 56 WITHIN IF
        48 - SWAP 8 * +  1 PD-I +!
      ELSE DROP LEAVE THEN
    ELSE LEAVE THEN
  LOOP
  255 AND PD-C ;

VARIABLE PD-EUID                 \ the effective uid; -2 until read, -1 unknown
-2 PD-EUID !
2048 BUFFER: PD-STATUS           \ /proc/self/status, while it is read
VARIABLE PD-SN

: PD-NUMBER ( i --- i' n )   \ the decimal number at PD-STATUS + i, after blanks
  BEGIN DUP PD-SN @ < IF DUP PD-STATUS + C@ DUP 32 = SWAP 9 = OR ELSE 0 THEN WHILE 1+ REPEAT
  0 SWAP
  BEGIN DUP PD-SN @ < IF DUP PD-STATUS + C@ 48 58 WITHIN ELSE 0 THEN WHILE
    DUP PD-STATUS + C@ 48 -  ROT 10 * +  SWAP 1+
  REPEAT
  SWAP ;

: PD-READ-EUID ( --- uid )   \ the Uid: line's second field, or -1
  \ No engine primitive gives the effective uid, and $USER is only what
  \ someone set: `sudo -E` keeps it, `su` may not change it. Linux says
  \ what is true in /proc/self/status - "Uid:", then the real,
  \ EFFECTIVE, saved and filesystem uids - and the shell cannot change
  \ its own, so it is read once (Iteration 417).
  S" /proc/self/status" R/O OPEN-FILE IF DROP -1 EXIT THEN
  >R  PD-STATUS 2047 R@ READ-FILE DROP  PD-SN !  R> CLOSE-FILE DROP
  PD-SN @ 4 - 0 MAX 0 ?DO
    PD-STATUS I + 4 S" Uid:" COMPARE 0= IF
      I 4 + PD-NUMBER DROP  PD-NUMBER NIP  UNLOOP EXIT
    THEN
  LOOP
  -1 ;


: PD-DOLLAR ( --- )   \ \$: # for the superuser, else $
  PD-EUID @ -2 = IF PD-READ-EUID PD-EUID ! THEN
  PD-EUID @ 0< IF                        \ no /proc: $USER, as before
    PD-USER-NM LOOKUP-VAR ?DUP IF
      DUP CSTRLEN S" root" COMPARE 0= IF 35 ELSE 36 THEN
    ELSE 36 THEN PD-C EXIT
  THEN
  PD-EUID @ 0= IF 35 ELSE 36 THEN PD-C ;

\ \! and \#: the number the next history entry will have. The history
\ is in edit.4, loaded after this file, so it arrives through a DEFER;
\ the 0 pushed before the call is what an unpatched one leaves.
DEFER HIST-NEXT-CALL                \ ( 0 --- n )

: PD-HISTNUM ( --- )   0 HIST-NEXT-CALL N>STR DUP CSTRLEN PD-S ;

\ The time and date escapes, from the engine's LOCAL-TIME (Iteration 417):
\   \t 13:05:09   \T 01:05:09   \@ 01:05 PM   \A 13:05   \d Mon Sep 21
7 CELLS BUFFER: PD-TM            \ sec min hour mday mon year wday

: PD-NOW ( --- )   LOCAL-TIME  7 0 DO  PD-TM 6 I - CELLS + !  LOOP ;
: PD-TM@ ( i --- n )   CELLS PD-TM + @ ;
: PD-2D ( n --- )   DUP 10 < IF 48 PD-C THEN N>STR DUP CSTRLEN PD-S ;
: PD-12 ( hour --- hour' )   12 MOD ?DUP 0= IF 12 THEN ;
: PD-HM ( hour --- )   PD-2D 58 PD-C 1 PD-TM@ PD-2D ;

: PD-TIME ( c --- )   \ one of t T @ A d
  PD-NOW
  DUP 116 = IF DROP 2 PD-TM@ PD-HM 58 PD-C 0 PD-TM@ PD-2D EXIT THEN        \ t
  DUP 84  = IF DROP 2 PD-TM@ PD-12 PD-HM 58 PD-C 0 PD-TM@ PD-2D EXIT THEN  \ T
  DUP 64  = IF DROP 2 PD-TM@ PD-12 PD-HM 32 PD-C
               2 PD-TM@ 12 < IF S" AM" ELSE S" PM" THEN PD-S EXIT THEN     \ @
  DUP 65  = IF DROP 2 PD-TM@ PD-HM EXIT THEN                                \ A
  DROP                                                                       \ d
  S" SunMonTueWedThuFriSat" DROP 6 PD-TM@ 3 * + 3 PD-S  32 PD-C
  S" JanFebMarAprMayJunJulAugSepOctNovDec" DROP 4 PD-TM@ 3 * + 3 PD-S  32 PD-C
  3 PD-TM@ PD-2D ;

: PD-ESCAPE ( c --- )   \ the character after a backslash
  DUP 117 = IF DROP PD-USER-NM PD-VAR EXIT THEN            \ u
  DUP 104 = IF DROP PD-HOSTNAME PD-SHORT PD-S EXIT THEN    \ h
  DUP 72  = IF DROP PD-HOSTNAME PD-S EXIT THEN             \ H
  DUP 119 = IF DROP PD-TILDE EXIT THEN                     \ w
  DUP 87  = IF DROP PD-BASENAME EXIT THEN                  \ W
  DUP 36  = IF DROP PD-DOLLAR EXIT THEN                    \ $
  DUP 110 = IF DROP 10 PD-C EXIT THEN                      \ n
  DUP 114 = IF DROP 13 PD-C EXIT THEN                      \ r
  DUP 97  = IF DROP 7 PD-C EXIT THEN                       \ a
  DUP 101 = IF DROP 27 PD-C EXIT THEN                      \ e
  DUP 92  = IF DROP 92 PD-C EXIT THEN                      \ backslash
  DUP 91  = IF DROP 1 PD-C EXIT THEN                       \ [ : takes no room
  DUP 93  = IF DROP 2 PD-C EXIT THEN                       \ ] : ... to here
  DUP 115 = IF DROP S" relfsh" PD-S EXIT THEN              \ s
  DUP 116 = OVER 84 = OR OVER 64 = OR OVER 65 = OR OVER 100 = OR
    IF PD-TIME EXIT THEN                                   \ t T @ A d
  DUP 33  = IF DROP PD-HISTNUM EXIT THEN                   \ ! history number
  DUP 35  = IF DROP PD-HISTNUM EXIT THEN                   \ # command number
  DUP 48 56 WITHIN IF 48 - PD-OCTAL EXIT THEN              \ nnn
  92 PD-C PD-C ;                                           \ anything else, as it was

: PROMPT-DECODE ( c-addr u --- c-addr' u' )
  PD-LEN !  PD-SRC !  0 PD-N !  0 PD-I !
  BEGIN PD-I @ PD-LEN @ < WHILE
    PD-NEXT DUP 92 = IF
      DROP PD-I @ PD-LEN @ < IF PD-NEXT PD-ESCAPE ELSE 92 PD-C THEN
    ELSE
      PD-C
    THEN
  REPEAT
  PD-BUF PD-N @ ;

: PROMPT-VISIBLE ( c-addr u --- c-addr u' )   \ markers out, width measured
  \ In place: the text only ever shrinks. A UTF-8 continuation byte
  \ takes no column of its own, and a newline starts the count again,
  \ since the cursor arithmetic is about the LAST line of the prompt.
  0 PROMPT-WIDTH !  0 PD-J !  0 PD-INV !
  OVER SWAP 0 ?DO
    DUP I + C@
    DUP 1 = IF DROP -1 PD-INV ! ELSE
    DUP 2 = IF DROP 0 PD-INV ! ELSE
      DUP 10 = IF 0 PROMPT-WIDTH ! ELSE
        PD-INV @ 0= IF DUP 192 AND 128 <> IF 1 PROMPT-WIDTH +! THEN THEN
      THEN
      OVER PD-J @ + C!  1 PD-J +!
    THEN THEN
  LOOP
  DROP PD-J @ ;

: PROMPT-STRING ( name-cstr default --- c-addr u )
  \ Decoded, expanded - parameters, command substitutions and
  \ arithmetic, as XCU 2.5.3 says of PS1, PS2 and PS4 (Iteration 389) -
  \ and measured.
  SWAP LOOKUP-VAR ?DUP IF NIP THEN         ( addr )
  DUP CSTRLEN
  PROMPT-DECODE
  EXPAND-DQ-TEXT-CALL
  PROMPT-VISIBLE ;

256 BUFFER: PS2-TEXT      \ PS2, already expanded
VARIABLE PS2-TEXT#

: SH-PROMPT ( --- )
  \ $PS1, or "$ ". To fd 2, not stdout: every reference shell writes its
  \ prompt to stderr, and `... | relfsh` otherwise had the prompt
  \ interleaved into the shell's own output. PS1 was ignored entirely
  \ until Iteration 302 - the prompt was always "$ ".
  PS1-NM PS1-DEFAULT PROMPT-STRING ERR-TYPE
  \ PS2 is expanded HERE, at the start of a command, and kept: a
  \ continuation prompt is written in the middle of a parse, and the
  \ expander builds a word in the tree the parser is still filling.
  \ Expanding it a moment early costs a `$(date)` in a PS2 its freshness
  \ and costs the parse nothing (Iteration 389).
  PS2-NM PS2-DEFAULT PROMPT-STRING              ( a u )
  DUP 255 MIN DUP PS2-TEXT# !                   ( a u n )
  >R DROP PS2-TEXT R@ MOVE R> DROP ;

: SH-PROMPT2 ( --- )   \ $PS2, or "> ", for a line that continues one
  PS2-TEXT PS2-TEXT# @ ERR-TYPE ;


\ ==================================================================
\ Pipes: a single "cmd1 | cmd2" per line
\ Split off into its own pass, run *before* redirection parsing, and
\ deliberately mutually exclusive with it for v0.2: if a line has a
\ "|", redirection syntax on either side is left untouched (passed
\ through as a literal argument) rather than risked - combining the
\ two correctly (figuring out which side a "<"/">" belongs to) is
\ real complexity better tackled once each piece is independently
\ solid, not solved speculatively alongside the first pipe support.
\ Builtins aren't supported on either side of a pipe in v0.2 either -
\ both sides always run via RUN-CHILD (PATH search + exec), reusing
\ that already-proven logic unchanged by copying each side's own argv
\ into the *global* ARGV/ARGC from within that side's own forked
\ child - safe, since fork() gives each child an independent copy of
\ all memory, so overwriting ARGV there can't affect the parent or
\ the other child.
\ ==================================================================

\ How many '('/'{' are open at the scan position. Every operator scan
\ below (';', '&&', '||', '|') only recognises its operator at depth
\ 0, so a group used as an ordinary command keeps its own separators
\ to itself: "{ a; b; } && c" splits at the '&&', not at either ';'.
\ Bash gets this from a real grammar; this is the flat-token-array
\ equivalent - see GOALS.md's notes on Ramey's bash chapter.

\ ==================================================================
\ ';' - multiple commands per line, run in sequence regardless of
\ each one's own exit status (unlike '&&'/'||', not yet implemented).
\ Same whitespace-delimited-token convention as '|' below (';' only
\ acts as a separator when it's its own token - "a;b" is one literal
\ argument, same as "a|b" already is). Splits off *only* the first
\ ';' each call, leaving everything after it (which may itself
\ contain further ';'s) in ARGV-SEMI-REST for RUN-TOKENIZED to feed
\ back through this same logic on its next call - see RUN-TOKENIZED
\ for how the two pieces get run in turn.
\ ==================================================================

\ ==================================================================
\ Moved ahead of RUN-PIPELINE and RUN-SIMPLE-OR-PIPELINE, both of
\ which now recognise a group as an ordinary command (Iteration 49).
\ ==================================================================

                                \ that and MG-SUB? exist, far below.

1 CELLS ARGS-BUFFER: PIPE-PIDS

\ ------------------------------------------------------------------
\ A compound command as the last pipeline stage
\ ------------------------------------------------------------------
\ "printf ... | while read line; do ... done".
\
\ The whole difficulty is buffer lifetime: capturing the body READS
\ LINES, and reading a line overwrites both RAW-LINE-BUF and LINE-BUF
\ - and SPLIT-PIPE's PIPE-ARGV entries are pointers INTO LINE-BUF. So
\ the capture cannot happen after the split (Iteration 79), and the
\ raw text has to be preserved across it too (Iteration 78).
\
\ The order that works: save the raw line, capture the body (freely
\ clobbering everything), restore the line, derive the stage's own raw
\ text, then re-tokenize and let SPLIT-PIPE run on a line that is
\ intact again. All of it in the parent, before any fork - a forked
\ child shares the script's file offset and would race for the body
\ lines (Iteration 57).

\ ==================================================================
\ '&&'/'||' - a pipeline runs only if the operator connecting it to
\ the previous one permits it, based on the previous pipeline's own
\ exit status: '&&' requires success (0), '||' requires failure
\ (nonzero). Left-associative, evaluated left to right, same
\ precedence for both (POSIX gives them equal, left-to-right
\ precedence, tighter than ';' but looser than '|' - RUN-TOKENIZED
\ calls SPLIT-ANDOR only after ';' and the assignment-word check have
\ already ruled themselves out, and RUN-SIMPLE-OR-PIPELINE below,
\ which SPLIT-PIPE's own '|' handling lives inside of, is what each
\ &&/||-separated piece is run through). Same whitespace-delimited-
\ token convention '|'/';' already have - a quoted '&&' or '||' is a
\ literal argument, not an operator (AT-AND?/AT-OR? both check
\ ARGV-QUOTED@, same as AT-PIPE?/AT-SEMI?).
\ ==================================================================

DEFER TRY-ASSIGNMENT-CALL   \ patched to TRY-ASSIGNMENT's own xt right
                               \ after it's defined, further down (the
                               \ same deferred-word pattern already
                               \ used for RUN-TOKENIZED-CALL) - needed
                               \ since RUN-SIMPLE-OR-PIPELINE is
                               \ defined long before ASSIGNMENT-EQPOS/
                               \ DO-ASSIGN are. A standalone assignment
                               \ has to be checked *here*, not only in
                               \ RUN-TOKENIZED's own fall-through,
                               \ since RUN-AND-OR-CHAIN calls this word
                               \ directly for each &&/||-separated
                               \ piece, bypassing RUN-TOKENIZED's own
                               \ checks entirely - found as a real bug
                               \ by testing directly: "x=hello &&
                               \ echo $x" silently failed, since
                               \ "x=hello" was never recognized as an
                               \ assignment at all inside the chain,
                               \ just path-searched as a literal,
                               \ failing command name.

\ Moved ahead of RUN-SIMPLE-OR-PIPELINE, which now uses both for
\ pipeline negation ( ! cmd ).

\ ==================================================================
\ Assignment words (Iteration 256)
\ ==================================================================
\ A line of nothing but NAME=value words sets them all; NAME=value words
\ in front of a command set them for that command only - exported, so
\ an external command sees them, and put back afterwards (XCU 2.9.1).
\ Until now only a lone assignment worked, and `FOO=x cmd` was "FOO=x:
\ command not found". The old values are kept in a heap record whose
\ address stays on the data stack while the command runs, as the
\ redirection undo list does. Assignments to special builtins persist
\ in POSIX; here every prefix is temporary.

: ASSIGN-WORD? ( i --- eqpos | -1 )
  DUP ARGV-NAME-QUOTED@ IF DROP -1 EXIT THEN
  ARGV@ ASSIGNMENT-EQPOS ;

: PREFIX-COUNT ( --- k )   \ how many leading words are NAME=value
  0 BEGIN DUP ARGC @ < IF DUP ASSIGN-WORD? -1 <> ELSE 0 THEN WHILE 1+ REPEAT ;

: STRDUP ( c-addr --- a )  \ a heap copy of a NUL-terminated string
  DUP CSTRLEN 1+ DUP ALLOCATE ABORT" shell: out of memory"
  DUP >R SWAP MOVE R> ;

VARIABLE TA-K
VARIABLE TA-REC
VARIABLE TA-I
VARIABLE TA-E

: TA-FIELD ( i n --- a )   \ field n of entry i: name, old value, had?, old env
  SWAP 4 * + 1+ CELLS TA-REC @ + ;

: TEMP-ASSIGN ( k --- record )
  SHADOW{ TA-K | TA-REC TA-I TA-E }
  TA-K @ 4 * 1+ CELLS ALLOCATE ABORT" shell: out of memory" TA-REC !
  TA-K @ TA-REC @ !
  BEGIN TA-I @ TA-K @ < WHILE
    TA-I @ ARGV@ TA-I @ ASSIGN-WORD? SPLIT-ASSIGN-AT
    ASSIGN-NAME-BUF STRDUP                TA-I @ 0 TA-FIELD !
    ASSIGN-NAME-BUF GET-SHVAR ?DUP IF
      STRDUP TA-I @ 1 TA-FIELD !  -1 TA-I @ 2 TA-FIELD !
    ELSE
      0 TA-I @ 1 TA-FIELD !  0 TA-I @ 2 TA-FIELD !
    THEN
    ASSIGN-NAME-BUF GETENV ?DUP IF STRDUP ELSE 0 THEN TA-I @ 3 TA-FIELD !
    ASSIGN-NAME-BUF ASSIGN-VALUE-BUF SET-SHVAR
    ASSIGN-VALUE-BUF ASSIGN-NAME-BUF SETENV DROP
    TA-I @ 1+ TA-I !
  REPEAT
  \ The command is what follows the assignments.
  0 TA-I !
  BEGIN TA-I @ TA-K @ + ARGC @ < WHILE
    TA-I @ TA-K @ + ARGV@            ARGV TA-I @ CELLS + !
    TA-I @ TA-K @ + ARGV-QUOTED@     ARGV-QUOTED TA-I @ + C!
    TA-I @ TA-K @ + ARGV-NAME-QUOTED@ ARGV-NAME-QUOTED TA-I @ + C!
    TA-I @ 1+ TA-I !
  REPEAT
  ARGC @ TA-K @ - ARGC !
  0 ARGV ARGC @ CELLS + !
  TA-REC @ ;

: TEMP-RESTORE ( record --- )
  SHADOW{ TA-REC | TA-I TA-K }
  TA-REC @ @ TA-I !
  BEGIN TA-I @ WHILE
    TA-I @ 1- TA-I !
    TA-I @ 2 TA-FIELD @ IF
      TA-I @ 0 TA-FIELD @  TA-I @ 1 TA-FIELD @  SET-SHVAR
    ELSE
      TA-I @ 0 TA-FIELD @ REMOVE-SHVAR
    THEN
    TA-I @ 3 TA-FIELD @ ?DUP IF
      TA-I @ 0 TA-FIELD @ SETENV DROP
    ELSE
      TA-I @ 0 TA-FIELD @ UNSETENV DROP
    THEN
    TA-I @ 0 TA-FIELD @ FREE DROP
    TA-I @ 1 TA-FIELD @ ?DUP IF FREE DROP THEN
    TA-I @ 3 TA-FIELD @ ?DUP IF FREE DROP THEN
  REPEAT
  TA-REC @ FREE DROP ;

VARIABLE REDIRS-PARSED?   \ EXPAND-AND-RUN already took them out of ARGV
VARIABLE NO-REDIRS?   \ set by tree.4 for a simple command without redirections

CREATE PS4-DEFAULT  CSTR," + "   \ "+ "
CREATE PS4-NM       CSTR," PS4"

512 BUFFER: PS4-TEXT             \ PS4, expanded before the command's own words
VARIABLE XTRACE-IN-PS4?          \ PS4 is being expanded: trace nothing
VARIABLE PS4-TEXT#

: XTRACE-PREPARE ( --- )   \ at the start of a simple command
  \ PS4 is expanded HERE, before the command's words are, and kept.
  \ Iteration 391 expanded it inside XTRACE-ARGV and said expanding it
  \ there "disturbs nothing" - but the command's words are in the
  \ expansion buffers at that point, and any PS4 holding an expansion,
  \ even `[$foo]`, crashed `set -x` on the next command. 391's test
  \ assigned PS4 in double quotes, so the stored value had no `$` left.
  \ Found by tools/crashfuzz.py (Iteration 421). Here, expanding is
  \ exactly as safe as the command's own expansion, which comes next.
  \ And not re-entered: a command substitution in PS4 runs a simple
  \ command, which would prepare PS4 again, and again - `PS4='+ $(echo
  \ L): '` overflowed the return stack. The commands PS4 itself runs are
  \ not traced, as in bash; the subshell inherits the flag.
  OPT-XTRACE @ 0= IF EXIT THEN
  XTRACE-IN-PS4? @ IF EXIT THEN
  -1 XTRACE-IN-PS4? !
  PS4-NM PS4-DEFAULT PROMPT-STRING
  DUP 1+ ENSURE-BUFFER PS4-TEXT
  DUP PS4-TEXT# !  PS4-TEXT SWAP MOVE
  0 XTRACE-IN-PS4? ! ;

: XTRACE-ARGV ( --- )   \ set -x: the command, expanded, on stderr
  OPT-XTRACE @ 0= IF EXIT THEN
  XTRACE-IN-PS4? @ IF EXIT THEN
  \ $PS4, expanded, or "+ " - a prompt like the others (XCU 2.5.3;
  \ Iteration 391), expanded by XTRACE-PREPARE before the words were.
  PS4-TEXT PS4-TEXT# @ ERR-TYPE
  ARGC @ 0 ?DO
    I IF S"  " ERR-TYPE THEN
    I ARGV@ ERR-CSTR
  LOOP ERR-NL ;

' DROP-ARGV0 IS DROP-ARGV0-CALL
' DISPATCH IS DISPATCH-CALL
' RUN-EXTERNAL IS RUN-EXTERNAL-CALL

VARIABLE ASSIGNED-HERE?   \ this command's assignments were permanent
VARIABLE RE-PREFIX        \ how many assignment prefixes it had

: APPLY-BARE-REDIRS ( --- )
  \ The redirections of a command that never reaches RUN-EXPANDED: one
  \ that was assignments only, or whose words all expanded away. They
  \ are parsed out of ARGV before the prefix is counted (Iteration 385),
  \ so the paths that return early have to perform them themselves.
  REDIR-N @ 0 > IF
    BEGIN-REDIRECT
    REDIR-FAILED? @ IF 1 LAST-STATUS ! THEN
    END-REDIRECT
  THEN ;

: RUN-EXPANDED ( --- )   \ the command in ARGV, its words already expanded
  \ A simple command from the tree has no pipes (Iteration 265), and the
  \ tree says whether it has redirections at all (Iteration 266).
  REDIRS-PARSED? @ 0= IF
    NO-REDIRS? @ IF 0 REDIR-N ! ELSE PARSE-REDIRECTIONS THEN
  THEN
  0 REDIRS-PARSED? !
  XTRACE-ARGV
  ARGC @ 0 > IF
    \ Assignments with a redirection beside them: the test in
    \ EXPAND-AND-RUN runs before the redirection words are taken out of
    \ ARGV, so `> f var=ok` and `var=ok > f` both missed it - the first
    \ ran the assignment as a command, the second lost it
    \ (Iteration 349).
    PREFIX-COUNT ARGC @ = IF
      REDIR-N @ 0 > IF
        BEGIN-REDIRECT
        REDIR-FAILED? @ IF 1 LAST-STATUS ! END-REDIRECT EXIT THEN
        END-REDIRECT
      THEN
      TRY-ASSIGNMENT-CALL DROP
      -1 ASSIGNED-HERE? !                    \ do not restore them afterwards
      EXIT
    THEN
    DISPATCH 0= IF RUN-EXTERNAL THEN
  ELSE
    \ A command that is only redirections still performs them - `> f`
    \ creates or truncates f - and yields 0 (XCU 2.9.1). This shell did
    \ nothing at all with such a command until Iteration 334.
    REDIR-N @ 0 > IF
      BEGIN-REDIRECT
      REDIR-FAILED? @ IF 1 ELSE 0 THEN LAST-STATUS !
      END-REDIRECT
    THEN
    \ `var=ok > f` leaves no words at all once the redirection is taken
    \ out, and its assignment is the shell's own: the caller applied it
    \ already, so it just must not be restored (Iteration 349).
    RE-PREFIX @ 0 > IF -1 ASSIGNED-HERE? ! THEN

  THEN ;

\ ==================================================================
\ Control structures: if/then/else/fi
\ Deliberately minimal for v0.5: no nesting support (a body containing
\ another if will misbehave - see PROGRESS.md), and then/else/fi must
\ each be alone on their own line (no ";"-separated forms, since there
\ is no ";" support at all yet). The condition is whatever follows
\ "if" on the same line - run via the normal command path, including
\ its own pipe/redirection handling. then/else bodies are read one
\ line at a time directly from stdin and executed immediately as
\ they're read, not buffered and re-scanned - this works for if
\ precisely because each body line only ever needs running once,
\ unlike a loop body (which is why while/for aren't attempted here -
\ they'd need a genuinely different, buffer-and-replay approach).
\
\ RUN-TOKENIZED (below) needs to detect "if" and hand off to DO-IF,
\ but DO-IF needs to run its own body lines through the same "act on
\ tokenized ARGV" logic RUN-TOKENIZED provides - a genuine mutual
\ dependency. Broken via a small deferred-word indirection
\ (RUN-TOKENIZED-CALL, patched to RUN-TOKENIZED's own execution token
\ once that word is defined below) rather than trying to reorder
\ around it.
\ ==================================================================

\ ==================================================================
\ '( list )' subshells and '{ list ; }' brace groups. Both require
\ whitespace around '(', ')', '{', '}' (this shell's established
\ convention for every operator so far - '|', ';', '&&', '||' all
\ need it too - though real POSIX shells don't require it around '('
\ specifically; a real gap against mrsh's own tests, which write
\ "(cmd)" with no spaces, but a deliberate, consistent scope choice
\ here rather than a special-cased tokenizer change). A subshell
\ forks: the body runs in a child process, so cd/variable/export
\ changes inside it don't affect this shell, and the parent takes the
\ child's exit status as its own (same FORK/WAITPID shape
\ RUN-PIPELINE already uses). A brace group runs its body directly in
\ this shell instead - no fork - so changes inside it persist
\ afterward, which is the entire reason it exists as a distinct
\ construct from a subshell. Neither supports nesting (a body
\ containing another '(' or '{' will misbehave - the same "no nesting"
\ scope limit if/while already have, and for the same reason: this
\ shell doesn't yet have real per-invocation state for control
\ structures, only shared globals). Detected by ARGV[0] alone (reusing
\ LINE-IS?, exactly as if/while already are) - this check runs *before*
\ ';'/'&&'/'||' splitting, since a group's own ';'/'&&'/'||' (used
\ inside its body) must stay scoped to that body rather than being
\ split as if it belonged to the outer line.
\ ==================================================================

\ ==================================================================
\ Shell-local variable assignment: a standalone "NAME=value" line
\ (the *entire* line - not a command with an assignment-looking
\ argument, and not "NAME=value command args..." either, which POSIX
\ treats as a *temporary* assignment scoped to just that one command's
\ execution - not implemented yet, a real, deliberate scope limit for
\ now) sets a shell-local variable via SET-SHVAR rather than being
\ looked up as a command name.
\ ==================================================================

: TRY-ASSIGNMENT ( --- f )  \ f = -1 if ARGV was a standalone
                              \ "NAME=value" assignment word (already
                              \ handled via DO-ASSIGN by the time this
                              \ returns), 0 otherwise (ARGV untouched).
  \ Checks ARGV-NAME-QUOTED, not ARGV-QUOTED - the latter records
  \ whether *any part* of the token was quoted, not whether the name
  \ portion specifically was, so x="value" (a very common, valid
  \ assignment - only the value is quoted) would otherwise be wrongly
  \ rejected just because SOME part of the token happened to go
  \ through a quote. A real, pre-existing bug found while testing IFS
  \ field splitting with a quoted, multi-word assignment value, but
  \ present already in the last committed version too, unrelated to
  \ that feature itself.
  \ Every word an assignment: set them all (Iteration 256; one only,
  \ before). A command after them is RUN-SIMPLE-OR-PIPELINE's business.
  PREFIX-COUNT DUP 0= OVER ARGC @ <> OR IF DROP 0 EXIT THEN
  SUPPRESS-EXEC? @ IF DROP -1 EXIT THEN
  0 VALUE-FAILED? !
  0 ?DO I ARGV@ I ASSIGN-WORD? DO-ASSIGN-AT LOOP
  VALUE-FAILED? @ IF 2 ELSE 0 THEN LAST-STATUS !
  -1 ;
' ASSIGNMENT-EQPOS IS EQPOS-CALL
' SPLIT-ASSIGN-AT IS SPLIT-ASSIGN-CALL
' STRDUP IS STRDUP-CALL
: EWA-NAME-BUF  ( --- c-addr )  ASSIGN-NAME-BUF ;
: EWA-VALUE-BUF ( --- c-addr )  ASSIGN-VALUE-BUF ;
' EWA-NAME-BUF IS NAME-BUF-CALL
' EWA-VALUE-BUF IS VALUE-BUF-CALL
' TRY-ASSIGNMENT IS TRY-ASSIGNMENT-CALL

                            \ READ-NEXT-INPUT-LINE below knows to read
                            \ from SHFILE-FID rather than the real
                            \ process stdin - if/while's own internal
                            \ body-line reading (READ-LINE-INTO-ARGV)
                            \ goes through that same word, so this is
                            \ what makes if/while work at all when a
                            \ script is run via `relfsh script.sh`
                            \ rather than piped into stdin - found and
                            \ fixed as a real, pre-existing bug:
                            \ without this, DO-IF/DO-WHILE always read
                            \ from the real stdin regardless of where
                            \ the script actually came from, so "if"'s
                            \ own "then"/body/"fi" lines were never
                            \ seen at all when invoked this way, and
                            \ the whole command was silently a no-op.

\ ==================================================================
\ Replaying a stored body as an INPUT SOURCE
\ ==================================================================
\ A while/for body and a function body are both stored as raw,
\ NUL-separated lines and replayed later. Replay used to dispatch each
\ stored line directly (RUN-STORED-LINE), which meant a nested
\ multi-line construct inside such a body did not work at all: DO-IF's
\ own search for "then"/"fi" reads a NEW line, and that read went to
\ the real process input rather than to the next stored line. So the
\ nested if's body ran unconditionally and its "fi" was never seen -
\ the limitation carried since Iteration 23 and since noted against
\ three separate features.
\
\ The fix is to make replay a third INPUT SOURCE, alongside the real
\ stdin and an open script file, rather than a separate dispatch path.
\ Everything that reads a line already funnels through
\ READ-NEXT-INPUT-LINE, so once replay is one of its cases, every
\ construct nested inside a body reads from the body automatically,
\ with no construct needing to know about replay at all.
\
\ REPLAY-SRC/LEN/POS are declared as locals by each replaying word, so
\ replays nest: an inner body's replay saves and restores the outer
\ one's position, and a construct that CAPTURES lines while a replay
\ is active (a nested while reading its own body, say) consumes them
\ from the outer body and leaves the position correctly advanced.

\ (INPUT-EOF? is declared with the line readers, near the top of the file.)
\ True when the current input source has genuinely run out, as opposed
\ to having produced an empty line - the two are reported identically
\ by READ-NEXT-INPUT-LINE's own u2, which is why every capture loop in
\ this file used to spin forever on an unterminated construct rather
\ than diagnosing one (Iteration 107).
\
\ Only the two sources that can actually tell set it: a replay knows
\ its own length, and READ-LINE returns a flag. ACCEPT cannot
\ distinguish them, so the interactive path is left alone - a real
\ shell prompts for continuation there indefinitely too.

\ ==================================================================
\ Operator normalization: ';', '|', '&', '<', '>' (and their doubled
\ forms '&&', '||', '>>') are, in real POSIX shells, self-delimiting
\ operator characters - "true;echo" and "a>file" parse correctly with
\ no whitespace needed around the operator at all. Every operator
\ this shell has implemented so far (Iterations 7, 18, 19) instead
\ took the shortcut of requiring surrounding whitespace, a deliberate,
\ consistently-documented scope limit - but re-reading mrsh's own test
\ files directly showed this blocking real progress: "if true; then",
\ "( echo hi )" written as "(echo hi)", and similar fused-operator
\ style are the norm in real scripts, not the exception.
\
\ Rather than rewrite SCAN-TOKEN/TOKENIZE's own in-place compaction
\ logic to recognize operators mid-scan (which turned out to risk a
\ real hazard: an unquoted word's NUL-termination write lands exactly
\ where a following fused operator character would sit, destroying it
\ before it could ever be read as its own token), this runs as a
\ pre-pass over the raw line text, inserting a literal space before
\ and after every *unquoted* operator character found (tracking
\ single/double quote state so an operator character *inside* a quote
\ is left untouched - quoted operators are literal text, not
\ operators, matching real shells) - "true;echo" becomes "true ; echo"
\ before TOKENIZE (entirely unmodified) ever sees it. Re-normalizing
\ an already-spaced-out operator is harmless (just adds a redundant
\ extra space either side, which SKIP-WS already tolerates fine) -
\ relevant since a while loop's condition gets re-tokenized fresh every
\ iteration, and would otherwise go through this twice.
\
\ Deliberately out of scope for now: '(', ')', '{', '}'. Unlike the
\ five operators above, blindly spacing every unquoted paren/brace
\ would break $(...) command substitution outright - EXPAND-VAR's own
\ detection needs "$(" with no space in between - and doing this
\ correctly needs tracking "am I currently inside a $(...) construct"
\ during this same pre-pass, which is real additional complexity left
\ for its own future iteration rather than risking this one.
\ ==================================================================

                            \ within the arithmetic expression itself,
                            \ so a nested "(...)" inside it isn't
                            \ mistaken for the expansion's own closing
                            \ "))" - mirrors EXPAND-ARITH's own,
                            \ separate depth tracking exactly, since
                            \ this is the same problem solved once
                            \ more, earlier in the pipeline.

\ Moved down here in Iteration 105: it now installs the substituted
\ text as a replay input source and reads it through
\ READ-LINE-INTO-ARGV, so it must come after that word and after the
\ REPLAY-*/SHFILE-ACTIVE? declarations. Reaching it from
\ EXPAND-CMDSUB, far above, is what RUN-CMDSUB-CHILD-CALL is for.

\ ==================================================================
\ Same-line 'then'/'fi'/'else' continuation: "if true; then echo hi;
\ fi" all on one line now tokenizes correctly (';' has been a
\ self-delimiting operator since Iteration 24), but DO-IF still needs
\ its own redesign to actually look for "then"/"fi"/"else" in the
\ *remainder of the current line* before falling back to reading a
\ whole new one - getting the tokenization right was necessary but
\ not sufficient, and this is that redesign, for "if" only (while/for
\ still require "do" on its own separate line - left for their own
\ future work, given the added complexity of also needing this for
\ their own body-replay buffers).
\
\ SPLIT-AT-KEYWORD scans the *global* ARGV for the first unquoted
\ token matching a given keyword ("then", "else", or "fi") - if found,
\ ARGV/ARGC are truncated to just what came before it (the "before"
\ content, e.g. the condition, or a body line - may be empty), and
\ everything after the keyword becomes the new PENDING-REMAINDER for
\ READ-NEXT-LOGICAL-LINE to pick up next, rather than reading an
\ actual new line of input. If not found, ARGV/ARGC are left
\ completely untouched and no pending remainder is set - DO-IF then
\ falls back to READ-LINE-INTO-ARGV exactly as before, so "then"/
\ "else"/"fi" on their own separate line still works exactly as it
\ always has.
\
\ Content after the *final* "fi" on the same line (e.g.
\ "if x; then y; fi; z") is a documented, deliberate scope limit: "z"
\ is silently dropped rather than handed back to whatever called
\ DO-IF - preserving it correctly would mean propagating a pending
\ remainder *up* the call stack, a bigger change than this one.
\ ==================================================================

\ ==================================================================
\ while/do/done
\ Unlike if, a loop body has to run more than once - stdin is a
\ one-pass stream, so it can't just be read-and-discarded like if's
\ body could be. This buffers the RAW (pre-tokenize, pre-expansion)
\ text of both the condition and the body once, the first time
\ through, then re-copies and re-tokenizes that saved text into
\ LINE-BUF fresh on every iteration. Re-tokenizing fresh each time -
\ rather than reusing the already-tokenized ARGV from the first
\ reading - matters: it's what lets $?/$$/$VAR in the condition
\ reflect each iteration's own current state rather than a value
\ frozen from before the loop even started (e.g. "while test $? -eq
\ 0" needs $? to update every time to be meaningful at all).
\ Same v0.5 limitations as if: no nesting, no ";"-separated forms.
\ ==================================================================

\ ==================================================================
\ Per-invocation storage for captured bodies
\ ==================================================================
\ A while/for body, a for word-list and a function-definition body are
\ all captured as raw text before being replayed. They used to live in
\ single shared buffers, which is why a loop nested directly inside
\ another loop produced no output at all: the inner loop's capture
\ overwrote the outer's body. Iteration 42 made replay a real input
\ source, which was the prerequisite; this is the other half.
\
\ A bump arena, carved by BODY-ALLOC. Nothing is ever freed
\ explicitly: DO-WHILE/DO-FOR/DO-FUNCDEF each declare BODY-ARENA-TOP
\ as a LOCAL, so the bump pointer is restored when the construct ends
\ - on every exit path, including an early EXIT - which gives exactly
\ the stack discipline nested constructs need, for free.
\
\ Note the idiom for that, since a "|" scratch local is ZEROED rather
\ than preserved:
\
\     BODY-ARENA-TOP @  SHADOW{ BODY-ARENA-TOP | ... }
\
\ pushing the current value and taking it straight back as an argument
\ local. Result: saved on entry, unchanged during the body, restored
\ on exit.
\
\ The arena itself is a BUFFER: (pool.4), so it costs nothing in the
\ image and nothing at runtime until the first loop or function is
\ actually seen.

\ RUN-LINE is the last word in the file; the suffix after a "done" or
\ "esac" is run as an ordinary line, so this reaches it the usual way.

\ ==================================================================
\ Shell functions: name() { <body> } - definition, invocation,
\ redefinition, and recursion. Each function's body is stored as raw,
\ NUL-separated lines (the same format while/for's own bodies use),
\ but persistently, in its own dedicated table slot keyed by name -
\ unlike while/for's shared WHILE-BODY-BUF, since a function's body
\ needs to survive and be replayed on every future call, not just
\ once immediately after being read.
\ ==================================================================

\ Each function's body is a heap block of its own, sized to fit
\ (Iteration 249); until then they were 2048-byte slots and a longer
\ body was cut short without a word. A redefined function's old block
\ is RETIRED, not freed: the function may be redefining itself while
\ its old body is being replayed. The top-level loop frees it.
MAX-FUNCS CELLS BUFFER: FUNC-BODY-PTRS
MAX-FUNCS BUFFER: FUNC-SUBSH
VARIABLE FUNCDEF-SUBSHELL?   \ set by DO-FUNCDEF, read by SET-FUNC
MAX-FUNCS CELLS BUFFER: FUNC-BODY-LENS

: FUNC-GROW ( --- )   \ double every array the function table is made of
  \ The table was 16 functions, fixed: the seventeenth said "too many
  \ functions" and was not defined, and a shell library defines dozens.
  \ Seven parallel arrays make it up - four here, three in tree.4,
  \ which grows its own through FUNC-GROW-CALL - and all are growable
  \ buffers, so it doubles instead (Iteration 419). Nothing holds an
  \ address into these arrays across a call that can define a
  \ function, which is what makes moving them safe.
  FUNC-CAP @ 2* FUNC-CAP !
  FUNC-CAP @ FUNC-NAME-MAX * ENSURE-BUFFER FUNC-NAMES
  FUNC-CAP @ CELLS ENSURE-BUFFER FUNC-BODY-PTRS
  FUNC-CAP @ ENSURE-BUFFER FUNC-SUBSH
  FUNC-CAP @ CELLS ENSURE-BUFFER FUNC-BODY-LENS
  FUNC-CAP @ FUNC-GROW-CALL ;

: REMOVE-FUNC ( name-addr --- )   \ forget a function, for `unset -f`
  FIND-FUNC DUP 0< IF DROP EXIT THEN
  FUNC-COUNT @ 1- OVER ?DO
    I 1+ FUNC-NAME-SLOT  I FUNC-NAME-SLOT  FUNC-NAME-MAX MOVE
    I 1+ CELLS FUNC-BODY-PTRS + @  I CELLS FUNC-BODY-PTRS + !
    I 1+ CELLS FUNC-BODY-LENS + @  I CELLS FUNC-BODY-LENS + !
    \ tree.4 keeps its own parsed body beside these, indexed the same way
    I FT-SHIFT-CALL DROP
  LOOP DROP
  FUNC-COUNT @ 1- FUNC-COUNT ! ;

' REMOVE-FUNC IS REMOVE-FUNC-CALL

: FUNC-BODY-SLOT ( i --- addr )  CELLS FUNC-BODY-PTRS + @ ;
: FUNC-BODY-LEN-SLOT ( i --- addr )  CELLS FUNC-BODY-LENS + ;
: FUNC-SUBSH-SLOT  ( i --- addr )  FUNC-SUBSH + ;

VARIABLE SF-NAME
VARIABLE SF-BODY-ADDR
VARIABLE SF-BODY-LEN
VARIABLE SF-I

: SET-FUNC ( name-addr body-addr body-len --- )
  \ Defines (or, if name-addr already names a function, redefines) a
  \ function - a new definition with the same name simply overwrites
  \ the existing table slot in place, the same "update if found,
  \ append if not" shape SET-SHVAR already uses for shell variables.
  \ body-addr/body-len is raw, NUL-separated line data (not a C
  \ string - it can and does contain embedded NULs as line
  \ separators), so it's copied via a length-bounded MOVE, not
  \ SAFE-CSTR-COPY/SAFE-COPY-NUL (which assume a single trailing NUL
  \ terminator, the wrong shape for this data).
  SF-BODY-LEN ! SF-BODY-ADDR ! SF-NAME !
  SF-NAME @ FIND-FUNC
  DUP -1 = IF
    DROP
    FUNC-COUNT @ FUNC-CAP @ < 0= IF FUNC-GROW THEN
    FUNC-COUNT @ SF-I !
    FUNC-COUNT @ 1+ FUNC-COUNT !
  ELSE
    SF-I !
  THEN
  SF-NAME @ SF-I @ FUNC-NAME-SLOT FUNC-NAME-MAX SAFE-CSTR-COPY DROP
  SF-BODY-LEN @ SF-I @ FUNC-BODY-LEN-SLOT !
  FUNCDEF-SUBSHELL? @ SF-I @ FUNC-SUBSH-SLOT C!
  SF-I @ FUNC-BODY-SLOT ?DUP IF BUF-RETIRE THEN
  SF-BODY-LEN @ 1+ ALLOCATE ABORT" shell: out of memory"
  DUP SF-I @ CELLS FUNC-BODY-PTRS + !
  SF-BODY-ADDR @ SWAP SF-BODY-LEN @ MOVE ;

: DO-EVAL ( --- )   \ the arguments, joined, parsed and run (tree.4)
  TREE-EVAL-CALL ;
' DO-EVAL S" eval" BUILTIN

\ ==================================================================
\ for VAR in word1 word2 ... / do / <body> / done
\ Requires "do" on its own, separate line, matching if/while's own
\ established convention here ("for VAR in ...; do" on one line isn't
\ supported, same as "if cond; then" isn't). Reuses while's own
\ body-capture/replay machinery (WHILE-BODY-BUF/APPEND-RAW-LINE-TO-
\ BODY/DO-WHILE-BODY) - the mechanics of "store body lines, then
\ replay them" are identical; only the iteration control differs (a
\ fixed word list, expanded once here at the "for ... in ..." line
\ itself, matching POSIX - not re-evaluated each iteration the way
\ while's own condition is). Does NOT support nesting a for/while
\ inside a for's own body (the same shared buffer would be clobbered,
\ the same underlying reason while doesn't support nesting either).
\ Does not validate that ARGV[2] is actually "in" (matching this
\ shell's sparse error handling elsewhere) - it's simply skipped over.
\ ==================================================================

\ ==================================================================
\ Glob-pattern matching (*, ?, [...] with a-z ranges and [!...]/[^...]
\ negation) - needed by case/esac below for matching its own patterns
\ against the case word, the same "pattern matching notation" POSIX
\ pathname expansion also uses. The classic iterative two-pointer
\ algorithm (no recursion needed): '*' remembers the pattern/text
\ positions it was seen at, initially matching zero characters; if a
\ later mismatch is hit, backtrack to the most recent '*' and let it
\ consume one more character of text instead, retrying from there.
\ Bracket expressions are handled as a single, variable-length unit
\ within this scan (BRACKET-END finds where one ends in the pattern
\ text; BRACKET-MATCHES? checks membership, including ranges and
\ negation) rather than needing their own separate backtrack state.
\ ==================================================================

VARIABLE GM-PATTERN
VARIABLE GM-PLEN
VARIABLE GM-TEXT
VARIABLE GM-TLEN
VARIABLE GM-P
VARIABLE GM-S
VARIABLE GM-STAR-P
VARIABLE GM-STAR-S
VARIABLE GM-HAS-STAR?

VARIABLE BM-NEG?
VARIABLE BM-I
VARIABLE BM-CHAR
VARIABLE BM-END
VARIABLE BM-MATCHED?

: BRACKET-END ( p --- p2 )
  \ GM-PATTERN[p] is '[' - returns the index right after the matching
  \ ']'. A leading '!'/'^' (negation) and a ']' immediately after
  \ that (or right after the '[' itself) are skipped as not being the
  \ closer - POSIX: "[]abc]" and "[!]abc]" both treat that first ']'
  \ as a literal member, not the end of the expression.
  1+
  DUP GM-PLEN @ < IF
    DUP GM-PATTERN @ + C@ 33 = OVER GM-PATTERN @ + C@ 94 = OR IF
      1+
    THEN
  THEN
  DUP GM-PLEN @ < IF
    DUP GM-PATTERN @ + C@ 93 = IF
      1+
    THEN
  THEN
  BEGIN
    DUP GM-PLEN @ < IF DUP GM-PATTERN @ + C@ 93 <> ELSE 0 THEN
  WHILE
    \ a backslash hides the next character, `]` included (Iteration 337)
    DUP GM-PATTERN @ + C@ 92 = OVER 1+ GM-PLEN @ < AND IF 1+ THEN
    \ "[:name:]" carries a `]` of its own: step over it, or the bracket
    \ expression looks as if it ended there (Iteration 325).
    DUP GM-PATTERN @ + C@ 91 =
    OVER 1+ GM-PLEN @ < IF OVER 1+ GM-PATTERN @ + C@ 58 = ELSE 0 THEN
    AND IF
      2 +
      BEGIN
        DUP 1+ GM-PLEN @ < IF
          DUP GM-PATTERN @ + C@ 58 = OVER 1+ GM-PATTERN @ + C@ 93 = AND 0=
        ELSE 0 THEN
      WHILE 1+ REPEAT
      DUP GM-PLEN @ < IF 2 + THEN
    ELSE
      1+
    THEN
  REPEAT
  DUP GM-PLEN @ < IF 1+ THEN ;

VARIABLE CC-TEXT       \ the class name in the pattern, just past "[:"
VARIABLE CC-CHAR       \ the character being tested
VARIABLE CC-LEN        \ how long "[:name:]" was, so the scan can step over it
VARIABLE CC-I

: CC-IS? ( name-addr u --- f )   \ does the pattern name this class
  0 CC-I !
  BEGIN CC-I @ OVER < WHILE
    OVER CC-I @ + C@  CC-TEXT @ CC-I @ + C@ <> IF 2DROP 0 EXIT THEN
    CC-I @ 1+ CC-I !
  REPEAT
  NIP 2 + CC-LEN !  -1 ;      \ NIP already dropped the name

: CC-ALPHA? ( c --- f )  DUP 65 - 26 U< SWAP 97 - 26 U< OR ;
: CC-DIGIT? ( c --- f )  48 - 10 U< ;

: CC-MATCH? ( p --- f )
  \ [:alpha:] and the rest (XCU 9.3.5), answered for the C locale, which
  \ is the only one this shell claims (Iteration 325). CC-LEN is left as
  \ the length of the whole "[:name:]" so the caller can step over it.
  2 + GM-PATTERN @ + CC-TEXT !
  S" alpha:]"  CC-IS? IF CC-CHAR @ CC-ALPHA? EXIT THEN
  S" digit:]"  CC-IS? IF CC-CHAR @ CC-DIGIT? EXIT THEN
  S" alnum:]"  CC-IS? IF CC-CHAR @ CC-ALPHA? CC-CHAR @ CC-DIGIT? OR EXIT THEN
  S" upper:]"  CC-IS? IF CC-CHAR @ 65 - 26 U< EXIT THEN
  S" lower:]"  CC-IS? IF CC-CHAR @ 97 - 26 U< EXIT THEN
  S" space:]"  CC-IS? IF CC-CHAR @ 32 = CC-CHAR @ 9 - 5 U< OR EXIT THEN
  S" blank:]"  CC-IS? IF CC-CHAR @ 32 = CC-CHAR @ 9 = OR EXIT THEN
  S" xdigit:]" CC-IS? IF
    CC-CHAR @ CC-DIGIT? CC-CHAR @ 65 - 6 U< OR CC-CHAR @ 97 - 6 U< OR EXIT THEN
  S" punct:]"  CC-IS? IF
    CC-CHAR @ 33 - 15 U< CC-CHAR @ 58 - 7 U< OR
    CC-CHAR @ 91 - 6 U< OR CC-CHAR @ 123 - 4 U< OR EXIT THEN
  S" print:]"  CC-IS? IF CC-CHAR @ 32 - 95 U< EXIT THEN
  S" graph:]"  CC-IS? IF CC-CHAR @ 33 - 94 U< EXIT THEN
  S" cntrl:]"  CC-IS? IF CC-CHAR @ 32 < CC-CHAR @ 127 = OR EXIT THEN
  0 CC-LEN !  0 ;

: BRACKET-MATCHES? ( p p2 char --- f )
  \ p is GM-PATTERN's index of the opening '[', p2 the index right
  \ after the matching ']' (from BRACKET-END). Checks whether char is
  \ a member of this set - a leading '!'/'^' negates the whole result,
  \ and "x-y" (three characters, a literal '-' in the middle) is a
  \ range rather than three separate members.
  SHADOW{ BM-I BM-END BM-CHAR | BM-NEG? BM-MATCHED? }
  BM-I @ 1+ BM-I !
  BM-I @ GM-PATTERN @ + C@ 33 = BM-I @ GM-PATTERN @ + C@ 94 = OR IF
    -1 BM-NEG? !
    BM-I @ 1+ BM-I !
  THEN
  BEGIN BM-I @ BM-END @ 1- < WHILE
    \ An escape is resolved BEFORE the range test, or `[0\-9]` reads as
    \ a range from backslash to 9 - empty, so the pattern matched
    \ nothing at all (Iteration 369).
    BM-I @ GM-PATTERN @ + C@ 92 = BM-I @ 1+ BM-END @ 1- < AND IF
      BM-I @ 1+ BM-I !
      BM-I @ GM-PATTERN @ + C@ BM-CHAR @ = IF -1 BM-MATCHED? ! THEN
      BM-I @ 1+ BM-I !
      0
    ELSE
    BM-I @ 1+ BM-END @ 1- < IF
      BM-I @ 1+ GM-PATTERN @ + C@ 45 =
      BM-I @ 2 + BM-END @ 1- < AND
    ELSE 0 THEN
    THEN
    IF
      BM-CHAR @ BM-I @ GM-PATTERN @ + C@ < 0=
      BM-I @ 2 + GM-PATTERN @ + C@ BM-CHAR @ < 0=
      AND IF -1 BM-MATCHED? ! THEN
      BM-I @ 3 + BM-I !
    ELSE
    \ "[:name:]" names a class rather than two characters
    BM-I @ GM-PATTERN @ + C@ 91 =
    BM-I @ 1+ BM-END @ < IF BM-I @ 1+ GM-PATTERN @ + C@ 58 = ELSE 0 THEN
    AND IF
      BM-CHAR @ CC-CHAR !
      BM-I @ CC-MATCH? IF -1 BM-MATCHED? ! THEN
      CC-LEN @ ?DUP IF BM-I @ + BM-I ! ELSE BM-I @ 1+ BM-I ! THEN
    ELSE
      BM-I @ GM-PATTERN @ + C@ BM-CHAR @ = IF -1 BM-MATCHED? ! THEN
      BM-I @ 1+ BM-I !
    THEN THEN
  REPEAT
  BM-MATCHED? @ BM-NEG? @ IF 0= ELSE THEN ;

VARIABLE GCM-P
VARIABLE GCM-CHAR
VARIABLE GCM-BEND

VARIABLE GM-ESCAPES?   \ pathname expansion: a backslash quotes a character

: GLOB-CHAR-MATCHES? ( p-idx char --- match? p-idx-after )
  \ Does GM-PATTERN[p-idx] (a '?', a bracket expression, or a single
  \ literal character) match char? p-idx-after is where to resume
  \ pattern scanning next, regardless of match/no-match - a bracket
  \ expression can span many pattern characters, unlike '?' or a
  \ literal, which only ever advance by one.
  SHADOW{ GCM-P GCM-CHAR | GCM-BEND }
  \ With GM-ESCAPES? set, a backslash makes the next character literal
  \ (pathname expansion, Iteration 267).
  GM-ESCAPES? @ IF
    GCM-P @ GM-PATTERN @ + C@ 92 = GCM-P @ 1+ GM-PLEN @ < AND IF
      GCM-P @ 1+ GM-PATTERN @ + C@ GCM-CHAR @ =  GCM-P @ 2 + EXIT
    THEN
  THEN
  GCM-P @ GM-PATTERN @ + C@
  DUP 63 = IF
    DROP
    -1 GCM-P @ 1+
  ELSE
    91 = IF
      GCM-P @ BRACKET-END GCM-BEND !
      GCM-P @ GCM-BEND @ GCM-CHAR @ BRACKET-MATCHES?
      GCM-BEND @
    ELSE
      GCM-P @ GM-PATTERN @ + C@ GCM-CHAR @ =
      GCM-P @ 1+
    THEN
  THEN ;

: GLOB-MATCH ( pattern-addr pattern-len text-addr text-len --- f )
  SHADOW{ GM-PATTERN GM-PLEN GM-TEXT GM-TLEN | GM-P GM-S GM-STAR-P GM-STAR-S GM-HAS-STAR? }
  BEGIN GM-S @ GM-TLEN @ < WHILE
    GM-P @ GM-PLEN @ < IF
      GM-P @ GM-PATTERN @ + C@ 42 =
    ELSE 0 THEN
    IF
      -1 GM-HAS-STAR? !
      GM-P @ GM-STAR-P !
      GM-S @ GM-STAR-S !
      GM-P @ 1+ GM-P !
    ELSE
      GM-P @ GM-PLEN @ < IF
        GM-P @ GM-TEXT @ GM-S @ + C@ GLOB-CHAR-MATCHES?
      ELSE 0 0 THEN
      OVER IF
        SWAP DROP GM-P !
        GM-S @ 1+ GM-S !
      ELSE
        DROP DROP
        GM-HAS-STAR? @ IF
          GM-STAR-P @ 1+ GM-P !
          GM-STAR-S @ 1+ DUP GM-STAR-S !
          GM-S !
        ELSE
          0 EXIT
        THEN
      THEN
    THEN
  REPEAT
  BEGIN
    GM-P @ GM-PLEN @ < IF GM-P @ GM-PATTERN @ + C@ 42 = ELSE 0 THEN
  WHILE
    GM-P @ 1+ GM-P !
  REPEAT
  GM-P @ GM-PLEN @ = ;

\ ==================================================================
\ Pathname expansion (XCU 2.6.6; Iteration 267)
\ ==================================================================
\ After EXPAND-WORDS, each field with a GLOB-MARK is a pattern. Its
\ unmarked * ? [ and every backslash are escaped, it is matched a
\ component at a time against directory listings, and the sorted
\ matches replace it; with no match it stays as it is. Names starting
\ with a dot match only an explicit leading dot, and . and .. are never
\ matched (bash 5.2 and dash agree). A redirection's target is not
\ expanded (dash; POSIX leaves it to interactive shells).

\ the pattern being expanded, escaped
256 BUFFER: GP-BUF
VARIABLE GP#
: GP-C, ( c --- )
  GP# @ 2 + ENSURE-BUFFER GP-BUF  GP-BUF GP# @ + C!  1 GP# +! ;

\ the field: its output offset and length, and its marks
VARIABLE GF-OFF
VARIABLE GF-LEN
VARIABLE GF-M
VARIABLE GF-K
VARIABLE GF-N

: MARKED? ( off --- f )
  GLOB-MARKS# @ 0 ?DO
    GLOB-MARKS I CELLS + @ OVER = IF DROP UNLOOP -1 EXIT THEN
  LOOP DROP 0 ;

: BUILD-GLOB-PATTERN ( --- )
  0 GP# !
  GF-LEN @ 0 ?DO
    GF-OFF @ I + OUT-BASE + C@
    \ `]` is escaped when quoted too, so `[a\]]` keeps its member and
    \ its terminator apart (Iteration 370).
    DUP 42 = OVER 63 = OR OVER 91 = OR OVER 92 = OR OVER 45 = OR OVER 93 = OR IF
      GF-OFF @ I + MARKED? 0= IF 92 GP-C, THEN
    THEN GP-C,
  LOOP ;

\ the path being built
: PATTERN-FROM-MARKS ( c-addr u --- pattern-addr pattern-len )
  \ Escapes the metacharacters the marks did not record - the quoted
  \ ones - and leaves the live ones alone (Iteration 341).
  GF-LEN !  OUT-BASE - GF-OFF !
  BUILD-GLOB-PATTERN
  GP-BUF GP# @ ;

256 BUFFER: GW-PATH
: GW-C, ( c pos --- pos' )
  DUP 2 + ENSURE-BUFFER GW-PATH  TUCK GW-PATH + C!  1+ ;
: GW-NUL ( pos --- )   DUP 1+ ENSURE-BUFFER GW-PATH  0 SWAP GW-PATH + C! ;
CREATE DOT-PATH  CSTR," ."

: COMP-END ( i --- j )   \ the next unescaped / in the pattern, or its end
  BEGIN DUP GP# @ < IF DUP GP-BUF + C@ 47 <> ELSE 0 THEN WHILE
    DUP GP-BUF + C@ 92 = IF 1+ THEN 1+
  REPEAT GP# @ MIN ;
: CLOSED-BRACKET? ( j i --- f )   \ does a ] close the [ at i, before j
  1+ DUP GP-BUF + C@ 33 = IF 1+ THEN        \ [! 
  1+                                        \ a ] first is a member
  BEGIN 2DUP > WHILE
    DUP GP-BUF + C@ 93 = IF 2DROP -1 EXIT THEN
    1+
  REPEAT 2DROP 0 ;
: MAGIC? ( i j --- f )   \ an unescaped * or ?, or a closed [...], in [i, j)
  SWAP BEGIN 2DUP > WHILE
    DUP GP-BUF + C@
    DUP 92 = IF DROP 1+ ELSE
    DUP 42 = OVER 63 = OR IF DROP 2DROP -1 EXIT THEN
    91 = IF 2DUP CLOSED-BRACKET? IF 2DROP -1 EXIT THEN THEN THEN
    1+
  REPEAT 2DROP 0 ;
: ANY-MAGIC? ( --- f )   \ is any component of the pattern a pattern at all
  0 BEGIN DUP GP# @ < WHILE
    DUP COMP-END 2DUP MAGIC? IF 2DROP -1 EXIT THEN
    NIP 1+
  REPEAT DROP 0 ;
VARIABLE UE-I
VARIABLE UE-J
VARIABLE UE-POS
: UNESCAPE-TO-PATH ( i j pos --- pos' )   \ [i, j) of the pattern, escapes dropped
  UE-POS !  UE-J !  UE-I !
  BEGIN UE-I @ UE-J @ < WHILE
    UE-I @ GP-BUF + C@ 92 = IF 1 UE-I +! THEN
    UE-I @ GP-BUF + C@  UE-POS @ GW-C,  UE-POS !
    1 UE-I +!
  REPEAT
  UE-POS @ ;
: EXISTS? ( pos --- f )   \ does GW-PATH[0, pos) name anything
  DUP GW-NUL
  GW-PATH OPEN-DIR ?DUP IF CLOSE-DIR DROP -1 EXIT THEN
  GW-PATH SWAP R/O OPEN-FILE IF DROP 0 ELSE CLOSE-FILE DROP -1 THEN ;

\ the matches: in the output, their offsets listed
256 BUFFER: GML
VARIABLE GML#
: ADD-MATCH ( pos --- )
  GML# @ 1+ CELLS ENSURE-BUFFER GML
  TOK-OUT @ OUT-BASE -  GML GML# @ CELLS + !  1 GML# +!
  0 ?DO GW-PATH I + C@ EMIT-TOK-CHAR LOOP  0 EMIT-TOK-CHAR ;

VARIABLE GWK-POS
VARIABLE GWK-I
VARIABLE GWK-J
VARIABLE GWK-DIR
VARIABLE GWK-NAME
VARIABLE GWK-NLEN

: DOT-NAME-OK? ( --- f )   \ may this directory entry match the component?
  GWK-NAME @ C@ 46 <> IF -1 EXIT THEN
  GWK-NLEN @ 1 = IF 0 EXIT THEN
  GWK-NLEN @ 2 = GWK-NAME @ 1+ C@ 46 = AND IF 0 EXIT THEN
  GP-BUF GWK-I @ + C@ 46 = ;

: GLOB-WALK ( pos i --- )
  SHADOW{ GWK-POS GWK-I | GWK-J GWK-DIR GWK-NAME GWK-NLEN }
  GWK-I @ GP# @ = IF                         \ after a trailing /
    GWK-POS @ DUP EXISTS? IF ADD-MATCH ELSE DROP THEN EXIT
  THEN
  GWK-I @ COMP-END GWK-J !
  GWK-I @ GWK-J @ MAGIC? 0= IF               \ a literal component
    GWK-I @ GWK-J @ GWK-POS @ UNESCAPE-TO-PATH GWK-POS !
    GWK-J @ GP# @ = IF
      GWK-POS @ DUP EXISTS? IF ADD-MATCH ELSE DROP THEN EXIT
    THEN
    47 GWK-POS @ GW-C,  GWK-J @ 1+ RECURSE EXIT
  THEN
  GWK-POS @ IF GWK-POS @ GW-NUL GW-PATH ELSE DOT-PATH THEN
  OPEN-DIR ?DUP 0= IF EXIT THEN GWK-DIR !
  BEGIN GWK-DIR @ READ-DIR ?DUP WHILE
    GWK-NAME !  GWK-NAME @ CSTRLEN GWK-NLEN !
    DOT-NAME-OK? IF
      -1 GM-ESCAPES? !
      GP-BUF GWK-I @ +  GWK-J @ GWK-I @ -  GWK-NAME @ GWK-NLEN @ GLOB-MATCH
      0 GM-ESCAPES? !
      IF
        GWK-POS @ GWK-NLEN @ + 2 + ENSURE-BUFFER GW-PATH
        GWK-NAME @  GW-PATH GWK-POS @ +  GWK-NLEN @ MOVE
        GWK-J @ GP# @ = IF
          GWK-POS @ GWK-NLEN @ + ADD-MATCH
        ELSE
          47 GWK-POS @ GWK-NLEN @ + GW-C,  GWK-J @ 1+ RECURSE
        THEN
      THEN
    THEN
  REPEAT
  GWK-DIR @ CLOSE-DIR ;

: GML@ ( i --- c-addr )   CELLS GML + @ OUT-BASE + ;
: CSTR< ( a b --- f )   >R DUP CSTRLEN R> DUP CSTRLEN COMPARE 0< ;
: GML-SWAP ( j --- )   \ exchange entries j-1 and j
  CELLS GML +  DUP 1 CELLS -                ( aj aj-1 )
  OVER @ OVER @                             ( aj aj-1 xj xj-1 )
  3 PICK !  SWAP !  DROP ;
: SORT-MATCHES ( --- )   \ insertion sort, in byte order
  GML# @ 1 ?DO
    I BEGIN
      DUP 0> IF DUP GML@ OVER 1- GML@ CSTR< ELSE 0 THEN
    WHILE
      DUP GML-SWAP 1-
    REPEAT DROP
  LOOP ;

: GLOB-ONE ( --- n )   \ the field's matches into ARGV; how many
  BUILD-GLOB-PATTERN
  \ `[` alone - the test command - is marked but is no pattern: no walk
  ANY-MAGIC? 0= IF 0 EXIT THEN
  0 GML# !
  0 0 GLOB-WALK
  GML# @ 0= IF 0 EXIT THEN
  SORT-MATCHES
  GML# @ 0 ?DO
    ARGC @ ROOM-FOR-ARG? IF
      I GML@ ARGV ARGC @ CELLS + !
      \ quoted, so a match is not taken for an operator or an assignment
      -1 ARGV-QUOTED ARGC @ + C!  -1 ARGV-NAME-QUOTED ARGC @ + C!
      ARGC @ 1+ ARGC !
    ELSE -1 ARGS-OVERFLOW? ! THEN
  LOOP
  GML# @ ;

: REDIR-OP-FIELD? ( i --- f )   \ is field i an unquoted redirection operator
  DUP 0< IF DROP 0 EXIT THEN
  DUP EW-LIT + C@ IF DROP 0 EXIT THEN
  CELLS EW-ARGV + @ OUT-BASE + C@ DUP 60 = SWAP 62 = OR ;

: GLOB-FIELDS ( --- )
  ARGC @ GF-N !
  ARGC @ 0 ?DO
    I ARGV@ OUT-BASE -  EW-ARGV I CELLS + !
    I ARGV-QUOTED@ EW-LIT I + C!
    I ARGV-NAME-QUOTED@ EW-ARGQ I + C!
  LOOP
  0 ARGC !  0 GF-M !
  GF-N @ 0 ?DO
    EW-ARGV I CELLS + @ GF-OFF !
    GF-OFF @ OUT-BASE + CSTRLEN GF-LEN !
    \ any mark inside this field. The marks were in order while they
    \ were made one character at a time; region marks (Iteration 278)
    \ come grouped by character, so every mark is looked at.
    0 GF-K !
    GLOB-MARKS# @ 0 ?DO
      GLOB-MARKS I CELLS + @
      DUP GF-OFF @ < 0= SWAP GF-OFF @ GF-LEN @ + < AND IF 1 GF-K +! THEN
    LOOP
    GF-K @ IF I 1- REDIR-OP-FIELD? IF 0 ELSE GLOB-ONE THEN ELSE 0 THEN
    0= IF
      ARGC @ ROOM-FOR-ARG? IF
        GF-OFF @ OUT-BASE +  ARGV ARGC @ CELLS + !
        EW-LIT I + C@ ARGV-QUOTED ARGC @ + C!
        EW-ARGQ I + C@ ARGV-NAME-QUOTED ARGC @ + C!
        ARGC @ 1+ ARGC !
      ELSE -1 ARGS-OVERFLOW? ! THEN
    THEN
  LOOP
  0 ARGV ARGC @ CELLS + ! ;
' GLOB-FIELDS IS GLOB-FIELDS-CALL

\ ==================================================================
\ ${VAR%word}/${VAR%%word}/${VAR#word}/${VAR##word} - suffix/prefix
\ removal, the real implementation behind the deferred TRIM-PARAM-CALL
\ EXPAND-BRACED-VAR uses (see its own comment for why this is
\ deferred: GLOB-MATCH, needed here, is defined much later in the file
\ than EXPAND-BRACED-VAR is). Each of the four modes searches for the
\ shortest or longest prefix/suffix of the variable's own value that
\ GLOB-MATCH accepts as a whole match against the pattern, by trying
\ candidate lengths one at a time - 0,1,2,...,value-len for shortest,
\ value-len,value-len-1,...,0 for longest - stopping at the first
\ length that matches. If nothing matches at any length (including 0
\ and the full value-len), the value is emitted unchanged, per POSIX.
\ ==================================================================

VARIABLE FPM-PAT-ADDR
VARIABLE FPM-PAT-LEN
VARIABLE FPM-VAL-ADDR
VARIABLE FPM-VAL-LEN
VARIABLE FPM-SUFFIX?
VARIABLE FPM-LONGEST?
VARIABLE FPM-I

: FPM-CANDIDATE ( --- c-addr u )
  \ The candidate substring of the value that is FPM-I characters long:
  \ its first FPM-I characters when trimming a prefix, its last FPM-I
  \ when trimming a suffix. Reads FIND-TRIM-LEN's own locals, which
  \ hold this invocation's values for as long as the call is running.
  FPM-SUFFIX? @ IF
    FPM-VAL-ADDR @ FPM-VAL-LEN @ FPM-I @ - +
  ELSE
    FPM-VAL-ADDR @
  THEN
  FPM-I @ ;

: FPM-MATCHES? ( --- f )
  FPM-PAT-ADDR @ FPM-PAT-LEN @ FPM-CANDIDATE GLOB-MATCH ;

\ ---- trims without trying every length (Iteration 273) ----
\ `${s##*/}` tried every prefix with GLOB-MATCH: O(n^2), and half of the
\ str benchmark. A pattern that is a literal with at most one star, at
\ one end - *LIT, LIT*, LIT, * - is answered by one substring search.
\ Anything with ? [ \ or another star takes the general path.
VARIABLE TF-LIT
VARIABLE TF-LEN
VARIABLE TF-LEAD?
VARIABLE TF-TRAIL?
: TRIM-SHAPE ( pat len --- f )
  0 TF-LEAD? !  0 TF-TRAIL? !
  DUP IF OVER C@ 42 = IF -1 TF-LEAD? !  1 /STRING THEN THEN
  TF-LEAD? @ 0= IF
    DUP IF 2DUP + 1- C@ 42 = IF -1 TF-TRAIL? !  1- THEN THEN
  THEN
  TF-LEN !  TF-LIT !
  TF-LIT @ TF-LEN @ + TF-LIT @ ?DO
    I C@ DUP 42 = OVER 63 = OR OVER 91 = OR SWAP 92 = OR IF UNLOOP 0 EXIT THEN
  LOOP -1 ;
: LIT-AT? ( addr --- f )   TF-LEN @ TF-LIT @ TF-LEN @ COMPARE 0= ;
: STARTS-WITH? ( a n --- f )
  TF-LEN @ < IF DROP 0 EXIT THEN LIT-AT? ;
: ENDS-WITH? ( a n --- f )
  DUP TF-LEN @ < IF 2DROP 0 EXIT THEN + TF-LEN @ - LIT-AT? ;
: FIND-FWD ( a n --- pos | -1 )   \ the literal's first occurrence
  TF-LEN @ - DUP 0< IF 2DROP -1 EXIT THEN
  1+ 0 ?DO DUP I + LIT-AT? IF DROP I UNLOOP EXIT THEN LOOP DROP -1 ;
: FIND-BWD ( a n --- pos | -1 )   \ its last
  TF-LEN @ - DUP 0< IF 2DROP -1 EXIT THEN
  BEGIN DUP 0< 0= WHILE
    2DUP + LIT-AT? IF NIP EXIT THEN
    1-
  REPEAT 2DROP -1 ;

: TRIM-FAST ( --- len -1 | 0 )   \ FIND-TRIM-LEN's arguments are in its locals
  FPM-PAT-ADDR @ FPM-PAT-LEN @ TRIM-SHAPE 0= IF 0 EXIT THEN
  FPM-VAL-ADDR @ FPM-VAL-LEN @
  TF-LEAD? @ IF                               \ *LIT
    FPM-SUFFIX? @ IF
      ENDS-WITH? IF FPM-LONGEST? @ IF FPM-VAL-LEN @ ELSE TF-LEN @ THEN ELSE -1 THEN
    ELSE
      FPM-LONGEST? @ IF FIND-BWD ELSE FIND-FWD THEN
      DUP 0< 0= IF TF-LEN @ + THEN
    THEN
    -1 EXIT
  THEN
  TF-TRAIL? @ IF                              \ LIT*
    FPM-SUFFIX? @ IF
      FPM-LONGEST? @ IF FIND-FWD ELSE FIND-BWD THEN
      DUP 0< 0= IF FPM-VAL-LEN @ SWAP - THEN
    ELSE
      STARTS-WITH? IF FPM-LONGEST? @ IF FPM-VAL-LEN @ ELSE TF-LEN @ THEN ELSE -1 THEN
    THEN
    -1 EXIT
  THEN
  FPM-SUFFIX? @ IF ENDS-WITH? ELSE STARTS-WITH? THEN   \ LIT
  IF TF-LEN @ ELSE -1 THEN -1 ;

: FIND-TRIM-LEN ( pat-addr pat-len val-addr val-len suffix? longest? --- match-len | -1 )
  \ One word replacing what were four near-identical ones
  \ (FIND-SHORTEST/LONGEST-PREFIX/SUFFIX-LEN). They only ever differed
  \ in two things: which end of the value the candidate is taken from,
  \ and whether candidate lengths are tried upward from 0 or downward
  \ from the full length. Both are now parameters. Returns the length
  \ of the first candidate GLOB-MATCH accepts, or -1 if no length
  \ matches at all - including 0 and the full value length - in which
  \ case POSIX says the value is emitted unchanged.
  SHADOW{ FPM-PAT-ADDR FPM-PAT-LEN FPM-VAL-ADDR FPM-VAL-LEN FPM-SUFFIX? FPM-LONGEST? | FPM-I }
  TRIM-FAST IF EXIT THEN
  FPM-LONGEST? @ IF FPM-VAL-LEN @ FPM-I ! THEN
  BEGIN
    FPM-MATCHES? 0=
    FPM-LONGEST? @ IF FPM-I @ 0 > ELSE FPM-I @ FPM-VAL-LEN @ < THEN
    AND
  WHILE
    FPM-LONGEST? @ IF FPM-I @ 1- ELSE FPM-I @ 1+ THEN FPM-I !
  REPEAT
  FPM-MATCHES? IF FPM-I @ ELSE -1 THEN ;

\ ==================================================================
\ case WORD in / PATTERN1) / <body> / ;; / PATTERN2|PATTERN3) / ... /
\ esac
\ Requires each pattern arm on its own line, and ';;' (or the arm
\ ending directly at "esac", for the last item, per POSIX) on its own
\ line too - no same-line support yet, matching while/for. Each
\ pattern (or '|'-separated alternative) is glob-matched against the
\ case word saved when "case WORD in" was first read; the first arm
\ with any matching alternative has its body run, and no further arms
\ are even inspected afterward - unlike a C switch, there's no
\ fall-through. A pattern arm's own trailing ')' isn't its own token
\ (unlike '('/')' used for command grouping, ')' here isn't spaced
\ out by NORMALIZE-OPERATORS - it stays fused to the last character of
\ whatever precedes it, e.g. "he*)" tokenizes as one token), so
\ CASE-ARM-MATCHES? strips it from the *last* ARGV token specifically
\ before testing it as a pattern.
\ ==================================================================

\ ==================================================================
\ Aliases
\ ==================================================================
\ Textual substitution of the first word of a command, done before the
\ line is interpreted - "completely lexical", as Ramey puts it, which
\ is why an alias can introduce operators and even change the grammar
\ of the line it appears in. The expansion re-normalizes and
\ re-tokenizes, so "alias ll='ls -l'" and "alias e='echo a;echo b'"
\ both behave.
\
\ ALIAS-DEPTH stops "alias ls='ls -l'" from recursing forever. Real
\ shells suppress re-expansion of the alias currently being expanded;
\ a depth cap is cruder but needs no per-expansion state, and the
\ failure mode is a diagnosed stop rather than a hang.

: .ALIAS ( i --- )   \ as XCU asks: a form the shell can read back
  DUP ALIAS-NAME-SLOT DUP CSTRLEN TYPE 61 EMIT
  ALIAS-VALUE-SLOT SQUOTED. CR ;

: DO-ALIAS ( --- )
  \ With no operands, every alias; with a name and no `=`, that one
  \ (Iteration 289 - both printed nothing).
  0 LAST-STATUS !
  ARGC @ 1 = IF
    ALIAS-COUNT @ 0 ?DO I .ALIAS LOOP EXIT
  THEN
  1 AL-I !
  \ `--` ends the options, and `alias --` alone still prints them all
  \ (XCU 1.4; Iteration 377).
  ARGC @ 1 > IF
    S" --" 1 ARGV@ STR0= IF
      2 AL-I !
      ARGC @ 2 = IF ALIAS-COUNT @ 0 ?DO I .ALIAS LOOP EXIT THEN
    THEN
  THEN
  BEGIN AL-I @ ARGC @ < WHILE
    AL-I @ ARGV@ ASSIGNMENT-EQPOS
    DUP -1 = IF
      DROP
      AL-I @ ARGV@ FIND-ALIAS DUP -1 <> IF
        .ALIAS
      ELSE
        DROP
        S" shell: alias: " ERR-TYPE AL-I @ ARGV@ ERR-CSTR
        S" : not found" ERR-TYPE ERR-NL  1 LAST-STATUS !
      THEN
    ELSE
      AL-I @ ARGV@ SWAP SPLIT-ASSIGN-AT
      ASSIGN-NAME-BUF ASSIGN-VALUE-BUF SET-ALIAS
    THEN
    AL-I @ 1+ AL-I !
  REPEAT ;

: DO-UNALIAS ( --- )
  0 LAST-STATUS !
  ARGC @ 1 > IF                              \ -a: all of them (Iteration 289)
    S" -a" 1 ARGV@ STR0= IF 0 ALIAS-COUNT ! EXIT THEN
  THEN
  1 AL-I !
  ARGC @ 1 > IF S" --" 1 ARGV@ STR0= IF 2 AL-I ! THEN THEN
  BEGIN AL-I @ ARGC @ < WHILE
    AL-I @ ARGV@ FIND-ALIAS DUP -1 <> IF
      ALIAS-COUNT @ 1- OVER <> IF
        ALIAS-COUNT @ 1- ALIAS-NAME-SLOT  OVER ALIAS-NAME-SLOT  ALIAS-NAME-MAX  MOVE
        ALIAS-COUNT @ 1- ALIAS-VALUE-SLOT OVER ALIAS-VALUE-SLOT ALIAS-VALUE-MAX MOVE
      THEN
      DROP ALIAS-COUNT @ 1- ALIAS-COUNT !
    ELSE
      \ Removing an alias that is not defined is an error (XCU
      \ `unalias`): this answered 0 and said nothing (Iteration 377).
      DROP
      S" shell: unalias: " ERR-TYPE AL-I @ ARGV@ ERR-CSTR
      S" : not found" ERR-TYPE ERR-NL
      1 LAST-STATUS !
    THEN
    AL-I @ 1+ AL-I !
  REPEAT ;

\ ---- background jobs (Iteration 299) ----
\ Every `&` records its child. `jobs` reports the ones still running and
\ forgets the rest; a finished job is dropped when it is noticed, as both
\ references do. dash prints no command text for a job in a script, and
\ this follows dash.
64 CELLS BUFFER: JOB-PIDS
64 CELLS BUFFER: JOB-NUMS
64 CELLS BUFFER: JOB-STATES  \ 0 running, 1 stopped, 2 finished (320, 324)
64 CELLS BUFFER: JOB-STATUS  \ how a finished job ended, kept for its notice
128 CONSTANT JOB-TEXT-MAX
64 JOB-TEXT-MAX * BUFFER: JOB-TEXT-POOL
VARIABLE JOB-TEXT-NEXT       \ the text being recorded for the next JOB-ADD
VARIABLE JOB-NEXT       \ the next job number to hand out
VARIABLE JB-I
VARIABLE JB-K

: JOB-TEXT-SLOT ( i --- addr )   JOB-TEXT-MAX * JOB-TEXT-POOL + ;

: JOB-NUM-TAKEN? ( n --- f )
  0 JOB# @ 0 ?DO OVER JOB-NUMS I CELLS + @ = OR LOOP NIP ;

: JOB-ADD ( pid --- )
  JOB# @ 1+ CELLS ENSURE-BUFFER JOB-PIDS
  JOB# @ 1+ CELLS ENSURE-BUFFER JOB-NUMS
  JOB-PIDS JOB# @ CELLS + !
  \ the lowest number no current job holds, which is how dash appears to
  \ reuse [1] as soon as the previous job has been reported
  1 BEGIN
    DUP JOB-NUM-TAKEN?
  WHILE 1+ REPEAT
  JOB-NUMS JOB# @ CELLS + !
  0 JOB-STATES JOB# @ CELLS + !
  \ the command's text, as the notice will print it
  JOB-TEXT-NEXT @ ?DUP IF
    DUP CSTRLEN 1+ JOB-TEXT-MAX MIN            ( src n )
    JOB# @ JOB-TEXT-SLOT SWAP MOVE
    0 JOB# @ JOB-TEXT-SLOT JOB-TEXT-MAX 1- + C!
  ELSE
    0 JOB# @ JOB-TEXT-SLOT C!
  THEN
  0 JOB-TEXT-NEXT !
  JOB# @ 1+ JOB# ! ;

: JOB-ALIVE? ( pid --- f )   0 KILL 0= ;   \ KILL takes ( pid sig )

: JOB-PRUNE ( --- )   \ drop the ones that have finished
  0 JB-K !
  JOB# @ 0 ?DO
    JOB-PIDS I CELLS + @ DUP JOB-ALIVE? IF
      JB-K @ CELLS JOB-PIDS + !
      JOB-NUMS I CELLS + @  JB-K @ CELLS JOB-NUMS + !
      JOB-STATES I CELLS + @  JB-K @ CELLS JOB-STATES + !
      I JOB-TEXT-SLOT  JB-K @ JOB-TEXT-SLOT  JOB-TEXT-MAX MOVE
      JB-K @ 1+ JB-K !
    ELSE DROP THEN
  LOOP
  JB-K @ JOB# !
  JOB# @ 0= IF 0 JOB-NEXT ! THEN ;             \ numbering restarts when empty

: .JOB-STATUS ( status --- )   \ as dash words it
  DUP -1 = IF DROP S" Stopped" TYPE EXIT THEN
  DUP 0= IF DROP S" Done" TYPE EXIT THEN
  DUP 128 > IF DROP S" Terminated" TYPE EXIT THEN
  S" Done(" TYPE 0 <# #S #> TYPE 41 EMIT ;

VARIABLE JN-I
VARIABLE JN-STATUS
VARIABLE JN-WIDTH

: .JOB-NOTICE ( i status --- )   \ [n] + Done<pad>text, as dash prints it
  JN-STATUS !  JN-I !
  91 EMIT  JOB-NUMS JN-I @ CELLS + @ 0 <# #S #> TYPE  93 EMIT 32 EMIT
  JOB# @ 1- JN-I @ = IF 43 ELSE JOB# @ 2 - JN-I @ = IF 45 ELSE 32 THEN THEN EMIT
  32 EMIT
  JN-STATUS @ -1 = IF 7 ELSE
  JN-STATUS @ 0= IF 4 ELSE JN-STATUS @ 128 > IF 10 ELSE 8 THEN THEN THEN JN-WIDTH !
  JN-STATUS @ .JOB-STATUS
  27 JN-WIDTH @ - 0 MAX SPACES
  JN-I @ JOB-TEXT-SLOT DUP C@ IF DUP CSTRLEN TYPE ELSE DROP THEN CR ;

: JOB-FORGET ( i --- )   \ drop one job, keeping the others in order
  JOB# @ 1- OVER ?DO
    I 1+ CELLS JOB-PIDS + @  I CELLS JOB-PIDS + !
    I 1+ CELLS JOB-NUMS + @  I CELLS JOB-NUMS + !
    I 1+ CELLS JOB-STATES + @  I CELLS JOB-STATES + !
    I 1+ JOB-TEXT-SLOT  I JOB-TEXT-SLOT  JOB-TEXT-MAX MOVE
  LOOP DROP
  JOB# @ 1- JOB# !
  JOB# @ 0= IF 0 JOB-NEXT ! THEN ;

VARIABLE JMD-PID
VARIABLE JMD-STATUS

: JOB-MARK-DONE ( pid status --- )
  \ A job the shell has reaped keeps its status until the next prompt
  \ reports it. Variables, not juggling: this word is called from two
  \ places with the values in different orders (Iteration 324).
  WAIT->STATUS JMD-STATUS !  JMD-PID !         \ the raw word, decoded here
  JOB# @ 0 ?DO
    JOB-PIDS I CELLS + @ JMD-PID @ = IF
      JMD-STATUS @ JOB-STATUS I CELLS + !
      2 JOB-STATES I CELLS + !
    THEN
  LOOP ;

: JOB-NOTICES ( --- )   \ before an interactive prompt, as both references do
  BEGIN
    WAIT-NOHANG                              ( pid status )
    OVER 0= IF 2DROP EXIT THEN
    \ ( pid raw-status ) - record it; the prompt reports it afterwards
    JOB-MARK-DONE
  AGAIN ;

VARIABLE JND-I

: JOB-NOTICES-DONE ( --- )
  \ Report each finished job and forget it. This replaces a pass that
  \ looked for a job whose process was simply gone and called every one
  \ of them `Done`, losing the status of anything killed by a signal
  \ (Iteration 324).
  BEGIN
    -1 JND-I !
    JOB# @ 0 ?DO
      JOB-STATES I CELLS + @ 2 = JND-I @ 0< AND IF I JND-I ! THEN
    LOOP
    JND-I @ 0< IF EXIT THEN
    JND-I @  JOB-STATUS JND-I @ CELLS + @  .JOB-NOTICE
    JND-I @ JOB-FORGET
  AGAIN ;

: DO-JOBS ( --- )
  0 LAST-STATUS !
  JOB-PRUNE
  \ newest first, as dash prints them; `+` is the most recent, `-` the
  \ one before it
  JOB# @ 0 ?DO
    JOB# @ 1- I - JB-I !
    91 EMIT  JOB-NUMS JB-I @ CELLS + @ 0 <# #S #> TYPE  93 EMIT 32 EMIT
    JOB# @ 1- JB-I @ = IF 43 ELSE JOB# @ 2 - JB-I @ = IF 45 ELSE 32 THEN THEN EMIT
    JOB-STATES JB-I @ CELLS + @ IF S"  Stopped" TYPE 20 SPACES
    ELSE S"  Running" TYPE 20 SPACES THEN
    JB-I @ JOB-TEXT-SLOT DUP C@ IF DUP CSTRLEN TYPE ELSE DROP THEN CR
  LOOP ;

VARIABLE JOB-SEL       \ the job `fg`/`bg` picked
VARIABLE FG-T
128 BUFFER: FG-TEXT-BUF

: JOB-BY-SPEC ( --- i | -1 )   \ %n, %% or nothing: the most recent
  ARGC @ 1 = IF JOB# @ 1- EXIT THEN
  1 ARGV@ DUP C@ 37 = IF 1+ THEN                 ( c-addr past the % )
  DUP C@ 0= IF DROP JOB# @ 1- EXIT THEN
  DUP C@ 37 = IF DROP JOB# @ 1- EXIT THEN        \ %%
  DUP CSTRLEN ALL-DECIMAL? 0= IF DROP -1 EXIT THEN
  1 ARGV@ DUP C@ 37 = IF 1+ THEN DUP CSTRLEN PARSE-DECIMAL   ( n )
  -1 SWAP JOB# @ 0 ?DO
    DUP JOB-NUMS I CELLS + @ = IF SWAP DROP I SWAP THEN
  LOOP DROP ;

: JOB-NO-SUCH ( --- )
  S" shell: no such job" ERR-TYPE ERR-NL  1 LAST-STATUS ! ;

: .JOB-TEXT ( i --- )   JOB-TEXT-SLOT DUP C@ IF DUP CSTRLEN TYPE ELSE DROP THEN ;

: JOB-WAIT-FG ( i --- )   \ wait for it, noting a stop
  DUP JOB-PIDS SWAP CELLS + @                    ( i pid )
  WAIT-JOB                                       ( i pid' status )
  OVER 0< IF 2DROP DROP 0 LAST-STATUS ! EXIT THEN
  DUP 127 AND 127 = IF                           \ stopped, not finished
    2DROP 1 SWAP JOB-STATES SWAP CELLS + !
    ERR-NL  0 LAST-STATUS !
  ELSE
    NIP WAIT->STATUS LAST-STATUS !
    JOB-FORGET
  THEN ;

: DO-FG ( --- )
  JOB-PRUNE
  JOB# @ 0= IF JOB-NO-SUCH EXIT THEN
  JOB-BY-SPEC DUP 0< IF DROP JOB-NO-SUCH EXIT THEN
  JOB-SEL !
  JOB-SEL @ .JOB-TEXT CR                         \ as both references do
  FLUSH-OUTPUT
  JOB-CONTROL? @ IF
    0 JOB-PIDS JOB-SEL @ CELLS + @ TCSETPGRP DROP
  THEN
  JOB-PIDS JOB-SEL @ CELLS + @ NEGATE 18 KILL DROP   \ SIGCONT to the group
  0 JOB-STATES JOB-SEL @ CELLS + !
  JOB-SEL @ JOB-WAIT-FG
  JOB-CONTROL? @ IF 0 SHELL-PGID @ TCSETPGRP DROP THEN ;

: DO-BG ( --- )
  JOB-PRUNE
  JOB# @ 0= IF JOB-NO-SUCH EXIT THEN
  JOB-BY-SPEC DUP 0< IF DROP JOB-NO-SUCH EXIT THEN
  JOB-SEL !
  JOB-PIDS JOB-SEL @ CELLS + @ NEGATE 18 KILL DROP
  0 JOB-STATES JOB-SEL @ CELLS + !
  91 EMIT JOB-NUMS JOB-SEL @ CELLS + @ 0 <# #S #> TYPE 93 EMIT 32 EMIT
  JOB-SEL @ .JOB-TEXT CR                       \ dash prints no trailing &
  0 LAST-STATUS ! ;

: FG-TEXT ( --- c-addr )   \ the command as typed, from ARGV
  0 FG-T !  0 FG-TEXT-BUF C!
  ARGC @ 0 ?DO
    FG-T @ IF 32 FG-TEXT-BUF FG-T @ + C! 1 FG-T +! THEN
    I ARGV@ DUP CSTRLEN                        ( addr u )
    DUP FG-T @ + JOB-TEXT-MAX 2 - > IF 2DROP ELSE
      DUP >R  FG-TEXT-BUF FG-T @ +  SWAP MOVE  R> FG-T +!
    THEN
  LOOP
  0 FG-TEXT-BUF FG-T @ + C!
  FG-TEXT-BUF ;

: FG-STOPPED ( pid --- )   \ a stopped foreground command becomes a job
  FG-TEXT JOB-TEXT-NEXT !
  JOB-ADD
  1 JOB-STATES JOB# @ 1- CELLS + !
  \ no newline first: the terminal has echoed ^C or ^Z and dash puts the
  \ notice on that same line
  JOB# @ 1- -1 .JOB-NOTICE                     \ -1 reads as "Stopped"
  148 LAST-STATUS ! ;

' FG-STOPPED IS FG-STOPPED-CALL

VARIABLE KJ-WANT
VARIABLE KJ-PID

: KILL-JOB-PID-IMPL ( c-addr --- pid | 0 )   \ %n, %% or not a job at all
  \ Written with variables after two stack-juggled versions crashed - the
  \ standing lesson of Iterations 308 and 317.
  DUP C@ 37 <> IF DROP 0 EXIT THEN
  1+                                           ( past the % )
  DUP C@ DUP 37 = SWAP 0= OR IF                \ `%%` or a bare `%`
    DROP
    JOB# @ 0= IF 0 EXIT THEN
    JOB-PIDS JOB# @ 1- CELLS + @ EXIT
  THEN
  DUP DUP CSTRLEN ALL-DECIMAL? 0= IF DROP 0 EXIT THEN
  DUP CSTRLEN PARSE-DECIMAL KJ-WANT !
  0 KJ-PID !
  JOB# @ 0 ?DO
    JOB-NUMS I CELLS + @ KJ-WANT @ = IF
      JOB-PIDS I CELLS + @ KJ-PID !
    THEN
  LOOP
  KJ-PID @ ;

' KILL-JOB-PID-IMPL IS KILL-JOB-PID

' DO-FG      S" fg"      BUILTIN
' DO-BG      S" bg"      BUILTIN

: REAP-QUIETLY ( --- )   \ collect finished children, remembering statuses
  BEGIN
    WAIT-NOHANG                              ( pid status )
    OVER 0= IF 2DROP EXIT THEN
    JOB-MARK-DONE
  AGAIN ;

' REAP-QUIETLY IS REAP-CALL

: JOB-STATUS-OF ( pid --- status | -1 )   \ a job already reaped
  JOB# @ 0 ?DO
    JOB-PIDS I CELLS + @ OVER = JOB-STATES I CELLS + @ 2 = AND IF
      DROP JOB-STATUS I CELLS + @ UNLOOP EXIT
    THEN
  LOOP DROP -1 ;

: JOB-FORGET-PID ( pid --- )   \ once `wait` has reported it
  JOB# @ 0 ?DO
    JOB-PIDS I CELLS + @ OVER = IF DROP I JOB-FORGET UNLOOP EXIT THEN
  LOOP DROP ;

' JOB-STATUS-OF IS JOB-STATUS-OF-CALL
' JOB-FORGET-PID IS JOB-FORGET-PID-CALL
' JOB-MARK-DONE IS JOB-MARK-DONE-CALL

' DO-JOBS    S" jobs"    BUILTIN

' DO-ALIAS   S" alias"   BUILTIN
' DO-UNALIAS S" unalias" BUILTIN
