\ PART 10 and an END-CROSS (`make native-k9` cuts it).
S" forth/extend.4" INCLUDED
S" forth/native-cross.4" INCLUDED
DECIMAL
N>A  S" forth/native-rt.4" INCLUDED  A>N
S" native-kcut9.4" INCLUDED
0 N-SKIPPING !  S" forth/kernel-native.4" INCLUDED  -1 N-SKIPPING !
S" tests/native/kernel-rc.4" INCLUDED
CR .( native-k9: forward calls waiting: ) N-UNRESOLVED CR
N>A  HERE-A CONSTANT ENTRY-T
rbp N-BASE N-MEMSZ @ + 64 - # mov,
ebx ebx xor,
rax N' S0 24 + N-ABS # mov,  rcx rbp mov,  rcx 8 # sub,  [ rax ] rcx mov,
rax N' DP 24 + N-ABS # mov,  rcx DP-T @ 256 + N-ABS # mov,  [ rax ] rcx mov,
N' MAIN call,
edi ebx mov,  eax 60 # mov,  syscall,
