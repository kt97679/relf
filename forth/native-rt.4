\ native-rt.4 - the native back end's runtime: CV8's primitives that are
\ routines rather than a few instructions, written in assembly as NCODE
\ words and called (docs/NATIVE.md; N1b, Iterations 611-612). Included by
\ a native build after forth/native.4, with TEXTORG defined.
\
\ The operating system's are raw system calls - no libc, as relfasm64 -
\ with CV8's results: a failure is ior 200, a fid of -1, CLOSE-FILE's -1,
\ as engine/cv8.c gives them; READ WRITE POLL return -errno, as there.

\ ---- the string primitives, in assembly --------------------------------------
NCODE MOVE  ( src dst u --- )   \ memmove: backward when dst overlaps above src
  rcx rbx mov,  rdi [ rbp ] mov,  rsi [ rbp 8 ] mov,
  \ under 16 bytes a byte loop (647): rep movsb is slow to start - forward,
  \ or from the end when dst is above src
  rcx 16 # cmp,  3 F jae,  rcx rcx test,  2 F jz,  rdi rsi cmp,  4 F ja,
  5 L:  eax [ rsi ] byte-ptr movzx,  [ rdi ] al mov,  rsi inc,  rdi inc,  rcx dec,  5 B jne,
  2 F jmp,
  4 L:  rcx dec,  eax [ rsi rcx *1 ] byte-ptr movzx,  [ rdi rcx *1 ] al mov,  rcx rcx test,  4 B jne,
  2 F jmp,
  3 L:  rdi rsi cmp,  1 F jbe,
  rax rsi mov,  rax rcx add,  rdi rax cmp,  1 F jae,
  rsi rcx add,  rsi 1 # sub,  rdi rcx add,  rdi 1 # sub,
  std,  rep, movsb,  cld,  2 F jmp,
  1 L:  rep, movsb,
  2 L:  rbx [ rbp 16 ] mov,  rbp 24 # add,
NEND
NCODE FILL  ( c-addr u c --- )
  rax rbx mov,  rcx [ rbp ] mov,  rdi [ rbp 8 ] mov,  rep, stosb,
  rbx [ rbp 16 ] mov,  rbp 24 # add,
NEND
NCODE COMPARE  ( c-addr1 u1 c-addr2 u2 --- n )   \ -1 0 1, as memcmp, then the lengths
  rsi [ rbp 16 ] mov,  rdi [ rbp ] mov,  rdx [ rbp 8 ] mov,
  rcx rdx mov,  rcx rbx cmp,  1 F jbe,  rcx rbx mov,  1 L:
  \ eight bytes at a time while they agree (626): repe cmpsb is microcoded,
  \ a byte a cycle; it is left only the last few, or the eight that differ
  7 L:  rcx 8 # cmp,  8 F jb,  rax [ rsi ] mov,  rax [ rdi ] cmp,  8 F jne,
        rsi 8 # add,  rdi 8 # add,  rcx 8 # sub,  7 B jmp,
  8 L:  rcx rcx test,  2 F jz,
  \ the last few, or the eight that differ: a byte loop (647) - repe cmpsb
  \ is slow to start, and a shell's names are mostly under eight bytes;
  \ unsigned, as memcmp: below at the first difference is -1
  9 L:  eax [ rsi ] byte-ptr movzx,  r8d [ rdi ] byte-ptr movzx,  eax r8d cmp,  3 F jne,
        rsi inc,  rdi inc,  rcx dec,  9 B jne,
  2 L:  rdx rbx cmp,  4 F jb,  5 F ja,  ebx ebx xor,  6 F jmp,
  3 L:  4 F jb,  5 F jmp,
  4 L:  rbx -1 # mov,  6 F jmp,
  5 L:  rbx 1 # mov,
  6 L:  rbp 24 # add,
NEND
NCODE SCAN  ( c-addr1 u1 c --- c-addr2 u2 )   \ from the first c, or the end and 0
  \ a byte loop (644): a shell scans short strings, and repne scasb is
  \ microcoded and slow to start - 6 % of fn and arith (tools/native-prof.py)
  rax rbx mov,  eax 255 # and,  rcx [ rbp ] mov,  rdi [ rbp 8 ] mov,
  1 L:  rcx rcx test,  2 F jz,
        edx [ rdi ] byte-ptr movzx,  edx eax cmp,  2 F je,
        rdi inc,  rcx dec,  1 B jmp,
  2 L:  [ rbp 8 ] rdi mov,  rbx rcx mov,  rbp 8 # add,
NEND
NCODE SHORT-FITS?  ( F H --- f )   \ (695) a jmp E9 or jcc 0F 8x before the rel32 at F,
  \ reaching H from F+4 in a signed byte
  r8 [ rbp ] mov,  rbp 8 # add,
  rbx r8 sub,  rbx 4 # sub,  rbx 128 # cmp,  1 F jae,
  [ r8 -1 ] byte-ptr 233 # cmp,  2 F je,
  [ r8 -2 ] byte-ptr 15 # cmp,  1 F jne,
  eax [ r8 -1 ] byte-ptr movzx,  eax 240 # and,  eax 128 # cmp,  1 F jne,
  2 L:  rbx -1 # mov,  3 F jmp,
  1 L:  ebx ebx xor,
  3 L:
NEND
NCODE RT-PUT  ( f t w tbl n --- )   \ (695) entry n of the relative fields' table at tbl
  rax rbx 24 # imul,  rax [ rbp ] add,
  rcx [ rbp 8 ] mov,  [ rax 16 ] rcx mov,
  rcx [ rbp 16 ] mov,  [ rax 8 ] rcx mov,
  rcx [ rbp 24 ] mov,  [ rax ] rcx mov,
  rbx [ rbp 32 ] mov,  rbp 40 # add,
NEND
NCODE SHORT-MOVE  ( tbl n F H --- H' f8 d )   \ (693, 695) the branch before the rel32 at F
  \ laid short: E9 -> EB (d 3) or 0F 8x -> 7x (d 4); every relative field
  \ the compiler recorded (kernel-native.4's RT+: field, target, width -
  \ three cells) that lies in the code from B = F+4 to H and aims out of
  \ it gains d, every one before it that aims into it loses d, and the
  \ entries follow the code; the code moved back d; the rel8 written.
  \ H' the new here, f8 the rel8's address. Was Forth until 695: 1.1 KB.
  r10 rbx mov,  r8 [ rbp ] mov,  rcx [ rbp 8 ] mov,  rdi [ rbp 16 ] mov,
  ebx 3 # mov,
  [ r8 -1 ] byte-ptr 233 # cmp,  1 F jne,
  [ r8 -1 ] byte-ptr 235 # mov,  2 F jmp,
  1 L:  eax [ r8 -1 ] byte-ptr movzx,  eax 16 # sub,  [ r8 -2 ] al mov,  ebx 4 # mov,
  2 L:  rsi [ r8 4 ] lea,
  3 L:  rcx rcx test,  9 F jz,
    r8 [ rdi ] mov,  r9 [ rdi 8 ] mov,
    edx edx xor,  r9 rsi cmp,  4 F jb,  r9 r10 cmp,  4 F ja,  edx 1 # mov,  4 L:      \ in_t: B <= t <= H
    eax eax xor,  r8 rsi cmp,  5 F jb,  r8 r10 cmp,  5 F jae,  eax 1 # mov,  5 L:     \ in_f: B <= f < H
    r11 r11 xor,
    eax eax test,  6 F jz,
      edx edx test,  7 F jnz,  r11 rbx mov,  7 F jmp,          \ in it, aimed out: +d
    6 L:  edx edx test,  7 F jz,  r8 rsi cmp,  7 F jae,  r11 rbx mov,  r11 neg,   \ before it, aimed in: -d
    7 L:  eax eax test,  1 F jz,  [ rdi ] rbx sub,  1 L:      \ the entry follows the code
          edx edx test,  2 F jz,  [ rdi 8 ] rbx sub,  2 L:
    r11 r11 test,  8 F jz,  rax r11 mov,
    [ rdi 16 ] byte-ptr 1 # cmp,  4 F jne,  [ r8 ] al add,  8 F jmp,
    4 L:  [ r8 ] eax add,
    8 L:  rdi 24 # add,  rcx dec,  3 B jmp,
  9 L:  r8 rsi mov,                                         \ B, kept: rep movsb moves rsi
  rdi rsi mov,  rdi rbx sub,  rcx r10 mov,  rcx rsi sub,  rep, movsb,      \ moved back
  rax r10 mov,  rax r8 sub,  r9 r8 mov,  r9 rbx sub,  r9 dec,  [ r9 ] al mov,   \ rel8: H - B
  r10 rbx sub,  [ rbp 16 ] r10 mov,  [ rbp 8 ] r9 mov,  rbp 8 # add,
NEND
NCODE CTABLE-FIND  ( c-addr table count width --- i | -1 )   \ the engines' (676)
  rsi [ rbp 16 ] mov,  rdi [ rbp 8 ] mov,  rcx [ rbp ] mov,  edx edx xor,
  1 L:  rdx rcx cmp,  4 F jae,
        r8 rdi mov,  r9 rsi mov,
  2 L:  eax [ r8 ] byte-ptr movzx,  r10d [ r9 ] byte-ptr movzx,
        eax r10d cmp,  3 F jne,
        eax eax test,  5 F jz,                \ both ended together: this one
        r8 inc,  r9 inc,  2 B jmp,
  3 L:  rdi rbx add,  rdx inc,  1 B jmp,      \ the next entry, width bytes on
  4 L:  rbx 1 NEGATE # mov,  6 F jmp,
  5 L:  rbx rdx mov,
  6 L:  rbp 24 # add,
NEND
NCODE CSTRLEN  ( c-addr --- u )
  \ eight bytes at a time (644): to an alignment by bytes - an aligned read
  \ never crosses into a page that is not there - then the zero-byte test,
  \ (x - 0x0101..) & ~x & 0x8080.., then the zero found in its word. repne
  \ scasb was 10-14 % of fn and arith (tools/native-prof.py).
  rdi rbx mov,
  \ (652) the first eight bytes in one load, where they lie in one page -
  \ an unaligned read inside a page cannot fault: a short string, most of
  \ a shell's, is then the load, the test and a bsf. Else, or no zero in
  \ them, the careful way from the start.
  eax edi mov,  eax 4095 # and,  eax 4088 # cmp,  1 F ja,
  r8 72340172838076673 # mov,  r9 -9187201950435737472 # mov,
  rax [ rdi ] mov,  rdx rax mov,  rax r8 sub,  rdx not,  rax rdx and,  rax r9 and,
  1 F jz,
  72 C,A 15 C,A 188 C,A 192 C,A          \ bsf rax, rax: the first zero's top bit
  eax 3 # shr,  rbx rax mov,  ret,
  1 L:  rax rdi mov,  eax 7 # and,  2 F jz,
        [ rdi ] byte-ptr 0 # cmp,  4 F je,
        rdi inc,  1 B jmp,
  2 L:  r8 72340172838076673 # mov,  r9 -9187201950435737472 # mov,
  3 L:  rax [ rdi ] mov,  rdx rax mov,  rax r8 sub,  rdx not,  rax rdx and,  rax r9 and,
        5 F jnz,  rdi 8 # add,  3 B jmp,
  5 L:  [ rdi ] byte-ptr 0 # cmp,  4 F je,  rdi inc,  5 B jmp,
  4 L:  rdi rbx sub,  rbx rdi mov,
NEND
NCODE TYPE  ( c-addr u --- )            \ write(1, ...)
  rdx rbx mov,  rsi [ rbp ] mov,  eax 1 # mov,  edi 1 # mov,  syscall,
  rbx [ rbp 8 ] mov,  rbp 16 # add,
NEND
\ ---- the operating system: what kernel.4 itself calls (Iteration 612) --------
LABEL open_modes
open_modes L:            \ engine/cv8.c's open_flags, in order - laid down before
577 Q,A  577 Q,A  0 Q,A  0 Q,A  2 Q,A  2 Q,A  1089 Q,A  1089 Q,A  578 Q,A  578 Q,A  193 Q,A
\ OPEN-FILE uses it: a forward label as an immediate is not resolved (asm64)
NCODE READ  ( c-addr u fd --- n )
  edi ebx mov,  rdx [ rbp ] mov,  rsi [ rbp 8 ] mov,  eax eax xor,  syscall,
  rbp 16 # add,  rbx rax mov,
NEND
NCODE WRITE  ( c-addr u fd --- n )
  edi ebx mov,  rdx [ rbp ] mov,  rsi [ rbp 8 ] mov,  eax 1 # mov,  syscall,
  rbp 16 # add,  rbx rax mov,
NEND
NCODE POLL  ( a-addr n ms --- n' )
  rdx rbx mov,  rsi [ rbp ] mov,  rdi [ rbp 8 ] mov,  eax 7 # mov,  syscall,
  rbp 16 # add,  rbx rax mov,
NEND
NCODE OPEN-FILE  ( c-addr u fam --- fid ior )   \ the name NUL-ended for the call
  rdi [ rbp 8 ] mov,  r8 rdi mov,  r8 [ rbp ] add,     \ r8: the byte after the name
  ecx [ r8 ] byte-ptr movzx,  [ r8 ] byte-ptr 0 # mov,
  rax -1 # mov,  rbx 11 # cmp,  1 F jae,               \ no such mode: -1
  rax open_modes ORG @ - N-START @ + # mov,  rsi [ rax rbx *8 ] mov,   \ the table's
  \ address at run time: its offset in the buffer plus where the buffer
  \ runs - the label itself where asm64's ORG is the load address (N1b),
  \ an offset where it is 0 (the native image, 616)
  edx 420 # mov,  eax 2 # mov,  syscall,               \ open(name, flags, 0644)
  1 L:  [ r8 ] cl mov,                                 \ the byte back
  rbp 8 # add,  rax rax test,  2 F js,
  [ rbp ] rax mov,  ebx ebx xor,  3 F jmp,
  2 L:  rax -1 # mov,  [ rbp ] rax mov,  ebx 200 # mov,
  3 L:
NEND
NCODE CLOSE-FILE  ( fid --- ior )   \ close's 0 or -1, as libc's
  edi ebx mov,  eax 3 # mov,  syscall,  rax rax test,  1 F jns,  rax -1 # mov,  1 L:  rbx rax mov,
NEND
NCODE REPOSITION-FILE  ( ud fid --- ior )
  edi ebx mov,  rsi [ rbp 8 ] mov,  edx edx xor,  eax 8 # mov,  syscall,   \ lseek SEEK_SET
  rbp 16 # add,  rax rax test,  ebx 0 # mov,  1 F jns,  ebx 200 # mov,  1 L:
NEND
NCODE FILE-POSITION  ( fid --- ud ior )
  edi ebx mov,  esi esi xor,  edx 1 # mov,  eax 8 # mov,  syscall,          \ lseek SEEK_CUR
  rbp 16 # sub,  ecx ecx xor,  [ rbp ] rcx mov,  rax rax test,  1 F js,
  [ rbp 8 ] rax mov,  ebx ebx xor,  2 F jmp,
  1 L:  [ rbp 8 ] rcx mov,  ebx 200 # mov,
  2 L:
NEND
NCODE SYS-EXIT  ( n --- )   edi ebx mov,  eax 60 # mov,  syscall,  NEND
NCODE BYE  ( --- )          edi edi xor,  eax 60 # mov,  syscall,  NEND
NCODE START-ADDR  ( --- a-addr )   N-PUSH  rbx N-START @ # mov,  NEND
N: !XT  SWAP START-ADDR - SWAP !  N;       \ kernel.4's: an xt as an offset
