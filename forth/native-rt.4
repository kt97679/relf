\ native-rt.4 - the native back end's runtime: CV8's primitives that are
\ routines rather than a few instructions, written in assembly as NCODE
\ words and called (docs/NATIVE.md; N1b, Iterations 611-612). Included by
\ a native build after forth/native.4, with TEXTORG defined.
\
\ The operating system's are raw system calls - no libc, as relfasm64 -
\ with CV8's results: a failure is ior 200, a fid of -1, CLOSE-FILE's -1,
\ as engine/cv8.c gives them; READ WRITE POLL return -errno, as there.

\ ---- the string primitives, in assembly --------------------------------------
NCODE MOVE  ( src dst u --- )   \ memmove: backward when dst overlaps above src
  rcx rbx mov,  rdi [ rbp ] mov,  rsi [ rbp 8 ] mov,
  rdi rsi cmp,  1 F jbe,
  rax rsi mov,  rax rcx add,  rdi rax cmp,  1 F jae,
  rsi rcx add,  rsi 1 # sub,  rdi rcx add,  rdi 1 # sub,
  std,  rep, movsb,  cld,  2 F jmp,
  1 L:  rep, movsb,
  2 L:  rbx [ rbp 16 ] mov,  rbp 24 # add,
NEND
NCODE FILL  ( c-addr u c --- )
  rax rbx mov,  rcx [ rbp ] mov,  rdi [ rbp 8 ] mov,  rep, stosb,
  rbx [ rbp 16 ] mov,  rbp 24 # add,
NEND
NCODE COMPARE  ( c-addr1 u1 c-addr2 u2 --- n )   \ -1 0 1, as memcmp, then the lengths
  rsi [ rbp 16 ] mov,  rdi [ rbp ] mov,  rdx [ rbp 8 ] mov,
  rcx rdx mov,  rcx rbx cmp,  1 F jbe,  rcx rbx mov,  1 L:
  rcx rcx test,  2 F jz,
  243 C,A 166 C,A                        \ repe cmpsb
  3 F jne,
  2 L:  rdx rbx cmp,  4 F jb,  5 F ja,  ebx ebx xor,  6 F jmp,
  3 L:  4 F jb,  5 F jmp,
  4 L:  rbx -1 # mov,  6 F jmp,
  5 L:  rbx 1 # mov,
  6 L:  rbp 24 # add,
NEND
NCODE SCAN  ( c-addr1 u1 c --- c-addr2 u2 )   \ from the first c, or the end and 0
  rax rbx mov,  rcx [ rbp ] mov,  rdi [ rbp 8 ] mov,
  rcx rcx test,  1 F jz,
  242 C,A 174 C,A                        \ repne scasb
  2 F je,
  1 L:  [ rbp 8 ] rdi mov,  ebx ebx xor,  3 F jmp,
  2 L:  rdi 1 # sub,  [ rbp 8 ] rdi mov,  rbx rcx mov,  rbx 1 # add,
  3 L:  rbp 8 # add,
NEND
NCODE CSTRLEN  ( c-addr --- u )
  rdi rbx mov,  eax eax xor,  rcx -1 # mov,  242 C,A 174 C,A  rcx not,  rcx 1 # sub,  rbx rcx mov,
NEND
NCODE TYPE  ( c-addr u --- )            \ write(1, ...)
  rdx rbx mov,  rsi [ rbp ] mov,  eax 1 # mov,  edi 1 # mov,  syscall,
  rbx [ rbp 8 ] mov,  rbp 16 # add,
NEND
\ ---- the operating system: what kernel.4 itself calls (Iteration 612) --------
LABEL open_modes
open_modes L:            \ engine/cv8.c's open_flags, in order - laid down before
577 Q,A  577 Q,A  0 Q,A  0 Q,A  2 Q,A  2 Q,A  1089 Q,A  1089 Q,A  578 Q,A  578 Q,A  193 Q,A
\ OPEN-FILE uses it: a forward label as an immediate is not resolved (asm64)
NCODE READ  ( c-addr u fd --- n )
  edi ebx mov,  rdx [ rbp ] mov,  rsi [ rbp 8 ] mov,  eax eax xor,  syscall,
  rbp 16 # add,  rbx rax mov,
NEND
NCODE WRITE  ( c-addr u fd --- n )
  edi ebx mov,  rdx [ rbp ] mov,  rsi [ rbp 8 ] mov,  eax 1 # mov,  syscall,
  rbp 16 # add,  rbx rax mov,
NEND
NCODE POLL  ( a-addr n ms --- n' )
  rdx rbx mov,  rsi [ rbp ] mov,  rdi [ rbp 8 ] mov,  eax 7 # mov,  syscall,
  rbp 16 # add,  rbx rax mov,
NEND
NCODE OPEN-FILE  ( c-addr u fam --- fid ior )   \ the name NUL-ended for the call
  rdi [ rbp 8 ] mov,  r8 rdi mov,  r8 [ rbp ] add,     \ r8: the byte after the name
  ecx [ r8 ] byte-ptr movzx,  [ r8 ] byte-ptr 0 # mov,
  rax -1 # mov,  rbx 11 # cmp,  1 F jae,               \ no such mode: -1
  rax open_modes ORG @ - N-START @ + # mov,  rsi [ rax rbx *8 ] mov,   \ the table's
  \ address at run time: its offset in the buffer plus where the buffer
  \ runs - the label itself where asm64's ORG is the load address (N1b),
  \ an offset where it is 0 (the native image, 616)
  edx 420 # mov,  eax 2 # mov,  syscall,               \ open(name, flags, 0644)
  1 L:  [ r8 ] cl mov,                                 \ the byte back
  rbp 8 # add,  rax rax test,  2 F js,
  [ rbp ] rax mov,  ebx ebx xor,  3 F jmp,
  2 L:  rax -1 # mov,  [ rbp ] rax mov,  ebx 200 # mov,
  3 L:
NEND
NCODE CLOSE-FILE  ( fid --- ior )   \ close's 0 or -1, as libc's
  edi ebx mov,  eax 3 # mov,  syscall,  rax rax test,  1 F jns,  rax -1 # mov,  1 L:  rbx rax mov,
NEND
NCODE REPOSITION-FILE  ( ud fid --- ior )
  edi ebx mov,  rsi [ rbp 8 ] mov,  edx edx xor,  eax 8 # mov,  syscall,   \ lseek SEEK_SET
  rbp 16 # add,  rax rax test,  ebx 0 # mov,  1 F jns,  ebx 200 # mov,  1 L:
NEND
NCODE FILE-POSITION  ( fid --- ud ior )
  edi ebx mov,  esi esi xor,  edx 1 # mov,  eax 8 # mov,  syscall,          \ lseek SEEK_CUR
  rbp 16 # sub,  ecx ecx xor,  [ rbp ] rcx mov,  rax rax test,  1 F js,
  [ rbp 8 ] rax mov,  ebx ebx xor,  2 F jmp,
  1 L:  [ rbp 8 ] rcx mov,  ebx 200 # mov,
  2 L:
NEND
NCODE SYS-EXIT  ( n --- )   edi ebx mov,  eax 60 # mov,  syscall,  NEND
NCODE BYE  ( --- )          edi edi xor,  eax 60 # mov,  syscall,  NEND
NCODE START-ADDR  ( --- a-addr )   N-PUSH  rbx N-START @ # mov,  NEND
N: !XT  SWAP START-ADDR - SWAP !  N;       \ kernel.4's: an xt as an offset
