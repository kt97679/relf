\ native.4 - a Forth compiler that lays down x86-64 machine code
\ (docs/NATIVE.md; N1a, Iteration 610).
\
\ It runs on the CV8 system, after forth/asm64.4, and lays its code into
\ asm64's buffer - as engine/relfasm64.4 lays the assembly engine. N1 is
\ plain native code: each primitive a fixed instruction sequence, each
\ colon definition a native function, no optimizer yet (that is N2).
\
\ The registers (NATIVE.md 3.1):
\   rsp   the return stack - the machine stack: a word is `call`ed and
\         left with `ret`
\   r15   the data stack, in memory, below the top; it grows down
\   rbx   the top of the data stack
\
\ Words in two word lists, apart from the host's:
\   NPRIMS   the primitives - host words that, run while a target word is
\            compiled, lay down that primitive's code; the control words
\            (IF THEN ... RECURSE EXIT) are here too
\   NTARGET  the words compiled for the target - host words that answer
\            the target address of their code
\
\ N: name ... N;  compiles a target word: a primitive's name runs it, a
\ target word's name lays down a call to it, a number a literal.

ALSO ASSEMBLER
BASE @ DECIMAL

WORDLIST CONSTANT NPRIMS
WORDLIST CONSTANT NTARGET
WORDLIST CONSTANT NCTRL      \ compile-time words - IF DO ." - searched first (617+)
VARIABLE N-SELF              \ the target word being compiled: RECURSE
CREATE N-LASTWORD 34 ALLOT   \ the word being looked up, for a message
VARIABLE N-UNKNOWN           \ a host xt ( c-addr --- f ) asked first about an
                             \ unknown word: the cross compiler's forwards (622)
VARIABLE N-START             \ the image's base: @XT and !XT count from it
4194304 N-START !            \ 0x400000, until a build says otherwise

\ ---- the stack, and the jumps the control words patch -----------------------
: N-PUSH ( --- )  r15 8 # sub,  [ r15 ] rbx mov, ;     \ the top into memory
: N-POP ( --- )   rbx [ r15 ] mov,  r15 8 # add, ;     \ the next becomes the top
: N-LIT ( n --- )   \ (694) the shortest load that holds it, as LIT, at run time (687, 692):
  \ 0 by xor ebx,ebx (2 bytes), 1 to 2^31-1 by mov ebx,imm32 (5, zero-extended),
  \ the rest as before - mov rbx,imm32 (7) or movabs. The kernel's own code
  \ is laid here, by the cross compiler, whose code is not in the image.
  >R N-PUSH
  R@ 0= IF  R> DROP  ebx ebx xor,  EXIT  THEN
  R@ 0> R@ 2147483648 < AND IF  ebx R> # mov,  EXIT  THEN
  rbx R> # mov, ;
: N-FLAG ( --- )  rax rbx mov,  N-POP  rax rax test, ; \ the flag, taken off
: N-ADDR ( buf --- addr ) ABUF @ - ORG @ + ;           \ a buffer place's address
: N-FWD ( op1 op2 --- fix )   \ a jump with its 32-bit displacement to come;
  SWAP ?DUP IF C,A THEN C,A  THERE @  0 L,A ;          \ op1 0: a one-byte opcode
: N-RESOLVE ( fix --- )       \ ... jumps here
  HERE-A OVER N-ADDR 4 + -  SWAP L! ;
: N-BACK ( target op1 op2 --- )   \ a jump back to target
  SWAP ?DUP IF C,A THEN C,A  HERE-A 4 + - L,A ;

\ ---- the primitives -------------------------------------------------------------
\ CV8's names (engine/opcodes.tab), so kernel.4 can be compiled against
\ them in N1c. N1b (Iteration 611): the computational core, each a fixed
\ sequence; a comparison leaves -1 or 0, as CV8's do.
: N-WORD ( --- c-addr )   \ the next name, across lines
  BEGIN BL WORD DUP C@ 0= WHILE DROP REFILL 0= ABORT" native: input ended inside N:" REPEAT ;
VARIABLE N-LEAVES            \ the innermost loop's LEAVE jumps, chained
: N-0CC ( --- )  ebx 0 # mov, ;                          \ flags kept: mov
: N-CMP ( --- )  rax [ r15 ] mov,  r15 8 # add,  rax rbx cmp,  N-0CC ;
: N-TRUE ( --- ) rbx neg, ;                              \ 1 -> -1
: N-LEAVE-ADD ( fix --- )   \ a jump to the loop's exit: a node, fix and next,
  HERE SWAP , N-LEAVES @ , N-LEAVES ! ;   \ in the host's memory, not the code's
: N-LOOP-END ( outer --- )   \ every exit jump resolved; the outer loop's chain back
  N-LEAVES @ BEGIN ?DUP WHILE DUP @ N-RESOLVE CELL+ @ REPEAT  N-LEAVES ! ;
CURRENT @  NPRIMS CURRENT !
: DUP   N-PUSH ;
: DROP  N-POP ;
: SWAP  rax [ r15 ] mov,  [ r15 ] rbx mov,  rbx rax mov, ;
: OVER  N-PUSH  rbx [ r15 8 ] mov, ;
: ROT   rax [ r15 8 ] mov,  rcx [ r15 ] mov,  [ r15 8 ] rcx mov,  [ r15 ] rbx mov,  rbx rax mov, ;
: ?DUP  rbx rbx test,  1 F jz,  N-PUSH  1 L: ;
: 2DUP  rax [ r15 ] mov,  r15 16 # sub,  [ r15 8 ] rbx mov,  [ r15 ] rax mov, ;
: 2DROP rbx [ r15 8 ] mov,  r15 16 # add, ;
: +     rbx [ r15 ] add,  r15 8 # add, ;
: -     rax [ r15 ] mov,  rax rbx sub,  rbx rax mov,  r15 8 # add, ;
: AND   rbx [ r15 ] and,  r15 8 # add, ;
: OR    rbx [ r15 ] or,   r15 8 # add, ;
: XOR   rbx [ r15 ] xor,  r15 8 # add, ;
: NEGATE  rbx neg, ;
: 1+    rbx 1 # add, ;
: 1-    rbx 1 # sub, ;
: CELL+ rbx 8 # add, ;
: CELLS rbx 3 # shl, ;
: LSHIFT  rcx rbx mov,  N-POP  rbx cl shl, ;
: RSHIFT  rcx rbx mov,  N-POP  rbx cl shr, ;
: *     rbx [ r15 ] imul,  r15 8 # add, ;
: /MOD  rax [ r15 ] mov,  72 C,A 153 C,A  rbx idiv,      \ cqo: rdx:rax
        [ r15 ] rdx mov,  rbx rax mov, ;                 \ ( rem quot )
: UM*   rax [ r15 ] mov,  rbx mul,  [ r15 ] rax mov,  rbx rdx mov, ;
: UM/MOD  rdx [ r15 ] mov,  rax [ r15 8 ] mov,  rbx div,
        r15 8 # add,  [ r15 ] rdx mov,  rbx rax mov, ;   \ ( rem quot )
: D+    rax [ r15 ] mov,  [ r15 16 ] rax add,  rbx [ r15 8 ] adc,  r15 16 # add, ;
: =     N-CMP  bl sete,  N-TRUE ;
: <>    N-CMP  bl setne, N-TRUE ;
: <     N-CMP  bl setl,  N-TRUE ;
: >     N-CMP  bl setg,  N-TRUE ;
: U<    N-CMP  bl setb,  N-TRUE ;
: 0=    rbx rbx test,  N-0CC  bl sete,  N-TRUE ;
: 0<    rbx 63 # sar, ;
: @     rbx [ rbx ] mov, ;
: !     rax [ r15 ] mov,  [ rbx ] rax mov,  rbx [ r15 8 ] mov,  r15 16 # add, ;
: C@    ebx [ rbx ] byte-ptr movzx, ;
: C!    rax [ r15 ] mov,  [ rbx ] al mov,  rbx [ r15 8 ] mov,  r15 16 # add, ;
: +!    rax [ r15 ] mov,  [ rbx ] rax add,  rbx [ r15 8 ] mov,  r15 16 # add, ;
: COUNT rax rbx mov,  rbx 1 # add,  N-PUSH  ebx [ rax ] byte-ptr movzx, ;
: >R    rbx push,  N-POP ;
: R>    N-PUSH  rbx pop, ;
: R@    N-PUSH  rbx [ rsp ] mov, ;
: EXECUTE  rax rbx mov,  N-POP  rax call, ;
: EMIT  [ r15 -8 ] rbx mov,                              \ write(1, the byte, 1)
        eax 1 # mov,  edi 1 # mov,  rsi [ r15 -8 ] lea,  edx 1 # mov,  syscall,
        N-POP ;
CURRENT !
\ The compile-time words, in NCTRL, searched before the target's words:
\ kernel.4 defines target words named IF and DO, for its own compiler,
\ and a definition after them must still get these (Iteration 618).
CURRENT @  NCTRL CURRENT !
\ control: laid down as jumps, patched when the structure closes
: IF    N-FLAG  15 132 N-FWD ;                           \ jz near
: ELSE  0 233 N-FWD  SWAP N-RESOLVE ;                    \ jmp near
: THEN  N-RESOLVE ;
: BEGIN HERE-A ;
: UNTIL N-FLAG  15 132 N-BACK ;
: AGAIN 0 233 N-BACK ;
: WHILE N-FLAG  15 132 N-FWD  SWAP ;                     \ ( dest --- orig dest )
: REPEAT  0 233 N-BACK  N-RESOLVE ;
: RECURSE  N-SELF @ call, ;
: EXIT  195 C,A ;                                        \ ret
\ DO LOOP: the counter at the top of the return stack - the machine
\ stack - and the limit under it, as CV8 keeps them (kernel.4's (DO));
\ LEAVE's jumps chained in N-LEAVES and resolved at the loop's end
: DO    rax [ r15 ] mov,  rax push,  rbx push,  rbx [ r15 8 ] mov,  r15 16 # add,
        N-LEAVES @  0 N-LEAVES !  HERE-A ;               \ ( leaves dest )
: ?DO   rax [ r15 ] mov,  rcx rbx mov,  rbx [ r15 8 ] mov,  r15 16 # add,
        rax rcx cmp,  15 132 N-FWD                       \ start = limit: skip
        N-LEAVES @ SWAP  0 N-LEAVES !  N-LEAVE-ADD       \ ( outer )
        rax push,  rcx push,  HERE-A ;
: LOOP  ( leaves dest --- )
        rax [ rsp ] mov,  rax 1 # add,  [ rsp ] rax mov,  rax [ rsp 8 ] cmp,
        15 133 N-BACK                                    \ jne back
        rsp 16 # add,  N-LOOP-END ;
: +LOOP ( leaves dest --- )   \ kernel.4's (+LOOP): out when x = index - limit
        rax rbx mov,  N-POP                              \ changes sign, against n
        rcx [ rsp ] mov,  rdx rcx mov,  rdx [ rsp 8 ] sub,   \ rdx: x
        rcx rax add,  [ rsp ] rcx mov,                   \ the new index
        r8 rdx mov,  r8 rax add,  r8 rdx xor,  rdx rax xor,  r8 rdx and,
        15 137 N-BACK                                    \ jns back: not crossed
        rsp 16 # add,  N-LOOP-END ;
: I     N-PUSH  rbx [ rsp ] mov, ;
: J     N-PUSH  rbx [ rsp 16 ] mov, ;
: UNLOOP  rsp 16 # add, ;
: LEAVE rsp 16 # add,  0 233 N-FWD  N-LEAVE-ADD ;
: [']   N-WORD COUNT NTARGET SEARCH-WORDLIST 0= ABORT" native: ['] of no target word"
        >BODY @ N-LIT ;
CURRENT !
\ back to NPRIMS: the pointer words and @XT, data primitives
CURRENT @  NPRIMS CURRENT !
: SP@   N-PUSH  rbx r15 mov, ;                           \ the old top's cell, as CV8's
: SP!   r15 rbx mov,  N-POP ;                            \ the top: the cell there
: RP@   N-PUSH  rbx rsp mov, ;                           \ the return stack: the machine's
: RP!   rsp rbx mov,  N-POP ;
: @XT   rbx [ rbx ] mov,  rbx N-START @ # add, ;         \ an offset, plus the image base
: NOOP  ;
\ inline templates for kernel.4's PRIMITIVE EXIT and I (623): without one
\ they were stubs, and the target's compiler copies what PRIMITIVE laid
: EXIT  195 C,A ;
: I     N-PUSH  rbx [ rsp ] mov, ;
CURRENT !

\ A target word written in assembly: NCODE name ... NEND. Called, never
\ inlined: the string primitives, too big to repeat at every use.
\ The routines' map (643): every NCODE and N-MARK records its name and
\ address - the code before the dictionary has no headers - for
\ tools/native-prof.py; a build writes the map with N-WRITE-MAP. Recorded
\ BEFORE CREATE: a shadow's cells must follow its header (619).
VARIABLE N-MAP                \ nodes: [next][address][counted name]
CREATE N-MARKNAME 34 ALLOT
: N-MARK ( "name" --- )   \ record the next name at HERE-A, the input left before it
  \ WORD's buffer is at HERE here: the name copied aside before a cell is
  \ laid, or the node's link lands on it (643 - the map's first names were
  \ node cells); native-cross.4's N-PEEK-NAME does the same
  >IN @  BL WORD COUNT 31 MIN DUP N-MARKNAME C!  N-MARKNAME 1+ SWAP MOVE  >IN !
  HERE N-MAP @ , HERE-A , N-MAP !
  N-MARKNAME DUP C@ 1+ 0 DO DUP I + C@ C, LOOP DROP ALIGN ;
CREATE N-LINE 96 ALLOT   VARIABLE N-LEN   VARIABLE N-FID
: N-PUT ( c-addr u --- )  DUP >R  N-LINE N-LEN @ + SWAP MOVE  R> N-LEN +! ;
: N-WRITE-MAP ( c-addr u base --- )   \ a line per routine: its address in hex, its name
  >R  W/O CREATE-FILE THROW N-FID !
  BASE @ HEX
  N-MAP @ BEGIN ?DUP WHILE
    0 N-LEN !
    DUP CELL+ @ ORG @ - R@ +  0 <# #S #> N-PUT  S"  " N-PUT
    DUP 2 CELLS + COUNT N-PUT
    N-LINE N-LEN @ N-FID @ WRITE-LINE THROW
    @
  REPEAT
  BASE !  R> DROP  N-FID @ CLOSE-FILE THROW ;
: NCODE ( "name" --- )   \ its shadow, found while compiling, lays a call to it
  N-MARK  CURRENT @ >R  NTARGET CURRENT !  CREATE  R> CURRENT !  HERE-A ,  DOES> @ call, ;
: NEND ( --- )  195 C,A ;

\ ---- compiling a target word ------------------------------------------------------
: N-COMPILE ( --- )
  BEGIN
    N-WORD
    DUP COUNT S" N;" COMPARE 0= OVER COUNT S" T;" COMPARE 0= OR
    OVER COUNT S" ;" COMPARE 0= OR
      IF DROP 195 C,A EXIT THEN                              \ ret
    DUP COUNT S" \" COMPARE 0= IF DROP SOURCE NIP >IN ! ELSE    \ a comment to the line's end
    DUP COUNT S" (" COMPARE 0= IF DROP 41 WORD DROP ELSE         \ ( a comment )
    DUP COUNT NCTRL SEARCH-WORDLIST IF NIP EXECUTE ELSE       \ IF DO ." ...
    DUP COUNT NTARGET SEARCH-WORDLIST IF NIP EXECUTE ELSE     \ the target's: it lays itself
    DUP COUNT NPRIMS SEARCH-WORDLIST IF NIP EXECUTE ELSE
    DUP N-LASTWORD OVER C@ 1+ MOVE              \ NUMBER? may use WORD's buffer
    \ NUMBER? that fails leaves five cells, not ( d f ) - the rest of the
    \ string too: the stack as it was is put back (Iteration 622; an IF's
    \ patch under it went with the extra cells, and the host fell over)
    SP@ >R
    DUP NUMBER? IF DROP NIP N-LIT R> DROP ELSE
      \ The build ends here, with the name said: ABORT's restart in the bare
      \ host, with a definition half made, did not come back (Iteration 620)
      R> SP! DROP
      N-UNKNOWN @ IF N-LASTWORD N-UNKNOWN @ EXECUTE ELSE 0 THEN
      0= IF CR ." native: unknown word " N-LASTWORD COUNT TYPE CR BYE THEN
    THEN THEN THEN THEN THEN THEN
  AGAIN ;
: N: ( "name" --- )
  CURRENT @ >R  NTARGET CURRENT !  CREATE  R> CURRENT !
  HERE-A DUP ,  N-SELF !  N-COMPILE
  DOES> @ call, ;
: T: ( "name" --- ) N: ;     \ the dialect a differential test is written in
: N' ( "name" --- addr )   \ a target word's address: its shadow's first cell
  BL WORD COUNT NTARGET SEARCH-WORDLIST 0= ABORT" native: no such target word" >BODY @ ;

BASE !
