\ tree.4 - the shell's lexer and parser: a complete command at a time,
\ into a tree. Stage A of COMMAND-TREE-PLAN.md (Iteration 263): the tree
\ is built and printed, not yet executed. Loaded after shell.4.
\
\ Words here are called recursively - `$(...)` is lexed by parsing its
\ contents - and a syntax error unwinds with THROW (extend.4). So no word
\ in this file uses shadow.4's SHADOW{ locals, which THROW would leave
\ unrestored: per-call state lives on the data and return stacks, and
\ globals hold only the current token and the input.

\ ==================================================================
\ The tree arena
\ ==================================================================
\ A growable buffer addressed by OFFSETS, so it may move while it grows.
\ A node is a type cell followed by field cells. Offset 0 is never a
\ node (the arena starts with a zero cell), so 0 means "none".

1 CONSTANT T-WORD       \ fields: text, flags
2 CONSTANT T-VEC        \ fields: count, items...
3 CONSTANT T-LIST       \ fields: vec of (and-or, separator) pairs
4 CONSTANT T-ANDOR      \ fields: vec of pipeline, op, pipeline, ...
5 CONSTANT T-PIPE       \ fields: bang, vec of commands
6 CONSTANT T-SIMPLE     \ fields: vec of (tag, node) pairs
7 CONSTANT T-SUBSHELL   \ fields: redirs, body
8 CONSTANT T-GROUP      \ fields: redirs, body
9 CONSTANT T-IF         \ fields: redirs, vec of cond/body, else
10 CONSTANT T-WHILE     \ fields: redirs, cond, body
11 CONSTANT T-UNTIL     \ fields: redirs, cond, body
12 CONSTANT T-FOR       \ fields: redirs, name, words (0: "$@"), body
13 CONSTANT T-CASE      \ fields: redirs, word, vec of items
14 CONSTANT T-CASEITEM  \ fields: vec of patterns, body (0: none)
15 CONSTANT T-FUNCDEF   \ fields: redirs, name, body
16 CONSTANT T-REDIR     \ fields: fd (-1: default), op, word, here-doc text

\ SIMPLE item tags
0 CONSTANT I-ASSIGN
1 CONSTANT I-WORD
2 CONSTANT I-REDIR

\ word flags
1 CONSTANT WF-QUOTED     \ some part is quoted or escaped
2 CONSTANT WF-NAME-Q     \ the first character is a quote or backslash
4 CONSTANT WF-EXPAND     \ contains $ or `
8 CONSTANT WF-SPECIAL    \ contains ~ * ? or a closed [...] (Iterations 266, 267)
16 CONSTANT WF-BRACKET   \ scanning: a [ was seen
32 CONSTANT WF-ENC-SIMPLE \ its encoding holds only what Stage B expands
64 CONSTANT WF-AT-PARAM   \ it holds $@ or $*, whose fields are its own

256 BUFFER: TREE-BUF
VARIABLE TREE-TOP

: TREE-RESET ( --- )   0 TREE-BUF !  1 CELLS TREE-TOP ! ;
: TREE-ALLOT ( n --- off )   \ n bytes, zeroed, at an aligned offset
  ALIGNED TREE-TOP @ SWAP                   ( off n )
  2DUP + DUP ENSURE-BUFFER TREE-BUF TREE-TOP !
  OVER TREE-BUF + SWAP 0 FILL ;
: T@ ( off --- x )   TREE-BUF + @ ;
: T! ( x off --- )   TREE-BUF + ! ;
: NODE ( type nfields --- off )
  1+ CELLS TREE-ALLOT  TUCK T! ;
: F@ ( off i --- x )   1+ CELLS + T@ ;
: F! ( x off i --- )   1+ CELLS + T! ;
: TSTR ( off --- c-addr )   TREE-BUF + ;   \ a string's address, for now

\ The vector builder: items are pushed on a stack of cells and made into
\ a T-VEC node in one piece. Builders nest - a vector is built while an
\ outer one is still open - so each remembers its base.
256 BUFFER: VEC-BUF
VARIABLE VEC-TOP

: >VEC ( x --- )
  VEC-TOP @ 1+ CELLS ENSURE-BUFFER VEC-BUF
  VEC-BUF VEC-TOP @ CELLS + !  1 VEC-TOP +! ;
: VEC-MARK ( --- base )   VEC-TOP @ ;
: VEC> ( base --- off )
  VEC-TOP @ OVER -                          ( base n )
  DUP 2 + CELLS TREE-ALLOT                  ( base n off )
  T-VEC OVER T!  2DUP CELL+ T!              ( base n off )
  SWAP 0 ?DO                                ( base off )
    OVER I + CELLS VEC-BUF + @
    OVER I 2 + CELLS + T!
  LOOP
  SWAP VEC-TOP ! ;
: V# ( vec --- n )   CELL+ T@ ;
: V@ ( vec i --- x )   2 + CELLS + T@ ;

\ ==================================================================
\ The input
\ ==================================================================
\ A whole text (a script file, a -c string, eval's or $(...)'s text), or
\ standard input, read a line at a time when the lexer needs more - a
\ shell must not read past the line it is running, since the commands
\ it runs may read the rest (Iteration 264). The lexer never looks past
\ a newline it has not yet returned, so a command runs before the next
\ line is asked for.
VARIABLE SRC-ADDR
VARIABLE SRC-LEN
VARIABLE SRC-POS
VARIABLE SRC-LINE
VARIABLE SRC-STDIN?     \ reading standard input
VARIABLE SRC-EOF?       \ ... and it has ended
VARIABLE INTERACTIVE?   \ standard input is a terminal: prompts, no exit on errors
VARIABLE CMD-START?     \ the next line read begins a command: "$ ", else "> "
\ alias state (see TRY-ALIAS)
VARIABLE NO-ALIAS?
VARIABLE ALIAS-NEXT?     \ a value ended in a blank: the word at ALIAS-NEXT-AT is a candidate
VARIABLE ALIAS-NEXT-AT
VARIABLE SRC-SPLICED     \ the heap block a splice copied the source into, or 0
16 CONSTANT MAX-ALIAS-NEST
CREATE AL-ACTIVE  MAX-ALIAS-NEST 2* CELLS ALLOT   \ (alias, end offset) pairs
VARIABLE AL-ACTIVE#
LINE-MAX BUFFER: STDIN-TEXT

: REFILL-STDIN ( --- f )   \ one more line of standard input, or false
  SRC-EOF? @ IF 0 EXIT THEN
  INTERACTIVE? @ IF
    CMD-START? @ IF SH-PROMPT ELSE S" > " ERR-TYPE THEN
  THEN
  0 CMD-START? !
  SRC-LEN @ BUFFER-BODY STDIN-TEXT 0 READ-LINE-INTO     ( u flag )
  0= IF DROP -1 SRC-EOF? ! 0 EXIT THEN
  SRC-LEN @ + DUP 2 + ENSURE-BUFFER STDIN-TEXT
  10 OVER STDIN-TEXT + C!  1+ SRC-LEN !
  STDIN-TEXT SRC-ADDR !  -1 ;

: SRC-C ( i --- c | -1 )   \ the character i past the position
  BEGIN
    DUP SRC-POS @ + SRC-LEN @ < 0=
  WHILE
    SRC-STDIN? @ 0= IF DROP -1 EXIT THEN
    REFILL-STDIN 0= IF DROP -1 EXIT THEN
  REPEAT
  SRC-POS @ + SRC-ADDR @ + C@ ;
: SRC-SKIP ( n --- )
  0 ?DO
    SRC-POS @ SRC-LEN @ < IF
      SRC-POS @ SRC-ADDR @ + C@ 10 = IF 1 SRC-LINE +! THEN
      1 SRC-POS +!
    THEN
  LOOP ;

\ ==================================================================
\ Errors
\ ==================================================================
\ A syntax error is reported and THROWn; the complete command is lost.
1 CONSTANT E-SYNTAX

: SYNTAX ( c-addr u --- )
  S" shell: syntax error at line " ERR-TYPE
  SRC-LINE @ N>STR DUP CSTRLEN ERR-TYPE
  S" : " ERR-TYPE ERR-TYPE ERR-NL
  E-SYNTAX THROW ;

\ ==================================================================
\ Tokens
\ ==================================================================
1 CONSTANT K-WORD
2 CONSTANT K-NEWLINE
3 CONSTANT K-EOF
4 CONSTANT K-OP
5 CONSTANT K-IONUM

1 CONSTANT OP-SEMI       2 CONSTANT OP-AMP        3 CONSTANT OP-PIPE
4 CONSTANT OP-AND        5 CONSTANT OP-OR         6 CONSTANT OP-DSEMI
7 CONSTANT OP-LPAREN     8 CONSTANT OP-RPAREN
9 CONSTANT OP-LESS      10 CONSTANT OP-GREAT     11 CONSTANT OP-DGREAT
12 CONSTANT OP-LESSAND  13 CONSTANT OP-GREATAND  14 CONSTANT OP-LESSGREAT
15 CONSTANT OP-DLESS    16 CONSTANT OP-DLESSDASH 17 CONSTANT OP-CLOBBER

VARIABLE TK-KIND
VARIABLE TK-OP
VARIABLE TK-START
VARIABLE TK-END
VARIABLE TK-FLAGS
VARIABLE TK-VALID?

: TK-TEXT ( --- c-addr u )   SRC-ADDR @ TK-START @ +  TK-END @ TK-START @ - ;

: BLANK? ( c --- f )   DUP 32 = SWAP 9 = OR ;
: OP-CHAR? ( c --- f )
  DUP 59 = OVER 38 = OR OVER 124 = OR OVER 40 = OR
  OVER 41 = OR OVER 60 = OR SWAP 62 = OR ;

\ ---- here-documents waiting for their bodies ----
256 BUFFER: HD-PEND
VARIABLE HD-PEND#
256 BUFFER: HD-TEXT
VARIABLE HD-TEXT#

: HD-ADD ( redir --- )
  HD-PEND# @ 1+ CELLS ENSURE-BUFFER HD-PEND
  HD-PEND HD-PEND# @ CELLS + !  1 HD-PEND# +! ;
: HD-APPEND ( c-addr u --- )
  HD-TEXT# @ OVER + 1+ ENSURE-BUFFER HD-TEXT
  HD-TEXT HD-TEXT# @ + SWAP DUP HD-TEXT# +! MOVE ;

DEFER PARSE-SUBLIST   \ for $(...): parse a compound list up to `)`

\ ---- words encoded while they are scanned ----
\ EXPANSION-PLAN.md Stage A (Iteration 274). The scanners below already
\ walk every construct with the right rules; each now also writes the
\ word's encoded form into ENC-BUF, which TOKEN-WORD copies into the
\ tree. Every control sequence starts with ENC-CTL, so a literal run is
\ one SCAN and one MOVE for the expander to come; a literal ENC-CTL byte
\ in the text is written twice.
129 CONSTANT ENC-CTL
0 CONSTANT ENC-END        \ ends a run, a name, a word or an expression
1 CONSTANT ENC-SQ         \ a single-quoted run: nothing inside is special
2 CONSTANT ENC-DQ         \ a double-quoted run: expansions still apply
3 CONSTANT ENC-ESC        \ one quoted character follows
4 CONSTANT ENC-VAR        \ an operator byte, a NUL-terminated name,
                          \ and for the operator forms a word and ENC-END
5 CONSTANT ENC-ARITH      \ $((...)): the expression, raw, then ENC-END
6 CONSTANT ENC-CMDSUB     \ one byte: which substitution of this word
7 CONSTANT ENC-TILDE      \ a position byte, the user name, ENC-END

\ ENC-VAR's operator byte
0 CONSTANT EV-PLAIN
1 CONSTANT EV-LENGTH
2 CONSTANT EV-DEFAULT
3 CONSTANT EV-ASSIGN
4 CONSTANT EV-ERROR
5 CONSTANT EV-ALT
8 CONSTANT EV-COLON       \ added to the four above: the : forms
16 CONSTANT EV-TRIM-PRE
17 CONSTANT EV-TRIM-PRE-LONG
18 CONSTANT EV-TRIM-SUF
19 CONSTANT EV-TRIM-SUF-LONG

\ ENC-TILDE's position byte: the expander expands the first always, the
\ others only in an assignment word
0 CONSTANT ET-START
1 CONSTANT ET-AFTER-EQ
2 CONSTANT ET-AFTER-COLON

1024 BUFFER: ENC-BUF
VARIABLE ENC#
VARIABLE ENC-MUTE         \ inside a raw region: the codes are not written
VARIABLE ENC-SUBS         \ command substitutions recorded so far
VARIABLE ENC-BASE         \ where this word's encoding starts in ENC-BUF
VARIABLE ENC-COMPLEX?     \ this word holds what Stage B cannot expand yet
VARIABLE ENC-SUB-BASE     \ ... and its first substitution slot: the words
                          \ inside a $(...) are lexed too, and append here

: ENC-PUT ( c --- )       \ unconditionally
  ENC# @ 1+ ENSURE-BUFFER ENC-BUF  ENC-BUF ENC# @ + C!  1 ENC# +! ;
: ENC-C, ( c --- )        ENC-MUTE @ IF DROP EXIT THEN ENC-PUT ;
: ENC-CODE, ( code --- )  ENC-MUTE @ IF DROP EXIT THEN ENC-CTL ENC-PUT ENC-PUT ;
: ENC-LIT, ( c --- )      \ a literal byte of the word's text
  ENC-MUTE @ IF DROP EXIT THEN
  DUP ENC-CTL = IF ENC-CTL ENC-PUT THEN ENC-PUT ;
VARIABLE ER-I
VARIABLE ER-END
: ENC-RAW ( from to --- )
  \ The source text as it stands, line continuations dropped. Only the
  \ outermost raw region copies: the ones nested in it are muted, and it
  \ copies their text along with its own.
  ENC-MUTE @ IF 2DROP EXIT THEN
  ER-END !  ER-I !
  BEGIN ER-I @ ER-END @ < WHILE
    ER-I @ SRC-ADDR @ + C@
    DUP 92 = ER-I @ 1+ ER-END @ < AND IF
      ER-I @ 1+ SRC-ADDR @ + C@ 10 = IF
        DROP 2 ER-I +!                     \ a continuation: neither byte
      ELSE
        DUP ENC-CTL = IF ENC-CTL ENC-PUT THEN ENC-PUT  1 ER-I +!
      THEN
    ELSE
      DUP ENC-CTL = IF ENC-CTL ENC-PUT THEN ENC-PUT  1 ER-I +!
    THEN
  REPEAT ;

\ Each command substitution in a word is recorded once - the ones nested
\ inside another's text belong to it - as the source range of its text,
\ which TOKEN-WORD copies into the tree.
64 BUFFER: ENC-SUB-POS    \ (start, end) source positions, a pair each
: ENC-SUB-BEGIN ( --- )   \ before muting: at the start of the text
  ENC-MUTE @ IF EXIT THEN
  -1 ENC-COMPLEX? !
  ENC-CMDSUB ENC-CODE,  ENC-SUBS @ ENC-SUB-BASE @ - ENC-C,
  ENC-SUBS @ 1+ 2* CELLS ENSURE-BUFFER ENC-SUB-POS
  SRC-POS @ ENC-SUB-POS ENC-SUBS @ 2* CELLS + !
  1 ENC-SUBS +! ;
: ENC-SUB-END ( --- )     \ after unmuting: past the closing ) or `
  ENC-MUTE @ IF EXIT THEN
  SRC-POS @ 1- ENC-SUB-POS ENC-SUBS @ 1- 2* 1+ CELLS + ! ;

: ENC-DQ-ESCAPE ( --- )   \ a backslash inside double quotes
  1 SRC-C
  DUP -1 = IF DROP 92 ENC-LIT, 1 SRC-SKIP EXIT THEN
  DUP 10 = IF DROP 2 SRC-SKIP EXIT THEN                \ a continuation
  DUP 34 = OVER 92 = OR OVER 36 = OR OVER 96 = OR IF
    ENC-ESC ENC-CODE, ENC-C,
  ELSE
    92 ENC-LIT, ENC-LIT,                               \ both stay
  THEN
  2 SRC-SKIP ;

\ ---- scanning a word ----
DEFER SCAN-DOLLAR

: SCAN-SQUOTE ( --- )     \ at ': to past the closing '
  1 SRC-SKIP
  ENC-SQ ENC-CODE,
  BEGIN
    0 SRC-C DUP -1 = IF DROP S" unterminated single quote" SYNTAX THEN
    DUP 39 <> IF ENC-LIT, ELSE DROP THEN
    1 SRC-SKIP
    -1 SRC-C 39 =
  UNTIL
  ENC-END ENC-CODE, ;

: SCAN-BACKQUOTE ( --- )  \ at `: to past the closing `
  1 SRC-SKIP
  ENC-SUB-BEGIN
  1 ENC-MUTE +!
  BEGIN
    0 SRC-C
    DUP -1 = IF DROP S" unterminated backquote" SYNTAX THEN
    DUP 92 = IF DROP 2 SRC-SKIP 0 ELSE
    96 = IF 1 SRC-SKIP -1 ELSE 1 SRC-SKIP 0 THEN THEN
  UNTIL
  -1 ENC-MUTE +!
  ENC-SUB-END ;

: SCAN-DQUOTE ( --- )     \ at ": to past the closing "
  1 SRC-SKIP
  ENC-DQ ENC-CODE,
  BEGIN
    0 SRC-C
    DUP -1 = IF DROP S" unterminated double quote" SYNTAX THEN
    DUP 34 = IF DROP 1 SRC-SKIP -1 ELSE
    DUP 92 = IF DROP ENC-DQ-ESCAPE 0 ELSE
    DUP 96 = IF DROP SCAN-BACKQUOTE 0 ELSE
    36 = IF SCAN-DOLLAR 0 ELSE 0 SRC-C ENC-LIT, 1 SRC-SKIP 0
    THEN THEN THEN THEN
  UNTIL
  ENC-END ENC-CODE, ;

: SCAN-ARITH ( --- )      \ at $((: to past the matching ))
  3 SRC-SKIP
  ENC-ARITH ENC-CODE,  -1 ENC-COMPLEX? !
  SRC-POS @ >R  1 ENC-MUTE +!
  2
  BEGIN
    0 SRC-C
    DUP -1 = IF DROP S" unterminated arithmetic expansion" SYNTAX THEN
    DUP 40 = IF DROP 1+ 1 SRC-SKIP ELSE
    DUP 41 = IF DROP 1- 1 SRC-SKIP ELSE
    DUP 36 = IF DROP SCAN-DOLLAR ELSE
    DUP 39 = IF DROP SCAN-SQUOTE ELSE
    34 = IF SCAN-DQUOTE ELSE 1 SRC-SKIP
    THEN THEN THEN THEN THEN
    DUP 0=
  UNTIL DROP
  -1 ENC-MUTE +!
  R> SRC-POS @ 2 - ENC-RAW              \ without the closing ))
  ENC-END ENC-CODE, ;

: SCAN-CMDSUB ( --- )     \ at $(: parse the contents, to past the )
  2 SRC-SKIP
  ENC-SUB-BEGIN
  1 ENC-MUTE +!
  \ The contents are a program: parse it, which is the only way to find
  \ the right `)` past a case pattern's. The tree it builds is thrown
  \ away; the token being scanned is saved around it.
  \ The words inside are lexed too, and each resets the encoding buffer:
  \ this word's encoding so far is kept across the parse (Iteration 274).
  ENC# @ >R  ENC-SUBS @ >R  ENC-MUTE @ >R  ENC-BASE @ >R  ENC-SUB-BASE @ >R
  ENC-COMPLEX? @ >R
  TK-START @ >R  TK-FLAGS @ >R  TREE-TOP @ >R  VEC-TOP @ >R  NO-ALIAS? @ >R
  0 TK-VALID? !  -1 NO-ALIAS? !
  PARSE-SUBLIST
  R> NO-ALIAS? !  R> VEC-TOP !  R> TREE-TOP !  R> TK-FLAGS !  R> TK-START !
  R> ENC-COMPLEX? !
  R> ENC-SUB-BASE !  R> ENC-BASE !  R> ENC-MUTE !  R> ENC-SUBS !  R> ENC# !
  -1 ENC-MUTE +!
  ENC-SUB-END ;

: SPECIAL-PARAM? ( c --- f )   \ NAME-CHAR? comes from shell.4
  DUP 64 = OVER 42 = OR OVER 35 = OR OVER 63 = OR OVER 36 = OR
  OVER 33 = OR SWAP 45 = OR ;

: SCAN-BRACE-NAME ( --- )   \ ${ ... : the name, or a special parameter
  0 SRC-C SPECIAL-PARAM? IF
    0 SRC-C DUP 64 = OVER 42 = OR IF WF-AT-PARAM TK-FLAGS @ OR TK-FLAGS ! THEN
    ENC-C, 1 SRC-SKIP EXIT
  THEN
  BEGIN 0 SRC-C DUP -1 <> SWAP NAME-CHAR? AND WHILE
    0 SRC-C ENC-C, 1 SRC-SKIP
  REPEAT ;

: SCAN-BRACE-OP ( --- op )   \ the operator after the name, or EV-PLAIN
  0 SRC-C 125 = IF EV-PLAIN EXIT THEN
  0 SRC-C 58 = IF                        \ the : forms
    1 SRC-SKIP
    0 SRC-C
    DUP 45 = IF DROP 1 SRC-SKIP EV-DEFAULT EV-COLON + EXIT THEN
    DUP 61 = IF DROP 1 SRC-SKIP EV-ASSIGN EV-COLON + EXIT THEN
    DUP 63 = IF DROP 1 SRC-SKIP EV-ERROR EV-COLON + EXIT THEN
    43 = IF 1 SRC-SKIP EV-ALT EV-COLON + EXIT THEN
    EV-DEFAULT EV-COLON + EXIT                         \ ${x:} - as ${x:-}
  THEN
  0 SRC-C
  DUP 45 = IF DROP 1 SRC-SKIP EV-DEFAULT EXIT THEN
  DUP 61 = IF DROP 1 SRC-SKIP EV-ASSIGN EXIT THEN
  DUP 63 = IF DROP 1 SRC-SKIP EV-ERROR EXIT THEN
  DUP 43 = IF DROP 1 SRC-SKIP EV-ALT EXIT THEN
  DUP 35 = IF
    DROP 1 SRC-SKIP
    0 SRC-C 35 = IF 1 SRC-SKIP EV-TRIM-PRE-LONG ELSE EV-TRIM-PRE THEN EXIT
  THEN
  37 = IF
    1 SRC-SKIP
    0 SRC-C 37 = IF 1 SRC-SKIP EV-TRIM-SUF-LONG ELSE EV-TRIM-SUF THEN EXIT
  THEN
  EV-PLAIN ;

: SCAN-BRACE ( --- )      \ at ${: to past the matching }
  2 SRC-SKIP
  ENC-VAR ENC-CODE,
  0 SRC-C 35 = 1 SRC-C 125 <> AND 1 SRC-C -1 <> AND IF
    1 SRC-SKIP  EV-LENGTH ENC-C,  SCAN-BRACE-NAME  0 ENC-C,
    0 SRC-C 125 = IF 1 SRC-SKIP THEN EXIT
  THEN
  \ the operator is only known after the name, so the name is written to
  \ one side and the operator byte goes in first
  ENC# @ >R  0 ENC-C,                     \ the operator's place
  SCAN-BRACE-NAME
  SCAN-BRACE-OP DUP R> ENC-BUF + C!       ( op )
  DUP EV-PLAIN <> OVER EV-LENGTH <> AND IF -1 ENC-COMPLEX? ! THEN
  0 ENC-C,                                \ the name's end
  EV-PLAIN <> IF                          \ a word follows, up to the }
    BEGIN
      0 SRC-C
      DUP -1 = IF DROP S" unterminated parameter expansion" SYNTAX THEN
      DUP 125 = IF DROP -1 ELSE
      DUP 92 = IF DROP ENC-DQ-ESCAPE 0 ELSE
      DUP 36 = IF DROP SCAN-DOLLAR 0 ELSE
      DUP 39 = IF DROP SCAN-SQUOTE 0 ELSE
      DUP 34 = IF DROP SCAN-DQUOTE 0 ELSE
      96 = IF SCAN-BACKQUOTE 0 ELSE
        0 SRC-C ENC-LIT, 1 SRC-SKIP 0
      THEN THEN THEN THEN THEN THEN
    UNTIL
    ENC-END ENC-CODE,
  THEN
  0 SRC-C 125 = IF 1 SRC-SKIP ELSE S" unterminated parameter expansion" SYNTAX THEN ;

: SCAN-DOLLAR-IMPL ( --- )           \ at $
  WF-EXPAND TK-FLAGS @ OR TK-FLAGS !
  1 SRC-C 40 = IF
    2 SRC-C 40 = IF SCAN-ARITH ELSE SCAN-CMDSUB THEN EXIT
  THEN
  1 SRC-C 123 = IF SCAN-BRACE EXIT THEN
  \ $name, $1, $@ and the rest: the name is taken here, so the word's
  \ own loop does not see it again
  1 SRC-C DUP SPECIAL-PARAM? SWAP 48 - 10 U< OR IF
    1 SRC-SKIP
    0 SRC-C DUP 64 = OVER 42 = OR IF WF-AT-PARAM TK-FLAGS @ OR TK-FLAGS ! THEN
    DROP
    ENC-VAR ENC-CODE,  EV-PLAIN ENC-C,  0 SRC-C ENC-C,  1 SRC-SKIP
    0 ENC-C, EXIT
  THEN
  1 SRC-C NAME-CHAR? IF
    1 SRC-SKIP
    ENC-VAR ENC-CODE,  EV-PLAIN ENC-C,
    BEGIN 0 SRC-C DUP -1 <> SWAP NAME-CHAR? AND WHILE
      0 SRC-C ENC-C,  1 SRC-SKIP
    REPEAT
    0 ENC-C, EXIT
  THEN
  36 ENC-LIT,  1 SRC-SKIP ;
' SCAN-DOLLAR-IMPL IS SCAN-DOLLAR

: TILDE-CLASS ( --- class | -1 )   \ where this ~ stands in the word
  SRC-POS @ TK-START @ = IF ET-START EXIT THEN
  -1 SRC-C DUP 61 = IF DROP ET-AFTER-EQ EXIT THEN
  58 = IF ET-AFTER-COLON EXIT THEN
  -1 ;
: TILDE-PREFIX? ( --- f )
  \ A tilde prefix runs to the first unquoted / or the word's end, and is
  \ expanded only if nothing in it is quoted (XCU 2.6.1): `~"/stuff"` is
  \ literal, as dash has it (Iteration 277).
  1
  BEGIN
    DUP SRC-C DUP -1 <> IF DUP NAME-CHAR? OVER 45 = OR SWAP 46 = OR ELSE DROP 0 THEN
  WHILE 1+ REPEAT
  SRC-C
  DUP 39 = OVER 34 = OR OVER 92 = OR OVER 36 = OR SWAP 96 = OR 0= ;

: SCAN-TILDE-PREFIX ( --- )   \ at ~ : its user name, up to / or the word's end
  TILDE-CLASS DUP 0< TILDE-PREFIX? 0= OR IF
    DROP 126 ENC-LIT, 1 SRC-SKIP EXIT
  THEN
  ENC-TILDE ENC-CODE,  ENC-C,  -1 ENC-COMPLEX? !
  1 SRC-SKIP
  BEGIN
    0 SRC-C DUP -1 <> IF
      DUP NAME-CHAR? OVER 45 = OR SWAP 46 = OR
    ELSE DROP 0 THEN
  WHILE
    0 SRC-C ENC-C,  1 SRC-SKIP
  REPEAT
  ENC-END ENC-CODE, ;

: SCAN-WORD ( --- )       \ at a word's first character
  SRC-POS @ TK-START !  0 TK-FLAGS !
  ENC# @ ENC-BASE !  ENC-SUBS @ ENC-SUB-BASE !  0 ENC-MUTE !  0 ENC-COMPLEX? !
  0 SRC-C DUP 39 = OVER 34 = OR SWAP 92 = OR IF WF-NAME-Q TK-FLAGS ! THEN
  BEGIN
    0 SRC-C
    DUP -1 = OVER BLANK? OR OVER 10 = OR OVER OP-CHAR? OR IF
      DROP -1
    ELSE DUP 92 = IF
      DROP WF-QUOTED TK-FLAGS @ OR TK-FLAGS !
      1 SRC-C DUP -1 = IF DROP 92 ENC-LIT, ELSE
        DUP 10 = IF DROP ELSE ENC-ESC ENC-CODE, ENC-C, THEN
      THEN
      1 SRC-C -1 = IF 1 ELSE 2 THEN SRC-SKIP 0
    ELSE DUP 39 = IF
      DROP WF-QUOTED TK-FLAGS @ OR TK-FLAGS !  SCAN-SQUOTE 0
    ELSE DUP 34 = IF
      DROP WF-QUOTED TK-FLAGS @ OR TK-FLAGS !  SCAN-DQUOTE 0
    ELSE DUP 96 = IF
      DROP WF-EXPAND TK-FLAGS @ OR TK-FLAGS !  SCAN-BACKQUOTE 0
    ELSE 36 = IF
      SCAN-DOLLAR 0
    ELSE
      \ A [ is a pattern character only if a ] closes it (XCU 2.13.1):
      \ `[` and `]` alone, the test command, stay literal.
      0 SRC-C DUP 126 = OVER 42 = OR SWAP 63 = OR IF
        WF-SPECIAL TK-FLAGS @ OR TK-FLAGS !
      THEN
      0 SRC-C 91 = IF WF-BRACKET TK-FLAGS @ OR TK-FLAGS ! THEN
      0 SRC-C 93 = TK-FLAGS @ WF-BRACKET AND 0<> AND IF
        WF-SPECIAL TK-FLAGS @ OR TK-FLAGS !
      THEN
      0 SRC-C 126 = IF
        SCAN-TILDE-PREFIX                    \ takes the ~ and the name
      ELSE
        0 SRC-C ENC-LIT, 1 SRC-SKIP
      THEN
      0
    THEN THEN THEN THEN THEN THEN
  UNTIL
  ENC-COMPLEX? @ 0= IF WF-ENC-SIMPLE TK-FLAGS @ OR TK-FLAGS ! THEN
  SRC-POS @ TK-END ! ;

: ALL-DIGITS? ( c-addr u --- f )
  DUP 0= IF 2DROP 0 EXIT THEN
  OVER + SWAP ?DO I C@ 48 - 9 U> IF UNLOOP 0 EXIT THEN LOOP -1 ;

: SCAN-OP ( --- )         \ at an operator character
  K-OP TK-KIND !
  0 SRC-C 1 SRC-C
  OVER 59 = IF NIP 59 = IF OP-DSEMI 2 ELSE OP-SEMI 1 THEN ELSE
  OVER 38 = IF NIP 38 = IF OP-AND 2 ELSE OP-AMP 1 THEN ELSE
  OVER 124 = IF NIP 124 = IF OP-OR 2 ELSE OP-PIPE 1 THEN ELSE
  OVER 40 = IF 2DROP OP-LPAREN 1 ELSE
  OVER 41 = IF 2DROP OP-RPAREN 1 ELSE
  OVER 60 = IF NIP
    DUP 60 = IF DROP 2 SRC-C 45 = IF OP-DLESSDASH 3 ELSE OP-DLESS 2 THEN ELSE
    DUP 38 = IF DROP OP-LESSAND 2 ELSE
    62 = IF OP-LESSGREAT 2 ELSE OP-LESS 1 THEN THEN THEN
  ELSE NIP
    DUP 62 = IF DROP OP-DGREAT 2 ELSE
    DUP 38 = IF DROP OP-GREATAND 2 ELSE
    124 = IF OP-CLOBBER 2 ELSE OP-GREAT 1 THEN THEN THEN
  THEN THEN THEN THEN THEN THEN
  SRC-SKIP TK-OP ! ;

\ ---- reading the bodies ----
: STRIP-QUOTES ( c-addr u --- )   \ the delimiter, into HD-TEXT
  0 HD-TEXT# !
  OVER + SWAP ?DO
    I C@ DUP 39 = OVER 34 = OR SWAP 92 = OR 0= IF
      I 1 HD-APPEND
    THEN
  LOOP ;

VARIABLE HD-DELIM
VARIABLE HD-DELIM#
VARIABLE HR-NODE
VARIABLE HR-DASH?

: HD-STORE ( --- off )   \ HD-TEXT, NUL-terminated, into the tree
  HD-TEXT# @ 1+ TREE-ALLOT  HD-TEXT OVER TSTR HD-TEXT# @ MOVE ;

\ A here-document's body: the lines after the command, up to one that is
\ exactly the delimiter (quotes removed; leading tabs stripped for <<-).
\ The body is stored raw; whether it is expanded is the word's business.
: READ-HEREDOC ( redir --- )
  DUP HR-NODE !  1 F@ OP-DLESSDASH = HR-DASH? !
  HR-NODE @ 2 F@ 0 F@ TSTR DUP CSTRLEN STRIP-QUOTES
  HD-TEXT# @ HD-DELIM# !  HD-STORE HD-DELIM !
  0 HD-TEXT# !
  BEGIN 0 SRC-C -1 <> WHILE
    HR-DASH? @ IF BEGIN 0 SRC-C 9 = WHILE 1 SRC-SKIP REPEAT THEN
    SRC-POS @
    BEGIN 0 SRC-C DUP -1 <> SWAP 10 <> AND WHILE 1 SRC-SKIP REPEAT
    DUP SRC-ADDR @ +  SRC-POS @ ROT -       ( c-addr u )
    1 SRC-SKIP
    2DUP HD-DELIM @ TSTR HD-DELIM# @ COMPARE 0= IF
      2DROP HD-STORE HR-NODE @ 3 F! EXIT
    THEN
    HD-APPEND  SH-NL 1 HD-APPEND
  REPEAT
  \ end of input before the delimiter: the body is what was read
  HD-STORE HR-NODE @ 3 F! ;

: READ-HEREDOCS ( --- )
  HD-PEND# @ 0 ?DO HD-PEND I CELLS + @ READ-HEREDOC LOOP
  0 HD-PEND# ! ;

\ ---- the lexer ----
: LEX ( --- )
  BEGIN
    0 SRC-C DUP BLANK? IF DROP 1 SRC-SKIP 0 ELSE
    92 = IF 1 SRC-C 10 = IF 2 SRC-SKIP 0 ELSE -1 THEN ELSE -1 THEN THEN
  UNTIL
  0 SRC-C 35 = IF
    BEGIN 0 SRC-C DUP -1 <> SWAP 10 <> AND WHILE 1 SRC-SKIP REPEAT
  THEN
  0 SRC-C
  DUP -1 = IF DROP K-EOF TK-KIND ! EXIT THEN
  DUP 10 = IF DROP 1 SRC-SKIP K-NEWLINE TK-KIND ! READ-HEREDOCS EXIT THEN
  OP-CHAR? IF SCAN-OP EXIT THEN
  SCAN-WORD K-WORD TK-KIND !
  0 SRC-C DUP 60 = SWAP 62 = OR TK-TEXT ALL-DIGITS? AND IF
    K-IONUM TK-KIND !
  THEN ;

: PEEK ( --- )   TK-VALID? @ 0= IF LEX -1 TK-VALID? ! THEN ;
: NEXT ( --- )   PEEK 0 TK-VALID? ! ;
: KIND? ( k --- f )   PEEK TK-KIND @ = ;
: OP? ( op --- f )   PEEK TK-KIND @ K-OP = SWAP TK-OP @ = AND ;
: KW? ( c-addr u --- f )   \ this unquoted word?
  PEEK TK-KIND @ K-WORD = TK-FLAGS @ WF-QUOTED AND 0= AND IF
    TK-TEXT COMPARE 0=
  ELSE 2DROP 0 THEN ;
: LINEBREAK ( --- )   BEGIN K-NEWLINE KIND? WHILE NEXT REPEAT ;

\ A word node from the current token. Its text drops backslash-newline
\ pairs outside single quotes - the one change the lexer makes to a word.
VARIABLE TW-DST
VARIABLE TW-SQ
VARIABLE TW-DQ
VARIABLE TW-I

: TW-PUT ( c --- )   TW-DST @ C!  1 TW-DST +! ;
: TW-C ( i --- c )   SRC-ADDR @ + C@ ;

VARIABLE CST-I
VARIABLE CST-END
VARIABLE CST-DST
: COPY-SRC-TEXT ( from to --- soff )   \ into the tree, NUL-terminated
  2DUP SWAP - 1+ TREE-ALLOT >R
  CST-END !  CST-I !
  R@ TSTR CST-DST !
  BEGIN CST-I @ CST-END @ < WHILE
    CST-I @ SRC-ADDR @ + C@
    DUP 92 = CST-I @ 1+ CST-END @ < AND
    IF
      CST-I @ 1+ SRC-ADDR @ + C@ 10 = IF
        DROP 2 CST-I +!
      ELSE
        CST-DST @ C!  1 CST-DST +!  1 CST-I +!
      THEN
    ELSE
      CST-DST @ C!  1 CST-DST +!  1 CST-I +!
    THEN
  REPEAT
  0 CST-DST @ C!
  R> ;

VARIABLE TW-ENC-OFF
VARIABLE TW-ENC-LEN
VARIABLE TW-SUBS-VEC
: TOKEN-WORD-ENC ( --- )   \ the encoding and each substitution's text
  ENC# @ ENC-BASE @ - TW-ENC-LEN !
  TW-ENC-LEN @ IF
    TW-ENC-LEN @ TREE-ALLOT DUP TW-ENC-OFF !
    TSTR  TW-ENC-LEN @ >R  ENC-BUF ENC-BASE @ + SWAP R> MOVE
  ELSE
    0 TW-ENC-OFF !
  THEN
  VEC-MARK
  ENC-SUBS @ ENC-SUB-BASE @ ?DO
    ENC-SUB-POS I 2* CELLS + @
    ENC-SUB-POS I 2* 1+ CELLS + @
    COPY-SRC-TEXT >VEC
  LOOP
  VEC> TW-SUBS-VEC !
  ENC-BASE @ ENC# !  ENC-SUB-BASE @ ENC-SUBS ! ;

: TOKEN-WORD ( --- node )
  TK-END @ TK-START @ - 1+ TREE-ALLOT       ( soff )
  DUP TSTR TW-DST !  0 TW-SQ !  0 TW-DQ !  TK-START @ TW-I !
  BEGIN TW-I @ TK-END @ < WHILE
    TW-I @ TW-C
    DUP 39 = TW-DQ @ 0= AND IF TW-SQ @ 0= TW-SQ ! THEN
    DUP 34 = TW-SQ @ 0= AND IF TW-DQ @ 0= TW-DQ ! THEN
    DUP 92 = TW-SQ @ 0= AND TW-I @ 1+ TK-END @ < AND IF
      TW-I @ 1+ TW-C 10 = IF
        DROP                                \ a continuation: dropped
      ELSE
        TW-PUT TW-I @ 1+ TW-C TW-PUT        \ an escape: both kept
      THEN
      2 TW-I +!
    ELSE
      TW-PUT 1 TW-I +!
    THEN
  REPEAT
  TOKEN-WORD-ENC
  T-WORD 5 NODE  TUCK 0 F!  TK-FLAGS @ OVER 1 F!
  TW-ENC-OFF @ OVER 2 F!  TW-ENC-LEN @ OVER 3 F!  TW-SUBS-VEC @ OVER 4 F! ;

\ ==================================================================
\ The parser: XCU 2.10's grammar, by recursive descent
\ ==================================================================
128 BUFFER: MSG-BUF
VARIABLE MSG#
: MSG+ ( c-addr u --- )   \ append to the message being built
  DUP MSG# @ + 1+ ENSURE-BUFFER MSG-BUF
  MSG-BUF MSG# @ + SWAP DUP MSG# +! MOVE ;

: EXPECT-KW ( c-addr u --- )
  2DUP KW? IF 2DROP NEXT EXIT THEN
  0 MSG# !  S" expected '" MSG+  MSG+  S" '" MSG+
  MSG-BUF MSG# @ SYNTAX ;
: EXPECT-OP ( op c-addr u --- )   ROT OP? IF 2DROP NEXT ELSE SYNTAX THEN ;

: CLOSER? ( --- f )   \ a token that ends a compound list
  K-EOF KIND? OP-RPAREN OP? OR OP-DSEMI OP? OR IF -1 EXIT THEN
  S" then" KW? S" else" KW? OR S" elif" KW? OR S" fi" KW? OR
  S" do" KW? OR S" done" KW? OR S" esac" KW? OR S" }" KW? OR ;

: NAME-TOKEN? ( --- f )   \ an unquoted word that is a valid name
  K-WORD KIND? TK-FLAGS @ WF-QUOTED AND 0= AND IF TK-TEXT VALID-NAME? ELSE 0 THEN ;

: ASSIGN-TOKEN? ( --- f )   \ NAME=... with the name unquoted
  K-WORD KIND? 0= IF 0 EXIT THEN
  TK-FLAGS @ WF-NAME-Q AND IF 0 EXIT THEN
  TK-TEXT 61 SCAN NIP                       ( rest )
  DUP 0= IF EXIT THEN
  TK-END @ TK-START @ - SWAP -              ( namelen )
  SRC-ADDR @ TK-START @ + SWAP VALID-NAME? ;

\ ---- aliases (XCU 2.3.1) ----
\ An unquoted word in command position that names an alias is replaced,
\ in the source text itself, by the alias's value, which is then lexed
\ as if it had been written there. An alias is not expanded again
\ inside its own expansion; a value ending in a blank makes the next
\ word a candidate too. Not while finding where a $(...) ends - its
\ text is parsed again when it runs (Iteration 264).
256 BUFFER: AL-NAME-BUF

: AL-ENTRY ( k --- addr )   2* CELLS AL-ACTIVE + ;
: AL-EXPIRE ( --- )         \ drop the expansions the lexer has left
  0  AL-ACTIVE# @ 0 ?DO
    I AL-ENTRY CELL+ @ TK-START @ > IF
      I AL-ENTRY OVER AL-ENTRY 2 CELLS MOVE  1+
    THEN
  LOOP AL-ACTIVE# ! ;
: AL-ACTIVE? ( i --- f )
  AL-ACTIVE# @ 0 ?DO
    DUP I AL-ENTRY @ = IF DROP UNLOOP -1 EXIT THEN
  LOOP DROP 0 ;
: AL-SHIFT ( delta --- )    \ the expansions around the token grow or shrink
  ALIAS-NEXT-AT @ TK-START @ > IF DUP ALIAS-NEXT-AT +! THEN
  AL-ACTIVE# @ 0 ?DO
    I AL-ENTRY CELL+ @ TK-START @ > IF DUP I AL-ENTRY CELL+ +! THEN
  LOOP DROP ;

\ Replace the current token's text with c-addr u, and lex it next.
: SPLICE ( c-addr u --- )
  DUP TK-END @ TK-START @ - - >R            ( a u  R: delta )
  SRC-LEN @ R@ +                            ( a u newlen )
  SRC-STDIN? @ IF
    DUP 1+ ENSURE-BUFFER STDIN-TEXT
    STDIN-TEXT TK-END @ +  DUP R@ +  SRC-LEN @ TK-END @ -  MOVE
    STDIN-TEXT SRC-ADDR !
  ELSE
    DUP 1 MAX ALLOCATE DROP                 ( a u newlen blk )
    SRC-ADDR @ OVER TK-START @ MOVE
    SRC-ADDR @ TK-END @ +  OVER TK-END @ + R@ +  SRC-LEN @ TK-END @ -  MOVE
    SRC-SPLICED @ ?DUP IF FREE DROP THEN
    DUP SRC-SPLICED !  SRC-ADDR !
  THEN
  SRC-LEN !
  SRC-ADDR @ TK-START @ + SWAP MOVE
  R> AL-SHIFT
  TK-START @ SRC-POS !  0 TK-VALID? ! ;

: TRY-ALIAS ( --- f )   \ the current token was an alias, and is replaced
  NO-ALIAS? @ IF 0 EXIT THEN
  K-WORD KIND? 0= IF 0 EXIT THEN
  TK-FLAGS @ WF-QUOTED AND IF 0 EXIT THEN
  AL-EXPIRE
  TK-END @ TK-START @ - DUP 2 + ENSURE-BUFFER AL-NAME-BUF
  TK-TEXT AL-NAME-BUF SWAP MOVE  0 AL-NAME-BUF ROT + C!
  AL-NAME-BUF FIND-ALIAS
  DUP 0< IF DROP 0 EXIT THEN
  DUP AL-ACTIVE? IF DROP 0 EXIT THEN
  AL-ACTIVE# @ MAX-ALIAS-NEST < 0= IF DROP 0 EXIT THEN
  DUP ALIAS-VALUE-SLOT DUP CSTRLEN          ( i a u )
  2DUP + 1- C@ OVER 0<> AND DUP 32 = SWAP 9 = OR IF
    \ where the name ends: SPLICE moves it to where the value ends
    -1 ALIAS-NEXT? !  TK-END @ ALIAS-NEXT-AT !
  THEN
  ROT AL-ACTIVE# @ AL-ENTRY !               ( a u )
  DUP TK-START @ + AL-ACTIVE# @ AL-ENTRY CELL+ !
  1 AL-ACTIVE# +!
  SPLICE -1 ;
: EXPAND-ALIASES ( --- )   BEGIN PEEK TRY-ALIAS 0= UNTIL ;

DEFER PARSE-AND-OR
DEFER PARSE-COMMAND

: SEPARATOR ( --- sep | -1 )   \ ; 0, & 1, or none
  OP-SEMI OP? IF NEXT 0 EXIT THEN
  OP-AMP OP? IF NEXT 1 EXIT THEN
  -1 ;

: LIST-NODE ( vec --- node )   T-LIST 1 NODE TUCK 0 F! ;

: PARSE-COMPOUND-LIST ( empty-ok? --- node )
  LINEBREAK
  CLOSER? IF
    0= IF S" empty command list" SYNTAX THEN
    VEC-MARK VEC> LIST-NODE EXIT
  THEN DROP
  VEC-MARK
  BEGIN
    PARSE-AND-OR >VEC
    SEPARATOR DUP 0< IF
      DROP 0 >VEC
      K-NEWLINE KIND? 0= IF CLOSER? 0= IF
        S" unexpected token" SYNTAX
      THEN THEN
    ELSE >VEC THEN
    LINEBREAK
    CLOSER?
  UNTIL
  VEC> LIST-NODE ;

: PARSE-SUBLIST-IMPL ( --- )   \ the contents of $(...), up to its )
  -1 PARSE-COMPOUND-LIST DROP
  OP-RPAREN S" expected ')' to end a command substitution" EXPECT-OP ;
' PARSE-SUBLIST-IMPL IS PARSE-SUBLIST

: PARSE-COMPLETE ( --- node )   \ a list up to a newline or the end
  VEC-MARK
  BEGIN
    PARSE-AND-OR >VEC
    SEPARATOR DUP 0< IF DROP 0 >VEC -1 ELSE
      >VEC K-NEWLINE KIND? K-EOF KIND? OR
    THEN
  UNTIL
  K-NEWLINE KIND? K-EOF KIND? OR 0= IF S" unexpected token" SYNTAX THEN
  VEC> LIST-NODE ;

: PARSE-PIPELINE ( --- node )
  0 S" !" KW? IF NEXT DROP -1 THEN
  VEC-MARK PARSE-COMMAND >VEC
  BEGIN OP-PIPE OP? WHILE NEXT LINEBREAK PARSE-COMMAND >VEC REPEAT
  VEC>                                      ( bang vec )
  T-PIPE 2 NODE  TUCK 1 F!  TUCK 0 F! ;

: PARSE-AND-OR-IMPL ( --- node )
  VEC-MARK PARSE-PIPELINE >VEC
  BEGIN OP-AND OP? OP-OR OP? OR WHILE
    OP-AND OP? IF 1 ELSE 2 THEN >VEC
    NEXT LINEBREAK PARSE-PIPELINE >VEC
  REPEAT
  VEC> T-ANDOR 1 NODE TUCK 0 F! ;
' PARSE-AND-OR-IMPL IS PARSE-AND-OR

\ ---- redirections ----
: REDIR-START? ( --- f )
  K-IONUM KIND? IF -1 EXIT THEN
  K-OP KIND? 0= IF 0 EXIT THEN
  TK-OP @ OP-LESS < 0= TK-OP @ OP-CLOBBER > 0= AND ;

: TEXT>N ( c-addr u --- n )
  0 ROT ROT OVER + SWAP ?DO 10 * I C@ 48 - + LOOP ;

: PARSE-REDIRECT ( --- node )
  -1 K-IONUM KIND? IF DROP TK-TEXT TEXT>N NEXT THEN   ( fd )
  REDIR-START? 0= K-OP KIND? 0= OR IF S" expected a redirection" SYNTAX THEN
  TK-OP @ NEXT                              ( fd op )
  K-WORD KIND? 0= IF S" expected a word after a redirection" SYNTAX THEN
  T-REDIR 4 NODE                            ( fd op node )
  TUCK 1 F!  TUCK 0 F!
  TOKEN-WORD OVER 2 F!  NEXT
  DUP 1 F@ DUP OP-DLESS = SWAP OP-DLESSDASH = OR IF DUP HD-ADD THEN ;

: PARSE-REDIRS ( node --- node )   \ a compound command's redirections
  REDIR-START? IF
    VEC-MARK BEGIN PARSE-REDIRECT >VEC REDIR-START? 0= UNTIL
    VEC> OVER 0 F!
  THEN ;

256 BUFFER: JOIN-BUF
VARIABLE JOIN#
: JOIN-C, ( c --- )
  JOIN# @ 2 + ENSURE-BUFFER JOIN-BUF  JOIN-BUF JOIN# @ + C!  1 JOIN# +! ;
: JOIN-S, ( c-addr u --- )
  DUP JOIN# @ + 2 + ENSURE-BUFFER JOIN-BUF
  JOIN-BUF JOIN# @ + SWAP DUP JOIN# +! MOVE ;
: JOIN-ARGV-FROM ( i0 --- c-addr u )   \ ARGV's words from i0, space-joined
  0 JOIN# !
  ARGC @ OVER ?DO
    I OVER > IF 32 JOIN-C, THEN
    I ARGV@ DUP CSTRLEN JOIN-S,
  LOOP DROP
  0 JOIN-C,  -1 JOIN# +!                    \ NUL-terminated, not counted
  JOIN-BUF JOIN# @ ;
: JOIN-ARGV ( --- c-addr u )   0 JOIN-ARGV-FROM ;

\ ---- simple commands ----
: SIMPLE-ITEM ( words --- words' done? )
  ALIAS-NEXT? @ IF
    PEEK TK-START @ ALIAS-NEXT-AT @ < 0= IF 0 ALIAS-NEXT? ! EXPAND-ALIASES THEN
  THEN
  PEEK
  REDIR-START? IF I-REDIR >VEC PARSE-REDIRECT >VEC 0 EXIT THEN
  K-WORD KIND? 0= IF -1 EXIT THEN
  DUP 0= ASSIGN-TOKEN? AND IF I-ASSIGN ELSE 1+ I-WORD THEN
  >VEC TOKEN-WORD >VEC NEXT 0 ;

: HAS-REDIR? ( items --- f )   \ any redirection among a simple command's items
  0 SWAP DUP V# 0 ?DO
    DUP I V@ I-REDIR = IF NIP -1 SWAP LEAVE THEN
  2 +LOOP DROP ;

: PARSE-SIMPLE ( first-word | 0 --- node )
  VEC-MARK SWAP                              ( base first )
  ?DUP IF I-WORD >VEC >VEC 1 ELSE 0 THEN     ( base words )
  BEGIN SIMPLE-ITEM UNTIL DROP               ( base )
  DUP VEC-TOP @ = IF S" expected a command" SYNTAX THEN
  \ field 1: has redirections - decided here, so running the command
  \ skips looking for them (Iteration 266)
  VEC> DUP HAS-REDIR?                        ( vec f )
  T-SIMPLE 2 NODE  TUCK 1 F!  TUCK 0 F! ;

\ ---- compound commands ----
: PARSE-GROUP ( --- node )
  NEXT 0 PARSE-COMPOUND-LIST S" }" EXPECT-KW
  T-GROUP 2 NODE TUCK 1 F! ;

: PARSE-SUBSHELL ( --- node )
  NEXT 0 PARSE-COMPOUND-LIST
  OP-RPAREN S" expected ')'" EXPECT-OP
  T-SUBSHELL 2 NODE TUCK 1 F! ;

: PARSE-IF ( --- node )
  NEXT VEC-MARK
  0 PARSE-COMPOUND-LIST >VEC  S" then" EXPECT-KW  0 PARSE-COMPOUND-LIST >VEC
  BEGIN S" elif" KW? WHILE
    NEXT 0 PARSE-COMPOUND-LIST >VEC  S" then" EXPECT-KW  0 PARSE-COMPOUND-LIST >VEC
  REPEAT
  S" else" KW? IF NEXT 0 PARSE-COMPOUND-LIST ELSE 0 THEN   ( base else )
  S" fi" EXPECT-KW
  >R VEC> R>                                ( vec else )
  T-IF 3 NODE  TUCK 2 F!  TUCK 1 F! ;

: PARSE-LOOP ( type --- node )   \ while or until
  NEXT
  0 PARSE-COMPOUND-LIST  S" do" EXPECT-KW
  0 PARSE-COMPOUND-LIST  S" done" EXPECT-KW   ( type cond body )
  ROT 3 NODE  TUCK 2 F!  TUCK 1 F! ;

: PARSE-FOR ( --- node )
  NEXT
  NAME-TOKEN? 0= IF S" expected a name after 'for'" SYNTAX THEN
  TOKEN-WORD NEXT                           ( name )
  OP-SEMI OP? IF
    NEXT 0                                  ( name 0 )
  ELSE
    LINEBREAK
    S" in" KW? IF
      NEXT VEC-MARK
      BEGIN K-WORD KIND? WHILE TOKEN-WORD >VEC NEXT REPEAT
      VEC>                                  ( name words )
      OP-SEMI OP? IF NEXT ELSE
        K-NEWLINE KIND? IF NEXT ELSE S" expected ';' or a newline" SYNTAX THEN
      THEN
    ELSE 0 THEN
  THEN
  LINEBREAK S" do" EXPECT-KW
  0 PARSE-COMPOUND-LIST  S" done" EXPECT-KW   ( name words body )
  T-FOR 4 NODE  TUCK 3 F!  TUCK 2 F!  TUCK 1 F! ;

: PARSE-CASE-ITEM ( --- item )
  OP-LPAREN OP? IF NEXT THEN
  VEC-MARK
  BEGIN
    K-WORD KIND? 0= IF S" expected a pattern" SYNTAX THEN
    TOKEN-WORD >VEC NEXT
    OP-PIPE OP?
  WHILE NEXT REPEAT
  VEC>                                      ( pats )
  OP-RPAREN S" expected ')' after a pattern" EXPECT-OP
  LINEBREAK
  OP-DSEMI OP? S" esac" KW? OR IF 0 ELSE -1 PARSE-COMPOUND-LIST THEN
  T-CASEITEM 2 NODE  TUCK 1 F!  TUCK 0 F!
  OP-DSEMI OP? IF NEXT LINEBREAK ELSE
    S" esac" KW? 0= IF S" expected ';;' or 'esac'" SYNTAX THEN
  THEN ;

: PARSE-CASE ( --- node )
  NEXT
  K-WORD KIND? 0= IF S" expected a word after 'case'" SYNTAX THEN
  TOKEN-WORD NEXT                           ( word )
  LINEBREAK S" in" EXPECT-KW LINEBREAK
  VEC-MARK
  BEGIN S" esac" KW? 0= WHILE
    K-EOF KIND? IF S" expected 'esac'" SYNTAX THEN
    PARSE-CASE-ITEM >VEC
  REPEAT
  NEXT VEC>                                 ( word items )
  T-CASE 3 NODE  TUCK 2 F!  TUCK 1 F! ;

: COMPOUND-START? ( --- f )
  OP-LPAREN OP? S" {" KW? OR S" if" KW? OR S" while" KW? OR
  S" until" KW? OR S" for" KW? OR S" case" KW? OR ;

: PARSE-COMPOUND ( --- node )
  OP-LPAREN OP? IF PARSE-SUBSHELL ELSE
  S" {" KW? IF PARSE-GROUP ELSE
  S" if" KW? IF PARSE-IF ELSE
  S" while" KW? IF T-WHILE PARSE-LOOP ELSE
  S" until" KW? IF T-UNTIL PARSE-LOOP ELSE
  S" for" KW? IF PARSE-FOR ELSE
  PARSE-CASE
  THEN THEN THEN THEN THEN THEN
  PARSE-REDIRS ;

: PARSE-FUNCDEF ( name --- node )
  NEXT OP-RPAREN S" expected ')' after '('" EXPECT-OP
  LINEBREAK
  COMPOUND-START? 0= IF S" a function body must be a compound command" SYNTAX THEN
  \ The body's nodes are all allocated while it is parsed, so they are
  \ the arena range [start, end): defining the function copies it.
  TREE-TOP @ >R
  PARSE-COMPOUND                            ( name body )
  T-FUNCDEF 5 NODE  TUCK 2 F!  TUCK 1 F!
  R> OVER 3 F!  TREE-TOP @ OVER 4 F! ;

: PARSE-COMMAND-IMPL ( --- node )
  0 ALIAS-NEXT? !
  EXPAND-ALIASES
  K-EOF KIND? IF S" unexpected end of input" SYNTAX THEN
  COMPOUND-START? IF PARSE-COMPOUND EXIT THEN
  CLOSER? IF S" unexpected token" SYNTAX THEN
  K-WORD KIND? IF
    NAME-TOKEN? IF
      TOKEN-WORD NEXT                       ( w )
      OP-LPAREN OP? IF PARSE-FUNCDEF EXIT THEN
      PARSE-SIMPLE EXIT
    THEN
  THEN
  0 PARSE-SIMPLE ;
' PARSE-COMMAND-IMPL IS PARSE-COMMAND

\ ==================================================================
\ Printing a tree
\ ==================================================================
DEFER PRINT-NODE

: .STR ( off --- )   \ quoted, with " \ and newline escaped
  34 EMIT
  TSTR DUP CSTRLEN OVER + SWAP ?DO
    I C@ DUP 10 = IF DROP 92 EMIT 110 EMIT ELSE
    DUP 34 = OVER 92 = OR IF 92 EMIT THEN EMIT THEN
  LOOP
  34 EMIT ;

\ ---- the encoded form, readably (tree-dump; Iteration 274) ----
VARIABLE ENC-SHOW?        \ tree-dump prints encodings too
VARIABLE PE-I
VARIABLE PE-A
VARIABLE PE-N
: .OP-NAME ( op --- )
  DUP EV-PLAIN = IF DROP S" plain" TYPE EXIT THEN
  DUP EV-LENGTH = IF DROP S" length" TYPE EXIT THEN
  DUP EV-TRIM-PRE = IF DROP S" #" TYPE EXIT THEN
  DUP EV-TRIM-PRE-LONG = IF DROP S" ##" TYPE EXIT THEN
  DUP EV-TRIM-SUF = IF DROP S" %" TYPE EXIT THEN
  DUP EV-TRIM-SUF-LONG = IF DROP S" %%" TYPE EXIT THEN
  DUP EV-COLON AND IF S" :" TYPE THEN
  EV-COLON 1- AND
  DUP EV-DEFAULT = IF DROP 45 EMIT EXIT THEN
  DUP EV-ASSIGN = IF DROP 61 EMIT EXIT THEN
  DUP EV-ERROR = IF DROP 63 EMIT EXIT THEN
  EV-ALT = IF 43 EMIT EXIT THEN
  S" ?op" TYPE ;
: PE-C ( --- c )   PE-A @ PE-I @ + C@ ;
: PRINT-ENC ( word --- )
  DUP 3 F@ ?DUP 0= IF DROP DROP EXIT THEN
  PE-N !  DUP 2 F@ TSTR PE-A !
  S"  enc<" TYPE
  0 PE-I !
  BEGIN PE-I @ PE-N @ < WHILE
    PE-C ENC-CTL = IF
      1 PE-I +!
      PE-C
      DUP ENC-CTL = IF DROP 91 EMIT PE-C EMIT 93 EMIT ELSE
      DUP ENC-END = IF DROP S" >" TYPE ELSE
      DUP ENC-SQ = IF DROP S" sq<" TYPE ELSE
      DUP ENC-DQ = IF DROP S" dq<" TYPE ELSE
      DUP ENC-ESC = IF DROP 1 PE-I +! S" esc(" TYPE PE-C EMIT 41 EMIT ELSE
      DUP ENC-VAR = IF
        DROP 1 PE-I +! S" var(" TYPE PE-C .OP-NAME 44 EMIT
        1 PE-I +!                            \ the name, NUL-terminated
        BEGIN PE-I @ PE-N @ < IF PE-C ELSE 0 THEN WHILE PE-C EMIT 1 PE-I +! REPEAT
        62 EMIT
      ELSE
      DUP ENC-ARITH = IF DROP S" arith<" TYPE ELSE
      DUP ENC-CMDSUB = IF DROP 1 PE-I +! S" sub" TYPE PE-C 48 + EMIT ELSE
      DUP ENC-TILDE = IF DROP 1 PE-I +! S" tilde" TYPE PE-C 48 + EMIT 40 EMIT ELSE
        DROP S" ?code" TYPE
      THEN THEN THEN THEN THEN THEN THEN THEN THEN
      1 PE-I +!
    ELSE
      PE-C EMIT  1 PE-I +!
    THEN
  REPEAT
  S" >" TYPE
  DUP 4 F@ ?DUP IF
    DUP V# 0 ?DO
      S"  sub" TYPE I 48 + EMIT S" =<" TYPE
      DUP I V@ .STR S" >" TYPE
    LOOP DROP
  THEN DROP ;

: .SP ( --- )   32 EMIT ;
: .VEC ( vec --- )   \ items, space-separated
  DUP V# 0 ?DO .SP DUP I V@ PRINT-NODE LOOP DROP ;
: .REDIRS ( node --- )   0 F@ ?DUP IF .VEC THEN ;
: .OP ( op --- )
  CASE
    OP-LESS OF ." <" ENDOF        OP-GREAT OF ." >" ENDOF
    OP-DGREAT OF ." >>" ENDOF     OP-LESSAND OF ." <&" ENDOF
    OP-GREATAND OF ." >&" ENDOF   OP-LESSGREAT OF ." <>" ENDOF
    OP-DLESS OF ." <<" ENDOF      OP-DLESSDASH OF ." <<-" ENDOF
    OP-CLOBBER OF ." >|" ENDOF
  ENDCASE ;

: PRINT-NODE-IMPL ( node --- )
  ?DUP 0= IF ." ()" EXIT THEN
  DUP T@ CASE
  T-WORD OF DUP 0 F@ .STR  ENC-SHOW? @ IF PRINT-ENC ELSE DROP THEN ENDOF
  T-VEC OF ." [" .VEC ."  ]" ENDOF
  T-LIST OF
    ." (list"
    0 F@ DUP V# 0 ?DO
      .SP DUP I V@ PRINT-NODE
      DUP I 1+ V@ IF ."  &" THEN
    2 +LOOP DROP ." )"
  ENDOF
  T-ANDOR OF
    0 F@ DUP V# 1 = IF 0 V@ PRINT-NODE ELSE
      ." (and-or"
      DUP V# 0 ?DO
        .SP DUP I V@ PRINT-NODE
        I 1+ OVER V# < IF DUP I 1+ V@ 1 = IF ."  &&" ELSE ."  ||" THEN THEN
      2 +LOOP DROP ." )"
    THEN
  ENDOF
  T-PIPE OF
    DUP 0 F@ 0= OVER 1 F@ V# 1 = AND IF
      1 F@ 0 V@ PRINT-NODE
    ELSE
      ." (pipe" DUP 0 F@ IF ."  !" THEN 1 F@ .VEC ." )"
    THEN
  ENDOF
  T-SIMPLE OF
    ." (simple"
    0 F@ DUP V# 0 ?DO
      DUP I V@ CASE
        I-ASSIGN OF ."  (assign " ENDOF
        I-REDIR OF .SP ENDOF
        .SP
      ENDCASE
      DUP I 1+ V@ PRINT-NODE
      DUP I V@ I-ASSIGN = IF ." )" THEN
    2 +LOOP DROP ." )"
  ENDOF
  T-SUBSHELL OF ." (subshell " DUP 1 F@ PRINT-NODE .REDIRS ." )" ENDOF
  T-GROUP OF ." (group " DUP 1 F@ PRINT-NODE .REDIRS ." )" ENDOF
  T-IF OF
    ." (if"
    DUP 1 F@ DUP V# 0 ?DO
      .SP DUP I V@ PRINT-NODE .SP DUP I 1+ V@ PRINT-NODE
    2 +LOOP DROP
    DUP 2 F@ ?DUP IF ."  (else " PRINT-NODE ." )" THEN
    .REDIRS ." )"
  ENDOF
  T-WHILE OF ." (while " DUP 1 F@ PRINT-NODE .SP DUP 2 F@ PRINT-NODE .REDIRS ." )" ENDOF
  T-UNTIL OF ." (until " DUP 1 F@ PRINT-NODE .SP DUP 2 F@ PRINT-NODE .REDIRS ." )" ENDOF
  T-FOR OF
    ." (for " DUP 1 F@ PRINT-NODE
    DUP 2 F@ ?DUP IF .SP PRINT-NODE ELSE ."  $@" THEN
    .SP DUP 3 F@ PRINT-NODE .REDIRS ." )"
  ENDOF
  T-CASE OF ." (case " DUP 1 F@ PRINT-NODE DUP 2 F@ .VEC .REDIRS ." )" ENDOF
  T-CASEITEM OF ." (item " DUP 0 F@ PRINT-NODE .SP 1 F@ PRINT-NODE ." )" ENDOF
  T-FUNCDEF OF ." (function " DUP 1 F@ PRINT-NODE .SP DUP 2 F@ PRINT-NODE .REDIRS ." )" ENDOF
  T-REDIR OF
    ." (redir "
    DUP 0 F@ DUP 0< IF DROP ELSE . THEN
    DUP 1 F@ .OP .SP DUP 2 F@ PRINT-NODE
    DUP 3 F@ ?DUP IF ."  (body " .STR ." )" THEN
    DROP ." )"
  ENDOF
  ." (?)"
  ENDCASE ;
' PRINT-NODE-IMPL IS PRINT-NODE

: PARSE-INIT ( c-addr u --- )
  SRC-LEN !  SRC-ADDR !  0 SRC-POS !  1 SRC-LINE !  0 SRC-STDIN? !
  0 SRC-SPLICED !  0 AL-ACTIVE# !  0 NO-ALIAS? !  0 ALIAS-NEXT? !
  0 TK-VALID? !  0 VEC-TOP !  0 HD-PEND# !  TREE-RESET ;

\ ==================================================================
\ Stage B: executing the tree (Iteration 264)
\ ==================================================================
\ Node offsets are relative to EXEC-BASE: the arena being executed - the
\ parse arena, or a function's own copy of its body. The parse arena can
\ move when eval parses during execution; a base saved before that still
\ reads the old block, which pool.4 keeps until the next top-level
\ command.
\
\ A simple command is laid out in ARGV the way the line-based path laid
\ it out - its assignments, words and redirections as raw words, each
\ redirection as an optional one-digit descriptor word, an operator word
\ and a target - so expansion, assignment, redirection and dispatch are
\ the same code for both paths until the old one is deleted.

VARIABLE EXEC-BASE
: X@ ( off --- x )   EXEC-BASE @ + @ ;
: XF@ ( node i --- x )   1+ CELLS + X@ ;
: XV# ( vec --- n )   CELL+ X@ ;
: XV@ ( vec i --- x )   2 + CELLS + X@ ;
: XSTR ( off --- c-addr )   EXEC-BASE @ + ;

DEFER EXEC   ( node --- )
DEFER EXEC-FINAL-CALL   ( node --- )

: STOP? ( --- f )   RETURN-PENDING? @ LOOP-CONTROL-PENDING? @ OR ;

\ set -e (Iteration 270). A failing pipeline ends the shell, except
\ while ERR-IGNORE is up: in an if, while or until condition, in any
\ but the last element of an && / || list, and under `!` (XCU 2.8.1,
\ set -e). A compound command's own status does not count - its
\ pipelines were checked as they ran - but a function call's does.
VARIABLE ERR-IGNORE
: ERREXIT-CHECK ( --- )
  LAST-STATUS @ IF
    OPT-ERREXIT @ ERR-IGNORE @ 0= AND IF LAST-STATUS @ SHELL-EXIT THEN
  THEN ;
: EXEC-IGNORING ( node --- )   1 ERR-IGNORE +!  EXEC  -1 ERR-IGNORE +! ;

\ set -u: an unset parameter fails the command, and ends a
\ non-interactive shell with status 2 (dash).
: EXPANSION-OK? ( --- f )
  UNSET-FATAL? @ IF
    0 UNSET-FATAL? !
    INTERACTIVE? @ 0= IF 2 SHELL-EXIT THEN
    0 EXPANSION-FAILED? !  1 LAST-STATUS !  0 EXIT
  THEN
  EXPANSION-FAILED? @ IF 1 LAST-STATUS !  0 EXIT THEN
  -1 ;

\ A node that is one foreground simple command and nothing else: a
\ process with only that left to do execs it instead of forking
\ (EXEC-LAST? in shell.4; Iteration 269).
VARIABLE WANT-EXEC?
: ONE-SIMPLE? ( node --- f )
  BEGIN
    DUP X@ T-LIST = IF
      0 XF@ DUP XV# 2 = OVER 1 XV@ 0= AND IF 0 XV@ ELSE DROP 0 EXIT THEN
    ELSE DUP X@ T-ANDOR = IF
      0 XF@ DUP XV# 1 = IF 0 XV@ ELSE DROP 0 EXIT THEN
    ELSE DUP X@ T-PIPE = IF
      DUP 0 XF@ 0= OVER 1 XF@ XV# 1 = AND IF 1 XF@ 0 XV@ ELSE DROP 0 EXIT THEN
    ELSE
      X@ T-SIMPLE = EXIT
    THEN THEN THEN
  AGAIN ;
: WAIT-STATUS ( pid --- status )   WAITPID DROP 8 RSHIFT 255 AND ;

\ ---- simple commands ----
CREATE W-DIGITS  48 C, 0 C, 49 C, 0 C, 50 C, 0 C, 51 C, 0 C, 52 C, 0 C,
                 53 C, 0 C, 54 C, 0 C, 55 C, 0 C, 56 C, 0 C, 57 C, 0 C,
CREATE W-LT     60 C, 0 C,
CREATE W-GT     62 C, 0 C,
CREATE W-DGT    62 C, 62 C, 0 C,
CREATE W-GTAND  62 C, 38 C, 0 C,
CREATE W-LTAND  60 C, 38 C, 0 C,
CREATE W-DLT    60 C, 60 C, 0 C,
CREATE W-DLTD   60 C, 60 C, 45 C, 0 C,

VARIABLE ARGV-NODE-NEXT   \ the node of the word being added, if it has one

: ARGV-ADD ( c-addr flags --- )
  ARGC @ ROOM-FOR-ARG? 0= IF 2DROP -1 ARGS-OVERFLOW? ! EXIT THEN
  DUP WF-QUOTED WF-EXPAND OR WF-SPECIAL OR AND 0= ARGV-LITERAL ARGC @ + C!
  DUP WF-QUOTED AND 0= 0= ARGV-QUOTED ARGC @ + C!
  WF-NAME-Q AND 0= 0= ARGV-NAME-QUOTED ARGC @ + C!
  ARGV ARGC @ CELLS + !
  ARGV-NODE-NEXT @ ARGV-NODES ARGC @ CELLS + !  0 ARGV-NODE-NEXT !
  ARGC @ 1+ ARGC !  0 ARGV ARGC @ CELLS + ! ;
\ A plain one-digit word goes in quoted: laid out before a redirection,
\ `echo 2 > f` would otherwise read as `echo 2> f`. The line path has
\ that bug; the tree knows which digits are descriptors.
CREATE W-QDIGITS  34 C, 48 C, 34 C, 0 C,  34 C, 49 C, 34 C, 0 C,
                  34 C, 50 C, 34 C, 0 C,  34 C, 51 C, 34 C, 0 C,
                  34 C, 52 C, 34 C, 0 C,  34 C, 53 C, 34 C, 0 C,
                  34 C, 54 C, 34 C, 0 C,  34 C, 55 C, 34 C, 0 C,
                  34 C, 56 C, 34 C, 0 C,  34 C, 57 C, 34 C, 0 C,
\ ==================================================================
\ Expanding a word from its encoding (EXPANSION-PLAN.md Stage B)
\ ==================================================================
\ Iteration 275, the first step: literal runs (copied whole), quoted
\ runs, quoted characters and plain parameters. A word whose encoding
\ holds anything else - an operator form, arithmetic, a command
\ substitution, a tilde - is declined, and EXPAND-WORDS scans it as
\ before, so both paths run side by side until Stage C.
VARIABLE XE-P             \ where the walk is, in the encoded bytes
VARIABLE XE-END           \ ... and where they end
VARIABLE XE-SPECIAL?      \ the word may hold unquoted pattern characters
VARIABLE XE-SUBS          \ its command substitutions' texts
VARIABLE XE-NOSPLIT?      \ capturing a word as a string: no field splitting
VARIABLE XE-IN-WORD?      \ inside ${x:-word}: even its literal text is split
VARIABLE XR-START
VARIABLE XP-OP
VARIABLE XP-LEN
VARIABLE XP-NAME          \ where the name is, in the encoding

: XE-C ( --- c )        XE-P @ C@ ;

: XE-LIT-RUN ( --- )   \ the literal bytes up to the next control byte
  XE-P @ XR-START !
  BEGIN XE-P @ XE-END @ < IF XE-C ENC-CTL <> ELSE 0 THEN WHILE 1 XE-P +! REPEAT
  XE-IN-WORD? @ IF
    \ a substituted word is an expansion result: split, literal text too
    XE-P @ XR-START @ ?DO I C@ EMIT-EXPANDED-CHAR LOOP
  ELSE
  XE-SPECIAL? @ IF
    XE-P @ XR-START @ ?DO I C@ GLOB-MARK EMIT-TOK-CHAR LOOP
  ELSE
    XR-START @  XE-P @ XR-START @ -  EMIT-RUN
  THEN THEN ;

: XE-QUOTED-RUN ( --- )   \ inside '...': literal to the run's end
  XE-P @ XR-START !
  BEGIN XE-P @ XE-END @ < IF XE-C ENC-CTL <> ELSE 0 THEN WHILE 1 XE-P +! REPEAT
  PATTERN-CAPTURE? @ IF
    XE-P @ XR-START @ ?DO I C@ EMIT-QUOTED LOOP
  ELSE
    XR-START @  XE-P @ XR-START @ -  EMIT-RUN
  THEN ;

: XE-QUOTED-TEXT ( c-addr u --- )   \ quoted text: literal in a trim's pattern
  PATTERN-CAPTURE? @ IF
    0 ?DO DUP I + C@ EMIT-QUOTED LOOP DROP
  ELSE
    EMIT-RUN
  THEN ;

\ ---- splitting by regions (EXPANSION-PLAN.md; Iteration 278) ----
\ An unquoted expansion's result is copied whole and its output range
\ recorded; when the word is done, the field splitting runs once over
\ those ranges (dash's recordregion/ifsbreakup). Pattern characters
\ inside a region are found with SCAN - the engine's memchr - rather
\ than tested one at a time on the way out.
256 BUFFER: XE-REGIONS     \ (start, end) output offsets, a pair each
VARIABLE XE-REG#
VARIABLE XE-REG-START

: XE-REGION-BEGIN ( --- )
  TOK-OUT @ OUT-BASE - XE-REG-START ! ;
VARIABLE XM-CH
VARIABLE XM-A
VARIABLE XM-U
: XE-MARK-CHAR ( char --- )   \ every one of them in the region, by SCAN
  XM-CH !
  XM-A @ XM-U @
  BEGIN DUP WHILE
    2DUP XM-CH @ SCAN                         ( a u a2 u2 )
    DUP 0= IF
      2DROP 2DROP 0 0
    ELSE
      OVER OUT-BASE - GLOB-MARK-OFF
      SWAP 1+ SWAP 1-
      2SWAP 2DROP
    THEN
  REPEAT 2DROP ;
: XE-MARK-PATTERNS ( from to --- )
  OVER - DUP 0= IF 2DROP EXIT THEN
  XM-U !  OUT-BASE + XM-A !
  42 XE-MARK-CHAR  63 XE-MARK-CHAR  91 XE-MARK-CHAR ;

: XE-REGION-END ( --- )
  TOK-OUT @ OUT-BASE - XE-REG-START @ = IF EXIT THEN
  XE-REG# @ 1+ 2* CELLS ENSURE-BUFFER XE-REGIONS
  XE-REG-START @ XE-REGIONS XE-REG# @ 2* CELLS + !
  TOK-OUT @ OUT-BASE - XE-REGIONS XE-REG# @ 2* 1+ CELLS + !
  1 XE-REG# +!
  XE-REG-START @ TOK-OUT @ OUT-BASE - XE-MARK-PATTERNS ;

: XE-VALUE ( c-addr --- )   \ a parameter's value: split when unquoted
  IN-DQ-CONTEXT? @ IF DUP CSTRLEN XE-QUOTED-TEXT EXIT THEN
  XE-NOSPLIT? @ IF DUP CSTRLEN EMIT-RUN EXIT THEN   \ captured, but not quoted
  XE-REGION-BEGIN  DUP CSTRLEN EMIT-RUN  XE-REGION-END ;

256 BUFFER: XW-BUF        \ an operator form's word, expanded
VARIABLE XW-LEN
DEFER XE-REGION-CALL      ( --- )   \ items until a region's end
DEFER XE-DQ-REGION        ( --- )

: XE-SKIP-WORD ( --- )   \ past an operator form's word, expanding nothing
  1 >R                                       \ nesting of ENC-END
  BEGIN XE-P @ XE-END @ < R@ 0 > AND WHILE
    XE-C ENC-CTL = IF
      1 XE-P +!
      XE-C
      DUP ENC-CTL = IF DROP ELSE
      DUP ENC-END = IF DROP R> 1- >R ELSE
      DUP ENC-ESC = IF DROP 1 XE-P +! ELSE
      DUP ENC-SQ = OVER ENC-DQ = OR OVER ENC-ARITH = OR IF DROP R> 1+ >R ELSE
      DUP ENC-VAR = IF
        DROP 1 XE-P +!                       \ the operator byte
        BEGIN XE-P @ XE-END @ < IF XE-C ELSE 0 THEN WHILE 1 XE-P +! REPEAT
        XE-P @ XE-END @ < IF 1 XE-P +! THEN
      ELSE
      ENC-CMDSUB = IF 1 XE-P +! THEN
      THEN THEN THEN THEN THEN
      1 XE-P +!
    ELSE 1 XE-P +! THEN
  REPEAT
  R> DROP ;

: XE-WORD-ASIDE ( --- )   \ the word after a parameter, into XW-BUF
  TOK-OUT @ OUT-BASE - >R                    \ on the stack: one of these nests
  XE-REGION-CALL                             \ stops at the word's end
  TOK-OUT @ OUT-BASE - R@ -                  ( length )
  DUP 1+ ENSURE-BUFFER XW-BUF
  XW-LEN !
  OUT-BASE R@ +  XW-BUF  XW-LEN @ MOVE
  0 XW-BUF XW-LEN @ + C!
  OUT-BASE R> + TOK-OUT ! ;                  \ taken back out of the output

VARIABLE XP-VAL

: XE-VALUE-N ( c-addr u --- )   \ part of a value: split when unquoted
  IN-DQ-CONTEXT? @ IF XE-QUOTED-TEXT EXIT THEN
  XE-NOSPLIT? @ IF EMIT-RUN EXIT THEN
  XE-REGION-BEGIN  EMIT-RUN  XE-REGION-END ;

: XE-WORD-ASIDE-SAFE ( pattern? --- )   \ the word may hold another of these
  XP-NAME @ >R  XP-OP @ >R  XP-VAL @ >R
  PATTERN-CAPTURE? @ >R  PATTERN-CAPTURE? !
  \ the enclosing double quotes do not reach inside the word: `"${x#*}"`
  \ still has a pattern (XCU 2.6.2; CAPTURE-BRACED-WORD does the same)
  IN-DQ-CONTEXT? @ >R  0 IN-DQ-CONTEXT? !
  XE-NOSPLIT? @ >R  -1 XE-NOSPLIT? !
  XE-WORD-ASIDE
  R> XE-NOSPLIT? !
  R> IN-DQ-CONTEXT? !
  R> PATTERN-CAPTURE? !
  R> XP-VAL !  R> XP-OP !  R> XP-NAME ! ;

: XE-WORD-INLINE ( --- )   \ ${x:-word}: into the output, and split
  XE-IN-WORD? @ >R  -1 XE-IN-WORD? !
  XE-REGION-CALL
  R> XE-IN-WORD? ! ;

: XE-PARAM-OP ( --- )   \ the operator forms: defaults, assign, error, trims
  XP-NAME @ LOOKUP-VAR XP-VAL !               \ the name is in the encoding
  XP-OP @ EV-TRIM-PRE < IF                   \ - = ? + , with or without :
    XP-OP @ EV-COLON AND IF
      \ unset or empty counts. ?DUP left the 0 here when it was unset,
      \ and the extra cell corrupted whatever ran next (Iteration 277).
      XP-VAL @ DUP 0= IF DROP -1 ELSE C@ 0= THEN
    ELSE
      XP-VAL @ 0=
    THEN
    XP-OP @ EV-COLON 1- AND                  ( unset? op )
    DUP EV-ALT = IF
      DROP IF XE-SKIP-WORD ELSE XE-WORD-INLINE THEN EXIT
    THEN
    DUP EV-DEFAULT = IF
      DROP IF XE-WORD-INLINE ELSE XE-SKIP-WORD XP-VAL @ XE-VALUE THEN EXIT
    THEN
    DUP EV-ASSIGN = IF
      DROP IF
        0 XE-WORD-ASIDE-SAFE
        XP-NAME @ XW-BUF SET-SHVAR
        XW-BUF XE-VALUE
      ELSE XE-SKIP-WORD XP-VAL @ XE-VALUE THEN EXIT
    THEN
    EV-ERROR = IF
      IF
        0 XE-WORD-ASIDE-SAFE
        S" shell: " ERR-TYPE XP-NAME @ ERR-CSTR S" : " ERR-TYPE
        XW-LEN @ IF XW-BUF ERR-CSTR ELSE S" parameter not set" ERR-TYPE THEN
        ERR-NL
        -1 EXPANSION-FAILED? !
      ELSE XE-SKIP-WORD XP-VAL @ XE-VALUE THEN
    ELSE DROP THEN EXIT
  THEN
  \ the trims: the word is the pattern, in which quoted pattern
  \ characters are literal (Iteration 273)
  -1 XE-WORD-ASIDE-SAFE
  XP-NAME @ LOOKUP-VAR XP-VAL !               \ it may have moved
  XP-VAL @ 0= IF EXIT THEN
  XW-BUF XW-LEN @  XP-VAL @ DUP CSTRLEN
  XP-OP @ EV-TRIM-SUF < 0=  XP-OP @ 1 AND 0<>
  -1 GM-ESCAPES? !  FIND-TRIM-LEN  0 GM-ESCAPES? !   ( match-len | -1 )
  DUP -1 = IF
    DROP XP-VAL @ XE-VALUE EXIT
  THEN
  XP-OP @ EV-TRIM-SUF < 0= IF
    XP-VAL @ DUP CSTRLEN ROT - XE-VALUE-N
  ELSE
    XP-VAL @ OVER + SWAP XP-VAL @ CSTRLEN SWAP - XE-VALUE-N
  THEN ;

: XE-PARAM ( --- )   \ at the operator byte
  XE-C XP-OP !  1 XE-P +!
  XE-P @ DUP XP-NAME !                       \ NUL-terminated in the encoding
  XE-END @ OVER - 0 SCAN DROP                ( name end )
  DUP XP-NAME @ - XP-LEN !
  XE-END @ < IF XP-NAME @ XP-LEN @ + 1+ ELSE XE-END @ THEN XE-P !
  XP-LEN @ 1 = XP-OP @ EV-PLAIN = AND IF
    XP-NAME @ C@
    DUP 64 = IF DROP -1 EMIT-ALL-POS-PARAMS EXIT THEN
    DUP 42 = IF DROP 0 EMIT-ALL-POS-PARAMS EXIT THEN
    DUP 35 = IF DROP POS-PARAM-COUNT @ EMIT-DECIMAL EXIT THEN
    DUP 63 = IF DROP LAST-STATUS @ EMIT-DECIMAL EXIT THEN
    DUP 36 = IF DROP SHELL-PID @ EMIT-DECIMAL EXIT THEN
    DUP 33 = IF DROP BG-PID @ EMIT-DECIMAL EXIT THEN
    DUP 45 = IF DROP EMIT-OPTION-FLAGS EXIT THEN
    DROP
  THEN
  XP-OP @ EV-LENGTH = IF
    XP-NAME @ LOOKUP-VAR
    DUP 0= IF DROP XP-NAME @ XP-LEN @ NOUNSET-CHECK 0 ELSE CSTRLEN THEN
    EMIT-DECIMAL EXIT
  THEN
  XP-OP @ EV-PLAIN = IF
    XP-NAME @ LOOKUP-VAR ?DUP IF
      XE-VALUE
    ELSE
      XP-NAME @ XP-LEN @ NOUNSET-CHECK
    THEN EXIT
  THEN
  XE-PARAM-OP ;

: XE-ARITH ( --- )   \ the expression's text, up to ENC-END
  XE-P @                            ( addr )
  BEGIN XE-P @ XE-END @ < IF XE-C ENC-CTL <> ELSE 0 THEN WHILE 1 XE-P +! REPEAT
  XE-P @ OVER -                     ( addr u )
  AE-EVAL EMIT-DECIMAL
  XE-P @ XE-END @ < IF 2 XE-P +! THEN ;

: XE-CMDSUB ( --- )   \ substitution number XE-C of this word
  XE-C                                       ( n )
  1 XE-P +!
  XE-SUBS @ ?DUP 0= IF DROP EXIT THEN         ( n vec )
  SWAP                                        ( vec n )
  DUP 2 PICK XV# < IF
    XV@ XSTR DUP CSTRLEN
    XE-NOSPLIT? @ IN-DQ-CONTEXT? @ OR IF     \ captured or quoted: not split
      IN-DQ-CONTEXT? @ >R  -1 IN-DQ-CONTEXT? !
      RUN-CMDSUB-TEXT  R> IN-DQ-CONTEXT? !
    ELSE
      \ unquoted: its output is one region, split with the rest
      IN-DQ-CONTEXT? @ >R  -1 IN-DQ-CONTEXT? !
      XE-REGION-BEGIN  RUN-CMDSUB-TEXT  XE-REGION-END
      R> IN-DQ-CONTEXT? !
    THEN
  ELSE 2DROP THEN ;

: XE-TILDE ( --- )   \ a tilde prefix: its class, then the user name
  XE-C                                       ( class )
  1 XE-P +!
  XE-P @                            ( class addr )
  BEGIN XE-P @ XE-END @ < IF XE-C ENC-CTL <> ELSE 0 THEN WHILE 1 XE-P +! REPEAT
  XE-P @ OVER -                     ( class addr u )
  XE-P @ XE-END @ < IF 2 XE-P +! THEN
  2 PICK ET-START <> TOKEN-IS-ASSIGN-PREFIX? 0= AND IF
    \ ~ after = or : counts only in an assignment: the text as it stands
    ROT DROP 126 EMIT-TOK-CHAR EMIT-RUN EXIT
  THEN
  ROT DROP                                   ( addr u )
  DUP IF
    2DUP PASSWD-HOME ?DUP IF
      >R 2DROP R> TYPE0-TO-TOK-SPLIT
    ELSE
      126 EMIT-TOK-CHAR EMIT-RUN             \ no such user: as written
    THEN
  ELSE
    2DROP
    S" HOME" ENVNAMBUF SWAP MOVE  0 ENVNAMBUF 4 + C!
    ENVNAMBUF LOOKUP-VAR ?DUP IF TYPE0-TO-TOK-SPLIT ELSE 126 EMIT-TOK-CHAR THEN
  THEN ;

: XE-SQ-REGION ( --- )   \ '...': literal bytes until the run's end
  BEGIN XE-P @ XE-END @ < WHILE
    XE-C ENC-CTL = IF
      1 XE-P +!
      XE-C ENC-CTL = IF ENC-CTL EMIT-TOK-CHAR 1 XE-P +! ELSE 1 XE-P +! EXIT THEN
    ELSE
      XE-QUOTED-RUN
    THEN
  REPEAT ;

: XE-ITEM ( --- end? )   \ one item; true if it ended the enclosing region
  XE-C ENC-CTL <> IF
    IN-DQ-CONTEXT? @ IF XE-QUOTED-RUN ELSE XE-LIT-RUN THEN  0 EXIT
  THEN
  1 XE-P +!
  XE-C
  DUP ENC-CTL = IF DROP ENC-CTL GLOB-MARK EMIT-TOK-CHAR 1 XE-P +!  0 EXIT THEN
  DUP ENC-END = IF DROP 1 XE-P +!  -1 EXIT THEN
  DUP ENC-SQ = IF DROP 1 XE-P +!  -1 TOK-WAS-QUOTED? !  XE-SQ-REGION  0 EXIT THEN
  DUP ENC-DQ = IF DROP 1 XE-P +!  -1 TOK-WAS-QUOTED? !  XE-DQ-REGION  0 EXIT THEN
  DUP ENC-ESC = IF
    DROP 1 XE-P +!  -1 TOK-WAS-QUOTED? !  XE-C EMIT-QUOTED  1 XE-P +!  0 EXIT
  THEN
  DUP ENC-VAR = IF DROP 1 XE-P +!  XE-PARAM  0 EXIT THEN
  DUP ENC-ARITH = IF DROP 1 XE-P +!  XE-ARITH  0 EXIT THEN
  DUP ENC-CMDSUB = IF DROP 1 XE-P +!  XE-CMDSUB  0 EXIT THEN
  ENC-TILDE = IF 1 XE-P +!  XE-TILDE THEN  0 ;

: XE-REGION ( --- )   \ items until the region's end
  BEGIN XE-P @ XE-END @ < WHILE XE-ITEM IF EXIT THEN REPEAT ;
' XE-REGION IS XE-REGION-CALL

: XE-DQ-REGION-IMPL ( --- )
  IN-DQ-CONTEXT? @ >R  -1 IN-DQ-CONTEXT? !
  XE-REGION
  R> IN-DQ-CONTEXT? ! ;
' XE-DQ-REGION-IMPL IS XE-DQ-REGION

: XE-WALK ( --- )   BEGIN XE-P @ XE-END @ < WHILE XE-ITEM DROP REPEAT ;

VARIABLE XS-FS
VARIABLE XS-WSP
VARIABLE XS-PEND?

: XS-CLOSE ( nul-off next-off --- )   \ end the field here, start one there
  SWAP OUT-BASE + 0 SWAP C!
  ARGC @ ROOM-FOR-ARG? IF
    ARGC @ 1+ ARGC !
    OUT-BASE + ARGV ARGC @ CELLS + !
    0 ARGV-QUOTED ARGC @ + C!  0 ARGV-NAME-QUOTED ARGC @ + C!
  ELSE
    DROP -1 ARGS-OVERFLOW? !
  THEN ;

VARIABLE XS-PREV          \ where the text after the last region begins
: XS-CONTENT-AT ( off --- )   \ content here: any pending whitespace ends a field
  XS-PEND? @ IF
    XS-WSP @ SWAP DUP XS-FS !  XS-CLOSE
    0 XS-PEND? !
  ELSE DROP THEN ;

: XS-REGION-SPLIT ( from to --- )   \ the state machine, over one region
  SWAP ?DO
    OUT-BASE I + C@
    DUP IFS-CHAR? IF
      DUP 32 = OVER 9 = OR SWAP 10 = OR IF
        I XS-FS @ > IF
          XS-PEND? @ 0= IF I XS-WSP !  -1 XS-PEND? ! THEN
        ELSE
          I 1+ DUP XS-FS !  OUT-BASE + ARGV ARGC @ CELLS + !
        THEN
      ELSE                                   \ ends one field, even an empty one
        XS-PEND? @ IF XS-WSP @ ELSE I THEN
        I 1+ DUP XS-FS !  XS-CLOSE
        0 XS-PEND? !
      THEN
    ELSE
      DROP I XS-CONTENT-AT
    THEN
  LOOP ;

: XE-SPLIT ( start-off --- )   \ XCU 2.6.5, over the recorded regions only
  XE-REG# @ 0= IF DROP EXIT THEN
  TOKEN-IS-ASSIGN-PREFIX? IF DROP EXIT THEN   \ an assignment is not split
  DUP XS-FS !  DUP XS-PREV !  DROP
  0 XS-PEND? !
  XE-REG# @ 0 ?DO
    XE-REGIONS I 2* CELLS + @                ( start )
    DUP XS-PREV @ > IF XS-PREV @ XS-CONTENT-AT THEN   \ text before this region
    XE-REGIONS I 2* 1+ CELLS + @             ( start end )
    DUP XS-PREV !
    XS-REGION-SPLIT
  LOOP
  XS-PEND? @ IF
    TOK-OUT @ OUT-BASE - XS-PREV @ > IF
      XS-PREV @ XS-CONTENT-AT                \ text after the last region
    ELSE
      XS-WSP @ OUT-BASE + TOK-OUT !          \ trailing whitespace: dropped
    THEN
  THEN ;

: XE-TRY ( node --- f )   \ expanded here? then EXPAND-WORDS goes on
  DUP 1 XF@ WF-AT-PARAM AND IF DROP 0 EXIT THEN   \ $@ / $*: the old path
  DUP 3 XF@ ?DUP 0= IF 2DROP 0 EXIT THEN    \ no encoding: the old path
  OVER 2 XF@ XSTR                            ( node len addr )
  SWAP OVER + XE-END !  XE-P !               ( node )
  DUP 4 XF@ XE-SUBS !
  1 XF@ WF-SPECIAL AND 0<> XE-SPECIAL? !
  0 XE-REG# !
  0 IN-DQ-CONTEXT? !
  TOK-OUT @ OUT-BASE - >R
  XE-WALK
  0 IN-DQ-CONTEXT? !
  R> XE-SPLIT
  -1 ;
' XE-TRY IS ENC-EXPAND-CALL

: ADD-WORD ( word --- )
  DUP ARGV-NODE-NEXT !
  DUP 0 XF@ XSTR SWAP 1 XF@                 ( c-addr flags )
  OVER CSTRLEN 1 = 2 PICK C@ 48 - 10 U< AND OVER WF-QUOTED AND 0= AND IF
    \ a lone digit goes in quoted, as `"2"`, so a following > is not read
    \ as `2>`; the encoding says plain 2, so that word keeps to the old
    \ path (Iteration 275)
    DROP C@ 48 - 4 * W-QDIGITS + WF-QUOTED  0 ARGV-NODE-NEXT !
  THEN
  ARGV-ADD ;

: OP>WORD ( op --- c-addr )
  DUP OP-LESS = OVER OP-LESSGREAT = OR IF DROP W-LT EXIT THEN
  DUP OP-GREAT = OVER OP-CLOBBER = OR IF DROP W-GT EXIT THEN
  DUP OP-DGREAT = IF DROP W-DGT EXIT THEN
  DUP OP-GREATAND = IF DROP W-GTAND EXIT THEN
  DUP OP-LESSAND = IF DROP W-LTAND EXIT THEN
  OP-DLESS = IF W-DLT ELSE W-DLTD THEN ;

: ADD-REDIR ( redir --- )
  DUP 0 XF@ DUP 0< 0= OVER 10 < AND IF 2* W-DIGITS + 0 ARGV-ADD ELSE DROP THEN
  DUP 1 XF@ OP>WORD 0 ARGV-ADD
  2 XF@ ADD-WORD ;

\ A here-document's body, into HEREDOC-BUF. With an unquoted delimiter
\ it is expanded as a double-quoted word would be, except that `"` is
\ not special (XCU 2.7.4) - so each `"` is escaped first, and a `\`
\ before one is doubled. Done before the command's words are laid out,
\ since expanding uses ARGV (Iteration 264).
256 BUFFER: HDX-BUF
VARIABLE HDX#
: HDX-C, ( c --- )
  HDX# @ 2 + ENSURE-BUFFER HDX-BUF  HDX-BUF HDX# @ + C!  1 HDX# +! ;

: HEREDOC-SET ( c-addr u --- )
  DUP 1+ ENSURE-BUFFER HEREDOC-BUF
  DUP HEREDOC-LEN !  HEREDOC-BUF SWAP MOVE ;

: PREPARE-HEREDOC ( redir --- )
  DUP 3 XF@ 0= IF DROP EXIT THEN
  DUP 2 XF@ 1 XF@ WF-QUOTED AND IF
    3 XF@ XSTR DUP CSTRLEN HEREDOC-SET EXIT
  THEN
  0 HDX# !  34 HDX-C,
  3 XF@ XSTR DUP CSTRLEN OVER + SWAP ?DO
    I C@ 34 = IF 92 HDX-C, 34 HDX-C, ELSE
      I C@ 92 = I 1+ C@ 34 = AND IF 92 HDX-C, 92 HDX-C, ELSE
        I C@ HDX-C,
      THEN
    THEN
  LOOP
  34 HDX-C,  0 HDX-C,
  0 ARGC !  0 ARGV !  HDX-BUF WF-QUOTED ARGV-ADD
  -1 NO-GLOB? ! EXPAND-WORDS 0 NO-GLOB? !  JOIN-ARGV HEREDOC-SET ;

: PREPARE-HEREDOCS ( redirs-vec --- )
  DUP XV# 0 ?DO DUP I XV@ PREPARE-HEREDOC LOOP DROP ;
: PREPARE-SIMPLE-HEREDOCS ( items-vec --- )
  DUP XV# 0 ?DO
    DUP I XV@ I-REDIR = IF DUP I 1+ XV@ PREPARE-HEREDOC THEN
  2 +LOOP DROP ;

: TOO-MANY? ( --- f )   \ words were dropped: refuse rather than run short
  ARGS-OVERFLOW? @ DUP IF
    0 ARGS-OVERFLOW? !
    S" shell: too many arguments" ERR-TYPE ERR-NL  1 LAST-STATUS !
  THEN ;

: EXPAND-AND-RUN ( --- )   \ ARGV's raw words: what the line path does next
  WANT-EXEC? @  0 WANT-EXEC? !  >R          \ taken now, so nothing nested sees it
  TOO-MANY? IF R> DROP EXIT THEN
  0 CMDSUB-RAN? !
  EXPAND-WORDS
  TOO-MANY? IF R> DROP EXIT THEN
  EXPANSION-OK? 0= IF R> DROP EXIT THEN
  PREFIX-COUNT ARGC @ = IF XTRACE-ARGV THEN    \ set -x: an assignment-only command
  TRY-ASSIGNMENT-CALL IF
    R> DROP
    CMDSUB-RAN? @ IF CMDSUB-STATUS @ LAST-STATUS ! THEN EXIT
  THEN
  R> EXEC-LAST? !                           \ set after expansion: see RUN-EXTERNAL
  PREFIX-COUNT ?DUP IF
    TEMP-ASSIGN >R RUN-EXPANDED R> TEMP-RESTORE
  ELSE
    RUN-EXPANDED
  THEN
  0 EXEC-LAST? ! ;

: EXEC-SIMPLE ( node --- )
  DUP 1 XF@ DUP 0= NO-REDIRS? !
  IF DUP 0 XF@ PREPARE-SIMPLE-HEREDOCS THEN
  0 ARGC !  0 ARGV !
  0 XF@ DUP XV# 0 ?DO
    DUP I 1+ XV@  OVER I XV@ I-REDIR = IF ADD-REDIR ELSE ADD-WORD THEN
  2 +LOOP DROP
  EXPAND-AND-RUN ;

\ A compound command's redirections, expanded into the REDIR tables.
: REDIR-SETUP ( node --- )
  0 ARGC !  0 ARGV !  0 REDIR-N !
  0 XF@ ?DUP IF
    DUP PREPARE-HEREDOCS
    0 ARGC !  0 ARGV !
    DUP XV# 0 ?DO DUP I XV@ ADD-REDIR LOOP DROP
    EXPAND-WORDS PARSE-REDIRECTIONS
  THEN ;

\ ---- lists, and-or, pipelines ----
: EXEC-BG ( node --- )
  FORK DUP 0= IF DROP CHILD-RESET-TRAPS EXEC-FINAL-CALL LAST-STATUS @ SHELL-EXIT THEN
  BG-PID !  DROP  0 LAST-STATUS ! ;

: EXEC-LIST ( node --- )
  0 XF@ DUP XV# 0 ?DO
    STOP? IF LEAVE THEN
    DUP I XV@  OVER I 1+ XV@ IF EXEC-BG ELSE EXEC THEN
  2 +LOOP DROP ;

: EXEC-ANDOR ( node --- )
  0 XF@
  DUP XV# 1 = IF 0 XV@ EXEC EXIT THEN
  DUP 0 XV@ EXEC-IGNORING                    \ not the last: set -e ignored
  DUP XV# 1 ?DO
    STOP? IF LEAVE THEN
    DUP I XV@ 1 =  LAST-STATUS @ 0=  = IF
      DUP I 1+ XV@
      I 2 + 2 PICK XV# < IF EXEC-IGNORING ELSE EXEC THEN
    THEN
  2 +LOOP DROP ;

VARIABLE PS-VEC
VARIABLE PS-N
VARIABLE PS-PREV
VARIABLE PS-RD
VARIABLE PS-WR

: CLOSE-FD ( fd --- )   DUP 0< IF DROP ELSE CLOSE-FILE DROP THEN ;

\ Stages run in children, so these globals are never in use twice in one
\ process.
: RUN-STAGES ( vec --- )
  DUP PS-VEC !  XV# PS-N !  -1 PS-PREV !
  PS-N @ 1+ GROW-ARGS
  PS-N @ 0 ?DO
    I PS-N @ 1- < IF PIPE DROP PS-WR ! PS-RD ! ELSE -1 PS-WR ! -1 PS-RD ! THEN
    FORK DUP 0= IF
      DROP CHILD-RESET-TRAPS
      PS-PREV @ 0< 0= IF PS-PREV @ 0 DUP2 DROP PS-PREV @ CLOSE-FD THEN
      PS-WR @ 0< 0= IF PS-WR @ 1 DUP2 DROP PS-WR @ CLOSE-FD PS-RD @ CLOSE-FD THEN
      PS-VEC @ I XV@ EXEC-FINAL-CALL
      LAST-STATUS @ SHELL-EXIT
    THEN
    PIPE-PIDS I CELLS + !
    PS-PREV @ CLOSE-FD  PS-WR @ CLOSE-FD
    PS-RD @ PS-PREV !
  LOOP
  PS-N @ 0 ?DO
    PIPE-PIDS I CELLS + @ WAIT-STATUS
    I PS-N @ 1- = IF LAST-STATUS ! ELSE DROP THEN
  LOOP ;

: EXEC-PIPE ( node --- )
  DUP 0 XF@ IF                               \ ! pipeline: set -e ignored
    1 ERR-IGNORE +!
    DUP 1 XF@ DUP XV# 1 = IF 0 XV@ EXEC ELSE RUN-STAGES THEN
    -1 ERR-IGNORE +!
    DROP LAST-STATUS @ 0= IF 1 ELSE 0 THEN LAST-STATUS !  EXIT
  THEN
  1 XF@ DUP XV# 1 = IF
    0 XV@ DUP EXEC CHECK-TRAPS
    X@ DUP T-SIMPLE = SWAP T-SUBSHELL = OR IF ERREXIT-CHECK THEN
  ELSE
    RUN-STAGES CHECK-TRAPS ERREXIT-CHECK
  THEN ;

\ ---- compound commands ----
: EXEC-SUBSHELL ( node --- )
  FORK DUP 0= IF
    DROP CHILD-RESET-TRAPS
    DUP REDIR-SETUP APPLY-REDIRECTIONS
    REDIR-FAILED? @ IF 1 SYS-EXIT THEN
    1 XF@ EXEC-FINAL-CALL LAST-STATUS @ SHELL-EXIT
  THEN
  NIP WAIT-STATUS LAST-STATUS ! ;

: EXEC-IF ( node --- )
  DUP 1 XF@                                 ( node vec )
  DUP XV# 0 ?DO
    DUP I XV@ EXEC-IGNORING
    STOP? IF 2DROP UNLOOP EXIT THEN
    LAST-STATUS @ 0= IF I 1+ XV@ EXEC DROP UNLOOP EXIT THEN
  2 +LOOP DROP
  2 XF@ ?DUP IF EXEC ELSE 0 LAST-STATUS ! THEN ;

\ After a loop body: consume a break or continue aimed at this loop.
\ Leaves true when the loop must stop.
: LOOP-AFTER-BODY ( --- stop? )
  RETURN-PENDING? @ IF -1 EXIT THEN
  LOOP-CONTROL-PENDING? @ IF
    0 LOOP-CONTROL-PENDING? !
    LOOP-BREAK? @ IF 0 LOOP-BREAK? ! -1 EXIT THEN
  THEN 0 ;

: EXEC-LOOP ( node until? --- )
  LOOP-DEPTH @ 1+ LOOP-DEPTH !
  0 >R                                      \ the loop's status
  BEGIN
    OVER 1 XF@ EXEC-IGNORING
    STOP? IF 0 ELSE LAST-STATUS @ 0= OVER XOR THEN   ( node until? run? )
  WHILE
    OVER 2 XF@ EXEC
    R> DROP LAST-STATUS @ >R
    LOOP-AFTER-BODY IF 2DROP R> LAST-STATUS ! LOOP-DEPTH @ 1- LOOP-DEPTH ! EXIT THEN
  REPEAT
  2DROP R> LAST-STATUS !
  LOOP-DEPTH @ 1- LOOP-DEPTH ! ;

\ for: the words are expanded once, and copied out of ARGV, which the
\ body will overwrite.
: ARGV>BLOCK ( --- block n )   \ ARGV's words, NUL-separated, in a heap block
  0 ARGC @ 0 ?DO I ARGV@ CSTRLEN 1+ + LOOP
  1 MAX ALLOCATE DROP DUP
  ARGC @ 0 ?DO
    I ARGV@ DUP CSTRLEN 1+ >R OVER R@ MOVE R> +
  LOOP DROP
  ARGC @ ;

: EXEC-FOR ( node --- )
  DUP 2 XF@ ?DUP IF
    0 ARGC !  0 ARGV !
    DUP XV# 0 ?DO DUP I XV@ ADD-WORD LOOP DROP
    EXPAND-WORDS
    EXPANSION-OK? 0= IF DROP EXIT THEN
  ELSE
    \ no `in`: the positional parameters
    0 ARGC !  0 ARGV !
    POS-PARAM-COUNT @ 0 ?DO I POS-PARAM-SLOT 1 ARGV-ADD LOOP
  THEN
  ARGV>BLOCK                                ( node block n )
  LOOP-DEPTH @ 1+ LOOP-DEPTH !
  0 LAST-STATUS !
  OVER SWAP 0 ?DO                           ( node block p )
    2 PICK 1 XF@ 0 XF@ XSTR OVER SET-SHVAR
    2 PICK 3 XF@ EXEC
    DUP CSTRLEN 1+ +
    LOOP-AFTER-BODY IF LEAVE THEN
  LOOP DROP
  FREE DROP DROP
  LOOP-DEPTH @ 1- LOOP-DEPTH ! ;

\ case: the word and each pattern are expanded without field splitting -
\ joined back if they split.
: EXPAND-ONE ( word --- c-addr u quoted? )   \ no pathname expansion
  0 ARGC !  0 ARGV !  ADD-WORD  -1 NO-GLOB? ! EXPAND-WORDS 0 NO-GLOB? !
  ARGC @ IF 0 ARGV-QUOTED@ ELSE 0 THEN >R JOIN-ARGV R> ;

256 BUFFER: CASE-TEXT
VARIABLE CASE-TEXT#

: PATTERN-MATCHES? ( pattern --- f )
  EXPAND-ONE IF
    CASE-TEXT CASE-TEXT# @ COMPARE 0=
  ELSE
    CASE-TEXT CASE-TEXT# @ GLOB-MATCH
  THEN ;

: EXEC-CASE ( node --- )
  DUP 1 XF@ EXPAND-ONE DROP                 ( node a u )
  DUP 1+ ENSURE-BUFFER CASE-TEXT
  DUP CASE-TEXT# !  CASE-TEXT SWAP MOVE
  0 LAST-STATUS !
  2 XF@ DUP XV# 0 ?DO                       ( items )
    DUP I XV@                               ( items item )
    DUP 0 XF@ DUP XV# 0 ?DO                 ( items item pats )
      DUP I XV@ PATTERN-MATCHES? IF
        DROP 1 XF@ ?DUP IF EXEC THEN
        DROP UNLOOP UNLOOP EXIT
      THEN
    LOOP 2DROP
  LOOP DROP ;

\ Functions: the body's range of the arena is copied into a block of its
\ own, and run with EXEC-BASE pointing so that its offsets land in it.
MAX-FUNCS CELLS BUFFER: FT-BLOCK
MAX-FUNCS CELLS BUFFER: FT-BASE
MAX-FUNCS CELLS BUFFER: FT-NODE
CREATE NO-TEXT 0 C,

: EXEC-FUNCDEF ( node --- )
  DUP 1 XF@ 0 XF@ XSTR NO-TEXT 0 SET-FUNC
  DUP 1 XF@ 0 XF@ XSTR FIND-FUNC            ( node i )
  DUP 0< IF 2DROP 1 LAST-STATUS ! EXIT THEN
  OVER 4 XF@ 2 PICK 3 XF@ -                 ( node i len )
  DUP 1 MAX ALLOCATE DROP                   ( node i len block )
  3 PICK 3 XF@ XSTR OVER 3 PICK MOVE NIP    ( node i block )
  OVER CELLS FT-BLOCK + DUP @ ?DUP IF BUF-RETIRE THEN
  OVER SWAP !                               ( node i block )
  2 PICK 3 XF@ -  OVER CELLS FT-BASE + !    ( node i )
  CELLS FT-NODE + SWAP 2 XF@ SWAP !
  0 LAST-STATUS ! ;

: TREE-RUN-FUNC ( i --- )
  FUNC-DEPTH @ MAX-POS-PARAM-DEPTH < 0= IF
    DROP S" shell: function recursion too deep" ERR-TYPE ERR-NL
    1 LAST-STATUS ! EXIT
  THEN
  DUP CELLS FT-BLOCK + @ 0= IF DROP 0 LAST-STATUS ! EXIT THEN
  FUNC-DEPTH @ SAVE-POS-PARAMS
  SET-POS-PARAMS-FROM-ARGV
  FUNC-DEPTH @ 1+ FUNC-DEPTH !
  EXEC-BASE @ >R  LOCALS# @ >R
  DUP CELLS FT-BASE + @ EXEC-BASE !
  CELLS FT-NODE + @ EXEC
  R> LOCALS-RESTORE                           \ `local` variables (Iteration 271)
  R> EXEC-BASE !
  0 RETURN-PENDING? !
  FUNC-DEPTH @ 1- FUNC-DEPTH !
  FUNC-DEPTH @ RESTORE-POS-PARAMS ;

: EXEC-BARE ( node --- )   \ a compound command, its redirections applied
  DUP X@
  DUP T-IF = IF DROP EXEC-IF EXIT THEN
  DUP T-WHILE = IF DROP 0 EXEC-LOOP EXIT THEN
  DUP T-UNTIL = IF DROP -1 EXEC-LOOP EXIT THEN
  DUP T-FOR = IF DROP EXEC-FOR EXIT THEN
  DUP T-CASE = IF DROP EXEC-CASE EXIT THEN
  DROP 1 XF@ EXEC ;                         \ a group

: EXEC-COMPOUND ( node --- )
  DUP 0 XF@ 0= IF EXEC-BARE EXIT THEN
  DUP REDIR-SETUP
  >R BEGIN-REDIRECT R>
  REDIR-FAILED? @ IF DROP 1 LAST-STATUS ! ELSE EXEC-BARE THEN
  END-REDIRECT ;

: EXEC-IMPL ( node --- )
  ?DUP 0= IF EXIT THEN
  STOP? IF DROP EXIT THEN
  \ set -n: a non-interactive shell reads commands and runs none
  OPT-NOEXEC @ IF INTERACTIVE? @ 0= IF DROP EXIT THEN THEN
  DUP X@
  DUP T-SIMPLE = IF DROP EXEC-SIMPLE EXIT THEN
  DUP T-LIST = IF DROP EXEC-LIST EXIT THEN
  DUP T-ANDOR = IF DROP EXEC-ANDOR EXIT THEN
  DUP T-PIPE = IF DROP EXEC-PIPE EXIT THEN
  DUP T-SUBSHELL = IF DROP EXEC-SUBSHELL EXIT THEN
  DUP T-FUNCDEF = IF DROP EXEC-FUNCDEF EXIT THEN
  DROP EXEC-COMPOUND ;
' EXEC-IMPL IS EXEC

: EXEC-FINAL ( node --- )   \ the last thing this process does
  DUP ONE-SIMPLE? WANT-EXEC? !  EXEC  0 WANT-EXEC? ! ;
' EXEC-FINAL IS EXEC-FINAL-CALL

\ ---- running a source ----
: PARSE-ONE ( --- node | 0 )   \ the next complete command, or 0 at the end
  LINEBREAK
  K-EOF KIND? IF 0 EXIT THEN
  PARSE-COMPLETE
  K-NEWLINE KIND? IF NEXT THEN ;
VARIABLE PARSE-ONE-XT
' PARSE-ONE PARSE-ONE-XT !XT

VARIABLE NESTED?   \ running eval's or $(...)'s text, not the shell's input
VARIABLE EXIT-AFTER?   \ this process ends when this source does: its last command may exec
VARIABLE SRC-DEPTH     \ nested sources: eval's and $(...)'s

: AT-END-OF-SOURCE? ( --- f )
  \ Only blanks, newlines and comments left in a whole-text source. Not
  \ found by lexing: that could report the NEXT command's syntax error
  \ before this one runs, and outside the CATCH that reports it.
  TK-VALID? @ IF TK-KIND @ K-EOF = EXIT THEN
  SRC-POS @
  BEGIN DUP SRC-LEN @ < WHILE
    SRC-ADDR @ OVER + C@
    DUP 32 = OVER 9 = OR OVER 10 = OR IF DROP 1+ ELSE
    35 = IF
      BEGIN DUP SRC-LEN @ < IF SRC-ADDR @ OVER + C@ 10 <> ELSE 0 THEN WHILE 1+ REPEAT
    ELSE DROP 0 EXIT THEN THEN
  REPEAT DROP -1 ;

: SKIP-INPUT ( --- )   \ after an interactive syntax error: drop the line
  SRC-LEN @ SRC-POS !  0 TK-VALID? !  0 HD-PEND# ! ;

\ Parse and execute complete commands until the source ends. A syntax
\ error ends a non-interactive shell with status 2 (XCU 2.8.1); an
\ interactive one drops the rest of the line; eval's text returns 2.
: TREE-RUN ( --- )
  BEGIN
    CHECK-TRAPS
    NESTED? @ 0= IF
      BUF-FREE-RETIRED
      SRC-STDIN? @ IF SRC-POS @ SRC-LEN @ = IF 0 SRC-POS ! 0 SRC-LEN ! 0 AL-ACTIVE# ! THEN THEN
      TREE-RESET  -1 CMD-START? !
    THEN
    PARSE-ONE-XT @XT CATCH
    ?DUP IF
      DROP 2 LAST-STATUS !
      NESTED? @ IF EXIT THEN
      INTERACTIVE? @ 0= IF 2 SHELL-EXIT THEN
      SKIP-INPUT 0
    ELSE
      ?DUP 0= IF EXIT THEN
      TREE-BUF EXEC-BASE !
      \ the source's last command, in a process that ends with it
      EXIT-AFTER? @ SRC-DEPTH @ 0= AND SRC-STDIN? @ 0= AND IF
        AT-END-OF-SOURCE? IF EXEC-FINAL ELSE EXEC THEN
      ELSE
        EXEC
      THEN
      -1
    THEN DROP
  AGAIN ;

\ A nested source - eval's text, $(...)'s - saves the shell's on the data
\ stack: the nested work leaves the stack as it found it, a THROW too.
: SOURCE@ ( --- x*19 )
  SRC-ADDR @ SRC-LEN @ SRC-POS @ SRC-LINE @ SRC-STDIN? @
  TK-VALID? @ TK-KIND @ TK-OP @ TK-START @ TK-END @
  TK-FLAGS @ NESTED? @ TREE-TOP @ EXEC-BASE @ HD-PEND#  @
  SRC-SPLICED @ AL-ACTIVE# @ NO-ALIAS? @ ALIAS-NEXT? @ ;
: SOURCE! ( x*19 --- )
  ALIAS-NEXT? ! NO-ALIAS? ! AL-ACTIVE# ! SRC-SPLICED !
  HD-PEND# ! EXEC-BASE ! TREE-TOP ! NESTED? ! TK-FLAGS !
  TK-END ! TK-START ! TK-OP ! TK-KIND ! TK-VALID? !
  SRC-STDIN? ! SRC-LINE ! SRC-POS ! SRC-LEN ! SRC-ADDR ! ;
: NEST-SOURCE ( c-addr u --- )
  SRC-LEN !  SRC-ADDR !  0 SRC-POS !  1 SRC-LINE !  0 SRC-STDIN? !
  0 TK-VALID? !  0 HD-PEND# !  -1 NESTED? !
  0 SRC-SPLICED !  0 AL-ACTIVE# !  0 ALIAS-NEXT? ! ;
: END-SOURCE ( --- )   SRC-SPLICED @ ?DUP IF FREE DROP THEN ;

: TREE-RUN-TEXT ( c-addr u --- )
  >R >R SOURCE@ R> R>  NEST-SOURCE
  1 SRC-DEPTH +!  TREE-RUN  -1 SRC-DEPTH +!
  END-SOURCE SOURCE! ;

\ Where a $(...) whose text starts at c-addr ends: the length of its
\ text, without the closing paren. Found by parsing it; if it does not
\ parse, all of it.
VARIABLE SUBLIST-XT
' PARSE-SUBLIST SUBLIST-XT !XT
: TREE-CMDSUB-END ( c-addr u --- n )
  DUP >R  >R >R  SOURCE@  R> R>  NEST-SOURCE  -1 NO-ALIAS? !
  SUBLIST-XT @XT CATCH IF R@ ELSE SRC-POS @ 1- THEN
  >R SOURCE! R>
  R> MIN 0 MAX ;
' TREE-CMDSUB-END IS TREE-CMDSUB-END-CALL

: TREE-EVAL ( --- )   \ eval's arguments, joined with spaces
  0 LAST-STATUS !
  ARGC @ 2 < IF EXIT THEN
  1 JOIN-ARGV-FROM                          ( a u )
  DUP 1 MAX ALLOCATE DROP                   ( a u block )
  DUP >R SWAP DUP >R MOVE R> R>             ( u block )
  SWAP OVER >R TREE-RUN-TEXT R> FREE DROP ;

: TREE-CMDSUB ( --- )   \ in the child: $(...)'s text
  \ The line path's length counts a NUL after the text; up to it only.
  \ The child ends with this text, so its last command may exec: the text
  \ runs as the child's top-level source, not as a nested one.
  CMDSUB-LINE-BUF CMDSUB-LINES-LEN @ 0 SCAN DROP CMDSUB-LINE-BUF -
  CMDSUB-LINE-BUF SWAP
  -1 EXIT-AFTER? !  -1 SRC-DEPTH +!
  TREE-RUN-TEXT
  LAST-STATUS @ SHELL-EXIT ;

: READ-WHOLE-FILE ( c-addr --- addr u | 0 0 )
  DUP CSTRLEN R/O OPEN-FILE IF DROP 0 0 EXIT THEN
  >R R@ FILE-SIZE 2DROP
  DUP 1+ ALLOCATE DROP
  2DUP SWAP R@ READ-FILE 2DROP  R> CLOSE-FILE DROP
  SWAP ;

' TREE-RUN-FUNC IS RUN-FUNC-BODY-CALL
' TREE-CMDSUB IS RUN-CMDSUB-CHILD-CALL
' TREE-EVAL IS TREE-EVAL-CALL
: TREE-RUN-CSTR ( c-addr --- )   DUP CSTRLEN TREE-RUN-TEXT ;
' TREE-RUN-CSTR IS TRAP-RUN-CALL

: RUN-SOURCES ( --- )   \ -c, a script, or standard input
  0 NESTED? !  0 INTERACTIVE? !  0 SRC-EOF? !  0 EXIT-AFTER? !  0 SRC-DEPTH !
  SYS-ARGC 2 = IF
    S" -c" 0 SYS-ARG STR0= IF
      1 SYS-ARG DUP CSTRLEN PARSE-INIT
      -1 EXIT-AFTER? !
      TREE-RUN LAST-STATUS @ SHELL-EXIT
    THEN
  THEN
  SYS-ARGC 0 > IF
    SET-POS-PARAMS-FROM-SYS-ARGS
    0 SYS-ARG READ-WHOLE-FILE
    OVER 0= IF 2DROP 127 SYS-EXIT THEN
    PARSE-INIT
    -1 EXIT-AFTER? !
    TREE-RUN LAST-STATUS @ SHELL-EXIT
  THEN
  0 0 PARSE-INIT  -1 SRC-STDIN? !  STDIN-TEXT SRC-ADDR !
  0 ISATTY INTERACTIVE? !
  \ An interactive shell survives INT, QUIT and TERM (XCU 2.11). They
  \ are caught rather than ignored, so the programs it runs get them as
  \ usual - exec resets a caught signal, not an ignored one (Iteration 271).
  INTERACTIVE? @ IF
    2 2 SIGNAL-ACTION DROP  3 2 SIGNAL-ACTION DROP  15 2 SIGNAL-ACTION DROP
  THEN
  TREE-RUN LAST-STATUS @ SHELL-EXIT ;

: MAIN ( --- )   \ the shell image's boot word
  ALLOC-BUFFERS
  GETPID SHELL-PID !
  0 BODY-ARENA-BASE !  0 BODY-ARENA-SIZE !  0 BODY-ARENA-TOP !
  2 #ORDER !
  FORTH-WORDLIST CONTEXT !
  FORTH-WORDLIST CONTEXT CELL+ !
  FORTH-WORDLIST CURRENT !
  TIB SRC !  0 SID !
  INCLUDE-BUFFER INCLUDE-POINTER !
  0 SHVAR-INDEX-OK? !
  S" RELF_EXP" ENVNAMBUF SWAP MOVE  0 ENVNAMBUF 8 + C!
  ENVNAMBUF GETENV ?DUP IF C@ 48 <> ELSE 0 THEN OPT-ENC? !     \ its buffer is new: build it on the first lookup
  RUN-SOURCES ;

\ ==================================================================
\ Entry: parse a text, printing each complete command's tree
\ ==================================================================

: DUMP-PROGRAM ( --- )
  \ Each command's tree is dropped after printing - back to where the
  \ arena was, since the tree path may be executing the caller's tree.
  TREE-TOP @ >R
  BEGIN
    LINEBREAK
    K-EOF KIND? 0=
  WHILE
    R@ TREE-TOP !
    PARSE-COMPLETE PRINT-NODE CR
    K-NEWLINE KIND? IF NEXT THEN
  REPEAT
  R> TREE-TOP ! ;

\ tree-dump FILE: print FILE's trees; status 0, or 2 at a syntax error.
\ A development builtin for Stage A (tests/parse).
\ An xt kept as an offset from START (shadow.4's !XT): ['] would compile
\ an absolute address, wrong once the saved image loads elsewhere.
VARIABLE DUMP-XT
' DUMP-PROGRAM DUMP-XT !XT

: DO-TREE-DUMP ( --- )
  0 ENC-SHOW? !
  ARGC @ 2 > IF
    1 ARGV@ S" -e" ROT STR0= IF -1 ENC-SHOW? ! DROP-ARGV0 THEN
  THEN
  ARGC @ 2 < IF 2 LAST-STATUS ! EXIT THEN
  1 ARGV@ DUP CSTRLEN R/O OPEN-FILE IF DROP 2 LAST-STATUS ! EXIT THEN
  >R R@ FILE-SIZE 2DROP                     ( size )
  DUP 1+ ALLOCATE DROP                      ( size buf )
  2DUP SWAP R@ READ-FILE 2DROP  R> CLOSE-FILE DROP
  2DUP SWAP                                 ( size buf buf size )
  >R >R SOURCE@ R> R> NEST-SOURCE           \ a source of its own
  DUMP-XT @XT CATCH IF 2 ELSE 0 THEN >R
  END-SOURCE SOURCE!
  R> LAST-STATUS !
  NIP FREE DROP ;
' DO-TREE-DUMP S" tree-dump" BUILTIN

\ ==================================================================
\ `.` and `type` (Iteration 270)
\ ==================================================================
VARIABLE DS-AT
VARIABLE DS-END
: DOT-SEARCH ( name --- path | 0 )   \ a readable file along PATH, in PATHBUF
  CC-CURRENT-PATH OVER + DS-END !  DS-AT !
  BEGIN DS-AT @ DS-END @ < WHILE
    DS-AT @
    BEGIN DS-AT @ DS-END @ < IF DS-AT @ C@ 58 <> ELSE 0 THEN WHILE 1 DS-AT +! REPEAT
    DS-AT @ OVER -                            ( name dir len )
    DUP IF
      PATHBUF B-RESET B-STR 47 B-CHAR DUP B-CSTR B-FINISH
      PATHBUF 4 ACCESS 0= IF
        PATHBUF OPEN-DIR ?DUP IF CLOSE-DIR ELSE DROP PATHBUF EXIT THEN
      THEN
    ELSE 2DROP THEN
    DS-AT @ DS-END @ < IF 1 DS-AT +! THEN
  REPEAT DROP 0 ;

: DOT-FIND ( name --- path | 0 )
  \ A name with a slash is itself; otherwise the first readable file
  \ along PATH, and then the current directory (bash; dash stops at PATH).
  DUP DUP CSTRLEN HAS-SLASH? IF EXIT THEN
  DUP DOT-SEARCH ?DUP IF NIP EXIT THEN
  DUP 4 ACCESS 0= IF EXIT THEN
  DROP 0 ;

: DO-DOT ( --- )
  ARGC @ 2 < IF
    S" shell: .: filename argument required" ERR-TYPE ERR-NL  2 LAST-STATUS ! EXIT
  THEN
  1 ARGV@ DOT-FIND ?DUP 0= IF
    S" shell: .: " ERR-TYPE 1 ARGV@ ERR-CSTR S" : not found" ERR-TYPE ERR-NL
    1 LAST-STATUS ! EXIT
  THEN
  READ-WHOLE-FILE                             ( addr u | 0 0 )
  OVER 0= IF
    2DROP S" shell: .: cannot read " ERR-TYPE 1 ARGV@ ERR-CSTR ERR-NL
    1 LAST-STATUS ! EXIT
  THEN
  \ arguments after the file are its positional parameters while it runs
  ARGC @ 2 > DUP >R IF
    FUNC-DEPTH @ MAX-POS-PARAM-DEPTH < 0= IF
      R> DROP DROP FREE DROP
      S" shell: .: nested too deep" ERR-TYPE ERR-NL  1 LAST-STATUS ! EXIT
    THEN
    DROP-ARGV0
    FUNC-DEPTH @ SAVE-POS-PARAMS  SET-POS-PARAMS-FROM-ARGV
    FUNC-DEPTH @ 1+ FUNC-DEPTH !
  THEN
  1 DOT-DEPTH +!
  0 LAST-STATUS !
  OVER >R TREE-RUN-TEXT R> FREE DROP
  -1 DOT-DEPTH +!
  0 RETURN-PENDING? !
  R> IF FUNC-DEPTH @ 1- FUNC-DEPTH !  FUNC-DEPTH @ RESTORE-POS-PARAMS THEN ;

: KEYWORD? ( c-addr --- f )
  >R
  S" if" R@ STR0=  S" then" R@ STR0= OR  S" else" R@ STR0= OR
  S" elif" R@ STR0= OR  S" fi" R@ STR0= OR  S" case" R@ STR0= OR
  S" esac" R@ STR0= OR  S" for" R@ STR0= OR  S" while" R@ STR0= OR
  S" until" R@ STR0= OR  S" do" R@ STR0= OR  S" done" R@ STR0= OR
  S" in" R@ STR0= OR  S" {" R@ STR0= OR  S" }" R@ STR0= OR
  S" !" R@ STR0= OR
  R> DROP ;

: TYPE-ONE ( c-addr --- found? )   \ dash's wording
  DUP DUP CSTRLEN TYPE
  DUP KEYWORD? IF DROP S"  is a shell keyword" TYPE CR -1 EXIT THEN
  DUP FIND-ALIAS DUP 0< 0= IF
    NIP S"  is an alias for " TYPE ALIAS-VALUE-SLOT DUP CSTRLEN TYPE CR -1 EXIT
  THEN DROP
  DUP FIND-FUNC -1 <> IF DROP S"  is a shell function" TYPE CR -1 EXIT THEN
  DUP FIND-BUILTIN IF DROP S"  is a shell builtin" TYPE CR -1 EXIT THEN
  DUP DUP CSTRLEN HAS-SLASH? IF
    DUP 1 ACCESS 0= IF S"  is " TYPE DUP CSTRLEN TYPE CR -1 EXIT THEN
    DROP S" : not found" TYPE CR 0 EXIT
  THEN
  LOCATE-COMMAND ?DUP IF S"  is " TYPE DUP CSTRLEN TYPE CR -1 EXIT THEN
  S" : not found" TYPE CR 0 ;

: DO-TYPE ( --- )
  0 LAST-STATUS !
  ARGC @ 1 ?DO
    I ARGV@ TYPE-ONE 0= IF 127 LAST-STATUS ! THEN
  LOOP ;

' DO-DOT S" ." BUILTIN
' DO-TYPE S" type" BUILTIN
